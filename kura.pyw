        hmore.setStyleSheet(glass)
        hmore.clicked.connect(lambda: self.more_menu(hmore))
        hnew = QPushButton(" New channel")
        hnew.setIcon(glyph_icon("add", "white", "white"))
        hnew.setStyleSheet(glass)
        hnew.clicked.connect(lambda: self.edit_channel(None))
        self.hero.top.addWidget(hmore)
        self.hero.top.addWidget(hnew)
        self.images, self.fetchers = {}, set()   # {show id: banner QImage}
        now_scroll = QScrollArea()
        now_scroll.setWidgetResizable(True)
        now_scroll.setFrameShape(QFrame.NoFrame)
        now_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        now_scroll.verticalScrollBar().setSingleStep(24)
        self.now_inner = QWidget()
        self.now_col = QVBoxLayout(self.now_inner)
        self.now_col.setContentsMargins(0, 0, 0, 28)
        self.now_col.setSpacing(0)
        self.now_col.addWidget(self.hero)
        now_scroll.setWidget(self.now_inner)
        self.stack.addWidget(now_scroll)
        self.guide_scroll = QScrollArea()
        self.guide_scroll.setFrameShape(QFrame.NoFrame)
        self.guide = GuideView(self.guide_scroll)
        self.guide.tune.connect(self.guide_click)
        self.guide.menu_for.connect(self.program_menu)
        self.guide_scroll.setWidget(self.guide)
        guide_page = QWidget()   # Live TV B: the chosen channel's muted preview above the guide
        gl = QVBoxLayout(guide_page)
        gl.setContentsMargins(0, 0, 0, 0)
        gl.setSpacing(0)
        self.preview = LivePreview(self)
        self.preview_cid = None
        gl.addWidget(self.preview)
        gl.addWidget(self.guide_scroll, 1)
        self.stack.addWidget(guide_page)
        self.outer.addWidget(self.stack, 1)
        self.stack.setCurrentIndex(1 if self.view.value() == "guide" else 0)
        self.apply_view(self.view.value())
        self.timer = QTimer(self, interval=20000, timeout=self.tick)
        self.shown_day = None

    def set_status(self, text):
        self.status.setText(text)
        self.hero_status.setText(text)

    def apply_view(self, v):
        """On now: no page margins or header (the banner carries them); Guide: the normal page."""
        now = v == "now"
        self.outer.setContentsMargins(*((0, 0, 0, 0) if now else (36, 28, 36, 28)))
        self.outer.setSpacing(0 if now else 20)
        for w in (self.title_label, self.subtitle, self.more_btn, self.new_btn, self.view, self.status):
            w.setVisible(not now)
        self.view.buttons[v].setChecked(True)
        self.hero_view.buttons[v].setChecked(True)

    # ---- making the days
    def showEvent(self, e):
        super().showEvent(e)
        self.ensure()
        self.timer.start()

    def hideEvent(self, e):
        super().hideEvent(e)
        self.timer.stop()

    def warm_durations(self):
        """Read the lengths of library episodes Live TV doesn't know yet, in the background (2 at a time)."""
        if SELFTEST or self.job is not None or self.warm_job is not None or not subs_mod.ffmpeg_installed():
            return
        files = [p for idx in self.library.indexes().values() if idx
                 for eps in (idx.get("local") or {}).values() for p in eps.values()]
        todo = [f for f in files if self.durations.get(f) is None]
        if not todo:
            return
        self.warm_stop = False
        self.warm_job = BgCall(lambda: self.durations.fill(todo, workers=2, cancelled=lambda: self.warm_stop))

        def done(n, err):
            self.warm_job.wait()
            self.warm_job = None
            klog.info(f"Live TV: read {n or 0} new episode lengths in the background" + (f" ({err})" if err else ""))
        self.warm_job.done.connect(done)
        self.warm_job.start()

    def ensure(self, force=False):
        """Today's and tomorrow's line-ups (made in the background the first time)."""
        today = livetv_mod.day_of()
        tomorrow = livetv_mod.next_day(today)
        if not force and self.tv.has_day(today) and self.tv.has_day(tomorrow):
            if self.shown_day != today or not self.cards:
                self.render()
            return
        if self.job is not None:
            return
        indexes = dict(self.library.indexes())
        if not indexes:
            self.set_status("Waiting for your library…")
            QTimer.singleShot(2000, self.ensure)
            return
        self.set_status("Making today's line-up…")
        settings = dict(self.settings)
        tv = self.tv   # this side's: you may switch sides while it's made

        def work():
            def progress(done, total):
                QTimer.singleShot(0, self, lambda: self.set_status(f"Reading episode lengths… {done} of {total} (only "
                                                                   "the first time)"))
            shows, planning = live_snapshot(indexes, self.account, self.durations, progress)
            if force:
                tv.forget_from(today)
            tv.make_day(today, shows, planning, settings)
            tv.make_day(tomorrow, shows, planning, settings)
            return shows
        self.job = BgCall(work)
        self.job.done.connect(lambda shows, err, j=self.job: self.made(shows, err, j))
        self.job.start()

    def made(self, shows, err, job=None):
        job = job or self.job
        job.wait()
        self.old_jobs = [j for j in getattr(self, "old_jobs", []) if j is not job]
        if job is not self.job:
            return   # made for the other side (you switched meanwhile): it's saved there, nothing to show
        self.job = None
        if err:
            self.set_status(f"Couldn't make the line-up: {err}")
            klog.error(f"Live TV: {err}")
            return
        self.shows = shows or self.shows
        self.render()

    def tick(self):
        if livetv_mod.day_of() != self.shown_day or not self.tv.has_day(livetv_mod.next_day(livetv_mod.day_of())):
            self.ensure()
            return
        self.render(keep_scroll=True)

    # ---- showing
    def switch(self, v):
        self.settings["live_view"] = v
        save_settings(self.settings)
        self.stack.setCurrentIndex(1 if v == "guide" else 0)
        self.apply_view(v)
        if v == "guide":
            self.scroll_guide_to_now()

    def render(self, keep_scroll=False):
        today = livetv_mod.day_of()
        self.shown_day = today
        chans = self.tv.channels(today)
        self.subtitle.setText(f"{datetime.now().strftime('%A %d %B')}  ·  {len(chans)} channels  ·  new line-up "
                              "every day at 4:00")
        n_custom = sum(1 for c in chans if not c.get("auto"))
        self.set_status(f"{n_custom} of yours" if n_custom else "")
        # On now: the banner (the first channel showing an episode of a show), then every channel as a tile
        while self.now_col.count() > 1:   # the banner stays (index 0); the wall below is made again
            it = self.now_col.takeAt(1)
            if it.widget():
                it.widget().deleteLater()
        self.cards, jobs = [], []
        now = time.time()
        rows = []
        for ch in chans:
            prog, _ = self.tv.on_at(ch["id"], now)
            nxt = (self.tv.upcoming(ch["id"], now, 1) or [None])[0]
            rows.append((ch, prog, nxt))
        feat = next((r for r in rows if r[1] and r[1].get("kind") == "episode" and r[1].get("mid")),
                    rows[0] if rows else None)
        if feat:
            mid = (feat[1] or {}).get("mid")
            self.hero.mid = mid
            self.hero.set_channel(*feat, self.art(mid, feat[1], jobs))
        wall = QWidget()
        wl = QVBoxLayout(wall)
        wl.setContentsMargins(36, 0, 36, 0)
        wl.setSpacing(12)
        wl.addWidget(row_title("All channels"))
        grid = ResponsiveGrid(min_col=250, max_cols=4, spacing=16)
        for ch, prog, nxt in rows:
            tile = ChannelTile(ch, prog, nxt)
            src = prog if prog and prog.get("mid") else (nxt or {})
            tile.mid = src.get("mid")
            img = self.art(tile.mid, src, jobs)
            if img is not None:
                tile.set_image(img)
            tile.clicked.connect(lambda c=ch["id"]: self.watch.emit(c))
            tile.setContextMenuPolicy(Qt.CustomContextMenu)
            tile.customContextMenuRequested.connect(lambda pos, c=ch, w=tile: self.channel_menu(c, w.mapToGlobal(pos)))
            grid.add(tile)
            self.cards.append(tile)
        wl.addWidget(grid)
        self.now_col.addWidget(wall)
        self.now_col.addStretch(1)
        if jobs:
            fetcher = ImageFetcher(jobs)
            fetcher.image.connect(self.on_banner)
            fetcher.finished.connect(lambda: self.fetchers.discard(fetcher))
            self.fetchers.add(fetcher)
            fetcher.start()
        # Guide (today's programmes and tomorrow's, for after 4:00)
        tomorrow = {c["id"]: c for c in self.tv.channels(livetv_mod.next_day(today))}
        merged = []
        for ch in chans:
            progs = list(ch["programs"]) + list((tomorrow.get(ch["id"]) or {}).get("programs") or [])
            merged.append({**ch, "programs": progs})
        self.update_preview()
        x = self.guide_scroll.horizontalScrollBar().value()
        self.guide.set_channels(merged)
        if keep_scroll:
            self.guide_scroll.horizontalScrollBar().setValue(x)
        else:
            QTimer.singleShot(0, self.scroll_guide_to_now)

    def scroll_guide_to_now(self):
        x = self.guide.x_of(time.time()) - self.guide.NAMES - 120
        self.guide_scroll.horizontalScrollBar().setValue(int(max(0, x)))

    def guide_click(self, cid):
        """A programme that's on now: the first click shows it in the preview, a second one tunes in."""
        if cid == self.preview_cid:
            self.watch.emit(cid)
            return
        self.preview_cid = cid
        self.update_preview()

    def update_preview(self):
        chans = self.tv.channels(livetv_mod.day_of())
        ch = next((c for c in chans if c["id"] == self.preview_cid), None) or (self.hero.ch if self.hero.ch else None) \
            or (chans[0] if chans else None)
        if not ch:
            return
        self.preview_cid = ch["id"]
        now = time.time()
        prog, _ = self.tv.on_at(ch["id"], now)
        nxt = (self.tv.upcoming(ch["id"], now, 1) or [None])[0]
        jobs = []
        img = self.art((prog or {}).get("mid"), prog, jobs)
        self.preview.set_channel(ch, prog, nxt, img)
        if jobs:
            fetcher = ImageFetcher(jobs)
            fetcher.image.connect(self.on_banner)
            fetcher.finished.connect(lambda: self.fetchers.discard(fetcher))
            self.fetchers.add(fetcher)
            fetcher.start()

    def art(self, mid, prog, jobs):
        """A show's banner for the On now banner / tiles: from memory or disk, else its cover for now and the banner
        fetched (on_banner)."""
        if not mid:
            return None
        if mid in self.images:
            return self.images[mid]
        img, url = live_banner(mid)
        if img is not None:
            self.images[mid] = img
            return img
        if url and all(j[0] != str(mid) for j in jobs):
            jobs.append((str(mid), url, f"banner_{mid}"))
        return self.provider.cover(prog or {"mid": mid})

    def on_banner(self, key, img):
        mid = int(key)
        self.images[mid] = img
        if getattr(self.hero, "mid", None) == mid:
            self.hero.set_image(img)
        if (self.preview.prog or {}).get("mid") == mid:
            self.preview.art.set_image(img)
        for t in self.cards:
            if getattr(t, "mid", None) == mid:
                t.set_image(img)

    # ---- menus
    def program_menu(self, cid, prog, pos):
        m = QMenu(self)
        if prog["start"] > time.time():
            key = (cid, prog["start"])
            reminded = any((r["cid"], r["start"]) == key for r in self.tv.state["reminders"])
            m.addAction("Don't remind me" if reminded else f"Remind me at {player_mod.clock(prog['start'])}",
                        lambda: self.remind(cid, prog, not reminded))
        elif prog["start"] <= time.time() < prog["end"]:
            m.addAction("Tune in", lambda: self.watch.emit(cid))
        if prog.get("mid"):
            m.addAction("Show page", lambda: self.open_media.emit(prog["mid"], prog.get("title") or "", None))
        if not m.isEmpty():
            m.exec(pos)

    def remind(self, cid, prog, on):
        rs = [r for r in self.tv.state["reminders"] if (r["cid"], r["start"]) != (cid, prog["start"])]
        if on:
            ch = self.tv.channel(cid) or {}
            rs.append({"cid": cid, "start": prog["start"], "title": prog.get("title") or "", "mid": prog.get("mid"),
                       "channel": f"{ch.get('number', '')} {ch.get('name', '')}".strip()})
            self.notify.emit(f"I'll remind you when {prog.get('title')} starts ({player_mod.clock(prog['start'])})")
        self.tv.state["reminders"] = rs
        self.tv.save()

    def due_reminders(self):
        """Reminders whose programme starts within the next minute (MainWindow asks every 30 s)."""
        now = time.time()
        due = [r for r in self.tv.state["reminders"] if now - 120 <= r["start"] <= now + 60]
        if due or any(r["start"] < now - 120 for r in self.tv.state["reminders"]):
            self.tv.state["reminders"] = [r for r in self.tv.state["reminders"] if r["start"] > now + 60]
            self.tv.save()
        return due

    def channel_menu(self, ch, pos):
        m = QMenu(self)
        m.addAction("Tune in", lambda: self.watch.emit(ch["id"]))
        if ch.get("auto"):
            m.addAction("Keep this channel (make it one of yours)", lambda: self.keep(ch))
        else:
            m.addAction("Edit channel…", lambda: self.edit_channel(ch["id"]))
            m.addAction("Delete channel", lambda: self.delete_channel(ch["id"]))
        m.exec(pos)

    def more_menu(self, anchor):
        m = QMenu(self)
        mine = self.tv.custom
        if mine:
            sub = m.addMenu("Your channels")
            for c in sorted(mine, key=lambda c: c.get("number") or 99):
                sub.addAction(f"{c.get('number') or '–'}  {c['name']}", lambda cid=c["id"]: self.edit_channel(cid))
            m.addSeparator()
        for key, text in (("live_openings", "Openings and endings between shows"),
                          ("live_commercials", "The shows' own commercials and previews (CM, PV)"),
                          ("live_trailers", "Trailers for your Planning shows as commercials"),
                          ("live_cards", "\"Up next\" cards between shows")):
            a = m.addAction(text)
            a.setCheckable(True)
            a.setChecked(self.settings.get(key, True))
            a.toggled.connect(lambda on, k=key: (self.settings.__setitem__(k, on), save_settings(self.settings)))
        m.addSeparator()
        m.addAction("Make today's line-up again", lambda: self.ensure(force=True))
        m.exec(anchor.mapToGlobal(QPoint(0, anchor.height())))

    # ---- your channels
    def shows_for_dialog(self):
        """The shows to pick from (lengths as already known; nothing is read from the files here)."""
        return self.shows or live_snapshot(dict(self.library.indexes()), self.account, self.durations, probe=False)[0]

    def edit_channel(self, cid):
        ch = next((c for c in self.tv.custom if c["id"] == cid), None) if cid else None
        shows = self.shows or self.shows_for_dialog()
        dlg = ChannelDialog(self, shows, ch)
        if dlg.exec() != QDialog.Accepted:
            return
        new = dlg.value()
        self.tv.custom = [c for c in self.tv.custom if c["id"] != new["id"]] + [new]
        self.tv.save_channels()
        self.notify.emit(f"Channel saved: {new['name']}")
        self.ensure(force=True)

    def delete_channel(self, cid):
        if QMessageBox.question(self, "Live TV", "Delete this channel?") != QMessageBox.Yes:
            return
        self.tv.custom = [c for c in self.tv.custom if c["id"] != cid]
        self.tv.save_channels()
        self.ensure(force=True)

    def keep(self, ch):
        """An automatic channel you like becomes one of yours (same shows, from now on every day)."""
        today = self.tv.channel(ch["id"]) or ch
        keys = sorted({p["show"] for p in today.get("programs") or [] if p.get("kind") == "episode" and p.get("show")})
        new = {"id": f"user:{int(time.time() * 1000)}", "name": ch["name"], "colour": ch.get("colour"),
               "number": None, "mode": ch.get("mode") if ch.get("mode") in ("blocks", "shuffle", "random") else "blocks",
               "block": 2, "track": bool(ch.get("track")), "pick": keys}
        self.tv.custom.append(new)
        self.tv.save_channels()
        self.notify.emit(f"{ch['name']} is now one of your channels")
        self.ensure(force=True)

    def set_mode(self, adult):
        """Anime / 18+: the other side's channels (its own schedule, channels and reminders)."""
        if self.tvs.get(adult) is None:
            self.tvs[adult] = livetv_mod.LiveTV(SCRIPT_DIR, "livetv_adult_" if adult else "livetv_")
        if self.job is not None:   # still making the other side's line-up: let it finish there, in the background
            self.old_jobs = getattr(self, "old_jobs", []) + [self.job]
            self.job = None
        self.tv = self.provider.tv = self.tvs[adult]
        self.shows, self.cards, self.shown_day = [], [], None
        if self.isVisible():
            self.ensure()

    def shutdown(self):
        self.warm_timer.stop()
        self.warm_stop = True
        for j in [self.job, self.warm_job] + getattr(self, "old_jobs", []):
            if j is not None:
                j.wait(60000)


META_STATE = SCRIPT_DIR / "metadata_state.json"   # {known: [show folders cached], last: time}


def fetch_file(url, dest):
    """Download a picture into cover_cache if it isn't there yet (bytes only, no decoding). True if it's there."""
    if dest.exists():
        return True
    try:
        req = urllib.request.Request(url, headers={"User-Agent": org.USER_AGENT})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = resp.read()
        tmp = dest.with_suffix(dest.suffix + ".part")
        tmp.write_bytes(data)
        os.replace(tmp, dest)
        return True
    except Exception:
        return False


def pic_dest(url, stem):
    return COVER_DIR / f"{stem}{Path(url.split('?')[0]).suffix or '.jpg'}"


class MetaCacher(QThread):
    """Tools → Library metadata: everything Kura shows about the shows in your libraries, cached ahead. Phases:
    matching + season links + 18+ flags, show info (AniList details), characters, pictures (covers, banners,
    episode stills, characters and voice actors), filler, skip times (AniSkip)."""
    progress = Signal(str, int, int)   # phase, done, total
    finished_with = Signal(dict)

    def __init__(self, folders, parts):
        super().__init__()
        self.folders, self.parts = [Path(f) for f in folders], parts

    def stop(self):
        return self.isInterruptionRequested()

    def run(self):
        summary = {"shows": 0, "entries": 0, "characters": 0, "pictures": 0, "filler": 0, "skips": 0, "failed": 0}
        try:
            self.work(summary)
        except Exception as e:
            klog.exception("Library metadata")
            summary["error"] = str(e)
        self.finished_with.emit(summary)

    def work(self, summary):
        cache = org.load_cache()
        shows = {}   # folder → {entry, ids, seasons}
        for n, d in enumerate(self.folders, 1):
            if self.stop():
                return
            self.progress.emit("Matching shows and their seasons", n, len(self.folders))
            entry, _ = org.lookup(d.name, None, cache)
            if not entry:
                continue
            ids, seasons = {entry["id"]}, [entry["id"]]
            try:
                smap = org.season_map(entry, cache)
                seasons = [s["id"] for s in (smap or {}).get("seasons") or [] if s] or seasons
                fam = org.show_family(entry, cache)
                ids |= {m["entry"]["id"] for m in (fam or {}).get("members") or []}
            except Exception:
                org.log.exception(f"Season links for {d.name}")
            ids |= set(seasons)
            shows[d] = {"entry": entry, "ids": ids, "seasons": seasons}
        all_ids = sorted({i for s in shows.values() for i in s["ids"]})
        adult = org.adult_ids(all_ids, cache)
        save_lookup_cache(cache)
        summary["shows"], summary["entries"] = len(shows), len(all_ids)

        details = {}
        for k in range(0, len(all_ids), 50):
            if self.stop():
                return
            self.progress.emit("Show info from AniList", min(k + 50, len(all_ids)), len(all_ids))
            details.update(fetch_details(all_ids[k:k + 50]))

        char_ids = sorted({i for s in shows.values() for i in s["seasons"]})
        chars = {}
        for k in range(0, len(char_ids), 10):
            if self.stop():
                return
            self.progress.emit("Characters", min(k + 10, len(char_ids)), len(char_ids))
            chars.update(fetch_characters(char_ids[k:k + 10]))
        summary["characters"] = sum(len(c.get("edges") or []) for c in chars.values())

        pics = []
        for mid, d in details.items():
            cover = (d.get("coverImage") or {}).get("extraLarge")
            if cover:
                pics.append((cover, str(mid)))
            if d.get("bannerImage"):
                pics.append((d["bannerImage"], f"banner_{mid}"))
            if self.parts.get("stills"):
                for ep in d.get("streamingEpisodes") or []:
                    if ep.get("thumbnail"):
                        pics.append((ep["thumbnail"], still_stem(ep["thumbnail"])))
        for got in chars.values():
            for e in (got.get("edges") or [])[:25]:
                n = e.get("node") or {}
                if (n.get("image") or {}).get("large"):
                    pics.append((n["image"]["large"], f"char_{n['id']}"))
                for va in (e.get("voiceActors") or [])[:1]:
                    if (va.get("image") or {}).get("large"):
                        pics.append((va["image"]["large"], f"va_{va['id']}"))
        todo = [(u, pic_dest(u, stem)) for u, stem in dict.fromkeys(pics) if not pic_dest(u, stem).exists()]
        COVER_DIR.mkdir(exist_ok=True)
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(6) as pool:   # AniList's CDN has no rate limit
            for n, ok in enumerate(pool.map(lambda job: self.stop() or fetch_file(*job), todo), 1):
                summary["pictures" if ok else "failed"] += 1
                if n % 10 == 0 or n == len(todo):
                    self.progress.emit("Pictures", n, len(todo))

        tv = [i for i in char_ids if i not in adult and (details.get(i) or {}).get("format") in org.TV_FORMATS]
        if self.parts.get("filler"):
            for n, mid in enumerate(tv, 1):
                if self.stop():
                    return
                self.progress.emit("Filler episodes", n, len(tv))
                if filler_mod.fresh(mid):
                    continue
                d = details.get(mid) or {}
                t = d.get("title") or {}
                try:
                    filler_mod.fetch(mid, {"titles": [x for x in (t.get("english"), t.get("romaji"),
                                                                   *(d.get("synonyms") or [])) if x],
                                           "episodes": d.get("episodes"), "mal": d.get("idMal")})
                    summary["filler"] += 1
                except Exception:
                    summary["failed"] += 1

        if self.parts.get("skips"):   # every episode you have of a TV season with a MyAnimeList id
            eps = []
            for d, s in shows.items():
                try:
                    idx = library_index(d, cache, details, {}, {})
                except Exception:
                    idx = None
                for sid, files in ((idx or {}).get("local") or {}).items():
                    mal = (details.get(sid) or {}).get("idMal")
                    if mal and sid in tv:
                        eps += [(mal, ep) for ep in files]
            todo = [(mal, ep) for mal, ep in eps if player_mod.aniskip(mal, ep, fetch=False) is None]
            for n, (mal, ep) in enumerate(todo, 1):
                if self.stop():
                    return
                self.progress.emit("Opening / ending skip times", n, len(todo))
                try:
                    player_mod.aniskip(mal, ep)
                    summary["skips"] += 1
                except Exception:
                    summary["failed"] += 1
                time.sleep(0.25)   # be gentle with AniSkip

        state = _read_json(META_STATE)
        state["known"] = sorted(set(state.get("known") or []) | {str(d) for d in self.folders})
        state["last"] = time.time()
        _write_json(META_STATE, state)


def library_folders(settings, adult_too=True):
    """Every show folder in the Anime library (and the Hentai one, when that side is on)."""
    roots = [anime_library(settings)]
    if adult_too and settings.get("adult_enabled"):
        roots.append(adult_value(settings, "library"))
    out = []
    for r in roots:
        try:
            out += [p for p in Path(r).iterdir() if p.is_dir() and not org.is_link(p) and not p.name.startswith(".")
                    and p.name.lower() not in SKIP_DIRS]
        except (OSError, TypeError):
            pass
    return sorted(out, key=lambda p: p.name.lower())


