def placeholder_gradient(rect, seed):
    hue = zlib.crc32(seed.encode()) % 360
    grad = QLinearGradient(rect.topLeft(), rect.bottomRight())
    grad.setColorAt(0, QColor.fromHsl(hue, 120, 70))
    grad.setColorAt(1, QColor.fromHsl((hue + 40) % 360, 110, 38))
    return grad


class RoundedImage(QWidget):
    def __init__(self, w, h, radius=10, seed=""):
        super().__init__()
        self.setFixedSize(w, h)
        self.radius, self.seed, self.img, self._pm = radius, seed, None, None

    def set_image(self, img):
        self.img, self._pm = img, None
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect())
        clip = QPainterPath()
        clip.addRoundedRect(r, self.radius, self.radius)
        p.setClipPath(clip)
        if self.img is not None:
            dpr = self.devicePixelRatioF()
            if (self._pm is None or self._pm.devicePixelRatio() != dpr
                    or self._pm.width() != round(self.width() * dpr)):   # resized (stretching ones: Live TV tiles)
                self._pm = cover_pixmap(self.img, self.width(), self.height(), dpr)
            p.drawPixmap(0, 0, self._pm)
        else:
            p.fillRect(r, placeholder_gradient(r, self.seed))
        p.setClipping(False)
        p.setPen(QPen(QColor(255, 255, 255, 20), 1))
        p.drawRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), self.radius, self.radius)


KIND_COLORS = {"filler": "#f5b642", "mixed": "#d9a45a", "recap": "#8d93a6"}   # filler guide marks
KIND_NAMES = {"filler": "Filler", "mixed": "Mixed canon / filler", "recap": "Recap"}


def filler_info(mid, account):
    """What the filler lookup needs for a show (called on a background thread: mal_id may ask AniList)."""
    m = media_for(mid, account)
    t = m.get("title") or {}
    return {"titles": [x for x in (t.get("english"), t.get("romaji"), *(m.get("synonyms") or [])) if x],
            "episodes": m.get("episodes"), "mal": mal_id(mid)}


class EpisodeGrid(QWidget):
    """Numbered episode chips that wrap to the width. Click a downloaded one to play it.
    With AniList connected, watched episodes are dimmed and right-click marks progress."""
    CW, CH, GAP = 40, 30, 8
    PAD = 4   # room around the grid so the "next up" ring isn't clipped at the edges
    mark = Signal(int)   # set progress to this episode

    def __init__(self, chips):
        super().__init__()
        self.chips = chips
        self.hover = -1
        self.progress = None   # episodes watched (None = not tracked)
        self.next_n = None     # highlighted "next up" episode
        self.trackable = False
        self.mid = None
        self.downloading = {}  # episode text → 0..1 while qBittorrent downloads it
        self.kinds = {}        # episode number → "filler" / "mixed" / "recap" (filler guide)
        self.setMouseTracking(True)
        sp = QSizePolicy(QSizePolicy.Preferred, QSizePolicy.Preferred)
        sp.setHeightForWidth(True)
        self.setSizePolicy(sp)

    def _cols(self, w):
        return max(1, (w - 2 * self.PAD + self.GAP) // (self.CW + self.GAP))

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        rows = math.ceil(len(self.chips) / self._cols(w)) if self.chips else 0
        return max(0, rows * (self.CH + self.GAP) - self.GAP + 2 * self.PAD) if rows else 0

    def sizeHint(self):
        return QSize(600, self.heightForWidth(600))

    def minimumSizeHint(self):
        return QSize(self.CW, self.heightForWidth(self.width() or 600))

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.updateGeometry()

    def _rect(self, i):
        cols = self._cols(self.width())
        return QRectF(self.PAD + (i % cols) * (self.CW + self.GAP), self.PAD + (i // cols) * (self.CH + self.GAP),
                      self.CW, self.CH)

    def _index_at(self, pos):
        cols = self._cols(self.width())
        col = int((pos.x() - self.PAD) // (self.CW + self.GAP))
        row = int((pos.y() - self.PAD) // (self.CH + self.GAP))
        i = row * cols + col
        return i if col < cols and 0 <= i < len(self.chips) and self._rect(i).contains(pos) else -1

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        f = QFont(self.font())
        f.setPointSizeF(8.5)
        f.setWeight(QFont.DemiBold)
        p.setFont(f)
        for i, (text, state, _, _) in enumerate(self.chips):
            r = self._rect(i).adjusted(0.5, 0.5, -0.5, -0.5)
            hot = i == self.hover
            if state == HAVE:
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(C["accent_hi"] if hot else C["accent"]))
                fg = QColor("white")
            elif state == MISSING:
                p.setPen(QPen(QColor(255, 93, 115, 150), 1))
                p.setBrush(QColor(255, 93, 115, 40 if hot else 22))
                fg = QColor(C["bad"])
            else:
                pen = QPen(QColor(C["border_hi"]), 1, Qt.DashLine)
                p.setPen(pen)
                p.setBrush(Qt.NoBrush)
                fg = QColor(C["faint"])
            frac = self.downloading.get(text) if state != HAVE else None
            if frac is not None:   # downloading: accent outline, filled as far as it got
                p.setPen(QPen(QColor(C["accent"]), 1))
                p.setBrush(accent_color(30))
                fg = QColor(C["accent_hi"])
            watched = self.progress is not None and text.isdigit() and int(text) <= self.progress
            p.setOpacity(0.35 if watched and not hot else 1)
            p.drawRoundedRect(r, 7, 7)
            if frac:
                path = QPainterPath()
                path.addRoundedRect(r, 7, 7)
                p.save()
                p.setClipPath(path)
                p.fillRect(QRectF(r.x(), r.y(), r.width() * min(frac, 1), r.height()), accent_color(110))
                p.restore()
            p.setPen(fg)
            p.drawText(r, Qt.AlignCenter, text)
            kind = self.kinds.get(int(text)) if text.isdigit() else None
            if kind:   # filler / recap: a short bar along the bottom
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(KIND_COLORS[kind]))
                p.drawRoundedRect(QRectF(r.x() + 9, r.bottom() - 4, r.width() - 18, 2.5), 1.2, 1.2)
            p.setOpacity(1)
            if self.next_n is not None and text == str(self.next_n):
                # Focus-style ring with a small gap, in the chip's own colour
                ring = QColor(C["accent_hi"] if state == HAVE else C["bad"] if state == MISSING else C["muted"])
                p.setPen(QPen(ring, 1.5))
                p.setBrush(Qt.NoBrush)
                p.drawRoundedRect(r.adjusted(-3, -3, 3, 3), 10, 10)

    def set_progress(self, progress, next_n):
        self.progress, self.next_n = progress, next_n
        self.update()

    def pad_rects(self):
        """Controller targets: each chip."""
        return [self._rect(i).toRect() for i in range(len(self.chips))]

    def set_downloading(self, downloading):
        if downloading != self.downloading:
            self.downloading = downloading
            self.update()

    def contextMenuEvent(self, e):
        i = self._index_at(e.pos().toPointF())
        if i < 0:
            return
        text, _, _, path = self.chips[i]
        menu = QMenu(self)
        if path:
            menu.addAction(glyph_icon(G["play"], C["text"]), "Play",
                           lambda: play_video(path))
            subtitle_actions(menu, path)
        if self.trackable and text.isdigit():
            n = int(text)
            menu.addAction(glyph_icon(G["add"], C["text"]), f"Watched up to episode {n}", lambda: self.mark.emit(n))
            if self.progress and n <= self.progress:
                menu.addAction(glyph_icon(G["minus"], C["text"]), f"Not watched from episode {n}",
                               lambda: self.mark.emit(n - 1))
        if not menu.isEmpty():
            menu.exec(e.globalPos())

    def mouseMoveEvent(self, e):
        i = self._index_at(e.position())
        if i != self.hover:
            self.hover = i
            self.setCursor(Qt.PointingHandCursor if i >= 0 and self.chips[i][3] else Qt.ArrowCursor)
            self.update()

    def leaveEvent(self, e):
        self.hover = -1
        self.update()

    def mouseReleaseEvent(self, e):
        i = self._index_at(e.position())
        if e.button() == Qt.LeftButton and i >= 0 and self.chips[i][3]:
            play_video(self.chips[i][3])

    def event(self, e):
        if e.type() == QEvent.ToolTip:
            i = self._index_at(e.position() if hasattr(e, "position") else e.pos())
            if i >= 0:
                text = self.chips[i][0]
                watched = self.progress is not None and text.isdigit() and int(text) <= self.progress
                tip = self.chips[i][2] + ("  ·  watched" if watched else "")
                if text in self.downloading and self.chips[i][1] != HAVE:
                    tip = f"Episode {text} · downloading {int(self.downloading[text] * 100)}%"

                kind = self.kinds.get(int(text)) if text.isdigit() else None
                tip += f"  ·  {KIND_NAMES[kind]}" if kind else ""
                tip += "\nClick to play" if self.chips[i][3] else ""
                tip += "\nRight-click to mark watched" if self.trackable else ""
                QToolTip.showText(e.globalPos(), tip, self)
            else:
                QToolTip.hideText()
            return True
        return super().event(e)


class EpisodeCards(QWidget):
    """A season's episodes as cards: AniList's still (or a frame from your file) with the episode's title.
    Watched ones are dimmed with a check, the next one glows, a half-watched one shows its resume bar,
    missing ones are striped (click to find a torrent), unaired ones say when they air.
    Same interface as EpisodeGrid (chips, mid, trackable, mark, set_progress, set_downloading)."""
    mark = Signal(int)
    find = Signal(int)          # a missing episode was clicked: search torrents for it
    MIN_W, GAP, TEXT_H = 210, 14, 46

    def __init__(self, chips, media=None, resume=None):
        super().__init__()
        self.chips = chips
        self.media = media or {}
        self.resume = resume or {}
        self.hover = -1
        self.progress, self.next_n = None, None
        self.trackable, self.mid = False, None
        self.downloading = {}
        self.images, self.scaled = {}, {}
        self.titles = {}
        self.kinds = {}
        mid = self.media.get("id")
        for text, _state, tip, path in chips:
            if str(tip).startswith("Recap · "):   # a .5 recap between two episodes
                self.titles[text] = "Recap"
            elif text.isdigit():   # "Episode 5 - Bakeneko": AniList's title, else the file's
                name = episode_name({mid: self.media}, mid, int(text), path)
                if name:
                    self.titles[text] = f"Episode {text} - {name}"
        self.setMouseTracking(True)
        sp = QSizePolicy(QSizePolicy.Preferred, QSizePolicy.Preferred)
        sp.setHeightForWidth(True)
        self.setSizePolicy(sp)

    def pad_rects(self):
        """Controller targets: each episode card."""
        return [self._rect(i).toRect() for i in range(len(self.chips))]

    def jobs(self):
        """What to load for the thumbnails: AniList stills, else a frame from the file."""
        out = []
        mid = self.media.get("id")
        for text, state, _, path in self.chips:
            url = None
            if text.isdigit() and mid:
                url, _ = episode_still({mid: self.media}, mid, int(text))
            if url:
                out.append((f"ep:{text}", "url", (url, still_stem(url))))
            elif path:
                out.append((f"ep:{text}", "frame", (path, "15%")))
        return out

    def set_image(self, text, img):
        self.images[text] = img
        self.scaled = {k: v for k, v in self.scaled.items() if k[0] != text}
        self.update()

    # ---- layout
    def _cols(self, w):
        return max(2, (w + self.GAP) // (self.MIN_W + self.GAP))

    def _card_w(self, w):
        c = self._cols(w)
        return (w - (c - 1) * self.GAP) / c

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        if not self.chips:
            return 0
        cw = self._card_w(w)
        rows = math.ceil(len(self.chips) / self._cols(w))
        return int(rows * (cw * 9 / 16 + self.TEXT_H + self.GAP) - self.GAP + 4)

    def sizeHint(self):
        return QSize(900, self.heightForWidth(900))

    def minimumSizeHint(self):
        return QSize(self.MIN_W * 2, self.heightForWidth(self.width() or 900))

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.updateGeometry()

    def _rect(self, i):
        w = self.width()
        cols, cw = self._cols(w), self._card_w(w)
        ch = cw * 9 / 16
        return QRectF((i % cols) * (cw + self.GAP), 2 + (i // cols) * (ch + self.TEXT_H + self.GAP), cw, ch)

    def _index_at(self, pos):
        for i in range(len(self.chips)):
            r = self._rect(i)
            if QRectF(r.x(), r.y(), r.width(), r.height() + self.TEXT_H).contains(pos):
                return i
        return -1

    # ---- state
    def set_progress(self, progress, next_n):
        self.progress, self.next_n = progress, next_n
        self.update()

    def set_downloading(self, downloading):
        if downloading != self.downloading:
            self.downloading = downloading
            self.update()

    def watched(self, text):
        return self.progress is not None and text.isdigit() and int(text) <= self.progress

    def subtitle(self, i):
        text, state, tip, path = self.chips[i]
        dur = self.media.get("duration")
        if text in self.downloading and state != HAVE:
            return f"Downloading · {int(self.downloading[text] * 100)}%"
        if state == MISSING:
            return "Not downloaded · find a torrent"
        if state == UPCOMING:
            nxt = self.media.get("nextAiringEpisode") or {}
            return f"Airs {when_short(nxt['airingAt'])}" if text.isdigit() and nxt.get("episode") == int(text) else "Not aired yet"
        r = self.resume.get(path) if path else None
        if r and r.get("pos", 0) > 30 and r.get("dur") and r["pos"] < r["dur"] * 0.92 and not self.watched(text):
            return f"Resume · {int((r['dur'] - r['pos']) // 60) or 1} min left"
        bits = [f"{dur} min" if dur else ""]
        if self.watched(text):
            bits.append("watched")
        return "  ·  ".join(b for b in bits if b) or Path(path or "").suffix.lstrip(".").upper()

    # ---- painting
    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        dpr = self.devicePixelRatioF()
        f_num = QFont(self.font())
        f_num.setPixelSize(12)
        f_num.setWeight(QFont.Bold)
        f_title = QFont(self.font())
        f_title.setPointSizeF(9.5)
        f_title.setWeight(QFont.DemiBold)
        f_sub = QFont(self.font())
        f_sub.setPointSizeF(8.5)
        f_big = QFont(self.font())
        f_big.setPixelSize(30)
        f_big.setWeight(QFont.Bold)
        for i, (text, state, tip, path) in enumerate(self.chips):
            r = self._rect(i)
            if not r.intersects(QRectF(self.visibleRegion().boundingRect())):
                continue
            hot = i == self.hover
            watched = self.watched(text)
            is_next = self.next_n is not None and text == str(self.next_n)
            # glow around the next episode
            if is_next:
                for k, a in ((6, 18), (4, 34), (2, 60)):
                    p.setPen(QPen(QColor(124, 108, 255, a), 2))
                    p.setBrush(Qt.NoBrush)
                    p.drawRoundedRect(r.adjusted(-k, -k, k, k), 11 + k, 11 + k)
            clip = QPainterPath()
            clip.addRoundedRect(r, 11, 11)
            p.save()
            p.setClipPath(clip)
            img = self.images.get(text)
            if state == HAVE and img is not None and not img.isNull():
                key = (text, int(r.width()))
                pm = self.scaled.get(key)
                if pm is None:
                    pm = cover_pixmap(img, int(r.width()), int(r.height()), dpr)
                    self.scaled[key] = pm
                p.drawPixmap(r.topLeft(), pm)
            elif state == HAVE:
                g = QLinearGradient(r.topLeft(), r.bottomRight())
                g.setColorAt(0, QColor(C["surface2"]))
                g.setColorAt(1, QColor(C["accent"]).darker(380))
                p.fillRect(r, g)
                p.setFont(f_big)
                p.setPen(QColor(255, 255, 255, 40))
                p.drawText(r, Qt.AlignCenter, text)
            else:
                p.fillRect(r, QColor("#161a22"))
                if state == MISSING and text not in self.downloading:
                    p.fillRect(r, QBrush(QColor(255, 255, 255, 10), Qt.BDiagPattern))
                p.setFont(f_sub)
                p.setPen(QColor(C["bad"] if state == MISSING else C["faint"]))
                label_ = "Not downloaded" if state == MISSING else "Not aired yet"
                if text in self.downloading:
                    label_ = "Downloading…"
                    p.setPen(QColor(C["accent_hi"]))
                p.drawText(r, Qt.AlignCenter, label_)
            if watched and not hot:
                p.fillRect(r, QColor(8, 9, 12, 150))
            frac = self.downloading.get(text) if state != HAVE else None
            res = self.resume.get(path) if path else None
            if frac is not None:
                p.fillRect(QRectF(r.x(), r.bottom() - 4, r.width(), 4), QColor(255, 255, 255, 30))
                p.fillRect(QRectF(r.x(), r.bottom() - 4, r.width() * min(1.0, frac), 4), QColor(C["accent"]))
            elif res and res.get("dur") and not watched and 30 < res.get("pos", 0) < res["dur"] * 0.92:
                p.fillRect(QRectF(r.x(), r.bottom() - 4, r.width(), 4), QColor(255, 255, 255, 40))
                p.fillRect(QRectF(r.x(), r.bottom() - 4, r.width() * res["pos"] / res["dur"], 4), QColor(C["accent"]))
            if hot and path:
                p.fillRect(r, QColor(0, 0, 0, 70))
                p.drawPixmap(QPointF(r.center().x() - 22, r.center().y() - 22), glyph_pixmap("play_circle:fill", "white", 44))
            p.restore()
            if state == UPCOMING:
                p.setPen(QPen(QColor(C["border_hi"]), 1, Qt.DashLine))
                p.setBrush(Qt.NoBrush)
                p.drawRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), 11, 11)
            # number badge and the watched check
            p.setFont(f_num)
            num = f"E{text}" if text.isdigit() else text
            split = org.EPISODE_SPLIT.get(str(self.mid)) if self.mid else None
            if split and text.isdigit():   # two-in-one: which of AniList's episodes this file is
                k = int(text)
                num += f"  ·  AniList {(k - 1) * split + 1}–{k * split}"
            nw = QFontMetrics(f_num).horizontalAdvance(num) + 14
            badge = QRectF(r.x() + 8, r.y() + 8, nw, 20)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(8, 9, 12, 170))
            p.drawRoundedRect(badge, 6, 6)
            p.setPen(QColor("white"))
            p.drawText(badge, Qt.AlignCenter, num)
            kind = self.kinds.get(int(text)) if text.isdigit() else None
            if kind:
                name = "Mixed" if kind == "mixed" else KIND_NAMES[kind]
                kw = QFontMetrics(f_num).horizontalAdvance(name) + 14
                pill = QRectF(badge.right() + 6, badge.y(), kw, 20)
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(KIND_COLORS[kind]))
                p.drawRoundedRect(pill, 6, 6)
                p.setPen(QColor("#1a1206"))
                p.drawText(pill, Qt.AlignCenter, name)
            if watched:
                c = QRectF(r.right() - 30, r.y() + 8, 22, 22)
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(C["ok"]))
                p.drawEllipse(c)
                p.drawPixmap(QPointF(c.x() + 3, c.y() + 3), glyph_pixmap("check", "#06210f", 16, fill=True))
            if hot:
                p.setPen(QPen(QColor(255, 255, 255, 210), 1.5))
                p.setBrush(Qt.NoBrush)
                p.drawRoundedRect(r.adjusted(0.75, 0.75, -0.75, -0.75), 11, 11)
            elif is_next:
                p.setPen(QPen(QColor(C["accent"]), 2))
                p.setBrush(Qt.NoBrush)
                p.drawRoundedRect(r.adjusted(1, 1, -1, -1), 11, 11)
            # title and line under it
            title = self.titles.get(text) or (f"Episode {text}" if text.isdigit() else Path(path or tip).stem)
            p.setFont(f_title)
            p.setPen(QColor(C["text"] if not watched else C["muted"]))
            fm = QFontMetrics(f_title)
            p.drawText(QRectF(r.x() + 2, r.bottom() + 7, r.width() - 4, 18), Qt.AlignLeft | Qt.AlignVCenter,
                       fm.elidedText(title, Qt.ElideRight, int(r.width() - 4)))
            p.setFont(f_sub)
            sub = self.subtitle(i)
            p.setPen(QColor(C["accent_hi"] if sub.startswith(("Resume", "Downloading")) else
                            C["bad"] if state == MISSING else C["faint"]))
            p.drawText(QRectF(r.x() + 2, r.bottom() + 26, r.width() - 4, 16), Qt.AlignLeft | Qt.AlignVCenter,
                       QFontMetrics(f_sub).elidedText(sub, Qt.ElideRight, int(r.width() - 4)))

    # ---- mouse
    def mouseMoveEvent(self, e):
        i = self._index_at(e.position())
        if i != self.hover:
            self.hover = i
            clickable = i >= 0 and (self.chips[i][3] or self.chips[i][1] == MISSING)
            self.setCursor(Qt.PointingHandCursor if clickable else Qt.ArrowCursor)
            self.update()

    def leaveEvent(self, e):
        self.hover = -1
        self.update()

    def mouseReleaseEvent(self, e):
        i = self._index_at(e.position())
        if e.button() != Qt.LeftButton or i < 0:
            return
        text, state, _, path = self.chips[i]
        if path:
            play_video(path)
        elif state == MISSING and text.isdigit():
            self.find.emit(int(text))

    def contextMenuEvent(self, e):
        i = self._index_at(e.pos().toPointF())
        if i < 0:
            return
        text, state, _, path = self.chips[i]
        menu = QMenu(self)
        if path:
            menu.addAction(glyph_icon("play_arrow", C["text"]), "Play", lambda: play_video(path))
            menu.addAction(glyph_icon("folder_open", C["text"]), "Show in folder",
                           lambda: os.name == "nt" and subprocess_open_select(path))
            subtitle_actions(menu, path)
        if state == MISSING and text.isdigit():
            menu.addAction(glyph_icon("search", C["text"]), f"Find episode {text}", lambda: self.find.emit(int(text)))
        if self.trackable and text.isdigit():
            n = int(text)
            menu.addAction(glyph_icon("check", C["text"]), f"Watched up to episode {n}", lambda: self.mark.emit(n))
            if self.progress and n <= self.progress:
                menu.addAction(glyph_icon("remove", C["text"]), f"Not watched from episode {n}", lambda: self.mark.emit(n - 1))
        if not menu.isEmpty():
            menu.exec(e.globalPos())

    def event(self, e):
        if e.type() == QEvent.ToolTip:
            i = self._index_at(e.position() if hasattr(e, "position") else e.pos())
            if i >= 0:
                text, state, tip, path = self.chips[i]
                title = self.titles.get(text)
                kind = self.kinds.get(int(text)) if text.isdigit() else None
                QToolTip.showText(e.globalPos(), (f"Episode {text} · {title}\n" if title else "") + tip +
                                  (f"\n{KIND_NAMES[kind]} (animefillerlist.com)" if kind else ""), self)
            else:
                QToolTip.hideText()
            return True
        return super().event(e)


