def follow_moved_files(settings):
    """Episodes the organizer moved or renamed (org.MOVES_FILE, e.g. "Show - 13" → "Show - S02E01"): their resume
    points, watch history and Home's "removed from this row" go with them. Then the list is emptied."""
    moves = _read_json(org.MOVES_FILE)
    if not moves:
        return 0
    new_for = {os.path.normcase(k): v for k, v in moves.items()}

    def follow(d):
        hits = [k for k in d if os.path.normcase(k) in new_for]
        for k in hits:
            d[new_for[os.path.normcase(k)]] = d.pop(k)
        return bool(hits)

    state = _read_json(PLAYBACK_STATE_FILE)
    if follow(state):
        tmp = PLAYBACK_STATE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(state), encoding="utf-8")
        os.replace(tmp, PLAYBACK_STATE_FILE)
    wl = APP.get("watchlog")
    for log in (wl.logs.values() if wl else []):
        with log.lock:
            changed = follow(log.data["finished"])
        if changed:
            log.save()
    hidden = dict(settings.get("home_hidden") or {})
    if follow(hidden):
        settings["home_hidden"] = hidden
        save_settings(settings)
    org._write(org.MOVES_FILE, {})
    klog.info(f"Followed {len(moves)} moved / renamed episode{'s' if len(moves) != 1 else ''}")
    return len(moves)


def save_settings(s):
    # Settings always come from load_settings(), which has every key. A dict without "library"
    # is a partial one (e.g. a dialog opened with {}), and writing it would wipe the rest.
    if "library" not in s:
        return
    out = s
    if "_anime" in s:   # on the 18+ side: the file keeps the Anime values
        out = {k: v for k, v in s.items() if k != "_anime"}
        for k, v in s["_anime"].items():
            out[f"adult_{k}"] = s.get(k)
            out[k] = v
    try:
        SETTINGS_FILE.write_text(json.dumps(out, indent=2), encoding="utf-8")
    except OSError:
        pass


