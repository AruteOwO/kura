RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"


def startup_command():
    """How Windows should start Kura at sign-in (exe, or pythonw + this script)."""
    if FROZEN:
        cmd = f'"{sys.executable}"'
    else:
        pyw = Path(sys.executable).with_name("pythonw.exe")
        cmd = f'"{pyw if pyw.exists() else sys.executable}" "{Path(__file__).resolve()}"'
    return cmd + " --startup"


def startup_target():
    """The program the startup entry starts (None: no entry, or it can't be read)."""
    if os.name != "nt":
        return None
    import shlex
    import winreg
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY) as key:
            cmd = winreg.QueryValueEx(key, APP_NAME)[0]
        return Path(shlex.split(cmd, posix=False)[0].strip('"'))
    except (OSError, ValueError, IndexError):
        return None


def get_startup():
    if os.name != "nt":
        return False
    import winreg
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY) as key:
            winreg.QueryValueEx(key, APP_NAME)
            return True
    except OSError:
        return False


def set_startup(on):
    if os.name != "nt":
        return
    import winreg
    with winreg.OpenKey(winreg.HKEY_CURRENT_USER, RUN_KEY, 0, winreg.KEY_SET_VALUE) as key:
        if on:
            winreg.SetValueEx(key, APP_NAME, 0, winreg.REG_SZ, startup_command())
        else:
            try:
                winreg.DeleteValue(key, APP_NAME)
            except OSError:
                pass


def torrent_filters(settings):
    """(enabled, filters). The first time, Taiga-like defaults are created (with the old
    'Preferred quality' / 'Preferred groups' settings turned into Prefer filters)."""
    loaded = tor.load_filters()
    if loaded is not None:
        return loaded
    filters = tor.default_filters(settings.get("torrent_quality", "1080p"))
    for i, g in enumerate(x.strip() for x in (settings.get("torrent_groups") or "").split(",") if x.strip()):
