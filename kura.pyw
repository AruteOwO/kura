        option_row(col, "Outline", "Thickness on a 1080p picture.", self._pair(self.outline_c, outline_box))
        self.shadow_c = ColorSwatch(st["shadow_color"], "Shadow color")
        self.shadow_w, shadow_box = self._slider(0, 16, st["shadow"] * 2, lambda v: f"{v / 2:g} px")
        option_row(col, "Shadow", "", self._pair(self.shadow_c, shadow_box))
        self.size, size_box = self._slider(60, 160, st["size"], lambda v: f"{v}%")
        self.size.setSingleStep(5)
        option_row(col, "Size", "Of the file's own size.", size_box)
        font_box = QWidget()
        fh = QHBoxLayout(font_box)
        fh.setContentsMargins(0, 0, 0, 0)
        fh.setSpacing(10)
        self.own_font = Toggle(not st["font"])
        fh.addWidget(self.own_font)
        fh.addWidget(label("The file's font", "muted"))
        self.font = QFontComboBox()
        self.font.setFixedWidth(220)
        if st["font"]:
            self.font.setCurrentFont(QFont(st["font"]))
        self.font.setEnabled(bool(st["font"]))
        fh.addWidget(self.font)
        option_row(col, "Font", "", font_box)
        self.bold = Toggle(bool(st["bold"]))
        option_row(col, "Bold", "", self.bold)
        self.dialogue_only = Toggle(bool(st["dialogue_only"]))
        option_row(col, "Only change the dialogue", "Signs, songs and on-screen text keep the group's look "
                   "(recommended: a forced style ruins typesetting).", self.dialogue_only)

        for sw in (self.text_c, self.outline_c, self.shadow_c):
            sw.changed.connect(self.emit_changed)
        for s in (self.outline_w, self.shadow_w, self.size):
            s.valueChanged.connect(self.emit_changed)
        self.own_font.toggled.connect(lambda on: (self.font.setEnabled(not on), self.emit_changed()))
        self.font.currentFontChanged.connect(self.emit_changed)
        self.bold.toggled.connect(self.emit_changed)
        self.dialogue_only.toggled.connect(self.emit_changed)
        self.timer = QTimer(self, singleShot=True, interval=60, timeout=self.send_style)
        eng = self.engine()
        eng.image.connect(self.on_image)
        eng.status.connect(self.on_status)

    @staticmethod
    def engine():
        return sub_preview_engine()

    def _slider(self, lo, hi, value, fmt):
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(10)
        s = QSlider(Qt.Horizontal)
        s.setRange(lo, hi)
        s.setFixedWidth(200)
        s.setValue(int(round(value)))
        lbl = label(fmt(s.value()), "muted")
        lbl.setFixedWidth(52)
        s.valueChanged.connect(lambda v: lbl.setText(fmt(v)))
        h.addWidget(s)
        h.addWidget(lbl)
        return s, box

    @staticmethod
    def _pair(a, b):
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(12)
        h.addWidget(a)
        h.addWidget(b)
        return box

    def value(self):
        return {"text": self.text_c.colour, "outline": self.outline_c.colour, "shadow_color": self.shadow_c.colour,
                "outline_w": self.outline_w.value() / 2, "shadow": self.shadow_w.value() / 2,
                "size": self.size.value(), "font": "" if self.own_font.isChecked() else self.font.currentFont().family(),
                "bold": self.bold.isChecked(), "dialogue_only": self.dialogue_only.isChecked()}

    def apply_preset(self, values):
        st = {**self.value(), **values}
        for sw, k in ((self.text_c, "text"), (self.outline_c, "outline"), (self.shadow_c, "shadow_color")):
            sw.set_colour(st[k])
        self.outline_w.setValue(int(round(st["outline_w"] * 2)))
        self.shadow_w.setValue(int(round(st["shadow"] * 2)))
        self.emit_changed()

    def set_active(self, on):
        """Off: the preview shows the file's own look."""
        self.active = on
        self.send_style()

    def set_episode(self, path):
        self.episode = path
        if self.isVisible():
            self.engine().request(open=path, style=(self.active, self.value()), mode=self.mode)

    def emit_changed(self, *_):
        self.changed.emit()
        self.timer.start()

    def send_style(self):
        if self.isVisible():
            self.engine().request(style=(self.active, self.value()), mode=self.mode)

    def showEvent(self, e):
        super().showEvent(e)
        if self.episode:
            self.engine().request(open=self.episode, style=(self.active, self.value()), mode=self.mode)
        else:
            self.frame.set_text("No episode to preview")

    def on_image(self, img):
        if self.isVisible():
            self.frame.set_image(img)

    def on_status(self, text):
        if self.isVisible():
            self.frame.set_text(text)


