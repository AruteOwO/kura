class GuideView(QWidget):
    """The TV guide: channels down the side, time across, a red line at now. Click what's on = tune in;
    something later = remind me / show page."""
    tune = Signal(str)
    menu_for = Signal(str, dict, QPoint)
    ROW, HEAD, NAMES, PX = 64, 34, 210, 6.0   # px per minute

    def __init__(self, scroll):
        super().__init__()
        self.scroll = scroll
        self.chans, self.t0, self.hours = [], 0.0, 8
        self.setMouseTracking(True)
        self.hover = None
        scroll.horizontalScrollBar().valueChanged.connect(lambda _: self.update())

    def set_channels(self, chans):
        self.chans = chans
        now = time.time()
        self.t0 = now - (now % 1800) - 1800   # half an hour before now, on the half hour
        w = self.NAMES + int(self.hours * 60 * self.PX) + 20
        self.setFixedSize(w, self.HEAD + len(chans) * self.ROW + 8)
        self.update()

    def x_of(self, ts):
        return self.NAMES + (ts - self.t0) / 60 * self.PX

    def cells(self):
        end = self.t0 + self.hours * 3600
        for r, ch in enumerate(self.chans):
            y = self.HEAD + r * self.ROW
            for p in ch["programs"]:
                if p["end"] <= self.t0 or p["start"] >= end:
                    continue
                x1, x2 = max(self.NAMES, self.x_of(p["start"])), self.x_of(min(p["end"], end))
                yield QRectF(x1 + 1, y + 4, max(1.0, x2 - x1 - 2), self.ROW - 8), ch, p

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        now = time.time()
        sx = self.scroll.horizontalScrollBar().value()
        p.fillRect(self.rect(), QColor(C["bg"]))
        f = QFont(self.font())
        # time marks
        f.setPointSizeF(8.5)
        p.setFont(f)
        t = self.t0
        while t < self.t0 + self.hours * 3600:
            x = self.x_of(t)
            p.setPen(QColor(C["border"]))
            p.drawLine(QPointF(x, self.HEAD - 6), QPointF(x, self.height()))
            p.setPen(QColor(C["muted"]))
            p.drawText(QPointF(x + 6, 21), player_mod.clock(t))
            t += 1800
        # programmes
        for rect, ch, pr in self.cells():
            airing = pr["start"] <= now < pr["end"]
            colour = QColor(ch.get("colour") or C["accent"])
            if pr["kind"] != "episode":
                p.setPen(Qt.NoPen)
                p.setBrush(QColor(255, 255, 255, 14))
                p.drawRoundedRect(rect, 6, 6)
                continue
            bg = QColor(colour)
            bg.setAlpha(70 if airing else 26)
            p.setPen(QPen(colour if airing else QColor(C["border"]), 1.2))
            p.setBrush(bg)
            if self.hover is pr:
                p.setBrush(QColor(255, 255, 255, 30))
            p.drawRoundedRect(rect, 8, 8)
            if rect.width() > 40:
                p.save()
                p.setClipRect(rect.adjusted(8, 0, -6, 0))
                f.setPointSizeF(9.5)
                f.setBold(True)
                p.setFont(f)
                p.setPen(QColor(C["text"]))
                p.drawText(rect.adjusted(10, 6, -6, -24), Qt.AlignLeft | Qt.AlignTop, pr.get("title") or "")
                f.setBold(False)
                f.setPointSizeF(8.5)
                p.setFont(f)
                p.setPen(QColor(C["muted"]))
                ep = (f"S{pr['season']} E{pr['ep']}  ·  " if pr.get("season") and pr.get("ep") is not None else "")
                p.drawText(rect.adjusted(10, 28, -6, -4), Qt.AlignLeft | Qt.AlignTop,
                           ep + f"{player_mod.clock(pr['start'])}")
                p.restore()
        # now
        x = self.x_of(now)
        p.setPen(QPen(QColor("#e5484d"), 2))
        p.drawLine(QPointF(x, self.HEAD - 8), QPointF(x, self.height()))
        p.setBrush(QColor("#e5484d"))
        p.drawEllipse(QPointF(x, self.HEAD - 8), 4, 4)
        # channel names stay put while the guide scrolls sideways
        p.fillRect(QRectF(sx, 0, self.NAMES, self.height()), QColor(C["bg"]))
        for r, ch in enumerate(self.chans):
            y = self.HEAD + r * self.ROW
            box = QRectF(sx + 6, y + 6, self.NAMES - 14, self.ROW - 12)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(C["surface"]))
            p.drawRoundedRect(box, 10, 10)
            p.setBrush(QColor(ch.get("colour") or C["accent"]))
            p.drawRoundedRect(QRectF(box.x() + 8, box.y() + 10, 34, box.height() - 20), 7, 7)
            f.setBold(True)
            f.setPointSizeF(11)
            p.setFont(f)
            p.setPen(QColor("white"))
            p.drawText(QRectF(box.x() + 8, box.y(), 34, box.height()), Qt.AlignCenter, str(ch.get("number", "")))
            f.setPointSizeF(9.5)
            p.setFont(f)
            p.setPen(QColor(C["text"]))
            p.drawText(QRectF(box.x() + 52, box.y(), box.width() - 56, box.height()), Qt.AlignVCenter | Qt.AlignLeft,
                       QFontMetrics(f).elidedText(ch.get("name", ""), Qt.ElideRight, int(box.width() - 60)))

    def at(self, pos):
        sx = self.scroll.horizontalScrollBar().value()
        r = int((pos.y() - self.HEAD) // self.ROW)
        if pos.x() < sx + self.NAMES:
            return (self.chans[r], None) if 0 <= r < len(self.chans) and pos.y() >= self.HEAD else (None, None)
        for rect, ch, pr in self.cells():
            if rect.contains(QPointF(pos)):
                return ch, pr
        return None, None

    def mouseMoveEvent(self, e):
        ch, pr = self.at(e.position().toPoint())
        if pr is not self.hover:
            self.hover = pr
            self.setCursor(Qt.PointingHandCursor if ch else Qt.ArrowCursor)
            self.update()
        if pr:
            bits = [pr.get("title") or ""]
            if pr.get("ep") is not None:
                bits.append((f"Season {pr['season']} · " if pr.get("season") else "") + f"Episode {pr['ep']}")
            bits.append(f"{player_mod.clock(pr['start'])} – {player_mod.clock(pr['end'])}  ·  {ch['name']}")
            QToolTip.showText(e.globalPosition().toPoint(), "\n".join(bits), self)

    def mouseReleaseEvent(self, e):
        ch, pr = self.at(e.position().toPoint())
        if not ch:
            return
        if e.button() == Qt.RightButton or (pr and pr["start"] > time.time()):
            if pr:
                self.menu_for.emit(ch["id"], pr, e.globalPosition().toPoint())
            return
        if pr is None or pr["start"] <= time.time() < pr["end"]:
            self.tune.emit(ch["id"])


