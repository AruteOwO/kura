    def eventFilter(self, obj, e):
        if e.type() == QEvent.Resize and obj is self.grid.viewport():
            self.fit_cards()
        return False

    def fit_cards(self):
        """The column count closest to the normal poster size, then the posters grow or shrink a
        little (same shape) to fill the width exactly, so there's no empty strip at the right."""
        width = steady_width(self.grid) - 12   # Qt wraps a column early without some slack
        gap = 22
        cols = max(1, round(width / (CARD_W + gap)))   # nearest count: posters stay close to normal size
        w = width // cols - gap
        if w < 140:   # never smaller than this: one column fewer
            cols = max(1, width // (140 + gap))
            w = width // cols - gap
        if w != self.cards.card_w:
            self.cards.set_width(w)
            self.grid.setGridSize(QSize(w + gap, self.cards.poster_h + CARD_H - POSTER_H + 20))

    def refresh(self, quick=False, list_only=False):
        """quick (switching sides): a scan of that library from the last 10 minutes is shown as it is; scanning
        again parses every file name, ~3 s of Python next to the window, which stuttered while it ran.
        list_only (the AniList sync finished): scan again only if the list differs from the one the last scan
        matched folders with; otherwise just its badges (the rescan after every start slowed the first pages)."""
        lib = self.settings.get("library")
        if not lib or not Path(lib).is_dir():
            self.subtitle.setText("No library folder set" if not lib else f"Folder not found: {lib}")
            self.stack.setCurrentIndex(0)
            return
        if list_only and self.scanned and getattr(self, "shown_root", None) == lib and self.scan_sig is not None:
            mine = {mid: e.get("media") or {} for mid, e in self.account.entries.items()} if (
                self.account and self.account.connected) else {}
            if self.list_sig(lib, mine) == self.scan_sig:
                self.apply_account()
                return
        for s in list(self.scanners):
            s.requestInterruption()
        self.scan_id += 1
        cached = self.root_cache.get(lib)
        if cached is not None and getattr(self, "shown_root", None) != lib:   # the other side, as it was
            self.on_listed(self.scan_id, cached, self.root_time.get(lib))
            if quick and time.time() - self.root_time.get(lib, 0) < 600:
                missing = [s for s in cached if s["path"] not in self.covers]
                if missing:   # left before its covers had all loaded: just those, no folder scan
                    sc = LibraryScanner(self.scan_id, lib, shows=missing)
                    sc.cover.connect(self.on_cover)
                    sc.finished.connect(lambda c=sc: self.scanners.discard(c))
                    self.scanners.add(sc)
                    sc.start()
                return
        elif cached is None:
            self.scanned = False   # a library not read yet (the other side's, the first time): Home waits for it
        # Snapshot of your list so the scan can match folders to it (no requests made)
        list_media, title_ids = {}, {}
        if self.account and self.account.connected:
            for mid, e in self.account.entries.items():
                m = e.get("media") or {}
                list_media[mid] = m
                for t in ((m.get("title") or {}).get("english"), (m.get("title") or {}).get("romaji")):
                    if t:
                        title_ids.setdefault(org.safe_name(t).lower(), mid)
        self.scan_sig = self.list_sig(lib, list_media)
        scanner = LibraryScanner(self.scan_id, lib, list_media, title_ids)
        scanner.listed.connect(self.on_listed)
        scanner.cover.connect(self.on_cover)
        scanner.finished.connect(lambda s=scanner: self.scanners.discard(s))
        self.scanners.add(scanner)
        self.subtitle.setText(f"Scanning {lib}…")
        if not self.items:   # first scan: the grid's shape while it runs
            self.stack.setCurrentIndex(1)
            self.skeleton.start()
        scanner.start()

    @staticmethod
    def list_sig(lib, list_media):
        try:
            return lib, hash(json.dumps(list_media, sort_keys=True, default=str))
        except Exception:
            return None

    def learn_adult(self, shows):
        """Shows matched before Kura knew about 18+: ask AniList once (50 per request), then scan again if any are."""
        if not self.settings.get("adult_enabled") or getattr(self, "adult_call", None):
            return
        mids = [s["index"]["mid"] for s in shows if s.get("index") and s["index"].get("adult") is None
                and (media_for(s["index"]["mid"], self.account) or {}).get("isAdult") is None]
        if not mids:
            return

        def work():
            known = {}
            adult = org.adult_ids(mids, known)
            cache = org.load_cache()   # fresh: an organizer run may have saved meanwhile
            cache.update({k: v for k, v in known.items() if k.startswith("adult:")})
            org.save_cache(cache)
            return adult

        def done(adult, err):
            if err:
                klog.warning(f"Checking 18+ shows: {err}")
            elif adult:
                klog.info(f"{len(adult)} library show(s) are 18+ on AniList")
                self.refresh()
        self.adult_call = BgCall(work)
        self.adult_call.done.connect(done)
        self.adult_call.start()

    def on_listed(self, scan_id, shows, scanned_at=None):
        if scan_id != self.scan_id:
            return
        root = self.settings.get("library")
        self.root_cache[root] = shows   # switching sides shows the other library at once next time
        self.root_time[root] = scanned_at or time.time()
        self.shown_root = root
        on = acct.ADULT["on"]
        hidden = [s for s in shows if index_adult(s["index"], self.account) != on]
        shows = [s for s in shows if index_adult(s["index"], self.account) == on]
        self.hidden_other = len(hidden)
        self.learn_adult(self.root_cache[root])
        self.skeleton.stop()
        old_covers = self.covers   # every cover loaded this session, both sides (switching sides scans nothing)
        self.model.clear()
        self.items, self.extra = {}, {}
        for s in shows:
            it = QStandardItem(s["name"])
            it.setEditable(False)
            it.setToolTip(s["name"])
            it.setData(s["path"], PATH_ROLE)
            it.setData(s["subtitle"], SUB_ROLE)
            it.setData(s["index"], INDEX_ROLE)
            if old_covers.get(s["path"]) is not None:
                it.setData(old_covers[s["path"]], COVER_ROLE)   # no flicker on refresh
            self.model.appendRow(it)
            self.items[s["path"]] = it
        self.episode_total = sum(s["episodes"] for s in shows)
        self.subtitle.setToolTip(self.settings["library"] + (f"\n{self.hidden_other} show(s) here belong to the other "
                                                            "side (Settings → Hentai → Move)" if
                                                            self.hidden_other else ""))
        self.scanned = True
        self.apply_account()
        self.read_file_times()
        if not on:   # the loading screen's wall: your anime's covers next time (never the hentai side's)
            remember_wall([s["index"]["mid"] for s in shows if s.get("index") and s["index"].get("mid")][:80])

    def on_cover(self, scan_id, path, img):
        self.covers[path] = img
        it = self.items.get(path)
        if scan_id == self.scan_id and it is not None:
            it.setData(img, COVER_ROLE)

    def indexes(self):
        """{show folder: library index} for every show (used by To download)."""
        return {path: it.data(INDEX_ROLE) for path, it in self.items.items()}

    def media_id_for(self, path):
        it = self.items.get(path)
        index = it.data(INDEX_ROLE) if it else None
        return index["mid"] if index else None

    def library_ids(self):
        """Every AniList id that belongs to a show folder you have."""
        ids = set()
        for idx in self.indexes().values():
            ids |= {i for i in (idx or {}).get("chain") or [] if i}
        return ids

    def path_for_media(self, mid):
        """The folder of that show: the one that IS it first (Legend of Crimson's own folder), else the one whose
        seasons / chain include it."""
        idxs = self.indexes()
        for path, idx in idxs.items():
            if idx and idx.get("mid") == mid:
                return path
        for path, idx in idxs.items():
            if idx and mid in idx["seasons"]:
                return path
        for path, idx in idxs.items():
            if idx and mid in idx["chain"]:
                return path
        return None

    # ---- shows on your list that aren't downloaded
    def sync_extra(self):
        for it in self.extra.values():
            self.model.removeRow(it.row())
        self.extra = {}
        if not (self.show_all.isChecked() and self.account and self.account.connected and self.items is not None):
            return
        have, jobs = self.library_ids(), []
        for mid, e in self.account.view().items():
            if not e.get("status") or mid in have:
                continue
            m = e.get("media") or {}
            name = media_title(m)
            it = QStandardItem(name)
            it.setEditable(False)
            it.setToolTip(f"{name}\nNot downloaded")
            it.setData(None, PATH_ROLE)
            it.setData(mid, MID_ROLE)
            it.setData(True, NOTDL_ROLE)
            it.setData("  ·  ".join(x for x in (FORMAT_TEXT.get(m.get("format"), ""), season_label(m)) if x), SUB_ROLE)
            it.setData({"mid": mid, "chain": [mid], "seasons": [mid], "local": {}}, INDEX_ROLE)
            if mid in self.extra_covers:
                it.setData(self.extra_covers[mid], COVER_ROLE)
            elif (m.get("coverImage") or {}).get("extraLarge"):
                jobs.append((str(mid), m["coverImage"]["extraLarge"], str(mid)))
            self.model.appendRow(it)
            self.extra[mid] = it
        if jobs:
            f = ImageFetcher(jobs)
            f.image.connect(self.on_extra_cover)
            f.finished.connect(lambda: self.fetchers.discard(f))
            self.fetchers.add(f)
            f.start()

    def on_extra_cover(self, key, img):
        mid = int(key)
        self.extra_covers[mid] = img
        if mid in self.extra:
            self.extra[mid].setData(img, COVER_ROLE)

    # ---- AniList list
    def apply_account(self):
        connected = bool(self.account and self.account.connected)
        self.sync_extra()
        self.tabs_box.setVisible(bool(self.items or self.extra))
        self.show_all.setVisible(connected)
        self.show_all_label.setVisible(connected)
        for path, it in list(self.items.items()) + list(self.extra.items()):
            idx = it.data(INDEX_ROLE)
            status, new, prog, nxt = show_state(idx, self.account)
            it.setData(status, STATUS_ROLE)
            it.setData(new, NEW_ROLE)
            it.setData(prog if status == "CURRENT" else None, PROG_ROLE)
            m = media_for((idx or {}).get("mid"), self.account) if idx else {}
            it.setData({"format": m.get("format"), "genres": m.get("genres") or [], "year": m.get("seasonYear")},
                       META_ROLE)
            times = self.file_times.get(path) if isinstance(path, str) else None
            it.setData(times[0] if times else None, ADDED_ROLE)
            it.setData(times[1] if times else None, LATEST_ROLE)
        if self.settings.get("library") and Path(self.settings["library"]).is_dir():
            sub = f"{len(self.items)} shows  ·  {getattr(self, 'episode_total', 0):,} episodes"
            if self.extra:
                sub += f"  ·  {len(self.extra)} on your list not downloaded"
            self.subtitle.setText(sub)
            self.stack.setCurrentIndex(1 if (self.items or self.extra) else 2)
        for key in ("NOTSTARTED", "FINISHED"):   # they read your AniList list
            self.view_btns[key].setVisible(connected)
        if not connected:
            self.proxy.statuses.clear()
            if self.proxy.view in ("NOTSTARTED", "FINISHED"):
                self.set_view("ALL")
        self.update_counts()
        self.refilter()
        self.updated.emit()

    def update_counts(self):
        """Each quick chip's count (All has none)."""
        rows = list(self.items.values()) + list(self.extra.values())
        for key, text in self.VIEWS:
            n = sum(1 for it in rows if lib_view_match(key, it.data)) if key != "ALL" else 0
            self.view_btns[key].setText(f"{text}  ·  {n}" if key != "ALL" and n else text)

    def read_file_times(self):
        """When each show's first and newest files arrived (Recently added, Newest episode first): file times
        read on a worker thread, thousands of files on a hard drive."""
        if self.times_job is not None:
            return
        todo = {path: [f for eps in (it.data(INDEX_ROLE) or {}).get("local", {}).values() for f in eps.values()]
                for path, it in self.items.items()}

        def work():
            out = {}
            for path, files in todo.items():
                ts = []
                for f in files:
                    try:
                        ts.append(os.path.getmtime(f))
                    except OSError:
                        pass
                if ts:
                    out[path] = (min(ts), max(ts))
            return out

        def done(out, err):
            self.times_job = None
            if err:
                klog.warning(f"Library file times: {err}")
                return
            self.file_times.update(out or {})
            for path, it in self.items.items():
                times = self.file_times.get(path)
                it.setData(times[0] if times else None, ADDED_ROLE)
                it.setData(times[1] if times else None, LATEST_ROLE)
            self.update_counts()
            self.refilter()
        self.times_job = BgCall(work)
        self.times_job.done.connect(done)
        self.times_job.start()

    def refilter(self):
        self.proxy.refilter()
        if self.proxy.sort_key != "title":
            self.proxy.invalidate()   # the times / list changed: sort again
        n = self.proxy.active()
        self.filters_btn.setText(f" Filters  ·  {n}" if n else " Filters")
        self.filters_btn.setStyleSheet(f"QPushButton {{ border-color: {C['accent']}; background: rgba({accent_rgb()},0.18);"
                                       f" font-weight: 600; }}" if n else "")
        self.update_showing()

    def set_view(self, key):
        self.proxy.view = key
        self.view_btns[key].setChecked(True)
        self.refilter()

    def set_sort(self):
        key = self.sort_box.currentData()
        self.proxy.sort_key = key
        self.settings["library_sort"] = key
        save_settings(self.settings)
        self.proxy.invalidate()
        self.proxy.sort(0)

    def open_filters(self):
        pop = LibraryFilterPopup(self)
        pop.changed.connect(self.refilter)
        pop.show_under(self.filters_btn)

    def clear_filters(self):
        f = self.proxy
        f.statuses.clear()
        f.formats.clear()
        f.genres.clear()
        f.years = (None, None)
        self.refilter()

    def genre_list(self):
        """Genres of the shows here, most common first."""
        count = {}
        for it in list(self.items.values()) + list(self.extra.values()):
            for g in (it.data(META_ROLE) or {}).get("genres") or ():
                count[g] = count.get(g, 0) + 1
        return sorted(count, key=lambda g: (-count[g], g))

    def year_range(self):
        ys = {(it.data(META_ROLE) or {}).get("year") for it in list(self.items.values()) + list(self.extra.values())}
        ys.discard(None)
        return sorted(ys, reverse=True)

    def update_showing(self):
        """The line under the chips: every active pop-over filter as a removable chip, then Clear."""
        lay = self.showing_row
        while lay.count():
            w = lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        f = self.proxy
        parts = ([(LIB_STATUS_TEXT[s], lambda s=s: f.statuses.discard(s)) for s in sorted(f.statuses)]
                 + [(LIB_FORMAT_TEXT[x], lambda x=x: f.formats.discard(x)) for x in sorted(f.formats)]
                 + [(g, lambda g=g: f.genres.discard(g)) for g in sorted(f.genres)])
        lo, hi = f.years
        if lo or hi:
            text = f"{lo}–{hi}" if lo and hi else f"From {lo}" if lo else f"Until {hi}"
            parts.append((text, lambda: setattr(f, "years", (None, None))))
        self.showing.setVisible(bool(parts))
        if not parts:
            return
        lay.addWidget(label("Showing only", "faint"))
        for text, remove in parts:
            b = QPushButton(f"{text}  ")
            b.setIcon(glyph_icon("close", C["muted"], C["text"], px=14))
            b.setLayoutDirection(Qt.RightToLeft)   # the × after the text
            b.setCursor(Qt.PointingHandCursor)
            b.setToolTip("Remove this filter")
            b.setStyleSheet(f"QPushButton {{ background: {C['surface2']}; border: none; border-radius: 10px;"
                            f" padding: 3px 8px 3px 10px; font-size: 9pt; color: {C['text']}; }}"
                            f" QPushButton:hover {{ background: {C['hover']}; }}")
            b.clicked.connect(lambda _=False, r=remove: (r(), self.refilter()))
            lay.addWidget(b)
        clear = QPushButton("Clear")
        clear.setObjectName("ghost")
        clear.setCursor(Qt.PointingHandCursor)
        clear.clicked.connect(self.clear_filters)
        lay.addWidget(clear)
        lay.addStretch(1)

    def _path(self, idx):
        return self.proxy.data(idx, PATH_ROLE) if idx.isValid() else None

    def on_click(self, idx):
        cover = self.proxy.data(idx, COVER_ROLE)
        if self._path(idx):
            self.open_show.emit(self._path(idx), cover)
        elif self.proxy.data(idx, MID_ROLE):
            self.open_media.emit(self.proxy.data(idx, MID_ROLE), self.proxy.data(idx, Qt.DisplayRole), cover)

    def open_folder(self, idx):
        path = self._path(idx)
        if path and os.name == "nt":
            os.startfile(path)

    def context_menu(self, pos):
        idx = self.grid.indexAt(pos)
        path = self._path(idx)
        mid = self.proxy.data(idx, MID_ROLE) if idx.isValid() else None
        if not path and mid:   # not downloaded
            m = (self.account.entries.get(mid) or {}).get("media") or {}
            menu = QMenu(self)
            menu.addAction(glyph_icon(G["library"], C["text"]), "Show details", lambda: self.on_click(idx))
            if m.get("siteUrl"):
                menu.addAction(glyph_icon(G["globe"], C["text"]), "Open on AniList", lambda: webbrowser.open(m["siteUrl"]))
            menu.exec(self.grid.viewport().mapToGlobal(pos))
            return
        if not path:
            return
        name = Path(path).name
        menu = QMenu(self)
        menu.addAction(glyph_icon(G["library"], C["text"]), "Show details",
                       lambda: self.open_show.emit(path, self.proxy.data(idx, COVER_ROLE)))
        menu.addAction(glyph_icon(G["folder"], C["text"]), "Open folder", lambda: self.open_folder(idx))
        menu.addAction(glyph_icon(G["search"], C["text"]), "Find on AniList",
                       lambda: webbrowser.open("https://anilist.co/search/anime?search=" + urllib.parse.quote(name)))
        menu.addAction(glyph_icon(G["file"], C["text"]), "Copy path", lambda: QApplication.clipboard().setText(path))
        menu.exec(self.grid.viewport().mapToGlobal(pos))


