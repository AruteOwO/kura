    def remember(self, key, value):
        self.settings[key] = value
        save_settings(self.settings)

    # ---- which episodes
    def set_files(self, files, only=False):
        """The episodes to look at: the ticked ones, or (only=True) just these, from elsewhere in Kura."""
        files = list(files or [])
        if files == self.files and only == self.only:
            return
        self.files, self.only = files, only
        self.found = {f: self.found[f] for f in files if f in self.found}
        self.fill()

    def fill(self):
        self.tree.blockSignals(True)
        self.tree.clear()
        shown = 0
        for f in self.files:
            got = self.found.get(f) or {}
            if self.missing.isChecked() and got.get("has_english") and not self.only:
                continue
            shown += 1
            it = QTreeWidgetItem([Path(f).name, "", "", ""])
            it.setData(0, Qt.UserRole, f)
            it.setToolTip(0, f)
            self.tree.addTopLevelItem(it)
            self.dress(it, got)
        self.tree.blockSignals(False)
        n = len(self.files)
        if not n:
            self.which.setText("Tick shows or seasons on the left, or use Find subtitles on an episode (show page, "
                               "player, Library health).")
        else:
            hidden = n - shown
            self.which.setText((f"Just {Path(self.files[0]).name}" if self.only and n == 1 else
                                f"{n} episode{'s' if n != 1 else ''}") +
                               (f"  ·  {hidden} already have English subtitles (hidden)" if hidden else ""))
        self.sync_buttons()

    def dress(self, it, got):
        """One row from what was found for it."""
        tree = self.tree
        state = got.get("state")
        found = {"searching": ("Searching…", C["muted"]), "english": ("Has English subtitles", C["faint"]),
                 "added": ("Added", C["ok"]),
                 "none": ("Not on Anime Tosho", C["faint"]), "error": (got.get("error") or "Couldn't search",
                                                                      C["bad"])}.get(state)
        it.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
        for c in (2, 3):
            tree.removeItemWidget(it, c)
        if found:
            it.setText(1, found[0])
            it.setForeground(1, QColor(found[1]))
            return
        cands = (got.get("result") or {}).get("exact", []) + (got.get("result") or {}).get("other", [])
        if not cands:
            it.setText(1, "")
            return
        exact = cands[0]["same"]
        it.setText(1, f"Same release · {cands[0]['group'] or 'no group'}" if exact else "Other releases")
        it.setForeground(1, QColor(C["ok"] if exact else C["warn"]))
        it.setToolTip(1, "The same file as yours: the timing matches." if exact else
                      "Anime Tosho doesn't have your exact release: these are other releases of the episode, the "
                      "timing may be off by a few seconds.")
        it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
        it.setCheckState(0, Qt.Checked if got.get("tick", True) else Qt.Unchecked)
        combo = QComboBox()
        for ci, c in enumerate(cands):
            for ti, t in enumerate(c["tracks"]):
                tag = "" if c["same"] else f"{c['group'] or c['title'][:30]}  ·  "
                combo.addItem(f"{tag}{lang_name(t['lang'])}" + (f"  ·  {t['name']}" if t["name"] else "") +
                              f"  ({t['format'].upper()})", (ci, ti))
                combo.setItemData(combo.count() - 1, c["title"], Qt.ToolTipRole)
        pick = got.get("pick") or tosho_mod.best_track(cands) or (0, 0)
        combo.setCurrentIndex(max(0, combo.findData(pick)))
        combo.currentIndexChanged.connect(lambda _=0, w=combo, g=got: g.update(pick=w.currentData()))
        got["pick"] = combo.currentData()
        tree.setItemWidget(it, 2, combo)
        box = QWidget()
        h = QHBoxLayout(box)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(4)
        shift = QDoubleSpinBox()
        shift.setRange(-30, 30)
        shift.setSingleStep(0.1)
        shift.setDecimals(1)
        shift.setSuffix(" s")
        shift.setValue(got.get("shift", 0.0))
        shift.setToolTip("Move every line earlier (−) or later (+)")
        shift.valueChanged.connect(lambda val, g=got: g.update(shift=val))
        shift.setVisible(not exact)
        h.addWidget(shift)
        h.addStretch(1)
        try_btn = QPushButton(" Try")
        try_btn.setIcon(glyph_icon("play_arrow", C["text"]))
        try_btn.setFixedWidth(84)
        try_btn.setToolTip("Play the episode with these subtitles, from their first line")
        try_btn.clicked.connect(lambda _=False, f=it.data(0, Qt.UserRole): self.try_it(f))
        h.addWidget(try_btn)
        tree.setItemWidget(it, 3, box)

    def on_tick(self, it, column):
        got = self.found.get(it.data(0, Qt.UserRole))
        if got is not None and column == 0:
            got["tick"] = it.checkState(0) == Qt.Checked
        self.sync_buttons()

    def item_for(self, f):
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            if it.data(0, Qt.UserRole) == f:
                return it
        return None

    # ---- searching
    def find(self):
        if self.finder is not None:
            self.finder.requestInterruption()
            return
        files = list(self.files)
        if not files:
            return
        only, missing_only = self.only, self.missing.isChecked()
        found = self.found

        def work(f, say):
            streams, _ = subs_mod.probe(f) if subs_mod.ffmpeg_installed() else ([], 0)
            has = any(t["type"] == "subtitle" and is_english(t) for t in streams) or english_sidecar(f)
            if has and missing_only and not only:
                found[f] = {"state": "english", "has_english": True}
                return "english"
            found[f] = {"state": "searching", "has_english": has}
            QTimer.singleShot(0, self, lambda: self.refresh_row(f))
            res = tosho_mod.find(f, progress=say)
            found[f] = {"result": res, "has_english": has,
                        "state": None if (res["exact"] or res["other"]) else "none"}
            return ""
        self.finder = FileJob(files, work, "find")
        self.finder.progress.connect(lambda i, n, name: self.status.setText(f"{min(i + 1, n)} of {n}  ·  {name}"
                                                                            if name else ""))
        self.finder.file_done.connect(self.on_found)
        self.finder.finished_all.connect(self.on_finished)
        self.find_btn.setText(" Stop")
        self.finder.start()
        self.sync_buttons()

    def on_found(self, f, ok, msg):
        if not ok:
            self.found[f] = {"state": "error", "error": msg}
        if msg == "english":
            self.fill()
        else:
            self.refresh_row(f)
        self.sync_buttons()

    def refresh_row(self, f):
        it = self.item_for(f)
        if it is not None:
            self.tree.blockSignals(True)
            self.dress(it, self.found.get(f) or {})
            self.tree.blockSignals(False)

    def on_finished(self, changed, failed, cancelled):
        self.finder.wait()
        self.finder = None
        self.find_btn.setText(" Find subtitles")
        rows = [self.found.get(f) or {} for f in self.files]
        exact = sum(1 for g in rows if (g.get("result") or {}).get("exact"))
        other = sum(1 for g in rows if not (g.get("result") or {}).get("exact") and (g.get("result") or {}).get("other"))
        none = sum(1 for g in rows if g.get("state") == "none")
        self.status.setText("  ·  ".join(t for t in (f"{exact} same release" if exact else "",
                                                      f"{other} other release" if other else "",
                                                      f"{none} not found" if none else "",
                                                      "stopped" if cancelled else "") if t) or "Nothing to look for")
        self.sync_buttons()

    # ---- choosing
    def chosen(self):
        """[(file, candidate, track, shift)] for the ticked rows."""
        out = []
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            f = it.data(0, Qt.UserRole)
            got = self.found.get(f) or {}
            res = got.get("result") or {}
            cands = res.get("exact", []) + res.get("other", [])
            if not cands or not (it.flags() & Qt.ItemIsUserCheckable) or it.checkState(0) != Qt.Checked:
                continue
            ci, ti = got.get("pick") or (0, 0)
            out.append((f, cands[ci], cands[ci]["tracks"][ti], 0.0 if cands[ci]["same"] else got.get("shift", 0.0)))
        return out

    def text_for(self, track, shift):
        key = track["url"]
        if key not in self.texts:
            self.texts[key] = tosho_mod.download(key)
        fmt = "srt" if tosho_mod.ext_for(track) == ".srt" else "ass"
        return subs_mod.shift_text(self.texts[key], shift, fmt) if fmt in ("ass", "srt") else self.texts[key]

    def try_it(self, f):
        got = self.found.get(f) or {}
        res = got.get("result") or {}
        cands = res.get("exact", []) + res.get("other", [])
        if not cands:
            return
        ci, ti = got.get("pick") or (0, 0)
        track, shift = cands[ci]["tracks"][ti], (0.0 if cands[ci]["same"] else got.get("shift", 0.0))
        self.status.setText("Getting the subtitles…")
        call = BgCall(lambda: self.text_for(track, shift))

        def done(text, err, c=call):
            c.wait()
            self.tries = [x for x in getattr(self, "tries", []) if x is not c]
            if err:
                self.status.setText(f"Couldn't get them: {err}")
                return
            self.status.setText("")
            tmp = Path(tempfile.gettempdir()) / f"kura_try{tosho_mod.ext_for(track)}"
            tmp.write_text(text, encoding="utf-8")
            fmt = "srt" if tosho_mod.ext_for(track) == ".srt" else "ass"
            self.tool.try_subtitle.emit(f, str(tmp), subs_mod.first_line_time(text, fmt))
        call.done.connect(done)
        self.tries = getattr(self, "tries", []) + [call]
        call.start()

    def sync_buttons(self):
        busy = self.tool.job is not None
        n = len(self.chosen())
        self.find_btn.setEnabled(bool(self.files) and not busy)
        self.save_btn.setEnabled(n > 0 and not busy and self.finder is None and
                                 (subs_mod.ffmpeg_installed() or self.save_as.value() == "next"))
        self.save_btn.setText(f"Save {n} subtitle{'s' if n != 1 else ''}" if n else "Save")

    # ---- saving
    def save(self):
        picks = self.chosen()
        if not picks:
            return
        inside, default = self.save_as.value() == "inside", self.make_default.isChecked()
        style = subs_mod.full_style(self.settings.get("subtool_style") or {}) if self.styled.isChecked() else None
        if inside and QMessageBox.question(
                self, "Subtitles", f"Add the subtitles to {len(picks)} episode{'s' if len(picks) != 1 else ''}?\n\n"
                "Each file is copied with the new track next to the original, checked, then swapped in (about 1 GB "
                "written per episode). Restore originals (Tracks) takes the track out again.") != QMessageBox.Yes:
            return
        jobs = {f: (c, t, s) for f, c, t, s in picks}

        def one(f, say):
            cand, track, shift = jobs[f]
            say("downloading")
            text = self.text_for(track, shift)
            ext = tosho_mod.ext_for(track)
            if style and ext == ".ass":
                text = subs_mod.restyle(text, style)
            lang = lang_code(track["lang"])
            if not inside:
                dest = subs_mod.sidecar_path(f, lang, ext)
                dest.write_text(text, encoding="utf-8")
                return ""
            with tempfile.TemporaryDirectory(prefix="kura_dl_") as td:
                tmp = Path(td) / f"new{ext}"
                tmp.write_text(text, encoding="utf-8")
                streams, _ = subs_mod.probe(f)
                wanted = [{"src": t["index"], "codec": t["codec"], "lang": t.get("lang") or "", "title": t.get("title")
                           or "", "default": bool(t.get("default")) and not default, "forced": bool(t.get("forced"))}
                          for t in streams if t["type"] == "subtitle"]
                who = cand["group"] or "Anime Tosho"
                wanted.append({"src": None, "file": tmp, "codec": {".srt": "subrip", ".vtt": "webvtt"}.get(ext, "ass"),
                               "lang": lang, "title": f"{lang_name(lang)} · {who} (Anime Tosho)",
                               "default": default, "forced": False})
                say("adding the track")
                subs_mod.edit_tracks(f, wanted)
            return ""

        def after():
            for f in jobs:
                g = self.found.get(f)
                if g is not None and f not in failed:
                    g.update(has_english=True, state="added")
            self.fill()
        failed = set()
        job = FileJob(list(jobs), one, "download")
        job.file_done.connect(lambda f, ok, _m: None if ok else failed.add(f))
        self.tool.start_job(job, "Added subtitles to", after)


