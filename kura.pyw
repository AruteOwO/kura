    HOME, LIBRARY, ORGANIZE, TORRENTS, STATS, TOOLS, SETTINGS, DETAIL = 0, 1, 2, 4, 7, 8, 9, 10   # page indexes (sidebar order)

    def setup_torrent_timer(self):
        minutes = int(self.settings.get("torrent_interval_min") or 15) if self.settings.get("torrent_auto_check") else 0
        if minutes:
            if self.torrent_timer.interval() != minutes * 60000 or not self.torrent_timer.isActive():
                self.torrent_timer.start(minutes * 60000)
        else:
            self.torrent_timer.stop()

    def library_target(self, idx):
        index = idx.data(INDEX_ROLE)
        mid = (index or {}).get("mid") or idx.data(MID_ROLE)
        if not mid:
            return None
        m = media_for(mid, self.account) or {}
        return {"mid": mid, "media": m, "show_path": idx.data(PATH_ROLE), "title": idx.data(Qt.DisplayRole)}

    def seasonal_target(self, idx):
        m = idx.data(MEDIA_ROLE) or {}
        return {"mid": m.get("id"), "media": m} if m.get("id") else None

    def changeEvent(self, e):
        super().changeEvent(e)
        if e.type() == QEvent.WindowStateChange and getattr(self, "strip", None) is not None:
            full = self.isFullScreen()
            if getattr(self, "player_strip", None) is not None:
                self.player_strip.setVisible(not full)
            for b in self.max_buttons():
                b.update()   # maximize ↔ restore
            if self.own_title and not full:
                QTimer.singleShot(0, lambda: own_frame(self))   # leaving fullscreen: our styles back
        if e.type() == QEvent.ActivationChange and getattr(self, "strip", None) is not None:
            self.strip.caps.update()
            for b in self.strip.caps.findChildren(CapButton):
                b.update()
        if e.type() == QEvent.ActivationChange and not self.isActiveWindow() and getattr(self, "previews", None):
            if not QApplication.activePopupWidget():
                self.previews.close()

    def show_downloads(self):
        self.go(self.TORRENTS)
        self.torrents.view_switch.buttons["downloads"].setChecked(True)
        self.torrents.set_view("downloads")

    PAGE_NAMES = {0: "Home", 1: "Library", 3: "To download", 5: "Schedule", 6: "Seasonal", 7: "Statistics",
                  8: "Tools", 11: "Kickoff", 12: "Live TV"}

    def find_torrents(self, query):
        """Torrents searches this (every name of the show it starts with); the back pill returns to this page."""
        here = self.pages.currentIndex()
        self._remember_page()
        if here == self.DETAIL:
            self.torrents.set_origin(here, self.detail.name or "the show", self.detail.media_id)
        elif here != self.TORRENTS:
            self.torrents.set_origin(here, self.PAGE_NAMES.get(here, "the last page"))
        self.finding = True
        self.go(self.TORRENTS)
        self.finding = False
        self.torrents.search(query)

    def torrents_back(self, page):
        self.go(page)

    def go(self, n):
        if getattr(self, "previews", None):
            self.previews.close()
        if n == self.ORGANIZE:   # a tool now
            self.tools.open_tool(ToolsPage.ORGANIZE)
            n = self.TOOLS
        if acct.ADULT["on"] and n in self.ADULT_HIDDEN:
            n = self.HOME
        if n == self.TORRENTS and not getattr(self, "finding", False) and self.pages.currentIndex() != n:
            self.torrents.set_origin(None)   # opened from the sidebar: nothing to go back to
        self.refresh_stale(n)
        changed = self.pages.currentIndex() != n
        self.pages.setCurrentIndex(n)
        if changed and getattr(self, "page_fade", None):
            self.page_fade.play()
        # A show page keeps the sidebar on the page you opened it from; Settings lights the gear
        shown = self.prev_page if n == self.DETAIL else n
        b = self.nav.button(shown)
        if b is not None:
            b.setChecked(True)
        else:
            self.nav.setExclusive(False)
            for nb in self.nav.buttons():
                nb.setChecked(False)
            self.nav.setExclusive(True)
        if getattr(self, "profile", None):
            self.profile.gear.setChecked(shown == self.SETTINGS)

    def _remember_page(self):
        if self.pages.currentIndex() != self.DETAIL:
            self.prev_page = self.pages.currentIndex()

    def show_details(self, path, cover):
        if path:
            it = self.library.items.get(path)
            if cover is None and it is not None:
                cover = it.data(COVER_ROLE)
            self._remember_page()
            self.detail.open(path, cover, media_id=self.library.media_id_for(path))
            self.go(self.DETAIL)

    def show_media(self, mid, name, cover):
        """A show that isn't in your library (from your list or the seasonal chart)."""
        path = self.library.path_for_media(mid)
        if path:
            self.show_details(path, cover)
            return
        self._remember_page()
        self.detail.open(None, cover, media_id=mid, name=name)
        self.go(self.DETAIL)

    def check_sequels(self, force=False):
        """Once a day (or Check for sequels): sequels to shows you finished or watch, new ones announced."""
        a = self.account
        if self.sequel_call is not None or not (a and a.connected) or not (force or alerts_mod.due()):
            return
        entries = dict(a.entries)
        self.kickoff.check_btn.setEnabled(False)
        self.kickoff.check_btn.setText(" Checking…")
        self.sequel_call = BgCall(lambda: alerts_mod.check(entries))
        self.sequel_call.done.connect(self.on_sequels)
        self.sequel_call.start()

    def on_sequels(self, result, err):
        self.sequel_call.wait()
        self.sequel_call = None
        self.kickoff.check_btn.setEnabled(True)
        self.kickoff.check_btn.setText(" Check for sequels")
        if err or not result:
            return
        found, new, started = result
        for x in (new + started)[:3]:
            m = x["media"]
            title = media_title(m)
            when_ = season_name(m.get("season"), m.get("seasonYear") or (m.get("startDate") or {}).get("year"))
            text = (f"Now airing: {title}, the sequel to {x['from_title']}" if x in started else
                    f"Sequel announced: {title} ({when_}), after {x['from_title']}")
            self.notify_action(text, "Add to Planning",
                               lambda mid=m["id"], mm=m: self.account.save(mid, mm, status="PLANNING"),
                               mid=m["id"], kind="sequel", sub=when_ or "", act={"media": m["id"]})
        if len(new) + len(started) > 3:
            self.remember_note(f"{len(new) + len(started) - 3} more sequel updates on the Kickoff page", "sequel",
                               button="Open Kickoff", run=lambda: self.go(11), act={"page": 11})
        self.kickoff.schedule()

    def on_account_changed(self):
        QTimer.singleShot(5000, self.check_sequels)
        self.library.refresh(list_only=True)   # rescan so folders can be matched through your list
        self.detail.on_account_changed()
        self.settings_page.build_account_card()
        self.seasonal.grid.viewport().update()
        current = self.pages.currentWidget()
        if current in (self.todo, self.schedule):
            current.rebuild()

    def on_entry_changed(self, mid):
        self.library.apply_account()
        self.detail.on_entry_changed(mid)
        for card in list(LIVE_CARDS):   # posters on Home, show pages, Kickoff: their list badge
            try:
                if card.media.get("id") == mid:
                    card.follow_list(self.account)
            except RuntimeError:
                pass
        self.seasonal.grid.viewport().update()
        if self.pages.currentWidget() is self.todo:
            self.todo.rebuild()

    def on_settings_changed(self):
        self.library.refresh()
        self.organize.sync_buttons(self.job is not None)
        self.setup_torrent_timer()

    def set_side_status(self, state):
        self.job_state, self.job_state_at = state, time.time()
        self.update_profile()
        if state != "running":
            QTimer.singleShot(12000, self.update_profile)   # "Finished" shows for a while, then the sync status

    def update_profile(self):
        """The sidebar's profile chip: who you are and what Kura is doing."""
        if not getattr(self, "profile", None):
            return
        a = self.account
        u = a.user if a and a.connected else None
        self.profile.name.setText((u or {}).get("name") or "Kura")
        url = ((u or {}).get("avatar") or {}).get("medium")
        if url and url != self.avatar_url:
            self.avatar_url = url
            call = BgCall(lambda: cached_image(url, COVER_DIR / f"user_avatar_{u.get('id')}_s.jpg"))
            call.done.connect(lambda img, err, c=call, n=u.get("name") or "K": (
                c.wait(), self.profile.set_avatar(img, n[:1].upper())))
            self.keep_call = call
            call.start()
        elif not u:
            self.profile.set_avatar(None, "K")
        recent = time.time() - self.job_state_at < 12
        if self.job_state == "running":
            self.profile.set_status("Organizing…", C["accent_hi"], C["accent_hi"])
        elif recent and self.job_state in ("ok", "preview", "failed"):
            text = {"ok": "Organizing finished", "preview": "Preview ready", "failed": "Organizing failed"}[self.job_state]
            self.profile.set_status(text, C["bad"] if self.job_state == "failed" else C["ok"],
                                    C["bad"] if self.job_state == "failed" else C["ok"])
        elif u and a.refreshing:
            self.profile.set_status("Syncing your list…", C["muted"], C["warn"])
        elif u:
            self.profile.set_status(f"Synced {_ago(a.fetched)}", C["faint"], C["ok"])
        else:
            self.profile.set_status("Not signed in to AniList", C["faint"], C["faint"])

    def update_badges(self):
        """Sidebar counts: shows with new episodes (Library), shows to download, active downloads."""
        if not getattr(self, "nav_buttons", None):
            return
        new = sum(1 for it in self.library.items.values() if (it.data(NEW_ROLE) or 0) > 0)
        self.nav_buttons[self.LIBRARY].set_badge(new, C["ok"], f"{new} show{'s' if new != 1 else ''} with new episodes")
        todo = todo_count(self.library, self.account)
        self.nav_buttons[3].set_badge(todo, "#8fd3ff", f"{todo} show{'s' if todo != 1 else ''} with episodes to get")
        self.update_missed_badge()
        self.update_torrent_badge()

    def update_missed_badge(self):
        try:
            n = len(self.torrents.missed_entries())   # shows (an unfinished season counts once)
        except Exception as e:
            klog.warning(f"Missed episodes: {e}")
            n = 0
        self.nav_buttons[5].set_badge(n, C["warn"], f"{n} show{'s' if n != 1 else ''} need you (Schedule → Needs you)")

    def on_missed_changed(self):
        self.update_missed_badge()
        if self.pages.currentWidget() is self.schedule:
            self.schedule.rebuild()

    def update_torrent_badge(self):
        if not getattr(self, "nav_buttons", None):
            return
        ts = self.downloads.torrents.values() if getattr(self, "downloads", None) else []
        n = sum(1 for t in ts if float(t.get("progress", 0)) < 1)
        self.nav_buttons[self.TORRENTS].set_badge(n, C["accent_hi"], f"{n} downloading")

    # ---- drag & drop anywhere in the window
    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls():
            e.acceptProposedAction()

    def dropEvent(self, e):
        paths = [u.toLocalFile() for u in e.mimeData().urls() if u.isLocalFile()]
        if paths:
            self.organize.add_paths(paths)
            self.go(self.ORGANIZE)

    # ---- jobs
    def run_job(self, argv, description, is_sort, dry=None, on_done=None):
        if self.job is not None:
            return
        sorting = not any(a.startswith("--") for a in argv)   # sorting files/folders, not a library tool
        # sorting goes to the Anime library and 18+ shows move on to the adult one by themselves; library tools
        # (icons, renames, season folders) work on the side you're on
        lib = anime_library(self.settings) if sorting else self.settings.get("library")
        if not lib:
            self.go(self.SETTINGS)
            return
        dry = self.settings.get("dry_run", False) if dry is None else dry
        org.PLAN = [] if (dry and sorting) else None          # a preview of a sort: keep what it would move
        self.job_paths = list(argv) if sorting else []
        argv = [*argv, "--library", lib] + (["--dry-run"] if dry else [])
        apply_settings(self.settings)
        self.organize.append_log(f"▶ {description}{' (preview)' if dry else ''}")
        self.job = Job(argv)
        self.job.done.connect(lambda ok, sort=is_sort, d=dry, cb=on_done: self.on_job_done(ok, sort, d, cb))
        self.organize.set_status("running")
        self.set_side_status("running")
        self.organize.sync_buttons(True)
        self.job.start()

    def on_job_done(self, ok, is_sort, dry, on_done=None):
        self.job.wait()
        self.job = None
        state = "failed" if not ok else ("preview" if dry else "ok")
        self.organize.set_status(state)
        self.set_side_status(state)
        if ok and is_sort and not dry:
            self.organize.clear_queue()
        self.organize.sync_buttons(False)
        if not dry:
            follow_moved_files(self.settings)
            self.library.refresh()
        plan, org.PLAN = org.PLAN, None
        if on_done:
            on_done(ok)
        if ok and dry and plan is not None:
            self.offer_plan(plan, self.job_paths)
        self.next_organize()

    def offer_plan(self, plan, paths):
        """Preview finished: tick/untick its moves, Apply runs the real sort on just the ticked episodes."""
        if not any(not e["skip"] for e in plan):
            self.organize.append_log("Preview: nothing to move.")
            if not plan:
                return
        dlg = PlanDialog(self, plan, self.settings.get("mode", "move"))
        if dlg.exec() != QDialog.Accepted:
            return
        chosen = dlg.chosen()
        if not chosen:
            return
        roots = [Path(p) for p in paths if Path(p).is_dir()]

        def tidy(ok):
            # the episodes came out of these folders: remove the ones left empty (moving only)
            if ok and org.MODE == "move":
                lib = Path(self.settings.get("library") or "").resolve()
                for r in roots:
                    if r.is_dir() and r.resolve() != lib:
                        try:
                            org.remove_empty_dirs(r.resolve(), lib)
                        except OSError:
                            pass
            self.organize.prune_queue()
        self.run_job(chosen, f"Applying {len(chosen)} from the preview", False, dry=False, on_done=tidy)

    # ---- finished downloads (qBittorrent Web UI)
    def describe_torrent(self, name):
        """(mid, episode) for a torrent name; episode None for batches or unknown."""
        p = tor.parse_release(name)
        eps = p["episodes"] or []
        mid, ep = self.now_playing.matcher()[0].match(p["name"], p["season"], eps[-1] if eps else 1)
        return mid, (ep if eps and not p.get("batch") and len(eps) == 1 else None)

    def download_name(self, t):
        mid, ep, eps = t.get("mid"), t.get("episode"), t.get("episodes")
        if mid:
            m = media_for(mid, self.account)
            title = (media_title(m) if m.get("title") else "") or tor.parse_release(t.get("name", ""))["name"]
            title = title or t.get("name", "")
            if ep:
                return f"{title} episode {ep}"
            if eps:
                return f"{title} episode{'s' if len(eps) > 1 else ''} {episode_ranges(eps)}"
            return title
        return t.get("name", "a torrent")

    def library_episodes(self):
        """{AniList id: {episode numbers on disk}} from the library scan."""
        have = {}
        for idx in self.library.indexes().values():
            for sid, eps in ((idx or {}).get("local") or {}).items():
                if sid:
                    have.setdefault(sid, set()).update(eps)
        return have

    def file_episode(self, name):
        """(mid, episode) of one video file inside a torrent; (None, None) for extras (NCOP...)."""
        title, season, types, ep = org.parse(Path(name).name)
        eps = tor._ints(ep)
        if len(eps) != 1 or types & {"NCOP", "NCED", "OP", "ED", "OPENING", "ENDING", "PV", "PREVIEW"}:
            return None, None
        p = tor.parse_release(Path(name).name)
        return self.now_playing.matcher()[0].match(p["name"] or title, p["season"] or season, eps[0])

    def pick_missing_files(self, t):
        """A batch sent with "only what you're missing": don't download episodes already on disk."""
        h, client = t["hash"], self.downloads.client

        def chosen(files, err):
            if err or not files:
                self.downloads.picking.discard(h)   # try again on a later poll
                return
            have, mid = self.library_episodes(), t.get("mid")
            known = tor.load_history().get(h) or {}
            skip, junk = [], []
            for f in files:
                path = Path(f["name"])
                if path.suffix.lower() not in org.VIDEO_EXTS:
                    # not video: scans, CD audio, documents go; subtitles and fonts stay (some releases need them)
                    if known.get("skip_junk") and path.suffix.lower() not in JUNK_KEEP:
                        junk.append(f["index"])
                    continue
                if known.get("skip_junk") and org.extra_kind(path.name, [p for p in reversed(path.parts[:-1])]) == "menu":
                    junk.append(f["index"])   # disc menus
                    continue
                if not known.get("only_missing"):
                    continue
                fmid, ep = self.file_episode(f["name"])
                if ep and ep in have.get(fmid or mid, ()):
                    skip.append(f["index"])

            def done(*_):
                tor.update_history(h, files_picked=True, skipped=len(skip), junk=len(junk))
            if skip or junk:
                said = []
                if skip:
                    said.append(f"{len(skip)} episode{'s' if len(skip) != 1 else ''} you already have")
                if junk:
                    said.append(f"{len(junk)} menu / scan / audio file{'s' if len(junk) != 1 else ''}")
                self.organize.append_log(f"{self.download_name(t)}: skipping {' and '.join(said)}")
                self.downloads.run(lambda: client.file_priority(h, skip + junk, 0), done)
            else:
                done()
        self.downloads.run(lambda: client.files(h), chosen)

    def on_download_finished(self, t):
        if not self.settings.get("qbit_organize", True):
            self.notify_ready(t, organized=False)
            return
        path = t.get("content_path") or str(Path(t.get("save_path", "")) / t.get("name", ""))
        # qBittorrent's own "run on finish" hook organizes too: give it a minute first
        wait = 60000 if self.downloads.hook else 0
        QTimer.singleShot(wait, lambda: self.organize_download(t, path))

    def organize_download(self, t, path):
        h, name, client = t["hash"], self.download_name(t), self.downloads.client
        remove = self.settings.get("qbit_remove", True)
        if client is None:
            return
        if not Path(path).exists():   # already organized (the hook) or removed by hand
            if remove:
                self.downloads.run(lambda: client.delete([h]), lambda *_: None)
            self.library.refresh()
            self.notify_ready(t)
            return

        def listed(files, err):
            # Only the files that were downloaded: a batch may skip episodes you have, and
            # qBittorrent leaves partial pieces of those behind
            videos = [] if err else [str(Path(t.get("save_path", "")) / f["name"]) for f in files or []
                                     if f.get("priority", 1) > 0 and f.get("progress", 1) >= 1
                                     and Path(f["name"]).suffix.lower() in org.VIDEO_EXTS]
            targets = [v for v in videos if Path(v).exists()] or [path]

            def released(_, err2):
                if err2:
                    self.organize.append_log(f"Couldn't {'remove' if remove else 'pause'} {name} in qBittorrent ({err2})")
                # a moment for qBittorrent to let go of the files
                QTimer.singleShot(1500, lambda: self.queue_organize(
                    targets, f"Organize finished download: {name}",
                    lambda ok: self.after_organized(t, ok, path, targets, remove)))
            # the files can't move while qBittorrent is seeding them
            self.downloads.run((lambda: client.delete([h])) if remove else (lambda: client.pause([h])), released)
        self.downloads.run(lambda: client.files(h), listed)

    def queue_organize(self, paths, description, done):
        self.organize_queue.append((paths, description, done))
        self.next_organize()

    def next_organize(self):
        if self.job is None and self.organize_queue and self.settings.get("library"):
            paths, description, done = self.organize_queue.pop(0)
            self.run_job(list(paths), description, False, dry=False, on_done=done)

    def after_organized(self, t, ok, path, targets, removed):
        library = Path(self.settings.get("library") or ".")
        left = list(org.collect([Path(p) for p in targets if Path(p).exists()], library))
        if left:
            n = len(left)
            self.notify(f"Couldn't organize {n} file{'s' if n != 1 else ''} of {self.download_name(t)}. "
                        f"{'They are' if n != 1 else 'It is'} still in {Path(left[0]).parent} "
                        "(details: Organize → Activity).")
            return
        # Every episode is in the library: what's left of a batch folder (fonts, .nfo, screenshots,
        # pieces of skipped files) goes too, once qBittorrent no longer has the torrent
        folder, save = Path(path), Path(t.get("save_path") or "")
        if removed and folder.is_dir() and save in folder.parents and folder != library:
            import shutil
            try:
                shutil.rmtree(folder)
                self.organize.append_log(f"Removed the leftovers in {folder}")
            except OSError as e:
                self.organize.append_log(f"Couldn't remove {folder} ({e})")
        self.notify_ready(t)

    def notify_ready(self, t, organized=True):
        mid, ep = t.get("mid"), t.get("episode")
        plural = not ep and len(t.get("episodes") or []) > 1
        verb = ("are" if plural else "is") + " ready" if organized else "finished downloading"
        text = f"{self.download_name(t)} {verb}"
        if mid and ep and organized:
            self.notify_action(text, "Play", lambda: self.play_episode(mid, ep), mid=mid, kind="episode",
                               sub=f"Episode {ep} · organized", act={"play": [mid, ep]})
        elif mid:
            self.notify_action(text, "Show", lambda: self.show_media(mid, "", None), mid=mid, kind="show",
                               act={"media": mid})
        else:
            self.notify(text)

    def play_episode(self, mid, ep):
        for it in self.library.items.values():
            f = ((it.data(INDEX_ROLE) or {}).get("local") or {}).get(mid, {}).get(ep)
            if f and Path(f).exists():
                play_video(f)
                return
        self.show_media(mid, "", None)   # not in the library index yet: the show page

