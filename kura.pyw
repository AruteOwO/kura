EXTRA_GLYPHS = {"op_ed": "music_note", "preview": "movie", "commercial": "campaign", "menu": "menu", "bonus": "stars"}


def extra_title(path):
    """A file name without the release group and the [tags] / (BD 1080p...) around it."""
    name = Path(path).stem
    name = re.sub(r"^\s*\[[^\]]*\]\s*", "", name)
    name = re.sub(r"\s*\[[^\]]*\]", "", name)
    name = re.sub(r"\s*\((?:BD|BDRip|DVD|Web|\d{3,4}p)[^)]*\)", "", name, flags=re.I)
    return name.replace(".", " ").replace("_", " ").strip() or Path(path).stem


