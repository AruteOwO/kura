    def max_buttons(self):
        out = [self.strip.caps.max_btn]
        if getattr(self, "player_strip", None) is not None:
            out.append(self.player_strip.caps.max_btn)
        return out

    def nativeEvent(self, event_type, message):
        if not self.own_title or event_type != b"windows_generic_MSG":
            return False, 0
        try:
            return frame_native_event(self, message, self.hit_region)
        except Exception as e:
            klog.warning(f"Title bar: {e}")
            return False, 0

    def hit_region(self, pos):
        """What's under this point: the maximize button (Windows shows snap layouts there), somewhere that moves
        the window (the title strip's empty space), or the page."""
        w = self.childAt(pos)
        self.nc_max_btn = None
        for b in self.max_buttons():
            if w is b:
                self.nc_max_btn = b
                return HTMAXBUTTON
        while w is not None and w is not self:
            if w.property("kura_drag"):
                return HTCAPTION
            if isinstance(w, (QAbstractButton, QLineEdit, QComboBox, QAbstractSpinBox, QSlider)):
                return HTCLIENT
            w = w.parentWidget()   # a label on the strip moves the window too
        return HTCLIENT

    def hideEvent(self, e):
        super().hideEvent(e)
        self.downloads.set_fast(False)   # in the tray: just enough to notice finished downloads

