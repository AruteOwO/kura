    def best_each(self):
        """The best release of each episode (the list is sorted best first)."""
        out, seen = [], set()
        for r in self.e.get("releases") or []:
            if r.get("ep") not in seen:
                seen.add(r.get("ep"))
                out.append(r)
        return out

    def run(self, how, records=None):
        self.accept()
        self.page.do_fix(self.e, how, records)

    def more_menu(self, btn):
        e, page = self.e, self.page
        m = QMenu(self)
