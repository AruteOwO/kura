        x = 40 + self.AV + 24
        bottom = self.H - 30
        self.since.adjustSize()
        self.name.adjustSize()
        self.name.move(x, bottom - 28 - self.name.height())
        y = bottom - 26
        self.since.move(x, y + (24 - self.since.height()) // 2)
        px = x + (self.since.width() + 14 if self.since.isVisible() else 0)
        for pl in (self.pill1, self.pill2):
            if pl.isVisible():
                pl.adjustSize()
                pl.move(px, y + (24 - pl.height()) // 2)
                px += pl.width() + 8
        for b in (self.refresh_btn, self.profile_btn):
            b.adjustSize()
        bx = self.width() - 40 - self.profile_btn.width()
        by = self.H - 36 - self.profile_btn.height()
        self.profile_btn.move(bx, by)
        self.refresh_btn.move(bx - 10 - self.refresh_btn.width(), by)
        # a narrow window: buttons move to the top right, over the banner
        if self.refresh_btn.x() < px + 20:
            self.profile_btn.move(bx, 20)
            self.refresh_btn.move(bx - 10 - self.refresh_btn.width(), 20)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        w, h = self.width(), self.height()
        bg = QColor(C["bg"])
        if self.banner is not None and not self.banner.isNull():
            if self._bpm is None or self._bpm.width() != int(w * self.devicePixelRatioF()):
                dpr = self.devicePixelRatioF()
                img = self.banner.scaled(int(w * dpr), int(h * dpr), Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
                y = int((img.height() - h * dpr) * 0.3)
                pm = QPixmap.fromImage(img.copy((img.width() - int(w * dpr)) // 2, y, int(w * dpr), int(h * dpr)))
                pm.setDevicePixelRatio(dpr)
                self._bpm = pm
            p.drawPixmap(0, 0, self._bpm)
        else:
            g = QLinearGradient(0, 0, w, h)
            g.setColorAt(0, QColor("#2a2457"))
            g.setColorAt(1, QColor("#14324a"))
            p.fillRect(self.rect(), g)
        v = QLinearGradient(0, 0, 0, h)
        for stop, a in ((0, 20), (0.45, 95), (0.8, 215), (1, 255)):
            c = QColor(bg)
            c.setAlpha(a)
            v.setColorAt(stop, c)
        p.fillRect(self.rect(), v)
        hz = QLinearGradient(0, 0, w, 0)
        c = QColor(bg)
        c.setAlpha(150)
        hz.setColorAt(0, c)
        c.setAlpha(0)
        hz.setColorAt(0.6, c)
        p.fillRect(self.rect(), hz)
        # avatar in a gradient ring
        r = QRectF(40, self.H - 30 - self.AV, self.AV, self.AV)
        ring = QConicalGradient(r.center(), 200)
        for stop, col in ((0, "#7c6cff"), (0.33, "#b58cff"), (0.66, "#5bd6ff"), (1, "#7c6cff")):
            ring.setColorAt(stop, QColor(col))
        p.setPen(Qt.NoPen)
        p.setBrush(ring)
        p.drawEllipse(r)
        p.setBrush(bg)
        p.drawEllipse(r.adjusted(4, 4, -4, -4))
        inner = r.adjusted(7, 7, -7, -7)
        clip = QPainterPath()
        clip.addEllipse(inner)
        p.save()
        p.setClipPath(clip)
        if self.avatar is not None and not self.avatar.isNull():
            p.drawImage(inner, self.avatar.scaled(int(inner.width() * 2), int(inner.height() * 2),
                                                  Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
        else:
            p.fillRect(inner, QColor(C["surface2"]))
            f = QFont(self.font())
            f.setPixelSize(40)
            f.setWeight(QFont.Bold)
            p.setFont(f)
            p.setPen(QColor(C["accent_hi"]))
            p.drawText(inner, Qt.AlignCenter, self.initial)
        p.restore()



