            self.cr_sign_btn = QPushButton("Sign in")
            self.cr_sign_btn.setObjectName("primary")
            self.cr_sign_btn.setCursor(Qt.PointingHandCursor)
            self.cr_sign_btn.clicked.connect(self.crunchy_sign_in)
            f.addWidget(self.cr_sign_btn)
            v.addWidget(form)
        self.divider(v)
        # the switch itself lives with the other recognition sources (one place for it)
        self.cr_toggle = label("", "faint", wrap=True)
        self.sync_crunchy_toggle(self.settings.get("recog_crunchyroll", False))
        to_sources = QPushButton("Sources")
        to_sources.clicked.connect(lambda: self.show_section("sources"))
        self.row(v, "Recognize what I play on Crunchyroll", self.cr_toggle, to_sources)
        self.crunchy_holder.addWidget(box)

    def sync_crunchy_toggle(self, on):
        """Sources' switch changed: the Crunchyroll card says so (Sources saves it itself)."""
        try:
            if self.cr_toggle is not None:
                self.cr_toggle.setText(("On" if on else "Off") + " · any device (TV, phone, browser), checked every "
                                       "30 s. Switched in Playback → Sources.")
        except RuntimeError:
            pass

    def crunchy_sign_in(self):
        if self.cr_signer is not None:
            return
        cookie = self.cr_cookie.text()
        self.cr_sign_btn.setEnabled(False)
        self.cr_sign_btn.setText("Signing in…")
        self.cr_signer = BgCall(lambda: crunchy.Crunchyroll({}).sign_in(cookie))
        self.cr_signer.done.connect(self.on_crunchy_signed_in)
        self.cr_signer.start()

    def on_crunchy_signed_in(self, creds, err):
        self.cr_signer.wait()
        self.cr_signer = None
        self.build_crunchy_card(note=err or "")
        self.crunchy_changed.emit()

    def crunchy_sign_out(self):
        box = QMessageBox(QMessageBox.Question, "Sign out of Crunchyroll",
                          "Sign Kura out of Crunchyroll? Kura's copy of your history and your matching choices are "
                          "kept.", QMessageBox.Yes | QMessageBox.Cancel, self)
        if box.exec() == QMessageBox.Yes:
            crunchy.forget()
            self.build_crunchy_card(note="")
            self.crunchy_changed.emit()

    def text_row(self, layout, title, desc, key, placeholder="", width=320):
        edit = QLineEdit(self.settings.get(key) or "")
        edit.setPlaceholderText(placeholder)
        edit.setMinimumWidth(width)
        edit.editingFinished.connect(lambda: self.set(key, edit.text().strip()))
        self.row(layout, title, label(desc, "faint", wrap=True), edit)

    def path_row(self, layout, title, desc, key):
        edit = QLineEdit(self.settings.get(key) or "")
        if not hasattr(self, "path_edits"):
            self.path_edits = {}
        self.path_edits[key] = edit
        edit.setPlaceholderText("Not set")
        edit.setMinimumWidth(320)
        edit.editingFinished.connect(lambda: self.set(key, edit.text().strip()))
        browse = QPushButton("Browse")

        def pick():
            d = QFileDialog.getExistingDirectory(self, title, edit.text() or "")
            if d:
                edit.setText(str(Path(d)))
                self.set(key, edit.text())
        browse.clicked.connect(pick)
        w = QWidget()
        h = QHBoxLayout(w)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(8)
        h.addWidget(edit, 1)
        h.addWidget(browse)
        self.row(layout, title, label(desc, "faint", wrap=True), w)

    def row(self, layout, title, desc_label, control):
        w = QWidget()
        h = QHBoxLayout(w)
        h.setContentsMargins(0, 12, 0, 12)
        h.setSpacing(24)
        text = QVBoxLayout()
        text.setSpacing(2)
        text.addWidget(label(title, "h2"))
        text.addWidget(desc_label)
        h.addLayout(text, 1)
        h.addWidget(control, 0, Qt.AlignVCenter)
        layout.addWidget(w)

    def divider(self, layout):
        d = QFrame()
        d.setObjectName("divider")
        layout.addWidget(d)

    def set(self, key, value):
        if self.settings.get(key) == value:
            return
        self.settings[key] = value
        save_settings(self.settings)
        if key == "mode":
            self.update_mode_desc()
        self.changed.emit()

    def update_mode_desc(self):
        self.mode_desc.setText({
            "move": "Move files into the library. qBittorrent stops seeding them.",
            "hardlink": "File shows up in both places, no extra space, keeps seeding. Same drive only.",
            "copy": "Full copy. Uses double the space.",
        }[self.settings["mode"]])

    def reveal_script(self):
        if os.name == "nt":
            import subprocess
            subprocess.Popen(["explorer", "/select,", str(SCRIPT_DIR / "anime_organizer.py")])


