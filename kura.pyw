    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        path = QPainterPath()
        path.addRoundedRect(r, 16, 16)
        p.fillPath(path, QColor(C["surface"]))
        if self.bg is not None:
            p.save()
            p.setClipPath(path)
            p.setOpacity(0.75)
            p.drawImage(r, self.bg, fill_source(self.bg.size(), r.size()))
            p.setOpacity(1)
            g = QLinearGradient(r.topLeft(), r.topRight())
            g.setColorAt(0, QColor(14, 16, 21, 150))
            g.setColorAt(1, QColor(14, 16, 21, 190))
            p.fillRect(r, g)
            p.restore()
        p.setPen(QPen(QColor(255, 255, 255, 22), 1))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.position().toPoint()):
            self.clicked.emit()


class ToDownloadPage(AccountPage):
    def __init__(self, settings, account, library):
        super().__init__("To download", "What you're missing, based on your AniList list and your library.", account)
        self.settings, self.library = settings, library
        self.downloads, self.dl_labels = None, {}
        lbl, self.show_all = show_all_toggle(settings, "todo_show_all", self.rebuild)
        self.actions.addWidget(lbl)
        self.actions.addWidget(self.show_all)
        self.actions.addSpacing(8)
        refresh = QPushButton(" Sync list")
        refresh.setIcon(glyph_icon(G["refresh"], C["text"]))
        refresh.clicked.connect(lambda: self.account.refresh())
        self.actions.addWidget(refresh)

    def searches(self):
        """Your download searches for this side, the starred one first."""
        items = side_items(self.settings.get("search_sites")) or [dict(DEFAULT_SEARCHES[0])]
        return sorted(items, key=lambda x: not x.get("default"))

    def search_url(self, query):
        return (self.searches()[0].get("url") or DEFAULT_SEARCH_URL).replace("{query}", urllib.parse.quote_plus(query))

    def rebuild(self):
        for f in list(self.fetchers):
            f.requestInterruption()
        self.slots, self.dl_labels = {}, {}
        a = self.account
        connected = a and a.connected

        # Which AniList entries are in the library, and the episodes on disk for each
        media_local, library_ids = {}, set()
        for path, idx in self.library.indexes().items():
            if not idx:
                continue
            library_ids |= {i for i in idx["chain"] if i}
            for n, sid in enumerate(idx["seasons"], 1):
                if sid:
                    media_local[sid] = (path, n, idx["local"].get(sid, {}))

        watching, planning, gaps = [], [], []
        show_all = self.show_all.isChecked()
        if connected:
            for mid, e in a.view().items():
                st, m = e.get("status"), e.get("media") or {}
                if not show_all and mid not in library_ids:
                    continue   # only shows you have (toggle "Show not downloaded" for the rest)
                if st in ("CURRENT", "REPEATING"):
                    aired, p = aired_count(m) or 0, e.get("progress") or 0
                    path, n, eps = media_local.get(mid, (None, None, {}))
                    need = [k for k in range(p + 1, aired + 1) if k not in eps]
                    strip = [(k, "watched" if k <= p else "have" if k in eps else "need") for k in range(1, aired + 1)]
                    if need:
                        nxt = m.get("nextAiringEpisode") or {}
                        detail = f"Episode{'s' if len(need) > 1 else ''} {episode_ranges(need)}  ·  you're on {p}"
                        if nxt.get("episode"):
                            detail += f"  ·  ep {nxt['episode']} airs {when(nxt['airingAt'])}"
                        watching.append(dict(mid=mid, media=m, title=media_title(m), detail=detail, path=path, strip=strip,
                                             query=self.query(m, need), badge=(f"{len(need)} to get", "CURRENT")))
                elif st == "PLANNING" and mid not in library_ids and m.get("status") in ("FINISHED", "RELEASING"):
                    parts = [FORMAT_TEXT.get(m.get("format"), ""), season_label(m),
                             f"{m['episodes']} episodes" if m.get("episodes") else "",
                             STATUS_TEXT.get(m.get("status"), "")]
                    planning.append(dict(mid=mid, media=m, title=media_title(m), path=None,
                                         detail="  ·  ".join(x for x in parts if x), query=self.query(m, []),
                                         badge=("Planning", "PLANNING")))

        # Holes in seasons you've started downloading (works without an account too)
        details = details_by_id()
        seen = {r["mid"] for r in watching}
        for path, idx in self.library.indexes().items():
            for n, sid in enumerate((idx or {}).get("seasons") or [], 1):
                eps = idx["local"].get(sid, {}) if sid else {}
                if not sid or sid in seen or not eps:
                    continue
                m = ((a.entries.get(sid) or {}).get("media") if connected else None) or details.get(sid)
                aired = aired_count(m) if m else None
                miss = [k for k in range(1, (aired or 0) + 1) if k not in eps]
                if miss:
                    prog = ((a.entry(sid) or {}).get("progress") or 0) if connected else 0
                    strip = [(k, "have" if k in eps else "watched" if k <= prog else "need") for k in range(1, (aired or 0) + 1)]
                    gaps.append(dict(mid=sid, media=m, title=f"{Path(path).name}  ·  Season {n}", path=path, strip=strip,
                                     detail=f"Missing episode{'s' if len(miss) > 1 else ''} {episode_ranges(miss)}",
                                     query=self.query(m, miss), badge=(f"{len(miss)} missing", "PAUSED")))

        # versions with fewer episodes than the others (Bikini Warriors' Hyper Sexy version: 6 of 12)
        versions = []
        for path, idx in self.library.indexes().items():
            for sid, vers in ((idx or {}).get("versions") or {}).items():
                every = set().union(*map(set, vers.values()))
                m = ((a.entries.get(sid) or {}).get("media") if connected else None) or details.get(sid)
                t = (m or {}).get("title") or {}
                base = t.get("romaji") or t.get("english") or Path(path).name
                for name, have in vers.items():
                    miss = sorted(every - set(have))
                    if not miss:
                        continue
                    words = re.sub(r"(?i)\b(version|ver|edition)\b", "", name).strip()
                    strip = [(k, "have" if k in have else "need") for k in sorted(every)]
                    versions.append(dict(mid=sid, media=m, title=f"{Path(path).name}  ·  {name}", path=path,
                                         strip=strip, detail=f"{len(have)} of {len(every)}  ·  missing "
                                                             f"{episode_ranges(miss)}",
                                         query=f"{base} {words}".strip(),
                                         badge=(f"{len(miss)} missing", "PAUSED")))

        body = QWidget()
        col = QVBoxLayout(body)
        col.setContentsMargins(0, 0, 8, 0)
        col.setSpacing(12)
        if not connected:
            col.addWidget(self.connect_prompt("Connect your AniList account to see new episodes for the shows "
                                              "you're watching and the shows on your Planning list."))
        else:
            self.section(col, "NEW EPISODES FOR SHOWS YOU'RE WATCHING", watching,
                         "You have every aired episode of the shows you're watching.")
            if show_all:
                self.section(col, "ON YOUR PLANNING LIST, NOT IN YOUR LIBRARY", planning,
                             "Everything on your Planning list is already in your library.")
        self.section(col, "GAPS IN YOUR LIBRARY", gaps,
                     "No gaps found. (Shows only appear here once their AniList info is known; "
                     "open a show once or connect your account.)")
        if versions:
            self.section(col, "INCOMPLETE VERSIONS", versions, "")
        col.addStretch(1)
        parts = [f"{len(watching)} watching"] + ([f"{len(planning)} planned"] if show_all else [])
        self.subtitle.setText("  ·  ".join(parts + [f"{len(gaps)} with gaps"]) if connected else "Gaps in your library")
        self.set_body(body)
        self.on_downloads_changed()

    def on_downloads_changed(self):
        """Shows qBittorrent is downloading episodes of: "Downloading 5 · 43%"."""
        if not self.dl_labels:
            return
        by_mid = {}
        for t in (self.downloads.torrents.values() if self.downloads else ()):
            if t.get("mid") in self.dl_labels:
                by_mid.setdefault(t["mid"], []).append(t)
        for mid, labels in self.dl_labels.items():
            ts = by_mid.get(mid) or []
            text = ""
            if ts:
                eps = sorted({e for t in ts for e in ([t["episode"]] if t.get("episode") else t.get("episodes") or [])})
                frac = sum(float(t.get("progress", 0)) for t in ts) / len(ts)
                what = f"episode{'s' if len(eps) > 1 else ''} {episode_ranges(eps)}" if eps else "batch"
                text = f"Downloading {what} · {int(frac * 100)}%"
            for lbl in labels:
                lbl.setText(text)
                lbl.setVisible(bool(text))

    def query(self, m, eps):
        t = (m or {}).get("title") or {}
        q = t.get("romaji") or t.get("english") or ""
        return f"{q} {eps[0]:02d}" if len(eps) == 1 else q

    def section(self, col, title, rows, empty):
        col.addSpacing(8)
        head = QHBoxLayout()
        head.setSpacing(10)
        head.addWidget(row_title(title[0] + title[1:].lower().replace("planning", "Planning")))
        if rows:
            head.addWidget(label(str(len(rows)), "faint"))
        head.addStretch(1)
        col.addLayout(head)
        if not rows:
            box = card()
            v = QHBoxLayout(box)
            v.setContentsMargins(16, 14, 16, 14)
            v.setSpacing(12)
            v.addWidget(glyph_label("task_alt", C["ok"], 22))
            v.addWidget(label(empty, "muted", wrap=True), 1)
            col.addWidget(box)
            return
        grid = ResponsiveGrid(min_col=360, max_cols=3, spacing=14)
        for r in sorted(rows, key=lambda r: r["title"].lower()):
            grid.add(self.row(r))
        col.addWidget(grid)

    def row(self, r):
        title = media_title(r["media"]) if r["media"] else r["title"]
        c = TodoCard(r, title, self)
        c.clicked.connect(lambda mid=r["mid"], t=title: self.open_media.emit(mid, t, None))
        url = ((r["media"] or {}).get("coverImage") or {}).get("extraLarge")
        if url:
            self.slots.setdefault(r["mid"], (url, []))[1].append(c)
        return c


