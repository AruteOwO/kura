def wrapped_inputs(account):
    """Everything wrapped.compute needs, read from Kura's files."""
    adult = acct.ADULT["on"]
    cr = _read_json(crunchy.HISTORY_FILE) if crunchy and not adult else {}
    return dict(entries=account.view(), score_format=account.score_format or "POINT_10",
                watchlog=_read_json(SCRIPT_DIR / ("kura_watch_adult.json" if adult else "kura_watch.json")),
