class Heatmap(QWidget):
    """Days you changed your list, like GitHub's contribution chart (hover a day for its count)."""
    CELL, GAP, TOP = 13, 4, 18
    LEVELS = [(0, "#20242e"), (1, "#3a3378"), (10, "#5a4bd0"), (40, "#8a78ff"), (150, "#c7b8ff")]

    def __init__(self):
        super().__init__()
        self.days = {}
        self.cells = []
        self.setMouseTracking(True)
        self.setFixedHeight(self.TOP + 7 * (self.CELL + self.GAP) + 26)
        self.setMinimumWidth(300)

    def set(self, days):
        self.days = dict(days)
        self.update()

    def color(self, n):
        c = self.LEVELS[0][1]
        for lim, col in self.LEVELS:
            if n >= lim:
                c = col
        return QColor(c)

    def paintEvent(self, _):
        from datetime import date as _date, timedelta
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        step = self.CELL + self.GAP
        weeks = max(8, (self.width() + self.GAP) // step)
        end = _date.today()
        row_of = lambda d: (d.weekday() + 1) % 7   # Sunday on top
        start = end - timedelta(days=(weeks - 1) * 7 + row_of(end))
        self.cells = []
        f = QFont(self.font())
        f.setPixelSize(11)
        p.setFont(f)
        d, i = start, 0
        while d <= end:
            col, row = i // 7, row_of(d)
            x, y = col * step, self.TOP + row * step
            if row == 0 and d.day <= 7 and col < weeks - 1:   # a month starts in this column
                p.setPen(QColor(C["faint"]))
                p.drawText(QPointF(x, 11), d.strftime("%b"))
            n = self.days.get(d, 0)
            p.setPen(Qt.NoPen)
            p.setBrush(self.color(n))
            rect = QRectF(x, y, self.CELL, self.CELL)
            p.drawRoundedRect(rect, 3.5, 3.5)
            self.cells.append((rect, d, n))
            d += timedelta(days=1)
            i += 1
        # legend
        y = self.TOP + 7 * step + 8
        x = self.width() - 5 * (11 + 4) - 34
        p.setPen(QColor(C["faint"]))
        p.drawText(QRectF(x - 40, y - 1, 34, 13), Qt.AlignRight | Qt.AlignVCenter, "Less")
        for k, (_, col) in enumerate(self.LEVELS):
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(col))
            p.drawRoundedRect(QRectF(x + k * 15, y, 11, 11), 3, 3)
        p.setPen(QColor(C["faint"]))
        p.drawText(QRectF(x + 5 * 15 + 2, y - 1, 34, 13), Qt.AlignLeft | Qt.AlignVCenter, "More")

    def mouseMoveEvent(self, e):
        pos = e.position()
        for rect, d, n in self.cells:
            if rect.contains(pos):
                what = f"{n} list update{'s' if n != 1 else ''}" if n else "No activity"
                QToolTip.showText(e.globalPosition().toPoint(), f"{d.strftime('%a %d %b %Y').replace(' 0', ' ')} · {what}", self)
                return
        QToolTip.hideText()


class Donut(QWidget):
    """Ring chart + legend: [(name, count, colour)]."""
    RING = 150

    def __init__(self):
        super().__init__()
        self.items, self.caption = [], "entries"
        self.setFixedHeight(self.RING + 20)
        self.setMinimumWidth(300)

    def set(self, items, caption="entries"):
        self.items, self.caption = [i for i in items if i[1]], caption
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        total = sum(c for _, c, _ in self.items) or 1
        size = max(110, min(self.RING, self.width() - 200))   # smaller ring in a narrow card
        ring = QRectF(12, (self.height() - size) / 2 + 8, size - 16, size - 16)
        pen = QPen(QColor("#22262f"), 15)
        p.setPen(pen)
        p.drawEllipse(ring)
        angle = 90 * 16
        gap = 3 * 16 if len(self.items) > 1 else 0
        for name, count, color in self.items:
            span = count / total * 360 * 16
            pen = QPen(QColor(color), 15)
            pen.setCapStyle(Qt.FlatCap)
            p.setPen(pen)
            p.drawArc(ring, int(angle - gap / 2), -int(max(span - gap, 16)))
            angle -= span
        f = QFont(self.font())
        f.setPixelSize(24)
        f.setWeight(QFont.Bold)
        p.setFont(f)
        p.setPen(QColor(C["text"]))
        p.drawText(ring.adjusted(0, -10, 0, -10), Qt.AlignCenter, _num(total))
        f2 = QFont(self.font())
        f2.setPixelSize(11)
        p.setFont(f2)
        p.setPen(QColor(C["muted"]))
        p.drawText(ring.adjusted(0, 30, 0, 30), Qt.AlignCenter, self.caption)
        # legend
        x0 = size + 18
        rows = len(self.items)
        row_h = 30
        y0 = (self.height() - rows * row_h) / 2
        f3 = QFont(self.font())
        f3.setPixelSize(13)
        for k, (name, count, color) in enumerate(self.items):
            y = y0 + k * row_h
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(color))
            p.drawEllipse(QRectF(x0, y + row_h / 2 - 4.5, 9, 9))
            p.setFont(f3)
            p.setPen(QColor(C["text"]))
            right = self.width() - 4
            pct_w, num_w = 40, 52
            name_w = right - pct_w - num_w - (x0 + 18)
            p.drawText(QRectF(x0 + 18, y, name_w, row_h), Qt.AlignVCenter | Qt.AlignLeft,
                       QFontMetrics(f3).elidedText(name, Qt.ElideRight, int(name_w)))
            p.setPen(QColor(C["faint"]))
            p.drawText(QRectF(right - pct_w, y, pct_w, row_h), Qt.AlignVCenter | Qt.AlignRight, f"{round(count / total * 100)}%")
            bf = QFont(f3)
            bf.setWeight(QFont.DemiBold)
            p.setFont(bf)
            p.setPen(QColor(C["text"]))
            p.drawText(QRectF(right - pct_w - num_w, y, num_w, row_h), Qt.AlignVCenter | Qt.AlignRight, _num(count))
            if k < rows - 1:
                p.setPen(QPen(QColor(255, 255, 255, 14), 1))
                p.drawLine(QPointF(x0, y + row_h), QPointF(right, y + row_h))


class BarList(QWidget):
    """Rows of name · bar · number (· faint extra). rows = [(name, value, right text, extra, tooltip)]."""
    ROW = 30

    def __init__(self, colors=("#7c6cff", "#b58cff"), columns=1, name_w=118, right_w=78):
        super().__init__()
        self.colors, self.columns, self.name_w, self.right_w = colors, columns, name_w, right_w
        self.rows, self.vmax, self.hit = [], 1, []
        self.setMouseTracking(True)
        self.setMinimumWidth(260)

    def set(self, rows, vmax=None):
        self.rows = rows
        self.vmax = vmax or max([r[1] for r in rows] + [1])
        per = -(-len(rows) // self.columns) if rows else 1
        self.setFixedHeight(max(1, per) * self.ROW)
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        if not self.rows:
            p.setPen(QColor(C["faint"]))
            p.drawText(self.rect(), Qt.AlignLeft | Qt.AlignVCenter, "Nothing yet")
            return
        cols = self.columns
        gutter = 34
        cw = (self.width() - (cols - 1) * gutter) / cols
        per = -(-len(self.rows) // cols)
        f = QFont(self.font())
        f.setPixelSize(13)
        bold = QFont(f)
        bold.setWeight(QFont.DemiBold)
        small = QFont(self.font())
        small.setPixelSize(11)
        fm = QFontMetrics(f)
        self.hit = []
        for k, (name, value, right, extra, tip) in enumerate(self.rows):
            c, r = k // per, k % per
            x, y = c * (cw + gutter), r * self.ROW
            p.setFont(f)
            p.setPen(QColor(C["text"]))
            p.drawText(QRectF(x, y, self.name_w, self.ROW), Qt.AlignVCenter | Qt.AlignLeft,
                       fm.elidedText(name, Qt.ElideRight, self.name_w - 6))
            bx = x + self.name_w + 8
            bw = cw - self.name_w - 8 - self.right_w - 12
            track = QRectF(bx, y + self.ROW / 2 - 4.5, max(bw, 10), 9)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor("#242833"))
            p.drawRoundedRect(track, 4.5, 4.5)
            frac = max(0.0, min(1.0, value / self.vmax if self.vmax else 0))
            if frac > 0:
                fill = QRectF(track.x(), track.y(), max(9.0, track.width() * frac), track.height())
                g = QLinearGradient(fill.topLeft(), fill.topRight())
                g.setColorAt(0, QColor(self.colors[0]))
                g.setColorAt(1, QColor(self.colors[1]))
                p.setBrush(g)
                p.drawRoundedRect(fill, 4.5, 4.5)
            rx = x + cw - self.right_w
            p.setFont(bold)
            p.setPen(QColor(C["text"]))
            rw = QFontMetrics(bold).horizontalAdvance(right)
            p.drawText(QRectF(rx, y, self.right_w, self.ROW), Qt.AlignVCenter | Qt.AlignLeft, right)
            if extra:
                p.setFont(small)
                p.setPen(QColor(C["faint"]))
                p.drawText(QRectF(rx + rw + 6, y, self.right_w - rw - 6, self.ROW), Qt.AlignVCenter | Qt.AlignLeft, extra)
            self.hit.append((QRectF(x, y, cw, self.ROW), tip))

    def mouseMoveEvent(self, e):
        for rect, tip in self.hit:
            if tip and rect.contains(e.position()):
                QToolTip.showText(e.globalPosition().toPoint(), tip, self)
                return
        QToolTip.hideText()


class Histogram(QWidget):
    """Vertical bars with the count above and a label below. items = [(label, value, tooltip)]."""

    def __init__(self, colors=("#4a3fb8", "#b58cff"), height=170):
        super().__init__()
        self.colors, self.items, self.hit = colors, [], []
        self.setFixedHeight(height)
        self.setMinimumWidth(240)
        self.setMouseTracking(True)

    def set(self, items):
        self.items = items
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        n = len(self.items)
        if not n:
            p.setPen(QColor(C["faint"]))
            p.drawText(self.rect(), Qt.AlignCenter, "Nothing yet")
            return
        vmax = max([v for _, v, _ in self.items] + [1])
        w, h = self.width(), self.height()
        slot = w / n
        gap = max(2.0, min(10.0, slot * 0.22))
        bw = slot - gap
        top, bottom = 18, 20
        avail = h - top - bottom
        f = QFont(self.font())
        f.setPixelSize(11)
        p.setFont(f)
        fm = QFontMetrics(f)
        label_every = max(1, int(-(-max(fm.horizontalAdvance(l) for l, _, _ in self.items) // max(slot, 1))) + (1 if slot < 26 else 0))
        self.hit = []
        for k, (lab, v, tip) in enumerate(self.items):
            x = k * slot + gap / 2
            bh = max(3.0, avail * v / vmax) if v else 3.0
            rect = QRectF(x, top + avail - bh, bw, bh)
            g = QLinearGradient(rect.bottomLeft(), rect.topLeft())
            g.setColorAt(0, QColor(self.colors[0]))
            g.setColorAt(1, QColor(self.colors[1]))
            p.setPen(Qt.NoPen)
            p.setBrush(g if v else QColor("#242833"))
            rad = min(6.0, bw / 2.5)
            p.drawRoundedRect(rect, rad, rad)
            if v and bw >= 16:
                p.setPen(QColor(C["muted"]))
                p.drawText(QRectF(x - 6, rect.top() - 16, bw + 12, 14), Qt.AlignCenter, _num(v))
            if k % label_every == 0:
                p.setPen(QColor(C["faint"]))
                p.drawText(QRectF(k * slot - 10, h - bottom + 4, slot + 20, 14), Qt.AlignCenter, lab)
            self.hit.append((QRectF(k * slot, 0, slot, h), tip or f"{lab}: {_num(v)}"))

    def mouseMoveEvent(self, e):
        for rect, tip in self.hit:
            if rect.contains(e.position()):
                QToolTip.showText(e.globalPosition().toPoint(), tip, self)
                return
        QToolTip.hideText()


