        v.addWidget(self.text, 1)
        acts = QHBoxLayout()
        self.info = label("", "faint")
        acts.addWidget(self.info)
        acts.addStretch(1)
        for text, fn in (("Copy", self.copy), ("Open file", self.open_file), ("Show in folder", self.reveal),
                         ("Clear…", self.clear)):
            b = QPushButton(text)
            b.clicked.connect(fn)
            acts.addWidget(b)
        v.addLayout(acts)
        self.timer = QTimer(self, interval=1500, timeout=self.load)

    def path(self):
        return next(p for k, _, p in self.LOGS if k == self.pick.value())

    def switch(self, key):
        self.settings["log_pick"] = key
        save_settings(self.settings)
        self.load(force=True)

    def showEvent(self, e):
        super().showEvent(e)
        self.load(force=True)
        self.timer.start()

    def hideEvent(self, e):
        super().hideEvent(e)
        self.timer.stop()

    def load(self, force=False):
        p = self.path()
        try:
            st = p.stat()
            sig = (str(p), st.st_size, st.st_mtime)
        except OSError:
            sig = (str(p), None, None)
        if sig == self.sig and not force:
            return
        self.sig = sig
        if sig[1] is None:
            self.text.setPlainText("")
            self.info.setText("Nothing written here yet.")
            return
        with open(p, "rb") as f:
            if sig[1] > self.TAIL:
                f.seek(sig[1] - self.TAIL)
                f.readline()   # start at a whole line
            raw = f.read().decode("utf-8", "replace")
        lines = raw.splitlines()
        q = self.find.text().strip().lower()
        if q:
            lines = [ln for ln in lines if q in ln.lower()]
        if self.problems.isChecked():   # with the organizer's "===== date =====" run line above them
            kept, header = [], None
            for ln in lines:
                if ln.startswith("===== "):
                    header = ln
                elif self.PROBLEM.search(ln):
                    if header:
                        kept.append(header)
                        header = None
                    kept.append(ln)
            lines = kept
        bar = self.text.verticalScrollBar()
        at_end = bar.value() >= bar.maximum() - 4
        keep = bar.value()
        self.text.setPlainText("\n".join(lines))
        if at_end or force:
            bar.setValue(bar.maximum())
        else:
            bar.setValue(keep)
        cut = "  ·  only the newest part of a big file" if sig[1] > self.TAIL else ""
        self.info.setText(f"{p.name}  ·  {fmt_bytes(sig[1])}  ·  changed "
                          f"{datetime.fromtimestamp(sig[2]).strftime('%d %b %H:%M:%S')}  ·  {len(lines)} lines{cut}")

    def copy(self):
        QApplication.clipboard().setText(self.text.toPlainText())

    def open_file(self):
        if self.path().exists() and os.name == "nt":
            os.startfile(str(self.path()))

    def reveal(self):
        if self.path().exists():
            subprocess_open_select(self.path())

    def clear(self):
        p = self.path()
        if p.exists() and QMessageBox.question(self, APP_NAME, f"Empty {p.name}?") == QMessageBox.Yes:
            try:
                with open(p, "w", encoding="utf-8"):
                    pass
            except OSError as e:
                QMessageBox.warning(self, APP_NAME, f"Couldn't empty it ({e}).")
            self.load(force=True)

CAPTURE_IMAGES = (".png", ".jpg", ".jpeg", ".webp", ".avif")
CAPTURE_VIDEOS = (".mp4", ".webm", ".mkv", ".gif")


def capture_thumb(path, width=320):
    """A small picture of a capture (videos: a frame from 1 s in, kept in cover_cache/captures)."""
    path = Path(path)
    ext = path.suffix.lower()
    try:
        if ext in (".png", ".jpg", ".jpeg", ".webp", ".gif"):
            from PySide6.QtGui import QImageReader
            r = QImageReader(str(path))
            size = r.size()
            if size.isValid() and size.width() > width:
                r.setScaledSize(QSize(width, round(size.height() * width / size.width())))
            img = r.read()
            if not img.isNull():
                return img
        if ext == ".avif" or ext in (".png", ".jpg", ".jpeg", ".webp"):
            from PIL import Image
            pil = Image.open(path).convert("RGB")
            pil.thumbnail((width, width))
            return QImage(pil.tobytes("raw", "RGB"), pil.width, pil.height, pil.width * 3, QImage.Format_RGB888).copy()
        if ext in (".mp4", ".webm", ".mkv") and subs_mod.ffmpeg_installed():
            import hashlib
            out = COVER_DIR / "captures" / (hashlib.sha1(f"{path}|{path.stat().st_mtime}".encode()).hexdigest()[:20] + ".jpg")
            if not out.exists():
                out.parent.mkdir(parents=True, exist_ok=True)
                cap_mod._run([str(subs_mod.FFMPEG), "-v", "error", "-y", "-ss", "1", "-i", str(path), "-frames:v", "1",
                              "-vf", f"scale={width}:-2", str(out)], timeout=60)
            img = QImage(str(out))
            return None if img.isNull() else img
    except Exception:
        return None
    return None


