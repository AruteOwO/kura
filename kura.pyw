def steady_width(view):
    """A scroll view's usable width as if its scrollbar were always there. Sizing cards from the viewport's width
    looped when the content was about one screen tall (the hentai Library's 13 shows): the scrollbar came, the cards
    shrank and fit, the scrollbar went, they grew... the covers moved around nonstop."""
    sb = view.verticalScrollBar()
    bar = sb.sizeHint().width() if view.verticalScrollBarPolicy() != Qt.ScrollBarAlwaysOff else 0
    return view.width() - 2 * view.frameWidth() - bar


