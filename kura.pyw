def build_qss():
    # Dropdown arrow: style sheets can only show images from files
    chevron = Path(tempfile.gettempdir()) / "kura_chevron.svg"
    try:
        chevron.write_text(f"<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6'><path d='M1 1l4 4 4-4' "
                           f"stroke='{C['muted']}' stroke-width='1.6' fill='none' stroke-linecap='round' "
                           f"stroke-linejoin='round'/></svg>", encoding="utf-8")
    except OSError:
        pass
    return fill_qss(QSS.replace("@chevron", chevron.as_posix()))


def fill_qss(qss):
    for key in sorted(C, key=len, reverse=True):   # longest first so @surface2 isn't hit by @surface
        qss = qss.replace("@" + key, C[key])
    a = QColor(C["accent"])   # tints written as the purple's rgba follow the side's accent
    qss = qss.replace("rgba(124, 108, 255,", f"rgba({a.red()}, {a.green()}, {a.blue()},")
    if C["accent"] != "#7c6cff":   # the primary button's purple shades → the same shades of this accent
        for purple, factor in (("#8f80ff", 112), ("#6a59ee", 88), ("#9d90ff", 122), ("#7767f4", 96), ("#6656e6", 84)):
            qss = qss.replace(purple, (a.lighter(factor) if factor >= 100 else a.darker(round(10000 / factor))).name())
        qss = qss.replace("#3a3566", a.darker(300).name()).replace("#8f8ab5", QColor(C["accent_hi"]).darker(140).name())
    return qss


class AccentTint(QObject):
    """The 18+ side's accent without re-styling the whole app (setStyleSheet on the app took ~2 s for Kura's
    ~2,500 widgets). The app's style sheet stays as it is; only widgets whose rules use the accent (buttons
    like Primary, inputs, selections, menus) get those few declarations in their own sheet, put first so
    the widget's own rules still win. Widgets made while on that side are caught as they're polished."""
    MARK = "/*kura-accent*/"
    ACCENT_RE = re.compile(r"@accent|124, 108, 255|#8f80ff|#6a59ee|#9d90ff|#7767f4|#6656e6|#3a3566|#8f8ab5")

    def __init__(self):
        super().__init__()
        self.rules = []   # [(selector, declarations)] from QSS, only the accent ones
        self.targets = set()   # (class, objectName or None) those rules can match
        for sel, body in re.findall(r"([^{}]+)\{([^}]*)\}", QSS):
            decl = "; ".join(" ".join(d.split()) for d in body.split(";") if self.ACCENT_RE.search(d))
            if not decl:
                continue
            sel = " ".join(sel.split())
            self.rules.append((sel, decl))
            for part in sel.split(","):
                m = re.match(r"\s*(Q\w+)(?:#(\w+))?", part)
                if m:
                    self.targets.add((m.group(1), m.group(2)))
        self.sheet = ""
        self.on = False

    def matches(self, w):
        name = w.objectName()
        return any((n is None or n == name) and w.inherits(cls) for cls, n in self.targets)

    def tint(self, w):
        own = w.styleSheet()
        base = own.split(self.MARK, 1)[1] if self.MARK in own else own
        new = (self.sheet + self.MARK + base) if self.on else base
        if new != own:
            w.setStyleSheet(new)

    def apply(self, on):
        """Switch every matching widget to the accent in C (on) or back to the app's (off)."""
        self.on = on
        self.sheet = fill_qss(" ".join(f"{s} {{ {d} }}" for s, d in self.rules)) if on else ""
        app = QApplication.instance()
        for w in app.allWidgets():
            if (on and self.matches(w)) or (not on and self.MARK in w.styleSheet()):
                self.tint(w)
        if on:
            app.installEventFilter(self)
        else:
            app.removeEventFilter(self)

    def eventFilter(self, obj, e):
        t = e.type()
        if (t == QEvent.Polish or t == QEvent.StyleChange) and isinstance(obj, QWidget) \
                and self.MARK not in obj.styleSheet() and self.matches(obj):
            QTimer.singleShot(0, lambda w=obj: self.on and shiboken6.isValid(w) and self.tint(w))
        return False


