    def close_player(self):
        if self.player is None:
            return
        view, self.player = self.player, None
        if self.isFullScreen() and self.player_overlay is not None:
            self.showNormal()
        view.stop()
        self.unembed(view)
        if self.player_popout is not None:
            self.player_popout.take_view()
            self.player_popout.close()
            self.player_popout.deleteLater()
            self.player_popout = None
        view.deleteLater()
        self.now_playing.builtin_closed()

