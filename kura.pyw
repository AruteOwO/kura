    def switch_filter_profile(self, adult):
        """The hentai side has its own torrent filter profile ("Hentai", made from the defaults the first time).
        Also run at startup (Kura always opens on the Anime side): quitting on the hentai side used to leave its
        profile active, and the next switch then remembered it as the Anime one."""
        H = self.HENTAI_PROFILE
        try:
            p = tor.load_profiles()
            if p is None:
                return
            enabled, active, profiles = p
            start = (active, list(profiles))
            if "18+" in profiles and H not in profiles:   # its first name
                profiles = {(H if n == "18+" else n): f for n, f in profiles.items()}
                active = H if active == "18+" else active
            if self.settings.get("anime_filter_profile") in ("18+", H):
                self.settings.pop("anime_filter_profile")
            if adult:
                if active != H:
                    self.settings["anime_filter_profile"] = active
                profiles.setdefault(H, tor.default_filters())
                target = H
            else:
                back = self.settings.get("anime_filter_profile")
                if back not in profiles:
                    back = next((n for n in profiles if n != H), None)
                if back is None:
                    back = "Default"
                    profiles[back] = tor.default_filters()
                target = back if active == H else active
            if (target, list(profiles)) != start:
                tor.save_profiles(enabled, target, profiles)
        except Exception as e:
            klog.warning(f"Filter profile switch: {e}")

