        self.initial = (name or "?")[:1].upper()
        self.since.setText(since)
        self.pill1.setText(pill1)
        self.pill2.setText(pill2)
        for w in (self.name, self.since, self.pill1, self.pill2):
            w.setVisible(bool(w.text()))
            w.adjustSize()
        self.place()
