def clear_layout(lay):
    """Remove and delete everything in a layout (nested layouts too)."""
    while lay.count():
        it = lay.takeAt(0)
        if it.widget() is not None:
            it.widget().deleteLater()
        elif it.layout() is not None:
            clear_layout(it.layout())

CR_MISS_DAYS = 14   # a title AniList search couldn't find is searched again after this (or "Search again")


def recent_miss(mine):
    return bool(mine and mine.get("miss") and time.time() - mine["miss"] < CR_MISS_DAYS * 86400)


class CrunchySync(QThread):
    """Reads new Crunchyroll history (and the watchlist), then matches every Crunchyroll season
    to AniList: your own earlier choices, then Kura's matcher (no requests), then an AniList search."""
    progress = Signal(str)
    done = Signal(object, str)

    def __init__(self, matcher, mapping, watchlist):
        super().__init__()
        self.matcher, self.mapping, self.want_watchlist = matcher, mapping, watchlist

    def run(self):
        try:
            self.done.emit(self.work(), "")
        except crunchy.CRAuthError as e:
            self.done.emit(None, "auth:" + str(e))
        except Exception as e:
            self.done.emit(None, str(e) or type(e).__name__)

    def find(self, title, season, eps, alts):
        """{AniList id: {episodes}} for one Crunchyroll season, from Kura's matcher (no requests).
        Each episode is matched on its own, so continuous numbering lands on the right season."""
        for t, sn in ((title, None), *((x, season) for x in alts)):
            if not t:
                continue
            by = {}
            for ep in eps:
                mid, e = self.matcher.match(t, sn, ep)
                if mid and e:
                    by.setdefault(mid, set()).add(e)
            if by:
                return by
        return {}

    def search(self, title, movie):
        """AniList's best result, only when one of its titles really is this title
        (a near-miss goes to "Couldn't match" for you to pick, rather than a wrong guess)."""
        import difflib
        results = ((org.anilist(QUERY_PICK, {"s": title}) or {}).get("Page") or {}).get("media") or []
        key = tor.norm(title)

        def titles(m):
            t = m.get("title") or {}
            return [tor.norm(x) for x in (t.get("english"), t.get("romaji"), *(m.get("synonyms") or [])) if x]

        def fits(m):
            return (m.get("format") == "MOVIE") == bool(movie)
        best, score = None, 0.0
        for m in results:
            ratio = max((1.0 if x == key else difflib.SequenceMatcher(None, x, key).ratio()) for x in titles(m) or [""])
            ratio += 0.01 * fits(m)   # same score: the right kind (TV vs movie) wins
            if ratio > score:
                best, score = m, ratio
        return best if score >= 0.92 else None

    def work(self):
        cr = crunchy.Crunchyroll()
        self.progress.emit("Reading your Crunchyroll history…")
        store, new = cr.sync_history(lambda n, total: self.progress.emit(
            f"Reading your Crunchyroll history…  {total} episodes"))
        groups = crunchy.seasons(store)
        watch = []
        if self.want_watchlist:
            self.progress.emit("Reading your Crunchyroll watchlist…")
            watch = cr.watchlist()
        found, media = {}, {}   # automatic AniList matches, remembered for the next syncs
        for i, g in enumerate(groups):
            eps = sorted(g["episodes"])
            mine = self.mapping.get(g["season_id"])
            missed = recent_miss(mine)
            if mine is not None and not missed and "miss" not in mine:
                g["by_mid"] = {mine["mid"]: set(eps)} if mine.get("mid") else {}
                g["how"] = ("auto" if mine.get("auto") else "yours") if mine.get("mid") else "skipped"
                continue
            alts = [g["series_title"]] if g["series_title"] != g["season_title"] else []
            by = self.find(g["season_title"], g["season_number"], eps, alts)   # cheap: no requests
            if not by and not missed and not self.isInterruptionRequested():
                self.progress.emit(f"Looking up “{g['season_title']}” on AniList…  ({i + 1} of {len(groups)})")
                m = self.search(g["season_title"], g["movie"])
                if not m and alts and (g["season_number"] or 1) == 1:
                    m = self.search(g["series_title"], g["movie"])
                if m:
                    by = {m["id"]: set(eps)}
                    media[m["id"]] = m
                    found[g["season_id"]] = {"mid": m["id"], "title": g["season_title"], "auto": True}
                else:   # remembered, so the next syncs don't search AniList for it again
                    found[g["season_id"]] = {"mid": None, "title": g["season_title"], "auto": True,
                                             "miss": time.time()}
            g["by_mid"], g["how"] = by, "auto"
        watched_series = {g["series_id"] for g in groups}
        for w in watch:
            if w["series_id"] in watched_series:
                continue
            mine = self.mapping.get("series:" + w["series_id"])
            missed = recent_miss(mine)
            if mine is not None and not missed and "miss" not in mine:
                w["mid"] = mine.get("mid")
                continue
            w["mid"] = self.matcher.match(w["title"], None, 1)[0]
            if not w["mid"] and not missed:
                self.progress.emit(f"Looking up “{w['title']}” on AniList…")
                m = self.search(w["title"], False)
                w["mid"] = m["id"] if m else None
                found["series:" + w["series_id"]] = (
                    {"mid": m["id"], "title": w["title"], "auto": True} if m else
                    {"mid": None, "title": w["title"], "auto": True, "miss": time.time()})
                if m:
                    media[m["id"]] = m
        if found:
            mapping = crunchy.load_map()
            # never over your own choices; a fresh search result replaces an old miss
            mapping.update({k: v for k, v in found.items() if k not in mapping or "miss" in mapping[k]})
            crunchy.save_map(mapping)
        mids = {m for g in groups for m in g["by_mid"]} | {w["mid"] for w in watch if w.get("mid")}
        self.progress.emit("Getting show details from AniList…")
        media.update(fetch_details(sorted(m for m in mids if m not in media)))
        return {"groups": groups, "watch": watch, "media": media, "new": new,
                "episodes": len(store.get("episodes", {}))}


class CrunchyApply(QThread):
    """Sends the ticked changes to AniList one by one (the shared limiter keeps it polite)."""
    step = Signal(int, int, str)
    done = Signal(int, list)

    def __init__(self, token, jobs):
        super().__init__()
        self.token, self.jobs = token, jobs

    def run(self):
        ok, errors = 0, []
        for i, (mid, fields, title) in enumerate(self.jobs):
            if self.isInterruptionRequested():
                break
            self.step.emit(i + 1, len(self.jobs), title)
            try:
                acct.gql(acct.save_mutation(fields), {"mediaId": mid, **fields}, token=self.token)
                ok += 1
            except acct.AuthError as e:
                errors.append(f"AniList sign-in: {e}")
                break
            except Exception as e:
                errors.append(f"{title}: {e}")
        self.done.emit(ok, errors)


QUERY_PICK = ("query ($s: String) { Page(perPage: 15) { media(search: $s, type: ANIME, sort: SEARCH_MATCH) { "
              "id format status episodes season seasonYear siteUrl title { romaji english } synonyms "
              "coverImage { extraLarge } nextAiringEpisode { episode airingAt } } } }")


class AniListPicker(QDialog):
    """Search AniList and pick the right show by hand."""

    def __init__(self, parent, title, query):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(560, 480)
        self.chosen, self.searcher = None, None
        v = QVBoxLayout(self)
        v.setContentsMargins(20, 18, 20, 18)
        v.setSpacing(10)
        v.addWidget(label(title, "h2"))
        self.box = QLineEdit(query)
        self.box.setObjectName("search")
        self.box.setPlaceholderText("Search AniList, then press Enter")
        self.box.returnPressed.connect(self.search)
        v.addWidget(self.box)
        self.results = QListWidget()
        self.results.setObjectName("presets")   # clear highlight on the picked show
        self.results.setSpacing(3)
        self.results.itemDoubleClicked.connect(lambda *_: self.accept_pick())
        v.addWidget(self.results, 1)
        self.status = label("", "faint")
        v.addWidget(self.status)
        row = QHBoxLayout()
        row.addStretch(1)
        cancel = QPushButton("Cancel")
        cancel.clicked.connect(self.reject)
        use = QPushButton("Use this show")
        use.setObjectName("primary")
        use.clicked.connect(self.accept_pick)
        row.addWidget(cancel)
        row.addWidget(use)
        v.addLayout(row)
        QTimer.singleShot(0, self.search)

    def search(self):
        text = self.box.text().strip()
        if not text or self.searcher is not None:
            return
        self.status.setText("Searching…")
        self.searcher = BgCall(lambda: (acct.gql(QUERY_PICK, {"s": text}).get("Page") or {}).get("media") or [])
        self.searcher.done.connect(self.on_results)
        self.searcher.start()

    def on_results(self, media, err):
        if self.searcher is not None:
            self.searcher.wait()
        self.searcher = None
        self.results.clear()
        for m in media or []:
            bits = [FORMAT_TEXT.get(m.get("format"), m.get("format") or ""), str(m.get("seasonYear") or ""),
                    f"{m['episodes']} ep" if m.get("episodes") else ""]
            it = QListWidgetItem(f"{media_title(m)}\n{'  ·  '.join(b for b in bits if b)}")
            it.setData(Qt.UserRole, m)
            self.results.addItem(it)
        if media:
            self.results.setCurrentRow(0)
        self.status.setText(err or ("" if media else "Nothing found. Try another spelling."))

    def accept_pick(self):
        it = self.results.currentItem()
        if it is not None:
            self.chosen = it.data(Qt.UserRole)
            self.accept()

    def done(self, r):
        if self.searcher is not None:
            self.searcher.wait()
        super().done(r)


