class SchedBars(QWidget):
    """Your week: a bar per day, green (here), amber (needs you), dashed (still to come), the total on top."""

    def __init__(self, days):
        super().__init__()
        self.days = days   # [(name, got, miss, todo, today)]
        self.setMinimumHeight(120)
        tip = []
        for n, got, miss, todo, _ in days:
            tip.append(f"{n}: {got} here" + (f", {miss} need you" if miss else "") + (f", {todo} to come" if todo else ""))
        self.setToolTip("\n".join(tip))

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        n = len(self.days)
        if not n:
            return
        gap = 8
        w = (self.width() - gap * (n - 1)) / n
        top, bottom = 16, self.height() - 18
        most = max(1, max(g + m + t for _, g, m, t, _ in self.days))
        unit = (bottom - top) / most
        f = QFont(self.font())
        f.setPixelSize(10)
        for i, (name, got, miss, todo, today) in enumerate(self.days):
            x = i * (w + gap)
            y = bottom
            for count, kind in ((got, "got"), (miss, "miss"), (todo, "todo")):
                if not count:
                    continue
                h = count * unit - 2
                r = QRectF(x, y - h, w, h)
                if kind == "todo":
                    pen = QPen(QColor("#4a5164"), 1, Qt.DashLine)
                    p.setPen(pen)
                    p.setBrush(Qt.NoBrush)
                    p.drawRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), 4, 4)
                else:
                    p.setPen(Qt.NoPen)
                    p.setBrush(QColor(C["ok"] if kind == "got" else C["warn"]))
                    p.drawRoundedRect(r, 4, 4)
                y -= count * unit
            total = got + miss + todo
            f.setWeight(QFont.Bold)
            p.setFont(f)
            p.setPen(QColor("#c8ccd6"))
            if total:
                p.drawText(QRectF(x, y - 15, w, 14), Qt.AlignCenter, str(total))
            f.setWeight(QFont.Normal)
            p.setFont(f)
            p.setPen(QColor(C["accent_hi"] if today else C["muted"]))
            p.drawText(QRectF(x - 4, bottom + 3, w + 8, 14), Qt.AlignCenter, name)


