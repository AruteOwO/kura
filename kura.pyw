class PlanDialog(KuraDialog):
    """After a preview (Preview only on): every episode the organizer would move, grouped by show,
    ticked; untick any and Apply moves just the ticked ones."""

    def __init__(self, parent, plan, mode):
        super().__init__(parent, "Preview", 860, 560)
        movable = [e for e in plan if not e["skip"]]
        skipped = [e for e in plan if e["skip"]]
        verb = {"move": "moved", "copy": "copied", "hardlink": "hard-linked"}.get(mode, "moved")
        head = label(f"{len(movable)} episode{'s' if len(movable) != 1 else ''} would be {verb} into your library",
                     "h2")
        self.body.addWidget(head)
        sub = "Untick anything you don't want, then Apply. Subtitle files go along with their episode."
        if skipped:
            sub += f" {len(skipped)} already in the library (grayed out)."
        self.body.addWidget(label(sub, "muted", wrap=True))
        self.tree = QTreeWidget()
        self.tree.setObjectName("torrents")
        self.tree.setHeaderLabels(["Episode", "Goes to", "AniList match"])
        self.tree.setRootIsDecorated(True)
        self.tree.setUniformRowHeights(True)
        head_v = self.tree.header()
        head_v.setStretchLastSection(False)
        head_v.setSectionResizeMode(0, QHeaderView.Stretch)
        head_v.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        head_v.setSectionResizeMode(2, QHeaderView.ResizeToContents)
        self.files = []   # (row, entry)
        groups = {}
        for e in sorted(plan, key=lambda e: (e["show"].lower(), e["folder"], Path(e["src"]).name.lower())):
            g = groups.get(e["show"])
            if g is None:
                g = QTreeWidgetItem([e["show"] + ("  · new show" if e["new_show"] else ""), "", ""])
                g.setFlags(g.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsAutoTristate)
                f = g.font(0)
                f.setBold(True)
                g.setFont(0, f)
                self.tree.addTopLevelItem(g)
                groups[e["show"]] = g
            name = Path(e["src"]).name + (f"  (+{e['subs']} subtitle{'s' if e['subs'] != 1 else ''})" if e["subs"] else "")
            r = QTreeWidgetItem([name, e["folder"] if not e["skip"] else e["skip"],
                                 e["match"] or f"no match · “{e['parsed']}”"])
            r.setToolTip(0, e["src"])
            r.setToolTip(1, e["dest"])
            if e["skip"]:
                r.setFlags(r.flags() & ~Qt.ItemIsEnabled)
            else:
                r.setFlags(r.flags() | Qt.ItemIsUserCheckable)
                r.setCheckState(0, Qt.Checked)
                self.files.append((r, e))
            if not e["match"]:
                r.setForeground(2, QColor(C["warn"]))
            g.addChild(r)
        for g in groups.values():
            if not any(g.child(i).flags() & Qt.ItemIsUserCheckable for i in range(g.childCount())):
                g.setFlags(g.flags() & ~Qt.ItemIsUserCheckable & ~Qt.ItemIsEnabled)
        self.tree.expandAll()
        self.tree.itemChanged.connect(lambda *_: self.update_count())
        self.body.addWidget(self.tree, 1)
        row = QHBoxLayout()
        for text, on in (("Select all", True), ("Select none", False)):
            b = QPushButton(text)
            b.setObjectName("ghost")
            b.clicked.connect(lambda _=False, v=on: self.set_all(v))
            row.addWidget(b)
        row.addStretch(1)
        cancel = QPushButton("Close")
        cancel.clicked.connect(self.reject)
        self.apply_btn = QPushButton()
        self.apply_btn.setObjectName("primary")
        self.apply_btn.setDefault(True)
        self.apply_btn.clicked.connect(self.accept)
        row.addWidget(cancel)
        row.addWidget(self.apply_btn)
        self.body.addLayout(row)
        self.update_count()

    def set_all(self, on):
        for r, _ in self.files:
            r.setCheckState(0, Qt.Checked if on else Qt.Unchecked)

    def chosen(self):
        return [e["src"] for r, e in self.files if r.checkState(0) == Qt.Checked]

    def update_count(self):
        n = len(self.chosen())
        self.apply_btn.setEnabled(n > 0)
        self.apply_btn.setText(f"Apply {n}" if n else "Apply")


