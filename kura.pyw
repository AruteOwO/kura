def todo_count(library, account):
    """Shows on To download's "new episodes" list (Watching, in the library, aired but not on disk) - for the
    sidebar badge; the same rule as ToDownloadPage.rebuild without building anything."""
    if not (account and account.connected):
        return 0
    have, local = set(), {}
    for idx in library.indexes().values():
        if idx:
            have |= {i for i in idx["chain"] if i}
            for sid in idx["seasons"]:
                if sid:
                    local[sid] = idx["local"].get(sid, {})
    n = 0
    for mid, e in account.view().items():
        if mid in have and e.get("status") in ("CURRENT", "REPEATING"):
            aired, p = aired_count(e.get("media") or {}) or 0, e.get("progress") or 0
            eps = local.get(mid, {})
            if any(k not in eps for k in range(p + 1, aired + 1)):
                n += 1
    return n


class NavButton(QPushButton):
    """A sidebar page: icon (filled when it's the page you're on), name, and an optional count badge."""

    def __init__(self, glyph, text):
        super().__init__("   " + text)
        self.setObjectName("nav")
        self.glyph = glyph
        self.setIcon(glyph_icon(glyph, "#8d93a6", accent_soft()))
        self.setIconSize(QSize(20, 20))
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.badge = QLabel(self)
        self.badge.setAlignment(Qt.AlignCenter)
        self.badge.hide()

    def set_badge(self, n, color="#8fd3ff", tip=""):
        if not n:
            self.badge.hide()
            return
        c = QColor(color)
        self.badge.setText(str(n) if n < 100 else "99+")
        self.badge.setStyleSheet(f"background: rgba({c.red()},{c.green()},{c.blue()},0.16); color: {color};"
                                 f" border-radius: 9px; padding: 1px 7px; font-size: 8pt; font-weight: 600;")
        self.badge.setToolTip(tip)
        self.badge.adjustSize()
        self.place_badge()
        self.badge.show()

    def place_badge(self):
        self.badge.move(self.width() - self.badge.width() - 10, (self.height() - self.badge.height()) // 2)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.place_badge()


class SideSearch(QPushButton):
