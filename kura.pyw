    # ---- tabs
    def show_tab(self, key):
        self.stack.setCurrentIndex({"tracks": 0, "download": 1, "style": 2}[key])
        if self.settings.get("subtool_tab") != key:
            self._remember("subtool_tab", key)
        if key == "download" and not self.download.only:
            self.download.set_files(self.ticked_files() or self.current_files())

    def current_files(self):
        it = self.tree.currentItem()
        return list(it.data(0, Qt.UserRole) or []) if it is not None else []

    def on_current(self, item):
        self.preview_item(item)
        files = item.data(0, Qt.UserRole) if item is not None else None
        if files and getattr(self, "pending_pick", None) is None:
            self.tracks.set_files(files)
        if not self.ticked_files() and not self.download.only:
            self.download.set_files(files or [])

    def item_for_file(self, path):
        """The season (or show) row holding this file."""
        key = os.path.normcase(path)
        for i in range(self.tree.topLevelItemCount()):
            show = self.tree.topLevelItem(i)
            for it in [show.child(j) for j in range(show.childCount())] + [show]:
                if any(os.path.normcase(f) == key for f in it.data(0, Qt.UserRole) or []):
                    return it
        return None

    def open_for(self, paths, tab):
        """From elsewhere in Kura: these episodes on this tab (Tracks: the first one)."""
        paths = [os.fspath(x) for x in paths]
        if not self.shows:
            self.pending_open = (paths, tab)
            if self.scan is None:
                self.load_shows()
            self.tabs.buttons[tab].setChecked(True)
            self.show_tab(tab)
            return
        it = self.item_for_file(paths[0])
        if it is not None:
            self.pending_pick = paths[0]
            self.tree.setCurrentItem(it)
            self.tree.scrollToItem(it)
            self.pending_pick = None
            self.tracks.set_files(it.data(0, Qt.UserRole), pick=paths[0])
        self.download.set_files(paths, only=True)
        self.tabs.buttons[tab].setChecked(True)
        self.show_tab(tab)
        if tab == "download":
            self.download.find()

    # ---- jobs from the Tracks and Download tabs (one at a time, with Style's)
    def start_job(self, job, verb, after=None):
        if self.job is not None:
            return
        self.editor.engine().release()   # the preview's episode may be one of these
        self.job = job
        self.job_verb, self.job_after, self.failures, self.pictures = verb, after, [], 0
        job.progress.connect(self.on_progress)
        job.file_done.connect(lambda f, ok, msg: self.failures.append(f"{Path(f).name}: {msg}") if not ok else None)
        job.finished_all.connect(self.on_job_finished)
        self.run_bar.setRange(0, len(job.files))
        self.run_bar.setValue(0)
        self.run_box.show()
        self.tree.setEnabled(False)
        self.update_summary()
        job.start()

    def on_job_finished(self, changed, failed, cancelled):
        job = self.job
        job.wait()
        self.job = None
        self.run_box.hide()
        self.tree.setEnabled(True)
        for f in job.files:   # the ✓ counts: files Kura changed
            (self.restyled.add if subs_mod.has_backup(f) else self.restyled.discard)(f)
        text = f"{self.job_verb} {changed} episode{'s' if changed != 1 else ''}" + (", canceled" if cancelled else "")
        if failed:
            text += f"  ·  {failed} left as they were"
        self.notify.emit(text)
        ticked = set(self.ticked_files())
        cur = self.tree.currentItem()
        cur_files = cur.data(0, Qt.UserRole) if cur is not None else None
        self.on_shows((self.shows, self.restyled), "")
        self.retick(ticked)
        if cur_files:
            it = self.item_for_file(cur_files[0])
            if it is not None:
                self.pending_pick = cur_files[0]
                self.tree.setCurrentItem(it)
                self.pending_pick = None
        if self.editor.episode:
            self.editor.set_episode(self.editor.episode)
        if self.job_after:
            self.job_after()
        if self.failures:
            QMessageBox.warning(self, "Subtitles", text + "\n\n" + "\n".join(self.failures[:12]) +
                                (f"\n… and {len(self.failures) - 12} more" if len(self.failures) > 12 else ""))
        self.update_summary()

    def _remember(self, key, value):
        self.settings[key] = value
        save_settings(self.settings)

    def copy_player_style(self):
        st = subs_mod.full_style(self.settings.get("player_sub_style") or {})
        e = self.editor
        e.text_c.set_colour(st["text"])
        e.outline_c.set_colour(st["outline"])
        e.shadow_c.set_colour(st["shadow_color"])
        e.outline_w.setValue(int(round(st["outline_w"] * 2)))
        e.shadow_w.setValue(int(round(st["shadow"] * 2)))
        e.size.setValue(int(st["size"]))
        e.own_font.setChecked(not st["font"])
        if st["font"]:
            e.font.setCurrentFont(QFont(st["font"]))
        e.bold.setChecked(bool(st["bold"]))
        e.dialogue_only.setChecked(bool(st["dialogue_only"]))
        e.emit_changed()

    # ---- FFmpeg
    def show_ffmpeg(self):
        ok = subs_mod.ffmpeg_installed()
        self.ff_box.setVisible(not ok or self.installer is not None)
        self.ff_text.setText("Needs FFmpeg to rewrite video files: about 115 MB, downloaded once (gyan.dev's "
                             "Windows build, the one FFmpeg's own site links to) into Kura's tools folder.")
        self.ff_btn.setEnabled(self.installer is None)
        self.update_summary()

    def install_ffmpeg(self):
        if self.installer is not None:
            return
        self.ff_bar.setValue(0)
        self.ff_bar.show()
        self.ff_btn.setEnabled(False)
        self.ff_text.setText("Downloading FFmpeg…")
        bar = self.ff_bar
        self.installer = BgCall(lambda: subs_mod.install_ffmpeg(
            lambda f: QTimer.singleShot(0, bar, lambda: bar.setValue(int(f * 100)))))
        self.installer.done.connect(self.on_installed)
        self.installer.start()

    def on_installed(self, version, err):
        self.installer.wait()
        self.installer = None
        self.ff_bar.hide()
        self.show_ffmpeg()
        if err:
            self.ff_box.show()
            self.ff_text.setText(f"Couldn't get FFmpeg: {err}")
        else:
            self.notify.emit(f"FFmpeg {version or ''} installed".replace("  ", " "))

    # ---- shows
    def showEvent(self, e):
        super().showEvent(e)
        if not self.shows and self.scan is None:
            self.load_shows()

    def load_shows(self):
        folders = list(getattr(self.library, "items", None) or {})
        self.summary.setText("Reading your library…")

        def collect():
            out = {}
            for folder in folders:
                seasons = {}
                for f in sorted(Path(folder).rglob("*.mkv")):
                    rel = f.parent.relative_to(folder)
                    seasons.setdefault(str(rel) if str(rel) != "." else "", []).append(str(f))
                if seasons:
                    out[folder] = sorted(seasons.items(), key=lambda kv: kv[0].lower())
            restyled = {f for groups in out.values() for _, files in groups for f in files if subs_mod.has_backup(f)}
            return out, restyled
        self.scan = BgCall(collect)
        self.scan.done.connect(self.on_scanned)
        self.scan.start()

    def on_scanned(self, result, err):
        self.scan.wait()
        self.scan = None
        self.on_shows(result, err)

    def on_shows(self, result, err):
        if err or not result:
            self.summary.setText(f"Couldn't read the library ({err})" if err else "No .mkv files in your library.")
            return
        self.shows, self.restyled = result
        self.tree.blockSignals(True)
        self.tree.clear()
        for folder in sorted(self.shows, key=lambda p: Path(p).name.lower()):
            groups = self.shows[folder]
            total = sum(len(f) for _, f in groups)
            done = sum(1 for _, files in groups for f in files if f in self.restyled)
            show = QTreeWidgetItem([Path(folder).name, f"{total}"])
            show.setData(0, Qt.UserRole + 1, folder)
            show.setFlags(show.flags() | Qt.ItemIsUserCheckable | Qt.ItemIsAutoTristate)
            show.setCheckState(0, Qt.Unchecked)
            show.setData(0, Qt.UserRole, [f for _, files in groups for f in files])
            if done:
                show.setToolTip(0, f"{done} of {total} changed by Kura (Restore originals undoes it)")
                show.setForeground(1, QColor(C["accent_hi"]))
                show.setText(1, f"{done}/{total} ✓")
            for name, files in groups:
                if len(groups) == 1 and not name:
                    break
                child = QTreeWidgetItem([name or "(show folder)", str(len(files))])
                child.setFlags(child.flags() | Qt.ItemIsUserCheckable)
                child.setCheckState(0, Qt.Unchecked)
                child.setData(0, Qt.UserRole, files)
                show.addChild(child)
            self.tree.addTopLevelItem(show)
        self.tree.blockSignals(False)
        self.filter_tree(self.search.text())
        self.update_summary()
        if getattr(self, "pending_show", None):
            folder, self.pending_show = self.pending_show, None
            self.select_show(folder)
        if getattr(self, "pending_open", None):
            (paths, tab), self.pending_open = self.pending_open, None
            self.open_for(paths, tab)

    def select_show(self, folder):
        """Tick one show (when its list is loaded)."""
        if not self.shows:
            self.pending_show = folder
            return
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            if os.path.normcase(it.data(0, Qt.UserRole + 1) or "") == os.path.normcase(folder):
                it.setCheckState(0, Qt.Checked)
                self.tree.setCurrentItem(it)
                self.tree.scrollToItem(it)

    def retick(self, files):
        """Tick again what was ticked before the list was rebuilt."""
        self.tree.blockSignals(True)
        for i in range(self.tree.topLevelItemCount()):
            show = self.tree.topLevelItem(i)
            items = [show.child(j) for j in range(show.childCount())] or [show]
            for it in items:
                if set(it.data(0, Qt.UserRole) or []) & files:
                    it.setCheckState(0, Qt.Checked)
        self.tree.blockSignals(False)

    def filter_tree(self, text):
        t = text.strip().lower()
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            it.setHidden(bool(t) and t not in it.text(0).lower())

    def ticked_files(self):
        out = []
        for i in range(self.tree.topLevelItemCount()):
            show = self.tree.topLevelItem(i)
            if show.childCount():
                for j in range(show.childCount()):
                    c = show.child(j)
                    if c.checkState(0) == Qt.Checked:
                        out += c.data(0, Qt.UserRole)
            elif show.checkState(0) == Qt.Checked:
                out += show.data(0, Qt.UserRole)
        return out

    def on_ticked(self, item, column):
        if column == 0:
            self.update_summary()
            if item.checkState(0) != Qt.Unchecked:
                self.preview_item(item)
            if self.stack.currentIndex() == 1 or not self.download.only:
                self.download.set_files(self.ticked_files() or self.current_files())

    def preview_item(self, item):
        files = item.data(0, Qt.UserRole) if item is not None else None
        if files:
            self.editor.set_episode(files[0])

    def update_summary(self):
        files = self.ticked_files() if self.shows else []
        restyled = sum(1 for f in files if f in getattr(self, "restyled", set()))
        busy = self.job is not None
        ready = subs_mod.ffmpeg_installed() and not busy
        self.apply_btn.setEnabled(ready and bool(files))
        self.apply_btn.setText(f"Apply to {len(files)} episode{'s' if len(files) != 1 else ''}" if files else "Apply")
        self.restore_btn.setEnabled(ready and restyled > 0)
        self.ocr_btn.setEnabled(ready and bool(files))
        self.tracks.sync_buttons()
        self.download.sync_buttons()
        if self.shows and not busy:
            self.summary.setText((f"{len(files)} episode{'s' if len(files) != 1 else ''} ticked" +
                                  (f"  ·  {restyled} already restyled (Apply restyles them again from the "
                                   "originals)" if restyled else "")) if files else "Tick shows or seasons on the left.")

    # ---- run
    def ask_ocr(self):
        files = self.ticked_files()
        if not files or self.job is not None:
            return
        dlg = KuraDialog(self, "Make text subtitles", 600, 0)
        dlg.body.addWidget(label("Blu-ray picture subtitles can only be recolored. This reads them with Windows' "
                                 "built-in text recognition and writes a normal text track, which you can then "
                                 "restyle like any other: colors, font, size, outline.", "muted", wrap=True))
        dlg.body.addWidget(label("Clean Blu-ray subtitles read very well, but expect the odd typo, italics come out "
                                 "as plain text, and signs drawn as pictures may come out garbled. English only.",
                                 "faint", wrap=True))
        dlg.body.addSpacing(6)
        choice = Segmented([("add", "Add a text track"), ("replace", "Replace the pictures")],
                           self.settings.get("subtool_ocr_mode", "add"))
        option_row(dlg.body, "The picture track", "Add: both stay, the text track becomes the one players pick "
                   "(switch back any time). Replace: only the text track is left. Restore originals undoes either.",
                   choice)
        dlg.add_buttons(f"Read {len(files)} episode{'s' if len(files) != 1 else ''}")
        if dlg.exec() != QDialog.Accepted:
            return
        self._remember("subtool_ocr_mode", choice.value())
        self.run(restore=False, ocr=choice.value())

    def run(self, restore, ocr=None):
        files = self.ticked_files()
        if restore:
            files = [f for f in files if f in self.restyled]
        if not files or self.job is not None:
            return
        drive = Path(files[0]).anchor
        text = (f"Put the original subtitles back in {len(files)} episode{'s' if len(files) != 1 else ''}?" if restore
                else f"Restyle the subtitles in {len(files)} episode{'s' if len(files) != 1 else ''}?\n\nEach file is "
                     f"copied with the new subtitles next to the original on {drive}, checked, then swapped in "
                     "(about 1 GB written per episode). The original subtitle tracks are kept, so Restore originals "
                     "undoes it. Episodes open in another app are skipped.")
        if not ocr and QMessageBox.question(self, "Subtitles", text) != QMessageBox.Yes:
            return
        self.editor.engine().release()   # the preview's episode may be one of these
        self.job = SubJob(files, self.editor.value(), restore, ocr)
        self.job.progress.connect(self.on_progress)
        self.job.file_done.connect(self.on_file_done)
        self.job.finished_all.connect(self.on_finished)
        self.failures, self.pictures = [], 0
        self.run_bar.setRange(0, len(files))
        self.run_bar.setValue(0)
        self.run_box.show()
        self.tree.setEnabled(False)
        self.update_summary()
        self.job.start()

    def on_progress(self, done, total, name):
        self.run_bar.setValue(done)
        self.run_text.setText(f"{done + 1 if name else done} of {total}  ·  {name}" if name else f"{done} of {total}")

    def on_file_done(self, path, ok, msg):
        if msg == "picture":
            self.pictures += 1
        elif ok and not msg:
            (self.restyled.discard if self.job.restore else self.restyled.add)(path)
        elif not ok:
            self.failures.append(f"{Path(path).name}: {msg}")

    def on_finished(self, changed, failed, cancelled):
        restore, ocr = self.job.restore, self.job.ocr
        self.job.wait()
        self.job = None
        self.run_box.hide()
        self.tree.setEnabled(True)
        verb = "Restored" if restore else "Made text subtitles for" if ocr else "Restyled"
        text = f"{verb} {changed} episode{'s' if changed != 1 else ''}" + (", canceled" if cancelled else "")
        if self.pictures:
            text += (f"  ·  {self.pictures} skipped: picture subtitles (Blu-ray PGS / DVD), their colors can't "
                     "be changed")
        if failed:
            text += f"  ·  {failed} left as they were"
        self.notify.emit(text)
        ticked = set(self.ticked_files())
        self.on_shows((self.shows, self.restyled), "")   # refresh the ✓ counts
        self.retick(ticked)
        if self.editor.episode:
            self.editor.set_episode(self.editor.episode)   # the preview again (it let go of the file for the run)
        if self.failures or (self.pictures and not changed):
            QMessageBox.warning(self, "Subtitles", text + "\n\n" + "\n".join(self.failures[:12]) +
                                (f"\n… and {len(self.failures) - 12} more" if len(self.failures) > 12 else ""))
        self.update_summary()

    def shutdown(self):
        for w in (self.job, self.scan, self.installer, self.download.finder, self.tracks.loader,
                  *getattr(self.download, "tries", [])):
            if w is not None:
                w.requestInterruption()
                w.wait(15000)



