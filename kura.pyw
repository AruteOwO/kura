        g.setColorAt(0.55, QColor("#241a52"))
        g.setColorAt(1, QColor("#0f1118"))
        p.fillPath(path, g)
        glow = QRadialGradient(rect.right() - 120, rect.top() + 40, 320)
        glow.setColorAt(0, QColor(color.red(), color.green(), color.blue(), 90))
        glow.setColorAt(1, QColor(0, 0, 0, 0))
        p.fillPath(path, glow)
        if not r:
            return
        x = rect.left() + 32
