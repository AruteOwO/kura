    # ---- queue
    def add_paths(self, paths):
        for p in paths:
            p = str(Path(p))
            if p not in self.queue:
                self.queue.append(p)
        self.update_queue()

    def pick_files(self):
        exts = " ".join(f"*{e}" for e in sorted(org.VIDEO_EXTS))
        files, _ = QFileDialog.getOpenFileNames(self, "Add episodes", self.settings.get("downloads") or "",
                                                f"Videos ({exts});;All files (*)")
        self.add_paths(files)

    def pick_folder(self):
        d = QFileDialog.getExistingDirectory(self, "Add folder", self.settings.get("downloads") or "")
        if d:
            self.add_paths([d])

    def clear_queue(self):
        self.queue.clear()
        self.update_queue()

    def update_queue(self):
        self.queue_list.clear()
        for p in self.queue:
            path = Path(p)
            item = QListWidgetItem(glyph_icon(G["folder" if path.is_dir() else "file"]), "  " + path.name)
            item.setToolTip(p)
            self.queue_list.addItem(item)
        has = bool(self.queue)
        self.queue_list.setVisible(has)
        self.drop_empty.setVisible(not has)
        self.clear_btn.setVisible(has)
        self.queue_count.setText(f"{len(self.queue)} item{'s' if len(self.queue) != 1 else ''} queued" if has else "")
        self.sync_buttons(self.running)

    def keyPressEvent(self, e):
        if e.key() == Qt.Key_Delete and self.queue_list.hasFocus():
            for r in sorted((self.queue_list.row(i) for i in self.queue_list.selectedItems()), reverse=True):
                del self.queue[r]
            self.update_queue()
        else:
            super().keyPressEvent(e)

    # ---- actions
    def _dry_changed(self, on):
        self.settings["dry_run"] = on
        save_settings(self.settings)

    def open_log_file(self):
        if org.LOG_FILE.exists() and os.name == "nt":
            os.startfile(org.LOG_FILE)

    def sort_queue(self):
        if self.queue:
            self.run_requested.emit(list(self.queue), f"Sorting {len(self.queue)} item(s)", True)

    def sort_downloads(self):
        d = Path(self.settings.get("downloads") or "")
        if not d.is_dir():
            self.append_log(f"Downloads folder not found: {d}")
            return
        # Pass what's inside, not the folder itself, so emptied torrent folders get
        # cleaned up but the downloads folder itself stays
        items = [str(p) for p in sorted(d.iterdir())]
        if not items:
            self.append_log(f"Downloads folder is empty: {d}")
            return
        self.run_requested.emit(items, "Sorting downloads folder", False)

    def sort_library(self):
        """The library folder itself: only loose files at its top level are sorted (collect())."""
        lib = Path(self.settings.get("library") or "")
        if not lib.is_dir():
            self.append_log(f"Library folder not found: {lib}")
            return
        self.run_requested.emit([str(lib)], "Organizing the library folder", False)

    def as_tool(self, back):
        """Shown inside Tools (it left the sidebar in Oct 2026): no page title, the tools' back bar instead."""
        self.title_label.hide()
        self.subtitle.hide()
        self.outer.setContentsMargins(0, 0, 0, 0)
        self.outer.setSpacing(12)
        top = QVBoxLayout()
        top.setSpacing(12)
        tool_top(top, "Organize", "Sort new episodes into your library and keep the folders tidy. Finished "
                 "downloads are sorted by themselves; this is for everything else.", back)
        self.outer.insertLayout(0, top)

    def prune_queue(self):
        """After applying a preview: drop queued items that were moved away (unticked ones stay)."""
        self.queue = [p for p in self.queue if Path(p).exists()]
        self.update_queue()

    def run_tool(self, flag, title, confirm):
        if flag in ("--fix-seasons", "--rename-seasons", "--sort-extras"):
            lib = self.settings.get("library")
            if lib:
                apply_settings(self.settings)
                dlg = {"--fix-seasons": SeasonFixDialog, "--rename-seasons": SeasonRenameDialog,
                       "--sort-extras": ExtrasSortDialog}[flag](self, lib)
                if dlg.exec() == QDialog.Accepted and dlg.shows():
                    argv = [flag]
                    for src in getattr(dlg, "sources", []):
                        argv += ["--extras-from", src]
                    for show in dlg.shows():
                        argv += ["--only", show]
                    self.run_requested.emit(argv, title, False)
            return
        if confirm:
            lang = "English" if self.settings["language"] == "english" else "romaji"
            box = QMessageBox(QMessageBox.Question, title, confirm.format(lang=lang),
                              QMessageBox.Yes | QMessageBox.Cancel, self)
            box.setDefaultButton(QMessageBox.Cancel)
            if box.exec() != QMessageBox.Yes:
                return
        self.run_requested.emit([flag], title, False)

    # ---- state
    def set_status(self, state):
        text, color = {"idle": ("Idle", C["faint"]), "running": ("Running", C["accent_hi"]),
                       "ok": ("Finished", C["ok"]), "preview": ("Preview finished", C["warn"]),
                       "failed": ("Failed", C["bad"])}[state]
        self.status.setText(f"●  {text}")
        self.status.setStyleSheet(f"color: {color}; font-size: 9pt; padding-left: 8px;")

    def sync_buttons(self, running):
        self.running = running
        has_lib = bool(self.settings.get("library"))
        self.sort_btn.setEnabled(not running and bool(self.queue) and has_lib)
        self.sort_downloads_btn.setVisible(bool(self.settings.get("downloads")))
        self.sort_downloads_btn.setEnabled(not running and has_lib)
        self.sort_library_btn.setEnabled(not running and has_lib)
        for t in self.tools:
            t.setEnabled(not running and has_lib)
        self.busy.setVisible(running)

    def append_log(self, text):
        for line in text.split("\n"):
            if not line.strip():
                continue
            low = line.lower()
            if line.startswith(("=====", "▶")):
                color = C["accent_hi"]
            elif any(w in low for w in ("error", "failed", "couldn't", "can't", "warning", "traceback")):
                color = C["bad"]
            elif "[dry run]" in low:
                color = C["warn"]
            elif line.strip().startswith("->") or low.startswith(("icon set", "linked", "renamed", "done")) \
                    or "icon set" in low:
                color = C["ok"]
            elif line.startswith("  "):
                color = C["muted"]
            else:
                color = C["text"]
            safe = html.escape(line)
            lead = len(safe) - len(safe.lstrip(" "))
            safe = "&nbsp;" * lead + safe.lstrip(" ")
            self.log.appendHtml(f'<span style="color:{color}">{safe}</span>')
        sb = self.log.verticalScrollBar()
        sb.setValue(sb.maximum())



class SeasonFixDialog(QDialog):
    """Preview of "Fix season folders": every planned move, grouped by show, each show tickable."""
    TITLE = "Fix season folders"
    COLUMNS = ["Show / episode", "From", "To", "Becomes"]
    VERB = "Move"

    def intro(self):
        return ("Some groups keep counting episodes into the next season (season 2 starts at 13). These episodes "
                "go into the right season folder and get their number in that season (Show - 13 becomes "
                "Show - S02E01); resume points and watch history follow them. Untick any show you want to keep as "
                "it is; nothing changes until you press Move.")

    def child(self, row):
        _, name, a, b, ep, new = row
        return [name, a, b, new if new != name else f"{('S' + b.split()[1]) if b.startswith('Season ') else b} E{ep}"]

    def __init__(self, parent, library):
        super().__init__(parent)
        self.setWindowTitle(self.TITLE)
        self.resize(820, 600)
        v = QVBoxLayout(self)
        v.setContentsMargins(22, 20, 22, 18)
        v.setSpacing(10)
        v.addWidget(label(self.TITLE, "h2"))
        v.addWidget(label(self.intro(), "muted", wrap=True))
        self.status = label("Checking your library… (AniList is asked for episode counts it doesn't know yet)",
                            "faint", wrap=True)
        v.addWidget(self.status)
        self.busy = QProgressBar()
        self.busy.setObjectName("busy")
        self.busy.setRange(0, 0)
        v.addWidget(self.busy)
        self.tree = QTreeWidget()
        self.tree.setObjectName("torrents")
        self.tree.setHeaderLabels(self.COLUMNS)
        head = self.tree.header()
        head.setStretchLastSection(False)
        head.setSectionResizeMode(QHeaderView.ResizeToContents)
        head.setSectionResizeMode(0, QHeaderView.Stretch)
        self.tree.itemChanged.connect(lambda *_: self.update_button())
        self.tree.hide()
        v.addWidget(self.tree, 1)
        row = QHBoxLayout()
        row.addStretch(1)
        cancel = QPushButton("Cancel")
        cancel.clicked.connect(self.reject)
        self.ok = QPushButton(self.VERB)
        self.ok.setObjectName("primary")
        self.ok.setEnabled(False)
        self.ok.clicked.connect(self.accept)
        row.addWidget(cancel)
        row.addWidget(self.ok)
        v.addLayout(row)
        self.worker = BgCall(lambda: self.preview(library))
        self.worker.done.connect(self.on_preview)
        self.worker.start()

    @staticmethod
    def preview(library):
        cache, plan = org.load_cache(), []
        org.fix_seasons(Path(library), cache, True, plan=plan)
        save_lookup_cache(cache)
        return plan

    def on_preview(self, plan, err):
        self.worker.wait()
        self.busy.hide()
        if err:
            self.status.setText(f"Couldn't check the library: {err}")
            return
        if not plan:
            self.status.setText(getattr(self, "EMPTY", None) or (
                "Every episode is already in the right season folder, numbered within its season."
                if self.VERB == "Move"
                else "Every season folder already has the chosen name."))
            return
        shows = {}
        for row in plan:
            shows.setdefault(row[0], []).append(row)
        self.tree.blockSignals(True)
        for show, files in shows.items():
            top = QTreeWidgetItem([f"{show}  ·  {len(files)} file{'s' if len(files) != 1 else ''}"])
            top.setFlags(top.flags() | Qt.ItemIsUserCheckable)
            top.setCheckState(0, Qt.Checked)
            top.setData(0, Qt.UserRole, show)
            f = top.font(0)
            f.setWeight(QFont.DemiBold)
            top.setFont(0, f)
            for row in files:
                child = QTreeWidgetItem(self.child(row))
                child.setForeground(0, QColor(C["muted"]))
                child.setForeground(len(self.COLUMNS) - 1 if self.VERB == "Rename" else 2, QColor(C["accent_hi"]))
                top.addChild(child)
            self.tree.addTopLevelItem(top)
        self.tree.blockSignals(False)
        self.tree.show()
        what = getattr(self, "NOUN", None) or ("folder" if self.VERB == "Rename" else "episode")
        self.status.setText(f"{len(plan)} {what}{'s' if len(plan) != 1 else ''} in {len(shows)} "
                            f"show{'s' if len(shows) != 1 else ''}. Expand a show to see the details."
                            + (" Subtitles move with their episode." if self.VERB == "Move" else ""))
        self.update_button()

    def shows(self):
        return [self.tree.topLevelItem(i).data(0, Qt.UserRole) for i in range(self.tree.topLevelItemCount())
                if self.tree.topLevelItem(i).checkState(0) == Qt.Checked]

    def update_button(self):
        n = sum(self.tree.topLevelItem(i).childCount() for i in range(self.tree.topLevelItemCount())
                if self.tree.topLevelItem(i).checkState(0) == Qt.Checked)
        self.ok.setEnabled(n > 0)
        noun = "folder" if self.VERB == "Rename" else "file"
        self.ok.setText(f"{self.VERB} {n} {noun}{'s' if n != 1 else ''}" if n else self.VERB)

    def done(self, r):
        if self.worker.isRunning():
            self.worker.requestInterruption()
            self.worker.wait()
        super().done(r)


class ExtrasSortDialog(SeasonFixDialog):
    """Preview of "Sort extras": each extra → Extras / <kind> / [season], grouped by show, each show tickable.
