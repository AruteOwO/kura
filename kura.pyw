        self.video, self.card = video, card
        self.setFixedHeight(self.H)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(8, 10, 10, 6)
        lay.setSpacing(0)
        self.seek = TrailerSeek(self)
        self.seek.seek.connect(self.on_seek)
        lay.addWidget(self.seek)
        row = QHBoxLayout()
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(4)
        self.play_btn = self._btn("Pause (click the video)", self.video.toggle_pause)
        row.addWidget(self.play_btn)
        self.time_lbl = QLabel("0:00 / 0:00", self)
        self.time_lbl.setStyleSheet("color: white; background: transparent; font-size: 9pt;")
        row.addWidget(self.time_lbl)
        row.addStretch(1)
        self.mute_btn = self._btn("Mute", self.toggle_mute)
        row.addWidget(self.mute_btn)
        self.vol = QSlider(Qt.Horizontal, self)
        self.vol.setRange(0, 130)
        self.vol.setFixedWidth(76)
        self.vol.setFocusPolicy(Qt.NoFocus)
        self.vol.setCursor(Qt.PointingHandCursor)
        self.vol.setStyleSheet(
            "QSlider { background: transparent; }"
            "QSlider::groove:horizontal { height: 4px; background: rgba(255,255,255,0.25); border-radius: 2px; }"
            "QSlider::sub-page:horizontal { background: white; border-radius: 2px; }"
            "QSlider::handle:horizontal { width: 12px; height: 12px; margin: -4px 0; border-radius: 6px;"
            " background: white; }")
        self.vol.setValue(int(video.volume))
        self.vol.valueChanged.connect(self.on_volume)
        row.addWidget(self.vol)
        row.addSpacing(4)
        self.fs_btn = self._btn("", card.toggle_mpv_fullscreen)
        row.addWidget(self.fs_btn)
        lay.addLayout(row)
        self.save_vol = QTimer(self, singleShot=True, interval=600, timeout=self._save_volume)
        self.tick = QTimer(self, interval=250, timeout=self.refresh)
        self.idle = QTimer(self, singleShot=True, interval=2500, timeout=self.auto_hide)
        self.paused = None
        self.update_mute()
        self.update_fs()
        video.activity.connect(self.wake)
        self.hide()

    def _btn(self, tip, slot):
        b = QPushButton(self)
        b.setFixedSize(32, 32)
        b.setIconSize(QSize(18, 18))
        b.setCursor(Qt.PointingHandCursor)
        b.setFocusPolicy(Qt.NoFocus)
        b.setToolTip(tip)
        b.setStyleSheet("QPushButton { background: transparent; border: none; border-radius: 16px; padding: 0px; }"
                        " QPushButton:hover { background: rgba(255,255,255,0.16); }")
        b.clicked.connect(slot)
        return b

    def start(self):
        self.place()
        self.show()
        self.raise_()
        self.refresh()
        self.tick.start()
        self.idle.start()

    def place(self):
        v = self.video
        self.setGeometry(0, v.height() - self.H, v.width(), self.H)
        self.raise_()

    def paintEvent(self, _):
        p = QPainter(self)
        g = QLinearGradient(0, 0, 0, self.height())
        g.setColorAt(0, QColor(0, 0, 0, 0))
        g.setColorAt(1, QColor(0, 0, 0, 185))
        p.fillRect(self.rect(), g)

    def refresh(self):
        st = self.video.state()
        if st is None:
            return
        pos, dur, paused = st
        self.seek.set_state(pos, dur)
        self.time_lbl.setText(f"{player_mod.fmt_time(pos)} / {player_mod.fmt_time(dur)}")
        if paused != self.paused:
            self.paused = paused
            self.play_btn.setIcon(glyph_icon("" if paused else "", "white", "white", px=18))
            self.play_btn.setToolTip("Play (click the video)" if paused else "Pause (click the video)")
            if paused:   # stays up while paused
                self.wake()

    def wake(self):
        if not self.isVisible() and self.video.state() is not None:
            self.show()
            self.raise_()
        self.idle.start()

    def auto_hide(self):
        if self.paused or self.underMouse():
            self.idle.start()
            return
        self.hide()

    def on_seek(self, t):
        self.video.seek_to(t)
        self.wake()

    def on_volume(self, v):
        self.video.set_volume(v)
        self.update_mute()
        self.save_vol.start()
        self.wake()

    def _save_volume(self):
        s = APP["settings"]
        s["trailer_volume"] = self.vol.value()
        save_settings(s)

    def toggle_mute(self):
        self.video.set_muted(not self.video.muted)
        self.update_mute()

    def update_mute(self):
        off = self.video.muted or self.vol.value() == 0
        self.mute_btn.setIcon(glyph_icon("" if off else "", "white", "white", px=18))
        self.mute_btn.setToolTip("Unmute" if self.video.muted else "Mute")

    def update_fs(self):
        full = self.card.overlay is not None
        self.fs_btn.setIcon(glyph_icon("" if full else "", "white", "white", px=18))
        self.fs_btn.setToolTip("Back to the page (Esc)" if full else "Fill the window (double-click)")


class TrailerCard(QFrame):
    """16:9 still with a play button; click swaps in the player."""
    W, H = 400, 225

    def __init__(self, trailer):
        super().__init__()
        self.trailer = trailer
        self.img, self._pm, self.view = None, None, None
        self.overlay = None   # black layer over the window while fullscreen
        self.controls = None  # Kura's player: progress, volume and fill-the-window over the video
        self.hover = False
        self.loading = False  # player is starting: keep the still up with a spinner
        self.angle = 0
        self.spin = QTimer(self)
        self.spin.setInterval(16)
        self.spin.timeout.connect(self._tick)
        self.setFixedSize(self.W, self.H)
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip("Play trailer")
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)

    def set_image(self, img):
        self.img, self._pm = img, None
        self.update()

    def enterEvent(self, e):
        self.hover = True
        self.update()

    def leaveEvent(self, e):
        self.hover = False
        self.update()

    def _tick(self):
        self.angle = (self.angle + 6) % 360
        self.update()

    def paintEvent(self, _):
        if self.view is not None and not self.loading:
            return
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect())
        clip = QPainterPath()
        clip.addRoundedRect(r, 12, 12)
        p.setClipPath(clip)
        if self.img is not None:
            dpr = self.devicePixelRatioF()
            if self._pm is None:
                self._pm = cover_pixmap(self.img, self.W, self.H, dpr)
            p.drawPixmap(0, 0, self._pm)
        else:
            p.fillRect(r, QColor(C["surface2"]))
        shade = QLinearGradient(0, 0, 0, self.H)
        shade.setColorAt(0, QColor(0, 0, 0, 30 if self.hover else 60))
        shade.setColorAt(1, QColor(0, 0, 0, 150))
        p.fillRect(r, shade)
        if self.loading:   # spinner where the play button was
            ring = QRectF((self.W - 44) / 2, (self.H - 44) / 2, 44, 44)
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(QColor(255, 255, 255, 50), 4))
            p.drawEllipse(ring)
            pen = QPen(QColor("white"), 4)
            pen.setCapStyle(Qt.RoundCap)
            p.setPen(pen)
            p.drawArc(ring, -self.angle * 16, 100 * 16)
        else:   # play button
            d = 64 if self.hover else 58
            circle = QRectF((self.W - d) / 2, (self.H - d) / 2, d, d)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(255, 255, 255, 235))
            p.drawEllipse(circle)
            tri = QPainterPath()
            cx, cy, s = circle.center().x() + 3, circle.center().y(), d * 0.2
            tri.moveTo(cx - s * 0.8, cy - s)
            tri.lineTo(cx + s * 1.1, cy)
            tri.lineTo(cx - s * 0.8, cy + s)
            tri.closeSubpath()
            p.setBrush(QColor(C["bg"]))
            p.drawPath(tri)
        # caption
        f = QFont(self.font())
        f.setPointSizeF(10)
        f.setWeight(QFont.DemiBold)
        p.setFont(f)
        p.setPen(QColor("white"))
        p.drawText(r.adjusted(16, 0, -16, -12), Qt.AlignLeft | Qt.AlignBottom, "Trailer")
        p.setClipping(False)
        p.setPen(QPen(QColor(255, 255, 255, 20), 1))
        p.setBrush(Qt.NoBrush)
        p.drawRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), 12, 12)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.view is None:
            self.play()

    def play(self):
        if trailer_engine() == "mpv":   # Kura's own engine (yt-dlp finds the stream)
            video = TrailerVideo(APP["settings"], self, loop=False, interactive=True)
            video.started.connect(self.reveal)
            video.failed.connect(self.mpv_failed)
            video.fullscreen_requested.connect(self.toggle_mpv_fullscreen)
            video.setGeometry(0, 0, 1, 1)   # it needs to be on screen to start; shown once it plays
            video.show()
            video.installEventFilter(self)   # keeps the controls along the bottom
            s = APP["settings"]
            video.volume = s.get("trailer_volume", s.get("player_volume", 100))
            self.controls = TrailerControls(video, self)
            self.view = video
            self.loading = True
            self.spin.start()
            video.play_trailer(self.trailer, muted=False, volume=video.volume)
            self.setCursor(Qt.ArrowCursor)
            self.setToolTip("Click: pause · double-click: fullscreen")
            self.update()
            return
        embed, watch = trailer_urls(self.trailer)
        try:
            from PySide6.QtWebEngineCore import QWebEnginePage
            from PySide6.QtWebEngineWidgets import QWebEngineView
        except ImportError:   # no browser engine available: open it in the normal browser
            webbrowser.open(watch)
            return
        view = QWebEngineView(self)
        page = QWebEnginePage(trailer_profile(), view)
        page.fullScreenRequested.connect(self.on_fullscreen)
        page.loadFinished.connect(self.reveal)
        view.setPage(page)
        self.lay.addWidget(view)
        self.view = view
        # The player loads behind the still image; it's shown once it's ready
        view.hide()
        self.loading = True
        self.spin.start()
        QTimer.singleShot(12000, self.reveal)   # don't wait forever on a slow network
        view.load(QUrl(embed))
        self.setCursor(Qt.ArrowCursor)
        self.setToolTip("")
        self.update()

    def reveal(self, *_):
        if self.view is None or not self.loading:
            return
        self.loading = False
        self.spin.stop()
        if isinstance(self.view, TrailerVideo):
            self.lay.addWidget(self.view)
        self.view.show()
        if self.controls is not None:
            self.controls.start()

    def update_fs_btn(self):
        if self.controls is not None:
            self.controls.update_fs()

    def mpv_failed(self, err):
        """yt-dlp couldn't get it: fall back to YouTube's player."""
        self.stop()
        APP["settings"]["_trailer_engine_once"] = "web"
        self.play()
        APP["settings"].pop("_trailer_engine_once", None)

    def toggle_mpv_fullscreen(self):
        if self.overlay is None:
            self.enter_fullscreen()
        else:
            self.exit_fullscreen()

    # ---- fullscreen = fill the Kura window (not the whole screen)
    def on_fullscreen(self, req):
        req.accept()
        if req.toggleOn():
            self.enter_fullscreen()
        else:
            self.exit_fullscreen()

    def enter_fullscreen(self):
        if self.overlay is not None or self.view is None:
            return
        host = self.window().centralWidget()
        self.overlay = QWidget(host)
        self.overlay.setStyleSheet("background: black;")
        lay = QVBoxLayout(self.overlay)
        lay.setContentsMargins(0, 0, 0, 0)
        self.lay.removeWidget(self.view)
        lay.addWidget(self.view)
        self.overlay.setGeometry(host.rect())
        host.installEventFilter(self)   # keep covering the window when it's resized
        esc = QShortcut(QKeySequence(Qt.Key_Escape), self.overlay)
        esc.activated.connect(self.leave_fullscreen)
        self.overlay.show()
        self.overlay.raise_()
        self.view.setFocus()
        self.update_fs_btn()

    def leave_fullscreen(self):
        """Esc: ask the player to leave fullscreen (it answers with on_fullscreen)."""
        if isinstance(self.view, TrailerVideo):
            self.exit_fullscreen()
            return
        from PySide6.QtWebEngineCore import QWebEnginePage
        if self.view is not None:
            self.view.page().triggerAction(QWebEnginePage.ExitFullScreen)

    def exit_fullscreen(self):
        if self.overlay is None:
            return
        self.window().centralWidget().removeEventFilter(self)
        if self.view is not None:
            self.overlay.layout().removeWidget(self.view)
            self.view.setParent(self)
            self.lay.addWidget(self.view)
            self.view.show()
        self.overlay.deleteLater()
        self.overlay = None
        self.update_fs_btn()

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Resize:
            if obj is self.view:
                if self.controls is not None:
                    self.controls.place()
            elif self.overlay is not None:
                self.overlay.setGeometry(obj.rect())
        return False

    def stop(self):
        """Back to the still image (stops the sound when leaving the page)."""
        self.exit_fullscreen()
        self.loading = False
        self.spin.stop()
        if self.view is not None:
            if isinstance(self.view, TrailerVideo):
                self.view.shutdown()
            self.view.removeEventFilter(self)
            self.view.setParent(None)
            self.view.deleteLater()
            self.view = None
            self.controls = None   # went with the video
            self.setCursor(Qt.PointingHandCursor)
            self.setToolTip("Play trailer")
            self.update()


