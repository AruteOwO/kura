        cb, self.pending_ask = self.pending_ask, None
        if cb:
            cb()

    def ask(self, question, callback):
        """A yes/no question: a button on the in-app message, or a click on the Windows notification."""
        self.notify_action(question, "Yes", callback, "Click here to confirm.", kind=None)

    def notify_action(self, text, button, callback, tray_hint=None, mid=None, kind="show", sub="", act=None):
        """A message with a button (in the window, with the show's cover), or a clickable Windows notification.
        Kept in the bell too, with the real title (kind None: not kept, e.g. yes/no questions)."""
        real = (text, mid)
        if mid and not acct.ADULT["on"] and self.settings.get("adult_enabled") and \
                self.settings.get("adult_quiet", True) and acct.is_adult(media_for(mid, self.account) or {}):
            text, mid = "Something in your other library is ready", None   # an 18+ show while you're on the Anime side
        if kind:
            self.remember_note(real[0], kind, real[1], button, callback, sub=sub, act=act)
        if self.isVisible() and not self.isMinimized():
            f = cover_file(mid) if mid else None
            self.toast.show_action(text, button, callback, image=QImage(str(f)) if f else None)
        elif self.tray.isVisible():
            self.pending_ask = callback
            self.tray.showMessage(APP_NAME, f"{text}\n{tray_hint or f'Click here to {button.lower()}.'}",
                                  self.windowIcon(), 20000)

    # ---- playing
    def playlist_for(self, path):
        """Every episode on disk of the show this file belongs to, in order, and this file's place."""
        target = os.path.normcase(os.path.abspath(path))
        items = []
        for show_path, it in self.library.items.items():
            if not target.startswith(os.path.normcase(os.path.abspath(show_path)) + os.sep):
                continue
            idx = it.data(INDEX_ROLE)
            if idx:
                for n, sid in enumerate(idx["seasons"], 1):
                    m = media_for(sid, self.account)
                    title = media_title(m) if m.get("title") else it.text()
                    one = len(idx["seasons"]) == 1 and m.get("format") and m.get("format") not in org.TV_FORMATS
                    kind = FORMAT_TEXT.get(m.get("format"), "") if one else f"Season {n}"   # an OVA isn't Season 1
                    for ep, f in sorted((idx["local"].get(sid) or {}).items()):
                        sub = kind if one and (m.get("episodes") or 0) <= 1 else f"{kind} · Episode {ep}"
                        items.append({"path": f, "mid": sid, "episode": ep, "title": title, "season": n,
                                      "subtitle": sub + version_note(f)})
            break
        items = self.with_recaps(items)
        for i, item in enumerate(items):
            if os.path.normcase(os.path.abspath(item["path"])) == target:
                return items, i
        guess = self.now_playing.recognize(Path(path).name, "Kura player") or {}
        return [{"path": path, "mid": guess.get("mid"), "episode": guess.get("ep"),
                 "title": guess.get("title") or Path(path).stem,
                 "subtitle": f"Episode {guess['ep']}" if guess.get("ep") else ""}], 0

    @staticmethod
    def with_recaps(items):
        """Recap files (8.5) of each season folder, in their place in the playlist. They have no episode number, so
        your list never changes when one plays; "recap" makes the player label them and Up next can skip them."""
        out, folders = [], {}
        for it in items:
            folders.setdefault((it.get("mid"), str(Path(it["path"]).parent)), []).append(it)
        extra = {}
        for (mid, folder), its in folders.items():
            for f in local_videos(Path(folder))[1]:
                r = recap_number(f)
                if r is not None:
                    base = its[0]
                    extra.setdefault((mid, int(r)), []).append({
                        "path": f, "mid": mid, "episode": None, "recap": r, "title": base.get("title"),
                        "season": base.get("season"),
                        "subtitle": (f"Season {base['season']} · " if base.get("season") else "") + f"Recap {r:g}"})
        if not extra:
            return items
        for it in items:
            out.append(it)
            for x in sorted(extra.pop((it.get("mid"), it.get("episode")), []), key=lambda x: x["recap"]):
                out.append(x)
        for rest in extra.values():
            out += rest
        return out

    def play(self, path):
        s = self.settings
        mode = s.get("player", "builtin")
        if mode == "external" and Path(s.get("player_path") or "").exists():
            import subprocess
            subprocess.Popen([s["player_path"], path])
            return
        if getattr(self, "previews", None):
            self.previews.close()
        self.home.hero.stop_trailer()
        if mode == "builtin":
            try:
                mpv_mod = player_mod.load_mpv(mpv_dirs())
            except Exception as e:
                self.notify(f"Kura's player couldn't start ({e}). Opening with your default app instead.")
            else:
                playlist, index = self.playlist_for(path)
                self.prefetch_filler(playlist)
                self.make_player(mpv_mod)
                self.player.open(playlist, index)
                if self.player_popout:
                    self.player_popout.raise_()
                    self.player_popout.activateWindow()
                return
        if os.name == "nt":
            os.startfile(path)

    def make_player(self, mpv_mod):
        """Kura's player, made the first time it's needed (inside Kura or popped out)."""
        if self.player is not None:
            return
        s = self.settings
        view = self.player = player_mod.PlayerView(mpv_mod, s, save_settings, PLAYBACK_STATE_FILE, mal_lookup=mal_id)
        view.progress.connect(self.now_playing.builtin_progress)
        view.progress.connect(self.watchlog.on_progress)
        view.close_requested.connect(self.close_player)
        view.popout_toggled.connect(self.toggle_popout)
        view.mini_toggled.connect(self.toggle_mini)
        view.on_top_toggled.connect(self.set_player_on_top)
        view.find_subs.connect(self.player_find_subs)
        view.find_episode.connect(self.player_find_episode)
        if s.get("player_popout"):
            self.popout_player()
        else:
            self.embed_player()

    def watch_live(self, cid):
        """Tune in to a Live TV channel in Kura's player."""
        if getattr(self, "previews", None):
            self.previews.close()
        self.home.hero.stop_trailer()
        try:
            mpv_mod = player_mod.load_mpv(mpv_dirs())
        except Exception as e:
            self.notify(f"Kura's player couldn't start ({e}).")
            return
        self.make_player(mpv_mod)
        self.player.open_live(cid)
        if self.player_popout:
            self.player_popout.raise_()
            self.player_popout.activateWindow()

    def live_reminders(self):
        for r in self.livetv.due_reminders():   # (the side you're on)
            self.notify_action(f"{r['title']} is starting on {r['channel']}", "Tune in",
                               lambda cid=r["cid"]: self.watch_live(cid), mid=r.get("mid"), kind="live",
                               sub="Live TV reminder")

    # ---- where the player lives: inside Kura (default) or in its own window
    def embed_player(self):
        """Kura turns into the player: it covers the whole window, sidebar included."""
        host = self.centralWidget()
        self.player_overlay = QWidget(host)
        self.player_overlay.setObjectName("playerLayer")
        self.player_overlay.setAttribute(Qt.WA_StyledBackground)
        self.player_overlay.setStyleSheet("#playerLayer { background: black; }")   # not the labels inside
        lay = QVBoxLayout(self.player_overlay)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        self.player_strip = None
        if self.own_title:   # the window's buttons above the video (not in fullscreen)
            self.player_strip = PlayerTitleStrip(self)
            self.player_strip.setVisible(not self.isFullScreen())
            lay.addWidget(self.player_strip)
        lay.addWidget(self.player)
        self.player.top.setProperty("kura_drag", True)   # the player's title bar moves the window too
        self.player_overlay.setGeometry(host.rect())
        host.installEventFilter(self)   # keep covering it when the window resizes
        # what's behind the player is hidden meanwhile: going fullscreen used to resize and repaint every
        # page underneath (Home's panels, card grids...), which made the switch stutter
        self.side.hide()
        self.page_col.hide()
        self.player.set_mode("embedded")
        self.player_overlay.show()
        self.player_overlay.raise_()
        self.toast.raise_()
        self.show_window()
        self.player.setFocus()

    def popout_player(self):
        self.player_popout = player_mod.PopoutWindow(self.player, self.settings.get("player_on_top", False), self.windowIcon())
        self.player_popout.closed.connect(self.close_player)
        self.player.set_mode("popout", self.settings.get("player_on_top", False))
        self.player_popout.show()
        dark_title_bar(self.player_popout)
        self.player.setFocus()

    def unembed(self, view=None):
        view = view or self.player
        if self.player_overlay is not None:
            self.centralWidget().removeEventFilter(self)
            self.player_overlay.layout().removeWidget(view)
            view.setParent(None)
            self.player_overlay.deleteLater()
            self.player_overlay = None
            self.player_strip = None
            self.side.show()
            self.page_col.show()

    def prefetch_filler(self, playlist):
        filler_mod.prefetch([it.get("mid") for it in playlist], lambda mid: filler_info(mid, self.account),
                            done=lambda mid: QTimer.singleShot(0, self, lambda: self.on_filler(mid)))

