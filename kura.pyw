    # ---- switching
    def on_tab(self, key, save=True):
        for k, page in self.pages.items():
            page.setVisible(k == key and self.account.connected)
        if save:
            self.settings["stats_tab"] = key
            save_settings(self.settings)
        if key == "kura":
            self.measure_library()
        if key == "wrapped":
            self.fill_wrapped()
        for w in (self.source_lbl, self.source):
            w.setVisible(key != "wrapped")   # the Year in review doesn't use AniList's own statistics
        if key == "wrapped":
            self.note.hide()

    def on_source(self, key):
        self.settings["stats_source"] = key
        save_settings(self.settings)
        self.render()

    def open_profile(self):
        saved = stats_mod.load() or {}
        url = (saved.get("viewer") or {}).get("siteUrl") or (self.account.user or {}).get("siteUrl")
        if url:
            webbrowser.open(url)

    # ---- data
    def showEvent(self, e):
        super().showEvent(e)
        self.reload()
        self.measure_library()

    def reload(self, force=False):
        self.render()
        if not self.account.connected:
            return
        if force:
            self.account.refresh()
        saved = stats_mod.load()
        if (force or stats_mod.stale(saved)) and not self.fetching:
            self.fetching = True
            self.hero.pill2.setText("Updating…")
            token = self.account.token
            call = BgCall(lambda: stats_mod.fetch(token))
            call.done.connect(lambda res, err, c=call: self.on_fetched(c, err))
            self.calls.add(call)
            call.start()

    def on_fetched(self, call, err):
        call.wait()
        self.calls.discard(call)
        self.fetching = False
        self.error = f"Couldn't update AniList's statistics: {err}" if err else ""
        self.render()

    def measure_library(self):
        if self.sizing or (self.sizes is not None and self.sizes[0] > time.time() - 600):
            return
        dirs = list(self.library.items.keys())
        if not dirs:
            return
        self.sizing = True
        call = BgCall(lambda: stats_mod.library_sizes(dirs))
        call.done.connect(lambda res, err, c=call: self.on_sizes(c, res))
        self.calls.add(call)
        call.start()

    def on_sizes(self, call, res):
        call.wait()
        self.calls.discard(call)
        self.sizing = False
        if res is not None:
            self.sizes = (time.time(), res)
            self.render()

    def load_image(self, key, url, dest, setter):
        if not url or self.images.get(key) == url:
            return
        self.images[key] = url
        call = BgCall(lambda: cached_image(url, dest))
        call.done.connect(lambda img, err, c=call: (c.wait(), self.calls.discard(c), img is not None and setter(img)))
        self.calls.add(call)
        call.start()

    def render(self):
        connected = self.account.connected
        self.prompt.setVisible(not connected)
        self.bar.setVisible(connected)
        for k, page in self.pages.items():
            page.setVisible(connected and k == self.tabs.value())
        if not connected:
            self.hero.set_user("Statistics", "Your AniList profile and stats", "", "")
            self.note.hide()
            return
        saved = stats_mod.load() or {}
        viewer = saved.get("viewer") or {}
        user = stats_mod.user_info(viewer) if viewer else {"name": (self.account.user or {}).get("name")}
        base = stats_mod.normalize(viewer) if viewer else None
        source = self.source.value()
        if source == "live" or base is None or acct.ADULT["on"]:   # 18+ statistics: from your 18+ list
            base = None if acct.ADULT["on"] else base
            data = stats_mod.live(self.account.view(), self.account.score_format, base)
            updated = self.account.fetched
        else:
            data = base
            updated = saved.get("fetched")
        since = ""
        if user.get("since"):
            since = "Member since " + datetime.fromtimestamp(user["since"]).strftime("%B %Y")
        days = data["minutes"] / 1440
        self.hero.set_user(user.get("name"), since, f"{days:,.1f} days of anime",
                           "Updating…" if self.fetching else f"Updated {_ago(updated)}")
        uid = user.get("id") or "me"
        if user.get("banner"):
            self.load_image("banner", user["banner"], COVER_DIR / f"user_banner_{uid}.jpg", self.hero.set_banner)
        if user.get("avatar"):
            self.load_image("avatar", user["avatar"], COVER_DIR / f"user_avatar_{uid}.jpg", self.hero.set_avatar)
        notes = [self.error] if self.error else []
        if source == "live" and data.get("partial"):
            notes.append("Genres and studios come from AniList until your list syncs with them (Refresh).")
        if source == "live":
            notes.append("Live: worked out from your list. Hours assume each episode's AniList length.")
        self.note.setText("  ".join(notes))
        self.note.setVisible(bool(notes))
        self.fill_overview(data, viewer)
        self.fill_genres(data, source)
        self.fill_studios(data)
        self.fill_years(data)
        self.fill_kura()
        if self.tabs.value() == "wrapped":
            self.note.hide()
            self.fill_wrapped()

    # ---- filling
    def fill_overview(self, d, viewer):
        t = self.ov_tiles
        t[0].set(_num(d["count"]), "", "Anime")
        t[1].set(_num(d["episodes"]), "", "Episodes watched")
        t[2].set(f"{d['minutes'] / 1440:,.1f}", "", "Days watched")
        t[3].set(f"{d['mean']:.1f}" if d["mean"] else "–", "/100" if d["mean"] else "", "Mean score")
        t[4].set(_num(d["minutes"] / 60), "h", "Hours watched")
        self.heat.set(stats_mod.activity(viewer) if viewer else [])
        order = ["CURRENT", "REPEATING", "COMPLETED", "PAUSED", "DROPPED", "PLANNING"]
        st = d["statuses"]
        self.donut.set([(acct.STATUS_NAMES.get(s, s), st.get(s, 0), STATUS_COLORS.get(s, C["muted"]))
                        for s in sorted(st, key=lambda s: -st[s]) if s in order])
        self.ov_genres.set([self.genre_row(g) for g in d["genres"][:7]])
        self.ov_scores.set([(str(i), d["scores"].get(i, 0), f"Score {i}: {d['scores'].get(i, 0)} shows")
                            for i in range(1, 11)])
        self.ov_studios.set([self.studio_row(s) for s in d["studios"][:6]])
        self.ov_formats.set([(FORMAT_TEXT.get(f, f.title()), n, _num(n), "", "") for f, n in d["formats"]])
        years = sorted(d["start_years"].items())[-8:]
        self.ov_years.set([(f"'{str(y)[2:]}", n, f"{y}: started {n} shows") for y, n in years])
        self.ov_kura.set(self.kura_rows()[:5])

    def genre_row(self, g, right_w=None):
        mean = f"★ {g['mean']:.0f}" if g.get("mean") else ""
        return (g["name"], g["count"], _num(g["count"]), mean,
                f"{g['name']}: {g['count']} shows · {g['minutes'] / 60:,.0f} h watched"
                + (f" · mean score {g['mean']:.0f}" if g.get("mean") else ""))

    def studio_row(self, s):
        return (s["name"], _num(s["count"]), f"★ {s['mean']:.0f}" if s.get("mean") else "",
                f"{s['name']}: {s['count']} shows · {s['minutes'] / 60:,.0f} h watched")

    def fill_genres(self, d, source):
        self.gn_all.set([self.genre_row(g) for g in d["genres"]])
        best = sorted([g for g in d["genres"] if g.get("mean") and g["count"] >= 5], key=lambda g: -g["mean"])[:8]
        self.gn_best.set([(g["name"], g["mean"], f"{g['mean']:.0f}", f"{g['count']} shows", "") for g in best], vmax=100)
        self.gn_tags.set([self.genre_row(t) for t in d["tags"][:30]])
        self.tags_card.hint.setText("AniList's most common tags in what you watch"
                                    + (" (tags always come from AniList)" if source == "live" else ""))

    def fill_studios(self, d):
        self.st_all.set([self.studio_row(s) for s in d["studios"][:20]])
        best = sorted([s for s in d["studios"] if s.get("mean") and s["count"] >= 3], key=lambda s: -s["mean"])[:10]
        self.st_best.set([(s["name"], s["mean"], f"{s['mean']:.0f}", f"{s['count']} shows", "") for s in best], vmax=100)

    def fill_years(self, d):
        rel = d["release_years"]
        if rel:
            lo, hi = min(rel), max(rel)
            self.yr_release.set([(f"'{str(y)[2:]}", rel.get(y, 0), f"{y}: {rel.get(y, 0)} shows")
                                 for y in range(lo, hi + 1)])
        else:
            self.yr_release.set([])
        st = d["start_years"]
        if st:
            lo, hi = min(st), max(st)
            self.yr_start.set([(str(y), st.get(y, 0), f"{y}: started {st.get(y, 0)} shows") for y in range(lo, hi + 1)])
        else:
            self.yr_start.set([])
        dec = {}
        for y, n in rel.items():
            dec[y // 10 * 10] = dec.get(y // 10 * 10, 0) + n
        self.yr_decades.set([(f"{k}s", n, _num(n), "", f"{k}s: {n} shows") for k, n in sorted(dec.items(), reverse=True)])

    def library_numbers(self):
        idxs = {p: i for p, i in self.library.indexes().items() if i}
        seasons = sum(len([s for s in i.get("seasons") or [] if s]) for i in idxs.values())
        episodes = getattr(self.library, "episode_total", 0) or             sum(len(v) for i in idxs.values() for v in (i.get("local") or {}).values())   # every video, like Library
        return idxs, seasons, episodes

    def kura_rows(self):
        idxs, seasons, episodes = self.library_numbers()
        size = sum(self.sizes[1].values()) if self.sizes else None
        log = APP.get("watchlog")
        month = stats_mod.downloads_per_month(_read_json(tor.HISTORY_FILE), 1)[-1][1]
        return [("Shows in library", _num(len(self.library.items))),
                ("Episodes on disk", _num(episodes)),
                ("Library size", stats_mod.human_size(size) if size is not None else "Measuring…"),
                ("Watched in Kura's player", f"{log.hours:,.1f} h" if log else "–"),
                ("Downloaded this month", f"{month} torrent{'s' if month != 1 else ''}")]

    def fill_wrapped(self, year=None):
        if not self.account.connected:
            return
        inputs = wrapped_inputs(self.account)
        years = wrapped_mod.years_with_data(inputs["entries"], inputs["cr_episodes"])[:6]
        if not years:
            return
        year = year or self.wr_year or years[0]
        self.wr_year = year
        clear_layout(self.wr_years)
        for y in years:
            b = QPushButton(str(y))
            b.setCheckable(True)
            b.setChecked(y == year)
            b.setCursor(Qt.PointingHandCursor)
            b.setStyleSheet(f"QPushButton {{ border-radius: 13px; padding: 4px 14px; }} QPushButton:checked {{"
                            f" background: rgba({accent_rgb()},0.22); border: 1px solid {C['accent']}; }}")
            b.clicked.connect(lambda _=False, yy=y: self.fill_wrapped(yy))
            self.wr_years.addWidget(b)
        r = self.wr_result = wrapped_mod.compute(year, **inputs)
        saved = stats_mod.load() or {}
        user = stats_mod.user_info(saved.get("viewer") or {}) if saved.get("viewer") else {}
        name = user.get("name") or (self.account.user or {}).get("name") or ""
        av_file = COVER_DIR / f"user_avatar_{user.get('id') or 'me'}.jpg"
        self.wr_avatar = QImage(str(av_file)) if av_file.exists() else None
        self.wr_name = name
        self.wr_hero.set(r, name, self.wr_avatar)
        self.wr_top.set(r["top"], r["score_format"])
        gmax = max((n for _, n, _ in r["genres"]), default=1)
        self.wr_genres.set([(g, n, f"{pct}%", "", f"{n} episodes") for g, n, pct in r["genres"]], gmax)
        self.wr_months.set([(m[:1], v, f"{m}: {v} episodes") for m, v in zip(wrapped_mod.MONTHS, r["months"])])
        mw = r["most_watched"]
        self.wr_most.set([(t, n, str(n), "", f"{n} episodes") for t, n in mw] or [("Nothing from Crunchyroll", 0, "", "", "")],
                         max((n for _, n in mw), default=1))
        st = studio_of_year(r)
        facts = [("Busiest month", f"{r['busiest'][0]} · {r['busiest'][1]} episodes" if r.get("busiest") else "–"),
                 ("Biggest binge", f"{r['best_day'][0]} · {r['best_day'][1]} episodes" if r.get("best_day") else "–"),
                 ("Days with anime", str(r["watch_days"]) if r["watch_days"] else "–"),
                 ("Studio of the year", st[0] if st else "–"),
                 ("First finished · last finished", f"{r['first'] or '–'}  ·  {r['last'] or '–'}"),
                 ("Average score", wrapped_mod.score_text(r["average"], r["score_format"]) if r["average"] else "–"),
                 ("This year's shows (aired in {0})".format(year), str(r["seasonal"])),
                 ("Movies", str(r["movies"]))]
        self.wr_facts.set(facts)
        k = r["kura"]
        self.wr_kura.set([("Watched in Kura's player", f"{k['seconds'] / 3600:.1f} h" if k["seconds"] else "–"),
                          ("Episodes finished in Kura", str(k["finished"])),
                          ("Torrents sent", str(k["torrents"]))])
        self.load_wrapped_covers(r)

    def load_wrapped_covers(self, r):
        want = [(t["id"], t["cover"]) for t in r["top"] if t.get("cover") and t["id"] not in self.wr_covers]
        for mid, img in self.wr_covers.items():
            self.wr_top.set_image(mid, img)
        if not want or self.wr_loader is not None:
            return

        def work():
            for mid, url in want:
                img = cached_image(url, COVER_DIR / f"{mid}{Path(url.split('?')[0]).suffix or '.jpg'}")
                if img is not None:
                    QTimer.singleShot(0, self, lambda m=mid, i=img: (self.wr_covers.__setitem__(m, i),
                                                                       self.wr_top.set_image(m, i)))
        self.wr_loader = BgCall(work)
        self.wr_loader.done.connect(lambda *_: (self.wr_loader.wait(), setattr(self, "wr_loader", None)))
        self.wr_loader.start()

    def wrapped_card(self):
        r = getattr(self, "wr_result", None)
        return wrapped_image(r, getattr(self, "wr_name", ""), getattr(self, "wr_avatar", None), self.wr_covers) if r else None

    def save_wrapped(self):
        img = self.wrapped_card()
        if img is None:
            return
        start = str(Path.home() / "Pictures" / f"Kura {self.wr_year} in anime.png")
        f, _ = QFileDialog.getSaveFileName(self, "Save your year", start, "PNG image (*.png)")
        if f:
            img.save(f, "PNG")

    def copy_wrapped(self):
        img = self.wrapped_card()
        if img is not None:
            QApplication.clipboard().setImage(img)

    def fill_kura(self):
        idxs, seasons, episodes = self.library_numbers()
        size = sum(self.sizes[1].values()) if self.sizes else None
        log = APP.get("watchlog")
        t = self.ku_tiles
        t[0].set(_num(len(self.library.items)), "", "Shows in library")
        t[1].set(_num(seasons), "", "Seasons")
        t[2].set(_num(episodes), "", "Episodes on disk")
        if size is None:
            t[3].set("…", "", "Library size")
        else:
            num, unit = stats_mod.human_size(size).split(" ")
            t[3].set(num, unit, "Library size")
        t[4].set(f"{log.hours:,.1f}" if log else "0", "h", "In Kura's player")
        if self.sizes:
            top = sorted(self.sizes[1].items(), key=lambda kv: -kv[1])[:10]
            self.ku_biggest.set([(Path(p).name, n, stats_mod.human_size(n), "", Path(p).name) for p, n in top])
        else:
            self.ku_biggest.set([])
        entries = self.account.view()
        on_list = lambda i: any(m in entries and entries[m].get("status") for m in (i.get("chain") or []))
        watching = [m for m, e in entries.items() if e.get("status") in ("CURRENT", "REPEATING")]
        have = {m for i in idxs.values() for m in (i.get("chain") or [])}
        completed = [m for m, e in entries.items() if e.get("status") == "COMPLETED"]
        self.ku_list.set([
            ("Watching shows you have", f"{sum(1 for m in watching if m in have)} of {len(watching)}"),
            ("Completed shows you have", f"{sum(1 for m in completed if m in have)} of {len(completed)}"),
            ("Folders not on your list", _num(sum(1 for i in idxs.values() if not on_list(i)))),
            ("Average episode size", stats_mod.human_size(size / episodes) if size and episodes else "–"),
        ])
        per = stats_mod.downloads_per_month(_read_json(tor.HISTORY_FILE), 12)
        self.ku_dl.set([(d.strftime("%b"), n, f"{d.strftime('%B %Y')}: {n} torrents") for d, n in per])
        days = len((log.data.get("days") or {})) if log else 0
        self.ku_player.set([("Time watched", f"{log.hours:,.1f} h" if log else "–"),
                            ("Episodes finished", _num(log.finished) if log else "–"),
                            ("Days you watched", _num(days))])

    def shutdown(self):
        for c in list(self.calls):
            c.wait(5000)


