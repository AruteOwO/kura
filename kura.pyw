                   f"Your anime persona: {persona}")
        p.setFont(small)
        p.setPen(QColor(255, 255, 255, 160))
        p.drawText(QRectF(x, rect.bottom() - 30, rect.width() - 64, 20), Qt.AlignLeft | Qt.AlignVCenter,
                   f"{line}  ·  about {r['days']:g} days of anime" + ("" if r["source"] == "crunchyroll" else
                                                                     "  ·  estimated from your AniList list"))


class TopFive(QWidget):
    """Your top 5 of the year: covers with their rank and score."""

    def __init__(self):
        super().__init__()
        self.items, self.images = [], {}
        self.setMinimumHeight(250)

    def set(self, items, fmt):
        self.items, self.fmt = items, fmt
        self.update()

    def set_image(self, mid, img):
        self.images[mid] = img
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        n = max(1, len(self.items))
        gap = 14
        w = min(150, (self.width() - gap * (n - 1)) / n)
        h = w * 1.42
        f = QFont(self.font())
        f.setPointSizeF(9)
        f.setWeight(QFont.DemiBold)
        num = QFont("Segoe UI Variable Display")
        num.setPixelSize(30)
        num.setWeight(QFont.Bold)
        for i, it in enumerate(self.items):
            x = i * (w + gap)
            r = QRectF(x, 0, w, h)
            path = QPainterPath()
            path.addRoundedRect(r, 10, 10)
            p.fillPath(path, QColor(it.get("color") or C["surface2"]).darker(200))
            img = self.images.get(it["id"])
            if img is not None and not img.isNull():
                p.save()
                p.setClipPath(path)
                p.drawImage(r, img, fill_source(img.size(), r.size()))
                g = QLinearGradient(r.topLeft(), r.bottomLeft())
                g.setColorAt(0.55, QColor(0, 0, 0, 0))
                g.setColorAt(1, QColor(0, 0, 0, 200))
                p.fillRect(r, g)
                p.restore()
            p.setFont(num)
            p.setPen(QColor("white"))
            p.drawText(QRectF(x + 10, r.bottom() - 42, 40, 36), Qt.AlignLeft | Qt.AlignVCenter, str(i + 1))
            if it.get("score"):
                p.setFont(f)
                p.setPen(QColor(C["warn"]))
                p.drawText(QRectF(x, r.bottom() - 30, w - 10, 22), Qt.AlignRight | Qt.AlignVCenter,
                           f"★ {wrapped_mod.score_text(it['score'], self.fmt)}")
            p.setFont(f)
            p.setPen(QColor(C["text"]))
            p.drawText(QRectF(x, h + 6, w, 36), Qt.AlignLeft | Qt.AlignTop | Qt.TextWordWrap,
                       QFontMetrics(f).elidedText(it["title"], Qt.ElideRight, int(w * 2 - 10)))


def wrapped_image(r, name, avatar, covers):
    """The shareable card: 1080×1350, painted on its own (doesn't depend on the window's size)."""
    W, H = 1080, 1350
    img = QImage(W, H, QImage.Format_ARGB32_Premultiplied)
    p = QPainter(img)
    p.setRenderHint(QPainter.Antialiasing)
    p.setRenderHint(QPainter.SmoothPixmapTransform)
    color = QColor((r["top"][0].get("color") if r.get("top") else None) or "#7c6cff")
    g = QLinearGradient(0, 0, W, H)
    g.setColorAt(0, color.darker(240))
    g.setColorAt(0.5, QColor("#21184c"))
    g.setColorAt(1, QColor("#0b0c12"))
    p.fillRect(img.rect(), g)
    glow = QRadialGradient(W - 160, 140, 520)
    glow.setColorAt(0, QColor(color.red(), color.green(), color.blue(), 110))
    glow.setColorAt(1, QColor(0, 0, 0, 0))
    p.fillRect(img.rect(), glow)

    def font(px, weight=QFont.Normal, display=False):
        f = QFont("Segoe UI Variable Display" if display else "Segoe UI")
        f.setPixelSize(px)
        f.setWeight(weight)
        return f
    x = 80
    if avatar is not None and not avatar.isNull():
        clip = QPainterPath()
        clip.addEllipse(QRectF(x, 80, 96, 96))
        p.save()
        p.setClipPath(clip)
        p.drawImage(QRectF(x, 80, 96, 96), avatar)
        p.restore()
    p.setPen(QColor(255, 255, 255, 210))
    p.setFont(font(34, QFont.DemiBold))
    p.drawText(QRectF(x + 120, 84, 800, 44), Qt.AlignLeft | Qt.AlignVCenter, name or "")
    p.setPen(QColor("white"))
    p.setFont(font(54, QFont.Bold, True))
    p.drawText(QRectF(x + 120, 124, 860, 64), Qt.AlignLeft | Qt.AlignVCenter, f"{r['year']} in anime")
    stats = [(f"{r['hours']:,}", "hours"), (f"{r['episodes']:,}", "episodes"), (f"{r['shows']:,}", "shows")]
    for i, (num, lab) in enumerate(stats):
        bx = x + i * 310
        p.setPen(QColor("white"))
        big = font(110, QFont.Bold, True)
        while QFontMetrics(big).horizontalAdvance(num) > 290 and big.pixelSize() > 60:   # "1,243" fits its column
            big.setPixelSize(big.pixelSize() - 4)
        p.setFont(big)
        p.drawText(QRectF(bx, 230, 310, 130), Qt.AlignLeft | Qt.AlignVCenter, num)
        p.setPen(QColor(255, 255, 255, 170))
        p.setFont(font(30))
        p.drawText(QRectF(bx + 4, 352, 300, 40), Qt.AlignLeft | Qt.AlignVCenter, lab)
    p.setPen(QColor(255, 255, 255, 190))
    p.setFont(font(30, QFont.DemiBold))
    p.drawText(QRectF(x, 440, 900, 40), Qt.AlignLeft | Qt.AlignVCenter, "Top 5")
    cw, ch = 168, 238
    for i, it in enumerate(r["top"][:5]):
        cx = x + i * (cw + 15)
        rr = QRectF(cx, 494, cw, ch)
        path = QPainterPath()
        path.addRoundedRect(rr, 14, 14)
        p.fillPath(path, QColor(it.get("color") or "#2a2f3c").darker(180))
        c = covers.get(it["id"])
        if c is not None and not c.isNull():
            p.save()
            p.setClipPath(path)
            p.drawImage(rr, c, fill_source(c.size(), rr.size()))
            gg = QLinearGradient(rr.topLeft(), rr.bottomLeft())
            gg.setColorAt(0.55, QColor(0, 0, 0, 0))
            gg.setColorAt(1, QColor(0, 0, 0, 210))
            p.fillRect(rr, gg)
            p.restore()
        p.setPen(QColor("white"))
        p.setFont(font(48, QFont.Bold, True))
        p.drawText(QRectF(cx + 12, rr.bottom() - 62, 60, 56), Qt.AlignLeft | Qt.AlignVCenter, str(i + 1))
        p.setFont(font(22, QFont.DemiBold))
        p.drawText(QRectF(cx, rr.bottom() + 10, cw, 64), Qt.AlignLeft | Qt.AlignTop | Qt.TextWordWrap,
                   QFontMetrics(font(22, QFont.DemiBold)).elidedText(it["title"], Qt.ElideRight, cw * 2 - 20))
    genre, persona, line = r["persona"]
    p.setPen(QColor(255, 255, 255, 170))
    p.setFont(font(28))
    p.drawText(QRectF(x, 850, 900, 40), Qt.AlignLeft | Qt.AlignVCenter, "Your anime persona")
    p.setPen(QColor("#c3b9ff"))
    p.setFont(font(76, QFont.Bold, True))
    p.drawText(QRectF(x, 890, 940, 100), Qt.AlignLeft | Qt.AlignVCenter, persona)
    p.setPen(QColor(255, 255, 255, 200))
    p.setFont(font(28))
    p.drawText(QRectF(x, 990, 940, 44), Qt.AlignLeft | Qt.AlignVCenter,
               "  ·  ".join(f"{g_} {pct}%" for g_, _, pct in r["genres"][:3]))
    facts = []
    if r.get("busiest"):
        facts.append(("Busiest month", f"{r['busiest'][0]} · {r['busiest'][1]} ep"))
    if r.get("best_day"):
        facts.append(("Biggest binge", f"{r['best_day'][0]} · {r['best_day'][1]} ep"))
    st = studio_of_year(r)
    if st:
        facts.append(("Studio of the year", st[0]))
    for i, (k, v) in enumerate(facts[:3]):
        bx = x + i * 310
        p.setPen(QColor(255, 255, 255, 150))
        p.setFont(font(24))
        p.drawText(QRectF(bx, 1080, 300, 34), Qt.AlignLeft | Qt.AlignVCenter, k)
        p.setPen(QColor("white"))
        p.setFont(font(32, QFont.DemiBold))
        p.drawText(QRectF(bx, 1114, 300, 44), Qt.AlignLeft | Qt.AlignVCenter,
                   QFontMetrics(font(32, QFont.DemiBold)).elidedText(v, Qt.ElideRight, 296))
    p.setPen(QColor(255, 255, 255, 110))
    p.setFont(font(24))
    p.drawText(QRectF(x, H - 100, W - 160, 40), Qt.AlignLeft | Qt.AlignVCenter, "Made with Kura")
    p.end()
    return img



