    def set_origin(self, page, text=None, mid=None):
        """Where Find torrents came from (None: you opened Torrents yourself): the back pill."""
        self.origin = None if page is None else {"page": page, "text": text, "mid": mid}
        if self.origin is None:
            self.back_pill.hide()
            return
        self.back_pill.setText(f"  ‹  Back to {text}")
        f = cover_file(mid) if mid else None
        img = QImage(str(f)) if f else QImage()
        self.back_pill.setIcon(QIcon(QPixmap.fromImage(img.scaled(36, 52, Qt.KeepAspectRatioByExpanding,
                                                                   Qt.SmoothTransformation))) if not img.isNull()
                               else glyph_icon("arrow_back", C["text"]))
