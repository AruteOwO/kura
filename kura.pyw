class ImageFetcher(QThread):
    """Loads covers from the disk cache or AniList's CDN, off the UI thread."""
    image = Signal(str, QImage)

    def __init__(self, jobs):
        super().__init__()
        self.jobs = jobs   # [(key, url, file stem)]

    def run(self):
        for key, url, stem in self.jobs:
            if self.isInterruptionRequested():
                return
            img = cached_image(url, COVER_DIR / f"{stem}{Path(url.split('?')[0]).suffix or '.jpg'}")
            if img is not None:
                self.image.emit(key, img)


def episode_ranges(nums):
    out, start, prev = [], None, None
    for n in sorted(nums):
        if start is None:
            start = prev = n
        elif n == prev + 1:
            prev = n
        else:
            out.append((start, prev))
            start = prev = n
    if start is not None:
        out.append((start, prev))
    return ", ".join(str(a) if a == b else f"{a}–{b}" for a, b in out)


def save_show_edits(change, account=None):
    """Edit info: change(data) edits user_overrides.json's dict in place; then every part of Kura that uses it
    catches up (the organizer's lists, two-in-one progress, episode counts) and the library is read again."""
    data = org.load_user_overrides()
    change(data)
    org.save_user_overrides(data)
    acct.PROGRESS_SCALE.clear()
    acct.PROGRESS_SCALE.update({int(k): v for k, v in org.EPISODE_SPLIT.items()})
    EPISODE_FIX.clear()
    _DETAILS_CACHE.clear()
    if account is not None:
        account.rescale()
        fix_list_episodes(account)
        account._save_file()
        account.changed.emit()   # every page counts again
    lib = APP.get("library")
    if lib is not None:
        lib.refresh()


def media_title(m):
    mine = org.DISPLAY_TITLES.get(str((m or {}).get("id")))   # Edit info: your title for it
    if mine:
        return mine
    t = (m or {}).get("title") or {}
    return ((t.get("english") if org.TITLE_LANGUAGE == "english" else t.get("romaji"))
            or t.get("romaji") or t.get("english") or "?")


class AccountPage(Page):
    """A page that needs your AniList list: scrollable body, covers loaded in the background."""
    want_settings = Signal()
    open_media = Signal(int, str, object)   # AniList id, title, cover (opens its show page)
    find_torrents = Signal(str)             # search text for the Torrents page

    def __init__(self, title, subtitle, account):
        super().__init__(title, subtitle)
        self.account = account
        self.fetchers = set()
        self.slots = {}
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)   # rows fit the width
        self.outer.addWidget(self.scroll, 1)
        self.dirty, self.built_at = True, 0.0

    STALE_AFTER = 1800   # s: "aired 2 h ago" moves on, so a page this old is made again when shown (Schedule's
    # countdowns tick on their own while it shows; the loading screen builds both at start)

    def mark_dirty(self, *_):
        """Your list, the library or the settings changed: made again the next time it's shown."""
        self.dirty = True

    def showEvent(self, e):
        super().showEvent(e)
        # only when something changed (it rebuilt every visit: ~0.5 s each time on To download / Schedule)
        if self.dirty or time.time() - self.built_at > self.STALE_AFTER:
            self.dirty, self.built_at = False, time.time()
            self.rebuild()

    def rebuild(self):
        raise NotImplementedError

    def connect_prompt(self, text):
        box = card()
        v = QHBoxLayout(box)
        v.setContentsMargins(20, 16, 20, 16)
        v.setSpacing(14)
        v.addWidget(glyph_label(G["account"], C["accent_hi"], 24))
        v.addWidget(label(text, "muted", wrap=True), 1)
        go = QPushButton("Connect AniList")
        go.setObjectName("primary")
        go.clicked.connect(self.want_settings)
        v.addWidget(go)
        return box

    def thumb(self, mid, media, seed):
        img = RoundedImage(40, 56, 6, seed)
        url = ((media or {}).get("coverImage") or {}).get("extraLarge")
        if url:
            self.slots.setdefault(mid, (url, []))[1].append(img)
        return img

    def load_covers(self):
        jobs = [(str(mid), url, str(mid)) for mid, (url, _) in self.slots.items()]
        if not jobs:
            return
        f = ImageFetcher(jobs)
        f.image.connect(lambda key, img: [w.set_image(img) for w in self.slots.get(int(key), (None, []))[1]])
        f.finished.connect(lambda: self.fetchers.discard(f))
        self.fetchers.add(f)
        f.start()

    def set_body(self, widget):
        pos = self.scroll.verticalScrollBar().value()
        self.scroll.setWidget(widget)
        self.scroll.verticalScrollBar().setValue(pos)
        self.load_covers()


class EpisodeStrip(QWidget):
    """A row of small segments, one per aired episode: watched (white), on disk (green), missing (empty)."""
    SEG_W, SEG_H, GAP = 12, 6, 3
    COLORS = {"watched": QColor(255, 255, 255, 120), "have": QColor(C["ok"]), "need": QColor(255, 255, 255, 26),
              "downloading": QColor(C["accent"])}

    def __init__(self, states):
        super().__init__()
        self.states = states   # [(episode, state)]
        self.setMinimumWidth(80)
        sp = QSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        sp.setHeightForWidth(True)
        self.setSizePolicy(sp)
        groups = {}
        for ep, st in states:
            groups.setdefault(st, []).append(ep)
        names = {"watched": "Watched", "have": "On disk", "need": "Missing", "downloading": "Downloading"}
        self.setToolTip("\n".join(f"{names[k]}: episode{'s' if len(v) > 1 else ''} {episode_ranges(v)}"
                                  for k, v in groups.items()))

    def cols(self, w):
        return max(1, (w + self.GAP) // (self.SEG_W + self.GAP))

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        rows = min(2, math.ceil(len(self.states) / self.cols(w))) if self.states else 0
        return rows * (self.SEG_H + 4)

    def sizeHint(self):
        return QSize(220, self.heightForWidth(220))

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        cols = self.cols(self.width())
        shown = self.states[-cols * 2:]   # the latest episodes when there are many
        p.setPen(Qt.NoPen)
        for i, (ep, st) in enumerate(shown):
            x = (i % cols) * (self.SEG_W + self.GAP)
            y = (i // cols) * (self.SEG_H + 4)
            p.setBrush(self.COLORS.get(st, self.COLORS["need"]))
            p.drawRoundedRect(QRectF(x, y, self.SEG_W, self.SEG_H), 3, 3)


def blur_image(img, w, h, radius, focus=0.25):
    """`img` cropped to fill w × h (keeping its shape; `focus` = how far down the crop sits) with a real
    gaussian blur. Blurred with a margin that's cut off after, so the edges don't fade out."""
    pad = radius * 2
    src = img.scaled(w + 2 * pad, h + 2 * pad, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
    src = src.copy((src.width() - w) // 2 - pad, int((src.height() - h - 2 * pad) * focus), w + 2 * pad, h + 2 * pad)
    scene = QGraphicsScene()
    item = QGraphicsPixmapItem(QPixmap.fromImage(src))
    blur = QGraphicsBlurEffect()
    blur.setBlurRadius(radius)
    blur.setBlurHints(QGraphicsBlurEffect.QualityHint)
    item.setGraphicsEffect(blur)
    scene.addItem(item)
    out = QImage(w, h, QImage.Format_ARGB32_Premultiplied)
    out.fill(0)
    p = QPainter(out)
    scene.render(p, QRectF(0, 0, w, h), QRectF(pad, pad, w, h))
    p.end()
    return out


def fill_source(size, target):
    """The part of an image of `size` that fills `target` without stretching (centred)."""
    scale = max(target.width() / size.width(), target.height() / size.height())
    w, h = target.width() / scale, target.height() / scale
    return QRectF((size.width() - w) / 2, (size.height() - h) / 2, w, h)


