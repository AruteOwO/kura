def clean_char_desc(text, spoilers=False):
    """AniList's character text: ~!spoilers!~ hidden (or shown), __bold__ and [links](url) as plain text."""
    t = text or ""
    t = re.sub(r"~!(.*?)!~", (lambda m: m.group(1)) if spoilers else "", t, flags=re.S)
    t = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", t)
    t = t.replace("__", "").replace("<br>", "\n")
    return re.sub(r"\n{3,}", "\n\n", html.unescape(re.sub(r"<[^>]+>", "", t))).strip()


def library_roles(va, skip_char=None):
    """A voice actor's other characters in shows you have: [(character, show title, AniList id)]."""
    lib = APP.get("library")
    out = []
    for char, mid in voice_roles((va or {}).get("id")):
        if char == skip_char or not lib or not lib.path_for_media(mid):
            continue
        m = media_for(mid, APP.get("account")) or {}
        title = media_title(m) if m.get("title") else ""
        if title and (char, title) not in [(a, b) for a, b, _ in out]:
            out.append((char, title, mid))
    return out


def load_image_into(widget, url, stem):
    """A picture from cover_cache (downloaded the first time) into a RoundedImage, off the UI thread."""
    if not url:
        return
    suffix = Path(url.split("?")[0]).suffix or ".jpg"
    f = COVER_DIR / f"{stem}{suffix}"
    if f.exists():
        img = QImage(str(f))
        if not img.isNull():
            widget.set_image(img)
            return
    call = BgCall(lambda: cached_image(url, f))
    call.done.connect(lambda img, err, w=widget, c=call: (c.wait(), shiboken6.isValid(w) and img is not None
                                                           and w.set_image(img)))
    widget._img_call = call
    call.start()


