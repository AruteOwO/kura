        creds = crunchy.load_creds()
        if not (self.account and self.account.connected):
            self.acct_lay.setContentsMargins(18, 14, 18, 14)
            row = QHBoxLayout()
            row.addWidget(label("Connect your AniList account first (Settings → Accounts): the import writes to "
                                "your AniList list.", "muted", wrap=True), 1)
            go = QPushButton("Connect AniList")
            go.setObjectName("primary")
            go.clicked.connect(self.want_settings)
            row.addWidget(go)
            self.acct_lay.addLayout(row)
            return
        if not creds:   # the sign-in lives in Settings → Accounts
            self.acct_lay.setContentsMargins(18, 26, 18, 26)
            self.acct_lay.addWidget(glyph_label("smart_display", CR_ORANGE, 40), 0, Qt.AlignHCenter)
            t = label("Sign in to Crunchyroll to import your history", "h2")
            t.setAlignment(Qt.AlignCenter)
            self.acct_lay.addWidget(t)
            d = label("Your sign-in lives in Settings → Accounts.", "muted")
            d.setAlignment(Qt.AlignCenter)
            self.acct_lay.addWidget(d)
            go = QPushButton(" Open Settings")
            go.setObjectName("primary")
            go.setIcon(glyph_icon("settings", "white"))
            go.setCursor(Qt.PointingHandCursor)
            go.clicked.connect(self.want_settings)
            self.acct_lay.addSpacing(4)
            self.acct_lay.addWidget(go, 0, Qt.AlignHCenter)
            return
        self.acct_lay.setContentsMargins(18, 12, 18, 12)
        row = QHBoxLayout()
        row.setSpacing(12)
        who = creds.get("name") or "your account"
        store = crunchy.load_history()
        when = (time.strftime("%d %b %H:%M", time.localtime(store["synced"])) if store.get("synced")
                else "never")
        row.addWidget(glyph_label("smart_display", CR_ORANGE, 24))
        text = QLabel(f"<b>Crunchyroll</b>  ·  {html.escape(who)}  ·  last synced {when}")
        text.setStyleSheet("background: transparent;")
        text.setToolTip(f"{len(store.get('episodes', {})):,} episodes in Kura's copy of your history")
        row.addWidget(text, 1)
        manage = QPushButton(" Manage")
        manage.setObjectName("ghost")
        manage.setIcon(glyph_icon("settings", C["text"]))
        manage.setToolTip("Sign in or out in Settings → Accounts")
        manage.setCursor(Qt.PointingHandCursor)
        manage.clicked.connect(self.want_settings)
        row.addWidget(manage)
        self.sync_btn = QPushButton(" Sync")
        self.sync_btn.setObjectName("primary")
        self.sync_btn.setIcon(glyph_icon(G["sync"], "white"))
        self.sync_btn.setCursor(Qt.PointingHandCursor)
        self.sync_btn.clicked.connect(self.sync)
        row.addWidget(self.sync_btn)
        self.acct_lay.addLayout(row)
        opts = QHBoxLayout()
        self.want_watchlist = Toggle(self.settings.get("crunchy_watchlist", True))
        self.want_watchlist.toggled.connect(lambda on: self._remember("crunchy_watchlist", on))
        opts.addWidget(self.want_watchlist)
        opts.addWidget(label("Also add your Crunchyroll watchlist to Planning", "muted"))
        opts.addStretch(1)
        self.acct_lay.addLayout(opts)

    def _remember(self, key, value):
        self.settings[key] = value
        save_settings(self.settings)

    def on_account_changed(self):
        if self.worker is None and self.applier is None:
            self.build_account()

    # ---- sync
    def sync(self):
        if self.worker is not None or self.applier is not None:
            return
        matcher, _, _ = build_matcher(self.library, self.account)
        self.worker = CrunchySync(matcher, crunchy.load_map(), self.settings.get("crunchy_watchlist", True))
        self.worker.progress.connect(self.status.setText)
        self.worker.done.connect(self.on_synced)
        self.sync_btn.setEnabled(False)
        self.busy.show()
        self.worker.start()

    def on_synced(self, result, err):
        self.worker.wait()
        self.worker = None
        self.busy.hide()
        if err.startswith("auth:"):
            crunchy.forget()
            self.build_account()
            self.status.setText(err[5:])
            self.signed_out.emit(err[5:])   # Settings → Accounts says why
            return
        self.build_account()
        if err:
            self.status.setText(f"Couldn't sync: {err}")
            return
        self.result = result
        self.status.setText(f"{result['new']} new episode{'s' if result['new'] != 1 else ''} since the last sync  ·  "
                            f"{result['episodes']} in your history")
        self.fill()

    # ---- the plan
    def plan(self):
        """(updates, held, planning, unmatched, up to date count) from the last sync + your list."""
        r, a = self.result, self.account
        per = {}
        unmatched = []
        for g in r["groups"]:
            if g["how"] == "skipped":
                continue
            if not g["by_mid"]:
                unmatched.append(g)
                continue
            for mid, eps in g["by_mid"].items():
                p = per.setdefault(mid, {"eps": set(), "first": "", "last": "", "groups": []})
                p["eps"] |= set(eps)
                p["first"] = min(filter(None, (p["first"], g["first"])), default="")
                p["last"] = max(p["last"], g["last"] or "")
                p["groups"].append(g)
        updates, held, current = [], [], 0
        for mid, p in per.items():
            m = r["media"].get(mid) or media_for(mid, a) or {}
            e = a.entry(mid) or {}
            total = m.get("episodes")
            got = max(p["eps"])
            new_p = min(got, total) if total else got
            cur_s, cur_p = e.get("status"), e.get("progress") or 0
            if cur_s == "COMPLETED" or (cur_s in ("CURRENT", "REPEATING") and cur_p >= new_p):
                current += 1   # already there (never lowered, a completed show is left alone)
                continue
            status = "COMPLETED" if total and new_p >= total else "CURRENT"
            fields = {}
            if new_p > cur_p:
                fields["progress"] = new_p
            if status != cur_s:
                fields["status"] = status
            if not (e.get("startedAt") or {}).get("year") and crunchy.to_fuzzy(p["first"]):
                fields["startedAt"] = crunchy.to_fuzzy(p["first"])
            if status == "COMPLETED" and not (e.get("completedAt") or {}).get("year") and crunchy.to_fuzzy(p["last"]):
                fields["completedAt"] = crunchy.to_fuzzy(p["last"])
            row = {"mid": mid, "media": m, "entry": e, "fields": fields, "groups": p["groups"], "eps": p["eps"],
                   "first": p["first"], "last": p["last"], "after": (status, max(new_p, cur_p))}
            (held if cur_s in ("PAUSED", "DROPPED", "REPEATING") else updates).append(row)
        planning, seen = [], set(per)
        for w in r["watch"]:
            mid = w.get("mid")
            if not mid or mid in seen or a.entry(mid):
                continue
            seen.add(mid)
            planning.append({"mid": mid, "media": r["media"].get(mid) or {}, "entry": {}, "watch": w,
                             "fields": {"status": "PLANNING"}, "after": ("PLANNING", 0)})
        return updates, held, planning, unmatched, current

    def fill(self):
        updates, held, planning, unmatched, current = self.plan()
        scroll = self.tree.verticalScrollBar().value()
        ticks = {it.data(0, Qt.UserRole)["row"]["mid"]: it.checkState(0) for it in self.items()
                 if (it.data(0, Qt.UserRole) or {}).get("kind") == "change"}
        self.tree.blockSignals(True)
        self.tree.clear()
        sections = [("Updates", updates, True, "Progress and status from what you watched."),
                    ("Paused, dropped or rewatching on AniList", held, False,
                     "Not ticked: tick one to update it anyway."),
                    ("From your Crunchyroll watchlist", planning, True, "Added to your Planning list."),
                    ("Couldn't match", unmatched, None, "Double-click to pick the AniList show by hand.")]
        for title, rows, tick, tip in sections:
            if not rows:
                continue
            head = QTreeWidgetItem([f"{title}  ·  {len(rows)}"])
            head.setFlags(Qt.ItemIsEnabled)
            head.setForeground(0, QColor(C["accent_hi"]))
            f = head.font(0)
            f.setWeight(QFont.DemiBold)
            head.setFont(0, f)
            head.setToolTip(0, tip)
            self.tree.addTopLevelItem(head)
            head.setFirstColumnSpanned(True)
            for row in sorted(rows, key=lambda x: self.row_title(x).lower()):
                item = self.make_item(row, tick)
                if tick is not None and row.get("mid") in ticks:   # your ticks survive a refill
                    item.setCheckState(0, ticks[row["mid"]])
                head.addChild(item)
            head.setExpanded(True)
        self.tree.blockSignals(False)
        self.tree.verticalScrollBar().setValue(scroll)
        any_rows = bool(updates or held or planning or unmatched)
        self.tree.setVisible(any_rows)
        self.empty_space.setVisible(not any_rows)
        self.apply_btn.setVisible(any_rows)
        parts = [f"{current} already up to date on AniList"] if current else []
        if not any_rows:
            parts.insert(0, "Nothing to change: your AniList list already has everything you watched on Crunchyroll.")
        self.summary.setText("  ·  ".join(parts))
        self.update_apply()

    def row_title(self, row):
        if "groups" in row and row.get("media") is None:
            return row.get("season_title", "")
        if "watch" in row:
            return row["watch"]["title"]
        if "groups" in row:
            return " + ".join(dict.fromkeys(g["season_title"] for g in row["groups"]))
        return row.get("season_title", "")

    def make_item(self, row, tick):
        def state(st, n):
            name = acct.STATUS_NAMES.get(st, st) if st else "Not on your list"
            return f"{name} · {n}" if st in ("CURRENT", "REPEATING", "PAUSED", "DROPPED") and n else name
        if tick is None:   # unmatched Crunchyroll season
            g = row
            eps = sorted(g["episodes"])
            it = QTreeWidgetItem([g["season_title"], "No match: double-click to choose", "", "",
                                  f"{len(eps)} episode{'s' if len(eps) != 1 else ''}"])
            it.setForeground(1, QColor(C["warn"]))
            it.setData(0, Qt.UserRole, {"kind": "unmatched", "row": g})
            it.setToolTip(0, f"{g['series_title']}  ·  episodes {episode_ranges(eps)}")
            return it
        m, e = row["media"], row["entry"]
        title = media_title(m) if m.get("title") else f"AniList #{row['mid']}"
        now = state(e.get("status"), e.get("progress") or 0)
        st, n = row["after"]
        after = "Planning" if st == "PLANNING" else (f"Completed · {n}" if st == "COMPLETED" else f"Watching · {n}")
        watched = ""
        if row.get("first"):
            a, b = crunchy.to_fuzzy(row["first"]), crunchy.to_fuzzy(row["last"])
            fmt = lambda d: datetime(d["year"], d["month"], d["day"]).strftime("%d %b %Y")
            watched = fmt(a) if (a == b or not b) else f"{fmt(a)} – {fmt(b)}"
        it = QTreeWidgetItem([self.row_title(row), title, now, after, watched])
        it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
        it.setCheckState(0, Qt.Checked if tick else Qt.Unchecked)
        it.setData(0, Qt.UserRole, {"kind": "change", "row": row})
        it.setForeground(3, QColor(C["ok"] if st == "COMPLETED" else C["accent_hi"]))
        it.setForeground(2, QColor(C["muted"]))
        if row.get("eps"):
            it.setToolTip(0, f"Watched on Crunchyroll: episodes {episode_ranges(sorted(row['eps']))}")
        how = {g.get("how") for g in row.get("groups", [])}
        it.setToolTip(1, ("Matched by your choice" if how == {"yours"} else "Matched automatically") +
                      ". Right-click to change.")
        return it

    def items(self):
        for i in range(self.tree.topLevelItemCount()):
            head = self.tree.topLevelItem(i)
            for j in range(head.childCount()):
                yield head.child(j)

    def ticked(self):
        return [it for it in self.items() if (it.data(0, Qt.UserRole) or {}).get("kind") == "change"
                and it.checkState(0) == Qt.Checked]

    def update_apply(self):
        n = len(self.ticked())
        self.apply_btn.setEnabled(n > 0 and self.applier is None)
        self.apply_btn.setText(f"Apply {n} change{'s' if n != 1 else ''} to AniList" if n else "Apply")

    # ---- fixing matches
    def double_clicked(self, it, _):
        data = it.data(0, Qt.UserRole) or {}
        if data.get("kind") == "unmatched":
            self.choose([data["row"]], data["row"]["season_title"])
        elif data.get("kind") == "change" and "groups" in data["row"]:
            self.choose(data["row"]["groups"], self.row_title(data["row"]))

    def context_menu(self, pos):
        it = self.tree.itemAt(pos)
        data = (it.data(0, Qt.UserRole) if it else None) or {}
        if not data:
            return
        row = data["row"]
        groups = [row] if data["kind"] == "unmatched" else row.get("groups") or []
        menu = QMenu(self)
        if groups:
            menu.addAction(glyph_icon(G["search"], C["text"]), "Choose the AniList show…",
                           lambda: self.choose(groups, groups[0]["season_title"]))
            if data["kind"] == "unmatched":
                menu.addAction(glyph_icon(G["refresh"], C["text"]), "Search AniList again for every unmatched show",
                               self.search_again)
            menu.addAction(glyph_icon(G["minus"], C["text"]), "Never import this",
                           lambda: self.remember(groups, None))
        elif "watch" in row:
            w = row["watch"]
            menu.addAction(glyph_icon(G["minus"], C["text"]), "Never import this",
                           lambda: self.remember_watch(w, None))
        if data["kind"] == "change":
            menu.addSeparator()
            mid, m = row["mid"], row["media"]
            menu.addAction(glyph_icon(G["library"], C["text"]), "Show anime",
                           lambda: self.open_media.emit(mid, media_title(m) if m.get("title") else "", None))
        menu.exec(self.tree.viewport().mapToGlobal(pos))

    def choose(self, groups, query):
        dlg = AniListPicker(self, f"Which AniList show is “{query}”?", query)
        if dlg.exec() == QDialog.Accepted and dlg.chosen:
            m = dlg.chosen
            self.result["media"][m["id"]] = m
            self.remember(groups, m["id"])
            # Show where it went: the row is selected (and scrolled to), or why there's none
            row = self.find_row(m["id"])
            if row is not None:
                self.tree.setCurrentItem(row)
                self.tree.scrollToItem(row, QTreeWidget.PositionAtCenter)
                where = row.parent().text(0).split("  ·")[0]
                self.status.setText(f"“{query}” is now {media_title(m)}: see “{where}”.")
            else:
                self.status.setText(f"“{query}” is now {media_title(m)}. Your AniList list already has it, "
                                    "so there's nothing to change. Kura will remember this choice.")

    def find_row(self, mid):
        for it in self.items():
            data = it.data(0, Qt.UserRole) or {}
            if data.get("kind") == "change" and data["row"].get("mid") == mid:
                return it
        return None

    def remember(self, groups, mid):
        """Your choice for these Crunchyroll seasons, kept for every later sync."""
        mapping = crunchy.load_map()
        for g in groups:
            mapping[g["season_id"]] = {"mid": mid, "title": g["season_title"]}
            g["by_mid"] = {mid: set(g["episodes"])} if mid else {}
            g["how"] = "yours" if mid else "skipped"
        crunchy.save_map(mapping)
        self.fill()

    def search_again(self):
        """Forget the remembered misses, so the next sync searches AniList for them again."""
        mapping = crunchy.load_map()
        crunchy.save_map({k: v for k, v in mapping.items() if "miss" not in v})
        self.sync()

    def remember_watch(self, w, mid):
        mapping = crunchy.load_map()
        mapping["series:" + w["series_id"]] = {"mid": mid, "title": w["title"]}
        crunchy.save_map(mapping)
        w["mid"] = mid
        self.fill()

    # ---- applying
    def apply(self):
        if not (self.account and self.account.connected) or self.applier is not None:
            return
        jobs = []
        for it in self.ticked():
            row = it.data(0, Qt.UserRole)["row"]
            if row["fields"]:
                m = row["media"]
                jobs.append((row["mid"], row["fields"], media_title(m) if m.get("title") else str(row["mid"])))
        if not jobs:
            return
        self.applier = CrunchyApply(self.account.token, jobs)
        self.applier.step.connect(lambda i, n, t: self.status.setText(f"Updating AniList: {i} of {n}  ·  {t}"))
        self.applier.done.connect(self.on_applied)
        self.busy.show()
        self.update_apply()
        self.applier.start()

    def on_applied(self, ok, errors):
        self.applier.wait()
        self.applier = None
        self.busy.hide()
        text = f"Updated {ok} show{'s' if ok != 1 else ''} on AniList."
        if errors:
            text += f" {len(errors)} failed: " + "; ".join(errors[:3])
        self.status.setText(text)
        self.notify.emit(text)
        self.tree.clear()
        self.tree.hide()
        self.apply_btn.hide()
        self.empty_space.show()
        self.summary.setText("")
        self.result = None
        self.account.refresh()   # one request: the whole list, so every page shows the new state

    def shutdown(self):
        for w in (self.worker, self.applier):
            if w is not None:
                w.requestInterruption()
                w.wait(5000)


class SubJob(QThread):
    """Restyle (or restore) the subtitles inside a list of video files, one at a time."""
    progress = Signal(int, int, str)            # done, total, file name
    file_done = Signal(str, bool, str)          # path, ok, message
    finished_all = Signal(int, int, bool)       # changed, failed, cancelled

    def __init__(self, files, style, restore=False, ocr=None):
        super().__init__()
        self.files, self.style, self.restore = files, style, restore
        self.ocr = ocr   # None, or "add" / "replace": read picture subtitles into a text track

    def run(self):
        changed = failed = 0
        for i, f in enumerate(self.files):
            if self.isInterruptionRequested():
                self.finished_all.emit(changed, failed, True)
                return
            self.progress.emit(i, len(self.files), Path(f).name)
            try:
                if self.ocr:
                    name = Path(f).name
                    n = subs_mod.ocr_file(f, replace=self.ocr == "replace", cancelled=self.isInterruptionRequested,
                                          progress=lambda k, total, i=i, name=name: self.progress.emit(
                                              i, len(self.files), f"{name}  ·  reading subtitle {k + 1} of {total}"))
                    if not n and not self.isInterruptionRequested():
                        self.file_done.emit(f, True, "no English picture subtitles (or done before)")
                        continue
                else:
                    n = subs_mod.restore_file(f) if self.restore else subs_mod.restyle_file(f, self.style)
                changed += bool(n)
                self.file_done.emit(f, True, "" if n else ("Nothing to restore" if self.restore else
                                                           "No subtitles to restyle"))
            except subs_mod.PictureSubs:
                self.file_done.emit(f, True, "picture")
            except ImportError:
                failed += 1
                self.file_done.emit(f, False, "Windows text recognition isn't available in this copy of Kura")
            except PermissionError:
                failed += 1
                self.file_done.emit(f, False, "Open somewhere (Jellyfin or Kura's player playing it?), left as it "
                                              "was. Run it again once it's closed")
            except Exception as e:
                failed += 1
                self.file_done.emit(f, False, str(e))
        self.progress.emit(len(self.files), len(self.files), "")
        self.finished_all.emit(changed, failed, False)


LANGS = [("eng", "English"), ("jpn", "Japanese"), ("spa", "Spanish"), ("por", "Portuguese"), ("fre", "French"),
         ("ger", "German"), ("ita", "Italian"), ("rus", "Russian"), ("ara", "Arabic"), ("chi", "Chinese"),
         ("kor", "Korean"), ("ind", "Indonesian"), ("may", "Malay"), ("tha", "Thai"), ("vie", "Vietnamese"),
         ("pol", "Polish"), ("tur", "Turkish"), ("und", "Unknown")]
LANG_ALIASES = {"en": "eng", "ja": "jpn", "es": "spa", "pt": "por", "fr": "fre", "fra": "fre", "de": "ger",
                "deu": "ger", "it": "ita", "ru": "rus", "ar": "ara", "zh": "chi", "zho": "chi", "ko": "kor",
                "id": "ind", "ms": "may", "msa": "may", "th": "tha", "vi": "vie", "pl": "pol", "tr": "tur"}


def lang_code(code):
    c = (code or "und").lower()
    return LANG_ALIASES.get(c, c)


def lang_name(code):
    c = lang_code(code)
    return dict(LANGS).get(c, c.upper())


def is_english(track):
    return lang_code(track.get("lang")) == "eng" or bool(re.search(r"\benglish\b|\beng\b", track.get("title") or "",
                                                                     re.I))


def english_sidecar(path):
    p = Path(path)
    return any(p.with_name(f"{p.stem}.{tag}{ext}").exists() for tag in ("eng", "en", "english")
               for ext in (".ass", ".srt", ".ssa", ".vtt"))


class FileJob(QThread):
    """Runs fn(path, say) for each file on a worker thread; fn returns "" (done), a note, or raises."""
    progress = Signal(int, int, str)
    file_done = Signal(str, bool, str)
    finished_all = Signal(int, int, bool)

    def __init__(self, files, fn, kind=""):
        super().__init__()
        self.files, self.fn, self.kind = files, fn, kind

    def run(self):
        changed = failed = 0
        for i, f in enumerate(self.files):
            if self.isInterruptionRequested():
                self.finished_all.emit(changed, failed, True)
                return
            name = Path(f).name
            self.progress.emit(i, len(self.files), name)
            try:
                note = self.fn(f, lambda text, i=i, name=name: self.progress.emit(i, len(self.files),
                                                                                f"{name}  ·  {text}"))
                changed += not note
                self.file_done.emit(f, True, note or "")
            except PermissionError:
                failed += 1
                self.file_done.emit(f, False, "Open somewhere (Jellyfin or Kura's player playing it?), left as it "
                                              "was. Run it again once it's closed")
            except Exception as e:
                failed += 1
                self.file_done.emit(f, False, str(e) or type(e).__name__)
        self.progress.emit(len(self.files), len(self.files), "")
        self.finished_all.emit(changed, failed, False)


class TrackEditor(QWidget):
    """Subtitles → Tracks: one episode's subtitle tracks. Keep or remove, rename, language, default, forced; add
    from a file; save one as a file. Apply to this episode, or the same change to every ticked episode (tracks
    matched by format, language and name)."""

    def __init__(self, tool):
        super().__init__()
        self.tool, self.loader, self.rows, self.path = tool, None, [], None
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(10)
        top = QHBoxLayout()
        top.addWidget(label("Episode", "muted"))
        self.ep = QComboBox()
        self.ep.setMinimumWidth(320)
        self.ep.currentIndexChanged.connect(lambda _: self.load(self.ep.currentData()))
        top.addWidget(self.ep, 1)
        self.state = label("", "faint")
        top.addWidget(self.state)
        v.addLayout(top)
        self.table = QTableWidget(0, 6)
        self.table.setObjectName("tracks")
        self.table.setHorizontalHeaderLabels(["Keep", "Name", "Language", "Format", "Default", "Forced"])
        hdr = self.table.horizontalHeader()
        hdr.setSectionResizeMode(1, QHeaderView.Stretch)
        for c in (0, 3, 4, 5):
            hdr.setSectionResizeMode(c, QHeaderView.ResizeToContents)
        hdr.setSectionResizeMode(2, QHeaderView.Fixed)
        hdr.resizeSection(2, 190)
