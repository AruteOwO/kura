class SkeletonOverlay(QWidget):
    """While a page loads: its shape as placeholders with a light sweeping across ("poster" grid,
    "wide" cards or "rows"), over a view's viewport; animates only while shown."""

    def __init__(self, viewport, kind="poster", card=(164, 290), gap=(22, 20)):
        super().__init__(viewport)
        self.kind, self.card, self.gap = kind, card, gap
        self.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.t = 0.0
        self.timer = QTimer(self, interval=16, timeout=self.tick)
        viewport.installEventFilter(self)
        self.hide()

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Resize:
            self.setGeometry(obj.rect())
        return False

    def start(self):
        self.setGeometry(self.parentWidget().rect())
        self.show()
        self.raise_()
        self.timer.start()

    def stop(self):
        self.timer.stop()
        self.hide()

    def tick(self):
        self.t = (self.t + 0.016) % 1.6
        self.update()

    def shapes(self):
        w, h = self.width(), self.height()
        out = []
        if self.kind == "rows":
            y = 14
            while y < h:
                out.append(QRectF(14, y + 6, 22, 22))
                out.append(QRectF(52, y + 8, min(520, w * 0.45), 12))
                out.append(QRectF(w - 260, y + 8, 120, 12))
                y += 38
            return out
        cw, ch = self.card
        gx, gy = self.gap
        cols = max(1, (w + gx) // (cw + gx)) if self.kind == "poster" else max(1, (w + gx) // (cw + gx))
        cw = (w - (cols - 1) * gx) / cols if self.kind == "wide" else cw
        y = 8
        while y < h:
            for c in range(cols):
                x = c * (cw + gx) + (6 if self.kind == "poster" else 0)
                if self.kind == "poster":
                    out.append(QRectF(x, y, cw, cw * 1.42))
                    out.append(QRectF(x, y + cw * 1.42 + 10, cw * 0.8, 11))
                    out.append(QRectF(x, y + cw * 1.42 + 28, cw * 0.5, 9))
                else:
                    out.append(QRectF(x, y, cw, ch))
            y += (cw * 1.42 + 64) if self.kind == "poster" else ch + gy
        return out

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        base = QColor("#1a1e27")
        hi = QColor("#262b37")
        x = (self.t - 0.3) * self.width() * 1.2
        g = QLinearGradient(x - 220, 0, x + 220, 0)
        g.setColorAt(0, base)
        g.setColorAt(0.5, hi)
        g.setColorAt(1, base)
        p.setPen(Qt.NoPen)
        p.setBrush(g)
