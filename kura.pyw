def library_shows(library):
    """[{"folder", "name", "mapped", "index"}] from the Library page's scan (no disk reads)."""
    out = []
    for folder, it in (getattr(library, "items", None) or {}).items():
        idx = it.data(INDEX_ROLE) if it is not None else None
        mapped = ({f for eps in (idx or {}).get("local", {}).values() for f in eps.values()} |
                  set((idx or {}).get("version_files") or [])) if idx else None
        out.append({"folder": folder, "name": Path(folder).name, "mapped": mapped, "index": idx})
    return sorted(out, key=lambda x: x["name"].lower())


class HealthTool(QWidget):
    """Tools → Library health: broken files, duplicates, leftovers, unmatched episodes, subtitles."""
    back = Signal()
    notify = Signal(str)
    open_show = Signal(str, object)
    find_torrents = Signal(str)
    open_subtitles = Signal(str)
    find_subtitles = Signal(list)
    REPORT = SCRIPT_DIR / "health_report.json"

    def __init__(self, library):
        super().__init__()
        self.library, self.job, self.cancel = library, None, False
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
        tool_top(v, "Library health", "Reads every episode (the first time takes a few minutes; later only new or "
                 "changed files) and lists what needs a look. Nothing is changed unless you press a button.", self.back)
        head = card()
        hh = QHBoxLayout(head)
        hh.setContentsMargins(18, 12, 18, 12)
        self.status = label("", "muted", wrap=True)
        hh.addWidget(self.status, 1)
        self.bar = QProgressBar()
        self.bar.setFixedWidth(220)
        self.bar.hide()
        hh.addWidget(self.bar)
        self.run_btn = QPushButton(" Check library")
        self.run_btn.setObjectName("primary")
        self.run_btn.setIcon(glyph_icon("health_and_safety", "white"))
        self.run_btn.clicked.connect(self.run)
        hh.addWidget(self.run_btn)
        v.addWidget(head)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.inner = QWidget()
        self.col = QVBoxLayout(self.inner)
        self.col.setContentsMargins(0, 0, 8, 0)
        self.col.setSpacing(12)
        self.scroll.setWidget(self.inner)
        v.addWidget(self.scroll, 1)
        self.report = _read_json(self.REPORT) or None
        self.render()

    def run(self):
        if self.job is not None:
            self.cancel = True
            self.run_btn.setText(" Stopping…")
            return
        if not subs_mod.ffmpeg_installed():
            self.status.setText("The check reads files with FFmpeg: install it first in Tools → Subtitles "
                                "(one button, about 115 MB).")
            return
        shows = library_shows(self.library)
        if not shows:
            self.status.setText("The library hasn't been read yet.")
            return
        self.cancel = False
        self.bar.setRange(0, 0)
        self.bar.show()
        self.run_btn.setText(" Stop")
        self.status.setText("Checking…")
        bar = self.bar

        def progress(n, total):
            QTimer.singleShot(0, bar, lambda: (bar.setRange(0, total), bar.setValue(n),
                                               self.status.setText(f"Reading episodes · {n} of {total}")))
        self.job = BgCall(lambda: health_mod.scan(shows, progress, lambda: self.cancel))
        self.job.done.connect(self.on_done)
        self.job.start()

    def on_done(self, report, err):
        self.job.wait()
        self.job = None
        self.bar.hide()
        self.run_btn.setText(" Check library")
        if err:
            self.status.setText(f"Couldn't finish: {err}")
            return
        if report is None:
            self.status.setText("Stopped. What was read is kept, so the next check continues from there.")
            return
        report["t"] = time.time()
        self.report = report
        try:
            self.REPORT.write_text(json.dumps(report), encoding="utf-8")
        except OSError:
            pass
        self.render()

    def render(self):
        clear_layout(self.col)
        r = self.report
        if not r:
            self.status.setText("Not checked yet.")
            self.col.addWidget(EmptyState("health_and_safety", "Check your library",
                                          "Finds broken or incomplete files, old versions next to a v2, the same "
                                          "episode twice, episodes Kura can't place, mixed resolutions and missing "
                                          "subtitles."))
            self.col.addStretch(1)
            return
        when = time.strftime("%d %b %H:%M", time.localtime(r.get("t", 0)))
        issues = r.get("issues") or []
        self.status.setText(f"Checked {r.get('checked', 0):,} episodes in {r.get('shows', 0)} shows · {when} · "
                            + (f"{len(issues)} thing{'s' if len(issues) != 1 else ''} to look at" if issues else
                               "all good"))
        for kind, title, desc in health_mod.KINDS:
            rows = [i for i in issues if i["kind"] == kind and all(os.path.exists(f) for f in i["files"][:1])]
            if rows:
                self.col.addWidget(self.section(kind, title, desc, rows))
        if not issues:
            self.col.addWidget(EmptyState("task_alt", "All good", "Nothing needs a look right now."))
        self.col.addStretch(1)

    def section(self, kind, title, desc, rows):
        box = card()
        v = QVBoxLayout(box)
        v.setContentsMargins(18, 14, 18, 10)
        v.setSpacing(4)
        head = QHBoxLayout()
        t = QVBoxLayout()
        t.setSpacing(1)
        t.addWidget(label(f"{title}  ·  {len(rows)}", "h2"))
        t.addWidget(label(desc, "faint", wrap=True))
        head.addLayout(t, 1)
        if kind == "old_version":
            allb = QPushButton(" Recycle all older versions")
            allb.setIcon(glyph_icon("delete", C["text"]))
            allb.clicked.connect(lambda: self.recycle_files([f for r in rows for f in r["files"]]))
            head.addWidget(allb, 0, Qt.AlignTop)
        v.addLayout(head)
        v.addSpacing(4)
        for n, r in enumerate(rows[:60]):
            if n:
                d = QFrame()
                d.setObjectName("divider")
                v.addWidget(d)
            row = QWidget()
            h = QHBoxLayout(row)
            h.setContentsMargins(0, 6, 0, 6)
            h.setSpacing(8)
            txt = QVBoxLayout()
            txt.setSpacing(1)
            txt.addWidget(label(r["show"], "h2"))
            info = label(r["detail"], "faint", wrap=True)
            info.setToolTip("\n".join(Path(f).name for f in r["files"][:25]))
            txt.addWidget(info)
            h.addLayout(txt, 1)
            for text, glyph, fn in self.actions(kind, r):
                b = QPushButton(f" {text}")
                b.setIcon(glyph_icon(glyph, C["text"]))
                b.setObjectName("ghost")
                b.clicked.connect(fn)
                h.addWidget(b)
            v.addWidget(row)
        if len(rows) > 60:
            v.addWidget(label(f"… and {len(rows) - 60} more", "faint"))
        return box

    def actions(self, kind, r):
        first, folder = r["files"][0], r["folder"]
        reveal = ("Show", "folder_open", lambda: subprocess_open_select(first))
        out = []
        if kind in ("broken", "old_version"):
            out.append(("Recycle", "delete", lambda: self.recycle_files(r["files"])))
        if kind == "picture_subs":
            out.append(("Subtitles", "subtitles", lambda: self.open_subtitles.emit(folder)))
        if kind in ("no_subs", "no_english"):
            out.append(("Find subtitles", "travel_explore", lambda: self.find_subtitles.emit(list(r["files"]))))
        if kind in ("unmatched",):
            out.append(("Show page", "info", lambda: self.open_show.emit(folder, None)))
        if kind in ("resolution", "no_subs", "no_english", "broken"):
            out.append(("Find torrents", "search", lambda: self.find_torrents.emit(r["show"])))
        out.append(reveal)
        return out

    def recycle_files(self, files):
        files = [f for f in files if os.path.exists(f)]
        if not files:
            return
        size = sum(os.path.getsize(f) for f in files)
        names = "\n".join(Path(f).name for f in files[:8]) + (f"\n… and {len(files) - 8} more" if len(files) > 8 else "")
        if QMessageBox.question(self, "Library health", f"Send {len(files)} file{'s' if len(files) != 1 else ''} "
                                f"({human(size)}) to the Recycle Bin?\n\n{names}") != QMessageBox.Yes:
            return
        err = recycle(files)
        if err:
            QMessageBox.warning(self, "Library health", err)
        else:
            self.notify.emit(f"Sent {len(files)} file{'s' if len(files) != 1 else ''} to the Recycle Bin")
        if self.report:
            for i in self.report.get("issues") or []:
                i["files"] = [f for f in i["files"] if os.path.exists(f)]
            self.report["issues"] = [i for i in self.report["issues"] if i["files"]]
        self.render()

    def shutdown(self):
        if self.job is not None:
            self.cancel = True
            self.job.wait(30000)


