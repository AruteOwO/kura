    def showEvent(self, e):
        super().showEvent(e)
        self.count()

    def count(self):
        def work():
            files = list(COVER_DIR.glob("*")) if COVER_DIR.exists() else []
            size = sum(f.stat().st_size for f in files if f.is_file())
            old = [f for f in files if re.fullmatch(r"still_\d{1,12}\.\w+", f.name)]
            return len(_read_json(DETAILS_FILE)), len(characters_store()), len(files), size, \
                sum(f.stat().st_size for f in old), len(old), _read_json(META_STATE).get("last")
        call = BgCall(work)

        def done(r, err, c=call):
            c.wait()
            if err or not r:
                return
            n_det, n_chars, n_files, size, old_size, n_old, last = r
            self.stats.setText(f"Show info for {n_det:,} AniList entries  ·  characters for {n_chars:,}  ·  "
                               f"{n_files:,} pictures ({size / 1e9:.1f} GB)"
                               + (f"\nLast full run: {time.strftime('%d %b %Y, %H:%M', time.localtime(last))}"
                                  if last else "\nNever run in full yet."))
            self.clean_btn.setText(f"Remove {n_old:,} old episode-picture copies ({old_size / 1e6:,.0f} MB)")
            self.clean_btn.setVisible(n_old > 0)
        call.done.connect(done)
        self._count = call
        call.start()

    def clean_old(self):
        n = 0
        for f in COVER_DIR.glob("still_*"):
            if re.fullmatch(r"still_\d{1,12}\.\w+", f.name):   # the old per-session names; Kura downloads again if needed
                try:
                    f.unlink()
                    n += 1
                except OSError:
                    pass
        self.notify.emit(f"Removed {n:,} old episode-picture copies")
        self.count()

    def parts(self):
        s = self.settings
        return {"stills": s.get("meta_stills", True), "filler": s.get("meta_filler", True), "skips": s.get("meta_skips", True)}

    def run_all(self):
        self.start(library_folders(self.settings), quiet=False)

    def run_new(self, folders):
        """New shows (the library found folders it hadn't cached): quietly, in the background."""
        if self.job is None and folders:
            self.start(folders, quiet=True)

    def start(self, folders, quiet):
        if self.job is not None or not folders:
            return
        self.quiet = quiet
        self.job = MetaCacher(folders, self.parts())
        self.job.progress.connect(self.on_progress)
        self.job.finished_with.connect(self.on_done)
        self.go.hide()
        self.stop_btn.show()
        self.bar.show()
        self.status.setText(f"Caching {len(folders)} show{'s' if len(folders) != 1 else ''}…")
        self.job.start()

    def stop(self):
        if self.job is not None:
            self.job.requestInterruption()
            self.status.setText("Stopping…")

    def on_progress(self, phase, done, total):
        self.bar.setRange(0, max(1, total))
        self.bar.setValue(done)
        self.status.setText(f"{phase}: {done:,} of {total:,}")

    def on_done(self, summary):
        self.job.wait()
        self.job = None
        self.go.show()
        self.stop_btn.hide()
        self.bar.hide()
        if summary.get("error"):
            self.status.setText(f"Stopped by a problem: {summary['error']} (details in Tools → Logs)")
        else:
            self.status.setText(f"{summary['shows']} shows ({summary['entries']} AniList entries), "
                                f"{summary['characters']:,} characters, {summary['pictures']:,} new pictures, "
                                f"filler for {summary['filler']}, {summary['skips']:,} skip times"
                                + (f", {summary['failed']} couldn't be downloaded" if summary["failed"] else "") + ".")
            if not self.quiet:
                self.notify.emit("Library metadata cached")
        self.count()


