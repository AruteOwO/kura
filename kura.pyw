        copy.clicked.connect(self.copy_player_style)
        same.addWidget(copy)
        rv.addLayout(same)
        self.editor = SubStyleEditor(settings.get("subtool_style") or settings.get("player_sub_style") or {}, None,
                                     preview_height=340, mode="files")
        self.editor.changed.connect(lambda: self._remember("subtool_style", self.editor.value()))
        rv.addWidget(self.editor)
