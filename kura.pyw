    def cache_new_shows(self):
        """Library metadata for shows that just landed in a library (once a full run has been made)."""
        if not self.settings.get("meta_auto", True) or "--selftest" in sys.argv:
            return
        known = set(_read_json(META_STATE).get("known") or [])
        if not known:
