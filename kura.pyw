    # ---- episodes the feed missed
    CATCHUP_FILE = SCRIPT_DIR / "torrent_catchup.json"
    CATCHUP_AFTER = (3600, 4 * 3600, 12 * 3600, 24 * 3600)   # seconds after an episode aired

    def load_missed(self):
        """torrent_catchup.json: what the searches for each aired episode found ("mid:ep" → aired, tries, done,
        reason, releases...), kept a week."""
        now = time.time()
        return {k: v for k, v in _read_json(self.CATCHUP_FILE).items() if now - v.get("aired", 0) < 7 * 86400}

    def have_sent(self):
        """({mid: episodes on disk}, AniList ids in your library, {(mid, episode) sent before})"""
        have, lib = {}, set()
        for idx in self.library.indexes().values():
            if idx:
                lib |= {i for i in idx["chain"] if i}
                for sid, eps in (idx.get("local") or {}).items():
                    have.setdefault(sid, set()).update(eps)
        sent = set()
        for h in tor.load_history().values():
            if h.get("mid"):
                sent |= {(h["mid"], e) for e in ([h["episode"]] if h.get("episode") else h.get("episodes") or [])}
        return have, lib, sent

    def catch_up(self):
        """After an automatic feed check. The feed only holds the newest ~75 releases: an episode that came out
        while Kura was closed (or scrolled past between checks) was never seen. Airing shows you're watching whose
        newest episode is out but not on disk or sent are searched under every name 1, 4, 12 and 24 hours after it
        aired, through your filters; what they select is downloaded (or announced) like the feed's. What the
        searches find is kept, so the Schedule can say why an episode didn't come (Needs you)."""
        if self.catchup is not None or self.catchup_due or not (self.account and self.account.connected):
            return
        now = time.time()
        state = self.load_missed()
        have, lib, sent = self.have_sent()
        log = air_log()
        ignore = set(self.settings.get("missed_ignore") or [])
        due = []
        for mid, e in self.account.view().items():
            m = e.get("media") or {}
            nxt = m.get("nextAiringEpisode") or {}
            if e.get("status") not in ("CURRENT", "REPEATING") or mid not in lib or not nxt.get("episode") or mid in ignore:
                continue
            if nxt.get("airingAt") and nxt["airingAt"] <= now:   # aired since the list was synced
                ep, aired = nxt["episode"], nxt["airingAt"]
            else:   # the one before it (logged when it was announced, else a week earlier: most shows are weekly)
                ep = nxt["episode"] - 1
                aired = aired_at(log, mid, ep, nxt) or now
                moved = state.get(f"{mid}:{nxt['episode']}")   # AniList moved an episode Kura was waiting for
                if moved and not moved.get("done") and moved.get("aired", 0) < nxt["airingAt"] - 3600:
                    moved.update(reason="off_schedule", moved=nxt["airingAt"])
            if ep < 1 or aired > now or ep in have.get(mid, ()) or (mid, ep) in sent or now - aired > 3 * 86400:
                continue
            st = state.setdefault(f"{mid}:{ep}", {"aired": aired, "tries": []})
            n = len(st["tries"])
            if st.get("done") or st.get("dismissed") or n >= len(self.CATCHUP_AFTER) or now < aired + self.CATCHUP_AFTER[n]:
                continue
            st["tries"].append(now)
            due.append((mid, ep, {}))
        self.save_catchup(state)
        self.catchup_due = due[:4]   # a few searches per check
        self.next_catchup()

    def save_catchup(self, state):
        try:
            tmp = self.CATCHUP_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(state), encoding="utf-8")
            os.replace(tmp, self.CATCHUP_FILE)
        except OSError:
            pass

    def queue_search(self, mid, eps, **opts):
        """Search these episodes now (Search again, "That's it", Find another), through the catch-up queue."""
        state = self.load_missed()
        for ep in eps:
            st = state.setdefault(f"{mid}:{ep}", {"aired": time.time(), "tries": []})
            st["tries"].append(time.time())
            st.pop("dismissed", None)
        self.save_catchup(state)
        self.catchup_due.extend((mid, ep, dict(opts, forced=True)) for ep in eps)
        if self.catchup is None:
            self.next_catchup()

    def next_catchup(self):
        if not self.catchup_due:
            self.catchup = None
            return
        mid, ep, opts = self.catchup_due.pop(0)
        feed = self.settings.get("torrent_search_feed")
        names = [n["text"] for n in self.show_names(mid) if n["on"]]
        urls = [tor.search_url(feed, f"{name} {int(ep):02d}") for name in names]
        if not urls:
            return self.next_catchup()
        ld = self.catchup = FeedLoader(-2, urls if len(urls) > 1 else urls[0], 1 if tor.is_nyaa(urls[0]) else 0)
        ld.done.connect(lambda _i, items, err, _p, _l, m=mid, e=ep, o=opts: self.caught_up(m, e, items, err, o))
        ld.finished.connect(lambda: QTimer.singleShot(1500, self.next_catchup))
        ld.start()

    @staticmethod
    def release_record(it):
        p = it.get("parsed") or tor.parse_release(it["title"])
        rec = {k: it.get(k) for k in ("title", "link", "page", "hash", "size", "seeders", "trusted", "date")}
        rec.update(group=p.get("group") or "", resolution=p.get("resolution") or "")
        return rec

    def item_from(self, rec, mid, ep):
        """A saved release, ready to send (download() wants a feed item)."""
        it = dict(rec, mid=mid, episode=ep, parsed=tor.parse_release(rec["title"]))
        it.setdefault("facts", {"anime_title": self.titles.get(mid) or ""})
        return it

    def release_score(self, mid):
        """Best other release: the group you already have this show from, trusted, 1080p, most seeders."""
        last = None
        for h in sorted(tor.load_history().values(), key=lambda h: h.get("t") or 0):
            if h.get("mid") == mid and h.get("title"):
                last = tor.parse_release(h["title"]).get("group") or last

        def score(r):
            g = r.get("group") or (r.get("parsed") or {}).get("group")
            res = r.get("resolution") or (r.get("parsed") or {}).get("resolution")
            return (bool(last and g == last), bool(r.get("trusted")), res == "1080p", r.get("seeders") or 0)
        return score

    def caught_up(self, mid, ep, items, err, opts=None):
        opts = opts or {}
        state = self.load_missed()
        key = f"{mid}:{ep}"
        st = state.setdefault(key, {"aired": time.time(), "tries": []})
        st["checked"] = time.time()
        if err:
            self.save_catchup(state)
            return
        matcher, describe, titles = build_matcher(self.library, self.account)
        self.titles.update(titles)
        enabled, filters = torrent_filters(self.settings)
        tor.evaluate(items, matcher, describe, tor.load_history(), filters, enabled,
                     tracking=bool(self.account and self.account.connected))
        replace = opts.get("replace")
        mine = [i for i in items if i.get("mid") == mid and i.get("episode") == ep
                and not (i.get("parsed") or {}).get("batch") and i.get("hash") != replace]
        mine.sort(key=self.release_score(mid), reverse=True)
        title = titles.get(mid) or self.titles.get(mid) or "This show"
        pick = next((i for i in mine if i.get("selected")), None)
        if pick is None and replace and mine:   # a stuck download: the best other release, whatever the filters say
            pick = mine[0]
        st.update(found=len(mine), groups=sorted({(i.get("parsed") or {}).get("group") or "no group" for i in mine}),
                  releases=[self.release_record(i) for i in mine[:8]])
        if pick is not None:
            st.update(done=True, reason=None)
            self.save_catchup(state)
            if replace and self.downloads is not None and self.downloads.client is not None:
                self.downloads.run(lambda h=replace: self.downloads.client.delete([h], True))
            if self.settings.get("torrent_new_action") == "download" or opts.get("forced"):
                self.download([pick], auto=True)
            elif pick["hash"] not in self.notified:
                self.notified.add(pick["hash"])
                self.notify.emit(f"Found {title} episode {ep}, which the feed missed: search Torrents to download it")
            self.missed_changed.emit()
            return
        now = time.time()
        if mine:
            st["reason"] = "filtered"
            hours = float(self.settings.get("torrent_fallback_hours") or 12)
            best = mine[0]
            group = (best.get("parsed") or {}).get("group")
            if self.settings.get("torrent_fallback") and group and now - st.get("aired", now) >= hours * 3600:
                # your group didn't release it in time: this show comes from the best other group from now on
                st.update(done=True, reason=None, fallback=group)
                self.save_catchup(state)
                self.use_group_for(mid, title, group)
                self.download([best], auto=True)
                self.notify.emit(f"{title} episode {ep} didn't come from your usual group in {hours:g} h, "
                                 f"so Kura got it from {group}")
                self.missed_changed.emit()
                return
        else:
            import difflib
            names = [n["key"] for n in self.show_names(mid)]
            odd = []
            for i in items:
                pn = (i.get("parsed") or {}).get("name") or ""
                if i.get("mid") or i.get("episode") != ep or not pn or pn in odd:
                    continue
                if max((difflib.SequenceMatcher(None, tor.norm(pn), k).ratio() for k in names), default=0) >= 0.5:
                    odd.append(pn)
            st["reason"] = "unrecognised" if odd else "waiting"
            st["names"] = odd[:3]
            if odd:
                found = [i for i in items if (i.get("parsed") or {}).get("name") in odd and i.get("episode") == ep]
                found.sort(key=self.release_score(mid), reverse=True)
                st["releases"] = [self.release_record(i) for i in found[:8]]
        grace = float(self.settings.get("torrent_fallback_hours") or 12) * 3600
        if (st["reason"] in ("filtered", "unrecognised") and not st.get("notified")
                and (now - st.get("aired", now) >= grace or len(st.get("tries") or []) >= len(self.CATCHUP_AFTER))):
            st["notified"] = True
            why = (f"{st['found']} releases, none your filters allow" if st["reason"] == "filtered"
                   else f"found as “{st['names'][0]}”")
            self.missed_new.emit(mid, float(ep), f"{title} episode {ep} needs you: {why}")
        self.save_catchup(state)
        self.missed_changed.emit()

    # ---- missed episodes (the Schedule's Needs you)
    MISSED_KINDS = {"filtered": ("FILTERED OUT", C["warn"]), "stuck": ("STUCK", "#ff9aa7"),
                    "unrecognised": ("NOT RECOGNIZED", "#9ccbff"), "gap": ("GAP", "#c8ccd6"),
                    "unfinished": ("SEASON UNFINISHED", "#7fe0b0")}

    def missed_entries(self):
        """Aired episodes that aren't coming by themselves, one entry per show and reason: filtered out (releases
        exist, none your filters allow), not recognised (releases under a name Kura doesn't know), stuck (sent a
        day ago, no seeders), gaps and finished seasons with episodes missing. Filtered / not recognised wait for
        the grace period (`torrent_fallback_hours`) first: the group may just be late."""
        if not (self.account and self.account.connected):
            return []
        now = time.time()
        grace = float(self.settings.get("torrent_fallback_hours") or 12) * 3600
        state = self.load_missed()
        ignore = set(self.settings.get("missed_ignore") or [])
        have, lib, sent = self.have_sent()
        out = {}

        def add(kind, mid, ep, **kw):
            e = out.setdefault((kind, mid), {"kind": kind, "mid": mid, "eps": [], "releases": [], "groups": [],
                                             "names": [], "tries": 0, "aired": None})
            e["eps"].append(ep)
            for k, v in kw.items():
                if k in ("releases", "groups", "names"):
                    e[k] += [x for x in v or [] if x not in e[k]]
                elif k == "tries":
                    e[k] = max(e[k], v)
                elif k == "aired":
                    e[k] = max(e[k] or 0, v or 0) or None
                else:
                    e[k] = v
        for key, st in state.items():
            try:
                mid, ep = int(key.split(":")[0]), int(float(key.split(":")[1]))
            except (ValueError, IndexError):
                continue
            r = st.get("reason")
            if (mid in ignore or st.get("done") or st.get("dismissed") or r not in ("filtered", "unrecognised")
                    or ep in have.get(mid, ()) or (mid, ep) in sent):
                continue
            if now - st.get("aired", now) >= grace or len(st.get("tries") or []) >= len(self.CATCHUP_AFTER):
                add(r, mid, ep, releases=[dict(x, ep=ep) for x in st.get("releases") or []],
                    groups=st.get("groups"), names=st.get("names"),
                    tries=len(st.get("tries") or []), aired=st.get("aired"), found=st.get("found") or 0)
        busy = set()
        dl = self.downloads
        if dl is not None and dl.connected:
            hist = tor.load_history()
            for h, t in dl.torrents.items():
                if not t.get("mid"):
                    continue
                busy |= {(t["mid"], e) for e in ([t["episode"]] if t.get("episode") else t.get("episodes") or [])}
                if tor.is_done(t) or t["mid"] in ignore or "paused" in (t.get("state") or "").lower() \
                        or "stopped" in (t.get("state") or "").lower():
                    continue
                sent_at = (hist.get(h) or {}).get("t") or t.get("added_on") or now
                if now - sent_at > 86400 and not t.get("num_seeds") and (t.get("progress") or 0) < 1:
                    add("stuck", t["mid"], t.get("episode") or 0, hash=h, progress=t.get("progress") or 0,
                        sent=sent_at, aired=sent_at)
        for mid, e in self.account.view().items():
            if e.get("status") not in ("CURRENT", "REPEATING") or mid not in lib or mid in ignore:
                continue
            m = e.get("media") or {}
            local = {int(x) for x in have.get(mid, ()) if isinstance(x, (int, float)) and x == int(x)}
            aired = aired_count(m) or 0
            if not local or not aired:
                continue
            waiting = {int(k.split(":")[1].split(".")[0]) for k in state if k.startswith(f"{mid}:")}

            def free(n):
                return n not in local and (mid, n) not in sent and (mid, n) not in busy and n not in waiting
            top, low = max(local), min(local)
            if top > max(aired, m.get("episodes") or 0):
                continue   # numbered on from an earlier season ("Black Clover - 174"): not gaps
            progress = e.get("progress") or 0
            if not on_schedule(m):   # user's rule: Needs you is about what's airing now, not older shows' gaps
                continue
            # holes between your first and last file (starting a show partway is on purpose), and aired ones after
            # your last file but before the newest (that one is the catch-up search's), past what you've watched
            gaps = [n for n in range(low + 1, min(top, aired)) if free(n) and n > progress] + \
                   [n for n in range(top + 1, aired) if free(n) and n > progress]
            if 0 < len(gaps) <= 5:
                for n in gaps:
                    add("gap", mid, n, local=sorted(local))
        skipped = self.settings.get("missed_skipped") or {}
        for k in list(out):
            e = out[k]
            e["eps"] = [x for x in e["eps"] if x not in (skipped.get(f"{e['kind']}:{e['mid']}") or [])]
            if not e["eps"] or not on_schedule(media_for(e["mid"], self.account) or {}):
                del out[k]   # only shows on the Schedule (airing, or finished this past week)
        order = ["filtered", "stuck", "unrecognised", "gap", "unfinished"]
        entries = sorted(out.values(), key=lambda e: (order.index(e["kind"]), -(e.get("aired") or 0)))
        for e in entries:
            self.describe_missed(e, state, have)
        return entries

    def describe_missed(self, e, state, have):
        mid, kind = e["mid"], e["kind"]
        e["eps"] = sorted(set(e["eps"]))
        m = media_for(mid, self.account) or {}
        e["title"] = self.titles.get(mid) or media_title(m)
        e["media"] = m
        e["tag"], e["color"] = self.MISSED_KINDS[kind]
        eps = episode_ranges(e["eps"])
        e["ep_text"] = f"Episode{'s' if len(e['eps']) > 1 else ''} {eps}"
        e["releases"].sort(key=self.release_score(mid), reverse=True)
        best = e["releases"][0] if e["releases"] else None
        e["best"] = best
        if kind == "filtered":
            groups = [g for g in e["groups"] if g and g != "no group"]
            e["why"] = (f"{e.get('found') or len(e['releases'])} release{'s' if (e.get('found') or 0) != 1 else ''}, "
                        f"none your filters allow" + (f" ({', '.join(groups[:3])})" if groups else "") + ".")
            earlier = sum(1 for k, v in state.items() if k.startswith(f"{mid}:") and v.get("reason") == "filtered")
            if earlier >= 2:
                e["why"] += " This keeps happening: your group probably isn't releasing this show."
            e["act"] = (f"Use {best['group']}" if best and best.get("group") else "Pick a release", "group")
        elif kind == "unrecognised":
            e["why"] = f"Found as “{e['names'][0]}”." if e["names"] else "Found under another name."
            e["act"] = ("That's it", "learn")
        elif kind == "stuck":
            days = max(1, int((time.time() - (e.get("sent") or time.time())) // 86400))
            e["why"] = f"{int((e.get('progress') or 0) * 100)}% for {days} day{'s' if days != 1 else ''}, 0 seeders."
            e["act"] = ("Find another", "replace")
        elif kind == "gap":
            e["why"] = f"You have {episode_ranges(e.get('local') or [])}, not {eps}."
            e["act"] = ("Find it", "find")
        else:
            e["why"] = f"Finished airing; episode{'s' if len(e['eps']) > 1 else ''} {eps} missing."
            e["act"] = ("Find a batch", "find")
        e["key"] = f"{kind}:{mid}"

    def fix_missed(self, e, how=None, records=None):
        """Do what a Needs you entry's button says. how: group / learn / replace / find / download / search."""
        how = how or e["act"][1]
        mid, title = e["mid"], e["title"]
        t = (e.get("media") or {}).get("title") or {}
        if how == "group" and e.get("best") and e["best"].get("group"):
            group = e["best"]["group"]
            self.use_group_for(mid, title, group)
            pick = []
            for ep in e["eps"]:
                st = self.load_missed().get(f"{mid}:{ep}") or {}
                rec = next((r for r in st.get("releases") or [] if r.get("group") == group), None)
                if rec:
                    pick.append(self.item_from(rec, mid, ep))
            self.mark_done(mid, e["eps"])
            if pick:
                self.download(pick)
        elif how == "download":
            items = [self.item_from(r, mid, r.get("ep") or e["eps"][0]) for r in records or []]
            if not items and e.get("best"):
                items = [self.item_from(e["best"], mid, e["eps"][-1])]
            self.mark_done(mid, [i["episode"] for i in items])
            if items:
                self.download(items)
        elif how == "learn" and e["names"]:
            self.remember_alias(mid, e["names"][0], "learned")
            self.notify.emit(f"Kura will now recognize “{e['names'][0]}” as {title}")
            self.queue_search(mid, e["eps"])
        elif how == "replace":
            self.queue_search(mid, e["eps"], replace=e.get("hash"))
        elif how == "search":
            self.queue_search(mid, e["eps"])
        elif how == "find":
            name = t.get("romaji") or t.get("english") or title
            return f"{name} {e['eps'][0]:02d}" if e["kind"] == "gap" and len(e["eps"]) == 1 else name
        self.missed_changed.emit()
        return None

    def mark_done(self, mid, eps):
        state = self.load_missed()
        for ep in eps:
            state.setdefault(f"{mid}:{ep}", {"aired": time.time(), "tries": []}).update(done=True)
        self.save_catchup(state)

    def skip_missed(self, e):
        state = self.load_missed()
        for ep in e["eps"]:
            state.setdefault(f"{e['mid']}:{ep}", {"aired": time.time(), "tries": []})["dismissed"] = True
        self.save_catchup(state)
        if e["kind"] in ("gap", "unfinished", "stuck"):
            skipped = dict(self.settings.get("missed_skipped") or {})
            skipped[e["key"]] = sorted(set(skipped.get(e["key"], [])) | set(e["eps"]))
            self._remember("missed_skipped", skipped)
        self.missed_changed.emit()

    def stop_tracking(self, mid):
        self._remember("missed_ignore", sorted(set(self.settings.get("missed_ignore") or []) | {mid}))
        self.missed_changed.emit()

    # ---- a search about one show: every one of its names, the show strip, back to where you came from
    NAME_KINDS = {"romaji": "Romaji", "english": "English", "synonym": "Other name", "yours": "Your name",
                  "learned": "Learned"}

