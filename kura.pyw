    def root(self):
        return cap_mod.root_dir(self.settings)

    # ---- reading the folder
    def showEvent(self, e):
        super().showEvent(e)
        if self.stale:
            self.refresh()

    def saved(self, path, kind):
        """A new capture (from the player): show it now if this page is open."""
        self.stale = True
        if self.isVisible():
            self.refresh()

    def refresh(self):
        self.stale = False
        root = self.root()
        index = cap_mod.load_index(self.settings)
        files = []
        if root.is_dir():
            for f in root.rglob("*"):
                if f.is_file() and f.suffix.lower() in CAPTURE_IMAGES + CAPTURE_VIDEOS:
                    meta = index.get(os.path.relpath(f, root)) or {}
                    kind = meta.get("kind") or ("sheet" if "contact sheet" in f.name.lower() else
                                                "screenshot" if f.suffix.lower() in CAPTURE_IMAGES else "clip")
                    show = meta.get("show") or (f.parent.name if f.parent != root else "")
                    files.append({"path": str(f), "kind": kind, "show": show, "meta": meta,
                                  "time": f.stat().st_mtime, "size": f.stat().st_size})
        files.sort(key=lambda x: -x["time"])
        self.files = files
        pick = self.show_pick.currentData()
        self.show_pick.blockSignals(True)
        self.show_pick.clear()
        self.show_pick.addItem(f"All shows ({len(files)})", "")
        for name in sorted({f["show"] for f in files if f["show"]}, key=str.lower):
            self.show_pick.addItem(f"{name} ({sum(1 for f in files if f['show'] == name)})", name)
        self.show_pick.setCurrentIndex(max(0, self.show_pick.findData(pick)))
        self.show_pick.blockSignals(False)
        self.fill()

    def fill(self):
        show, kind = self.show_pick.currentData() or "", self.kind.value()
        shown = [f for f in self.files if (not show or f["show"] == show) and (kind == "all" or f["kind"] == kind)]
        cur = self.current()
        self.grid.clear()
        placeholder = QPixmap(240, 135)
        placeholder.fill(QColor(C["surface2"]))
        for f in shown:
            it = QListWidgetItem(QIcon(self.thumbs.get(f["path"]) or placeholder), Path(f["path"]).stem[-40:])
            it.setData(Qt.UserRole, f["path"])
            it.setToolTip(f["path"])
            self.grid.addItem(it)
            if cur and f["path"] == cur:
                self.grid.setCurrentItem(it)
        self.count.setText(f"{len(shown)} shown" if self.files else f"Nothing yet · saved in {self.root()}")
        self.load_thumbs([f["path"] for f in shown if f["path"] not in self.thumbs])
        if self.grid.currentItem() is None:
            self.preview(None)

    def load_thumbs(self, paths):
        if self.loader is not None or not paths:
            return

        def work():
            for p in paths[:400]:
                img = capture_thumb(p)
                if img is not None:
                    QTimer.singleShot(0, self, lambda p=p, img=img: self.on_thumb(p, img))
        self.loader = BgCall(work)
        self.loader.done.connect(lambda *_: (self.loader.wait(), setattr(self, "loader", None)))
        self.loader.start()

    def on_thumb(self, path, img):
        pm = QPixmap.fromImage(img.scaled(240, 135, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        canvas = QPixmap(240, 135)
        canvas.fill(QColor(C["bg"]))
        p = QPainter(canvas)
        p.drawPixmap((240 - pm.width()) // 2, (135 - pm.height()) // 2, pm)
        if Path(path).suffix.lower() in CAPTURE_VIDEOS:   # a play mark on clips
            p.setRenderHint(QPainter.Antialiasing)
            p.setBrush(QColor(0, 0, 0, 150))
            p.setPen(Qt.NoPen)
            p.drawEllipse(QPointF(120, 67), 20, 20)
            p.setBrush(QColor("white"))
            p.drawPolygon([QPointF(114, 57), QPointF(114, 77), QPointF(131, 67)])
        p.end()
        self.thumbs[path] = canvas
        for i in range(self.grid.count()):
            it = self.grid.item(i)
            if it.data(Qt.UserRole) == path:
                it.setIcon(QIcon(canvas))
        if self.current() == path:
            self.preview(self.grid.currentItem())

    # ---- the one picked
    def current(self):
        it = self.grid.currentItem() if hasattr(self, "grid") else None
        return it.data(Qt.UserRole) if it is not None else None

    def entry(self, path):
        return next((f for f in self.files if f["path"] == path), None)

    def preview(self, it):
        path = it.data(Qt.UserRole) if it is not None else None
        f = self.entry(path) if path else None
        for b in (self.open_btn, self.copy_btn, self.reveal_btn, self.delete_btn):
            b.setEnabled(f is not None)
        if f is None:
            self.big.clear()
            self.what.setText("Nothing picked")
            self.info.setText("Pick a screenshot or clip.")
            self.art_box.hide()
            return
        img = None
        if f["kind"] != "clip":
            img = cached_image(path, None) if Path(path).suffix.lower() != ".gif" else QImage(path)
        pm = QPixmap.fromImage(img) if img is not None and not img.isNull() else self.thumbs.get(path)
        if pm is not None:
            self.big.setPixmap(pm.scaled(368, 210, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        else:
            self.big.clear()
        meta = f["meta"]
        ep = ""
        if meta.get("episode") is not None:
            ep = (f"Season {meta['season']} · " if meta.get("season") else "") + f"Episode {meta['episode']}"
        at = ""
        if meta.get("at") is not None and f["kind"] != "sheet":
            at = cap_mod.stamp(meta["at"]) + (f" – {cap_mod.stamp(meta['end'])}" if meta.get("end") is not None else "")
        self.what.setText(f["show"] or Path(path).stem)
        bits = [{"screenshot": "Screenshot", "clip": "Clip", "sheet": "Contact sheet"}[f["kind"]], ep, at,
                fmt_bytes(f["size"]), datetime.fromtimestamp(f["time"]).strftime("%d %b %Y, %H:%M")]
        self.info.setText("  ·  ".join(b for b in bits if b))
        folder = meta.get("folder")
        can_art = f["kind"] == "screenshot" and bool(folder) and os.path.isdir(folder or "")
        self.art_box.setVisible(can_art)
        if can_art:
            art = (self.settings.get("custom_art") or {}).get(os.path.normcase(folder)) or {}
            for sw, kind in ((self.banner_sw, "banner"), (self.icon_sw, "icon")):
                sw.blockSignals(True)
                sw.setChecked(os.path.normcase(art.get(kind) or "") == os.path.normcase(path))
                sw.blockSignals(False)
            self.icon_sw.setEnabled(self.icon_job is None)

    def open_file(self, path):
        if path and os.name == "nt":
            os.startfile(path)

    def copy(self):
        path = self.current()
        if not path:
            return
        from PySide6.QtCore import QMimeData
        if Path(path).suffix.lower() in (".png", ".jpg", ".jpeg", ".webp"):
            QApplication.clipboard().setImage(QImage(path))
        else:
            md = QMimeData()
            md.setUrls([QUrl.fromLocalFile(path)])
            QApplication.clipboard().setMimeData(md)
        self.notify.emit("Copied")

    def menu(self, pos):
        if self.grid.itemAt(pos) is None:
            return
        m = QMenu(self)
        m.addAction("Open", lambda: self.open_file(self.current()))
        m.addAction("Copy", self.copy)
        m.addAction("Show in folder", lambda: subprocess_open_select(self.current()))
        m.addSeparator()
        m.addAction("Delete", self.delete)
        m.exec(self.grid.viewport().mapToGlobal(pos))

    def delete(self):
        paths = [it.data(Qt.UserRole) for it in self.grid.selectedItems()] or ([self.current()] if self.current() else [])
        if not paths:
            return
        if QMessageBox.question(self, "Captures", f"Send {len(paths)} capture{'s' if len(paths) != 1 else ''} to the "
                                "Recycle Bin?") != QMessageBox.Yes:
            return
        err = recycle(paths)
        if err:
            QMessageBox.warning(self, "Captures", err)
        cap_mod.forget(self.settings, [p for p in paths if not os.path.exists(p)])
        self.refresh()

    # ---- banner / folder icon
    def set_art(self, kind, on):
        path = self.current()
        f = self.entry(path) if path else None
        folder = (f or {}).get("meta", {}).get("folder")
        if not folder:
            return
        key = os.path.normcase(folder)
        arts = dict(self.settings.get("custom_art") or {})
        mine = dict(arts.get(key) or {})
        if on:
            mine[kind] = path
        else:
            mine.pop(kind, None)
        if mine:
            arts[key] = mine
        else:
            arts.pop(key, None)
        self.settings["custom_art"] = arts
        save_settings(self.settings)
        if kind == "banner":
            self.art_changed.emit(folder)
            self.notify.emit("Banner set" if on else "Back to AniList's banner")
            return
        org.CUSTOM_ICONS = {k for k, v in arts.items() if v.get("icon")}
        mid = (f.get("meta") or {}).get("mid")
        cover = ((media_for(mid, self.account) or {}).get("coverImage") or {}).get("extraLarge") if mid else None
        self.icon_sw.setEnabled(False)

        def work():
            if on:
                return org.icon_from_image(Path(folder), path)
            if not cover:
                raise OSError("no AniList cover known for this show")
            return org.make_icon(Path(folder), {"cover": cover}, False, force=True)
        self.icon_job = BgCall(work)
        self.icon_job.done.connect(lambda _r, err, on=on: self.icon_done(err, on))
        self.icon_job.start()

    def icon_done(self, err, on):
        self.icon_job.wait()
        self.icon_job = None
        self.icon_sw.setEnabled(True)
        if err:
            self.notify.emit(f"Couldn't change the folder icon: {err}")
        else:
            self.notify.emit("Folder icon set" if on else "Folder icon back to the AniList cover")

    # ---- contact sheet for any episode
    def make_sheet(self):
        if self.sheet_job is not None:
            return
        if not subs_mod.ffmpeg_installed():
            QMessageBox.information(self, "Captures", "Contact sheets need FFmpeg: Settings → Captures → Install FFmpeg.")
            return
        start = self.settings.get("library") or ""
        f, _ = QFileDialog.getOpenFileName(self, "Contact sheet of which episode?", start,
                                           "Videos (*.mkv *.mp4 *.avi *.webm *.m4v)")
        if not f:
            return
        folder, name = None, Path(f).parent.name
        for show in getattr(self.library, "items", {}) or {}:
            if os.path.normcase(os.path.abspath(f)).startswith(os.path.normcase(os.path.abspath(show)) + os.sep):
                folder, name = show, Path(show).name
        parsed = org.anitopy_parse(Path(f).name) or {}
        info = {"path": f, "show": name, "folder": folder, "episode": parsed.get("episode_number")}
        try:
            info["episode"] = float(info["episode"]) if info["episode"] is not None else None
            if info["episode"] is not None and info["episode"].is_integer():
                info["episode"] = int(info["episode"])
        except (TypeError, ValueError):
            info["episode"] = None
        dest = cap_mod.out_path(self.settings, info, ".jpg", 0)
        dest = dest.with_name(dest.stem.rsplit(" - ", 1)[0] + " - contact sheet.jpg")
        self.count.setText("Making the contact sheet…")
        st = dict(self.settings)

        def work():
            path = cap_mod.contact_sheet(f, dest, name, Path(f).name)
            cap_mod.remember(st, path, info, 0, "sheet")
            return path
        self.sheet_job = BgCall(work)
        self.sheet_job.done.connect(self.sheet_done)
        self.sheet_job.start()

    def sheet_done(self, path, err):
        self.sheet_job.wait()
        self.sheet_job = None
        self.notify.emit(f"Couldn't make the contact sheet: {err}" if err else "Contact sheet saved")
        self.refresh()

    def shutdown(self):
        for job in (self.loader, self.icon_job, self.sheet_job):
            if job is not None:
                job.wait(30000)


# ---------------------------------------------------------------- Live TV

def live_snapshot(indexes, account, durations, progress=None, cancelled=None, probe=True):
    """What Live TV builds channels from (no Qt): every show with its episodes and their lengths, openings /
    endings, and what AniList / your list say about it."""
    shows, files = [], []
    for folder, idx in sorted(indexes.items()):
        if not idx or not idx.get("mid"):
            continue
        m = media_for(idx["mid"], account) or {}
        entry = (account.entries.get(idx["mid"]) if account and account.connected else None) or {}
        eps = []
        for n, sid in enumerate(idx.get("seasons") or [], 1):
            for ep, path in sorted((idx.get("local") or {}).get(sid, {}).items()):
                if os.path.isfile(path):
                    eps.append({"path": path, "season": n, "ep": ep, "sid": sid})
        if not eps:
            continue
        try:
            extras = livetv_mod.find_extras(folder, kind_of=org.extra_kind_of,
                                            skip=set((APP.get("settings") or {}).get("extras_skip") or []))
        except OSError:
            extras = []
        studios = [x.get("name") for x in ((m.get("studios") or {}).get("nodes") or [])
                   if x.get("name") and x.get("isAnimationStudio") is not False]
        start_index = 0
        if entry.get("status") in ("CURRENT", "REPEATING"):   # Catch-up starts at your next episode
            prog = entry.get("progress") or 0
            first = [i for i, e in enumerate(eps) if e["sid"] == idx["mid"] and (e["ep"] or 0) > prog]
            start_index = first[0] if first else 0
        details = saved_details(idx["mid"]) or {}
        shows.append({"key": folder, "name": media_title(m) if m.get("title") else Path(folder).name,
                      "mid": idx["mid"], "genres": m.get("genres") or details.get("genres") or [],
                      "studios": studios, "format": m.get("format") or details.get("format"),
                      "year": m.get("seasonYear") or (m.get("startDate") or {}).get("year"),
                      "score": m.get("averageScore") or details.get("averageScore"),
                      "status": entry.get("status"), "my_score": entry.get("score"),
                      "cover": (m.get("coverImage") or {}).get("extraLarge"), "eps": eps, "extras": extras,
                      "start_index": start_index})
        files += [e["path"] for e in eps] + [x["path"] for x in extras]
    if probe and subs_mod.ffmpeg_installed():
        durations.fill(files, progress=progress, cancelled=cancelled)
    for s in shows:
        fallback = ((media_for(s["mid"], account) or {}).get("duration") or 24) * 60
        for e in s["eps"]:
            e["dur"] = durations.get(e["path"]) or fallback
            try:
                e["mtime"] = os.path.getmtime(e["path"])
            except OSError:
                e["mtime"] = 0
        for x in s["extras"]:
            x["dur"] = durations.get(x["path"]) or 0
    planning = []
    if account and account.connected:   # trailers as "commercials": shows you plan to watch
        for mid, e in account.view().items():
            if e.get("status") != "PLANNING":
                continue
            d = saved_details(mid) or {}
            tr = d.get("trailer") or {}
            if tr.get("site") == "youtube" and tr.get("id"):
                m = e.get("media") or {}
                planning.append({"mid": mid, "title": media_title(m) if m.get("title") else str(mid), "trailer": tr,
                                 "cover": (m.get("coverImage") or {}).get("extraLarge")})
    return shows, planning


class LiveProvider:
    """What the player asks while it shows a channel (player.LIVE)."""

    def __init__(self, tv, account):
        self.tv, self.account = tv, account

    def now(self, cid, ts=None):
        return self.tv.on_at(cid, ts)

    def after(self, cid, prog):
        return self.tv.after(cid, prog)

    def upcoming(self, cid):
        return self.tv.upcoming(cid)

    def programs(self, cid, t0, t1):
        """The programmes on a channel between two moments (the player's guide), into tomorrow when needed."""
        out = []
        for day in {livetv_mod.day_of(t0), livetv_mod.day_of(t1)}:
            ch = self.tv.channel(cid, day)
            out += [p for p in (ch or {}).get("programs") or [] if p["end"] > t0 and p["start"] < t1]
        return sorted({p["start"]: p for p in out}.values(), key=lambda p: p["start"])

    def remind(self, cid, prog):
        """Remind me / don't (the player's guide): True when a reminder is now set."""
        page = getattr(self, "page", None)
        if page is None:
            return False
        on = not any((r["cid"], r["start"]) == (cid, prog["start"]) for r in self.tv.state["reminders"])
        page.remind(cid, prog, on)
        return on

    def channels(self):
        return self.tv.channels()

    def channel(self, cid):
        return self.tv.channel(cid)

    def item_for(self, cid, prog):
        ch = self.channel(cid) or {}
        sub = ""
        if prog.get("kind") == "episode" and prog.get("ep") is not None:
            sub = (f"Season {prog['season']} · " if prog.get("season") else "") + f"Episode {prog['ep']}"
        return {"path": prog.get("path"), "mid": prog.get("mid"), "episode": prog.get("ep") if prog.get("kind") ==
                "episode" else None, "season": prog.get("season"), "title": prog.get("title") or ch.get("name", ""),
                "subtitle": sub, "live": True, "track": bool(ch.get("track")) and prog.get("kind") == "episode"}

    def cover(self, prog):
        mid = prog.get("mid")
        if not mid:
            return None
        for f in COVER_DIR.glob(f"{mid}.*"):
            img = QImage(str(f))
            if not img.isNull():
                return img
        return None

    def trailer_url(self, prog):
        if not prog.get("trailer") or not trl.installed():
            return None
        try:
            return trl.resolve(prog["trailer"])
        except Exception:
            return None


def live_banner(mid):
    """(cached banner QImage or None, banner URL or None) for a show: Live TV's banner and tiles."""
    if not mid:
        return None, None
    for f in COVER_DIR.glob(f"banner_{mid}.*"):
        img = QImage(str(f))
        if not img.isNull():
            return img, None
    return None, ((details_file().get(str(mid)) or {}).get("data") or {}).get("bannerImage")


def prog_line(prog):
    """'S1 · E7 · 9:22 – 9:46' (or Break · times) for a Live TV programme."""
    bits = []
    if prog and prog.get("kind") == "episode" and prog.get("ep") is not None:
        bits.append((f"Season {prog['season']} · " if prog.get("season") else "") + f"Episode {prog['ep']}")
    elif prog and prog.get("kind") != "episode":
        bits.append("Break")
    if prog:
        bits.append(f"{player_mod.clock(prog['start'])} – {player_mod.clock(prog['end'])}")
    return "  ·  ".join(bits)


