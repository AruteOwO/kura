def setup_kura_log():
    """kura.log (1 MB, one older copy): errors nobody would otherwise see under pythonw / Kura.exe, Qt's
    warnings, and what Kura did (backups, restores). Tools → Logs shows it."""
    from logging.handlers import RotatingFileHandler
    try:
        h = RotatingFileHandler(KURA_LOG, maxBytes=1_000_000, backupCount=1, encoding="utf-8")
    except OSError:
        return
    h.setFormatter(logging.Formatter("%(asctime)s  %(levelname)-7s  %(message)s", "%Y-%m-%d %H:%M:%S"))
    klog.addHandler(h)
    klog.setLevel(logging.INFO)
    klog.propagate = False   # the organizer's logging setup stays as it was

    old_hook = sys.excepthook

    def hook(kind, value, tb):
        klog.error("Unexpected error:\n" + "".join(traceback.format_exception(kind, value, tb)).rstrip())
        if old_hook is not None and sys.stderr is not None:
            old_hook(kind, value, tb)
    sys.excepthook = hook
    threading.excepthook = lambda a: hook(a.exc_type, a.exc_value, a.exc_traceback)

    from PySide6.QtCore import QtMsgType, qInstallMessageHandler
    seen = {}

    def qt_message(kind, _ctx, msg):
        if kind in (QtMsgType.QtDebugMsg, QtMsgType.QtInfoMsg):
            return
        seen[msg] = seen.get(msg, 0) + 1
        if seen[msg] <= 3:   # the same warning over and over says nothing new
            (klog.error if kind in (QtMsgType.QtCriticalMsg, QtMsgType.QtFatalMsg) else klog.warning)(f"Qt: {msg}")
    qInstallMessageHandler(qt_message)
    klog.info(f"Kura started ({'Kura.exe' if FROZEN else 'script'}, {SCRIPT_DIR})")


