def lay_out_hidden(page, draw=False):
    """Give a page in the hidden window its real size before building it: a stack only sizes the page it shows, and
    a hidden widget's layouts wait for its first show (Schedule built at 640 px fitted 3 days, narrow)."""
    from PySide6.QtGui import QResizeEvent

    def settle(w):
        w.ensurePolished()   # its style sheet now, not all at once on the first show
        if QWidget.layout(w):
            QWidget.layout(w).activate()
        if w.testAttribute(Qt.WA_PendingResizeEvent):
            w.setAttribute(Qt.WA_PendingResizeEvent, False)
            QApplication.sendEvent(w, QResizeEvent(QWidget.size(w), QWidget.size(w)))
    chain, w = [], page.parentWidget()
    while w is not None:
        chain.insert(0, w)
        w = w.parentWidget()
    for w in chain:
        settle(w)
    if page.parentWidget() is not None:
        page.resize(QWidget.size(page.parentWidget()))
    todo = [page]
    while todo:
        w = todo.pop()
        settle(w)
        todo += [c for c in w.children() if isinstance(c, QWidget) and not c.isWindow()]
    if draw:   # paint it once off screen: covers scaled, text laid out (the first show was ~250 ms of that)
        page.grab()


def warm_up(win, splash, finish):
    """The loading screen's steps: wait for the library scan and the AniList sync, make today's Live TV line-up, start
    this season's Seasonal list, build Settings and Statistics; each step waits at most a few seconds."""
    t_end = time.time() + 12
    steps = [
        ("Reading your library", lambda: win.library.scanned or not Path(win.settings.get("library") or "").is_dir(), 6),
        ("Syncing your AniList list", lambda: not (win.account and win.account.connected) or
         not getattr(win.account, "refreshing", False), 3),
        ("Making today's Live TV line-up", lambda: win.livetv.job is None, 5),
        ("This season on AniList", None, 0),
        ("Settings and statistics", None, 0),
        ("To download, Schedule and Kickoff", None, 0),
    ]
    state = {"i": -1, "since": 0.0}

    def start(i):
        state["i"], state["since"] = i, time.time()
        text = steps[i][0]
        splash.set_step(text + "…", i / len(steps))
        try:
            if i == 2:
                win.livetv.ensure()
            elif i == 3:
                win.seasonal.lib_ids = win.library.library_ids()
                win.seasonal.load()
            elif i == 4:
                win.settings_page.build_embedded()
                win.stats.render()
            elif i == 5:   # they keep what they made until something changes (mark_dirty / dirty)
                for page in (win.todo, win.schedule):
                    lay_out_hidden(page)
                    page.dirty, page.built_at = False, time.time()
                    page.rebuild()
                    lay_out_hidden(page, draw=True)   # and what it made
                lay_out_hidden(win.kickoff)
                win.kickoff.fresh_rebuild(force=True)
                lay_out_hidden(win.kickoff, draw=True)
        except Exception:
            klog.exception(f"Warm-up step '{text}'")

    def tick():
        i = state["i"]
        if i >= 0:
            ready, wait = steps[i][1], steps[i][2]
            if ready is not None and not ready() and time.time() - state["since"] < wait and time.time() < t_end:
                return
        if i + 1 >= len(steps):
            timer.stop()
            splash.set_step("Ready", 1)
            finish()
            return
        start(i + 1)
    timer = QTimer(splash, interval=120, timeout=tick)
    timer.start()
    tick()


def main():
    global ICON_FONT
    if os.name == "nt":
        try:   # own taskbar button + icon instead of Python's
            import ctypes
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(APP_ID)
        except Exception:
            pass
    QApplication.setAttribute(Qt.AA_ShareOpenGLContexts)   # needed by the trailer player (Qt WebEngine)
    # One graphics API for every GPU widget: Kura's player (OpenGL, mpv) sits inside the main
    # window next to Qt Quick / WebEngine widgets, which would otherwise pick Direct3D 11.
    from PySide6.QtQuick import QQuickWindow, QSGRendererInterface
    QQuickWindow.setGraphicsApi(QSGRendererInterface.OpenGL)
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setStyle("Fusion")
    app.setQuitOnLastWindowClosed(False)   # the tray keeps Kura running; quitting is explicit
    # hover text appears at once: Qt's slide / fade plays in a solid window of its own (square corners flash)
    QApplication.setEffectEnabled(Qt.UI_AnimateTooltip, False)
    QApplication.setEffectEnabled(Qt.UI_FadeTooltip, False)
    app._wheel_debounce = WheelDebounce(app)
    app.installEventFilter(app._wheel_debounce)   # no end-of-page jitter from stray wheel ticks

    # One Kura at a time: a second launch just brings the running one to the front
    from PySide6.QtNetwork import QLocalServer, QLocalSocket
    instance = f"{APP_ID}-{os.environ.get('USERNAME', '')}"
    setup_kura_log()
    if "--restart" in sys.argv:   # the old Kura is still closing: wait for it (up to 20 s)
        for _ in range(80):
            probe = QLocalSocket()
            probe.connectToServer(instance)
            if not probe.waitForConnected(100):
                break
            probe.abort()
            time.sleep(0.25)
    probe = QLocalSocket()
    probe.connectToServer(instance)
    if probe.waitForConnected(300):
        probe.write(b"show")
        probe.waitForBytesWritten(300)
        return 0
    restored = None
    if org is not None:
        try:
            settings_now = json.loads(SETTINGS_FILE.read_text(encoding="utf-8")) if SETTINGS_FILE.exists() else {}
        except (OSError, ValueError):
            settings_now = {}
        restored = backup_mod.apply_pending(SCRIPT_DIR, backup_dir(settings_now))
        if restored is not None:
            klog.info(f"Restore: put back {', '.join(restored[0]) or 'nothing'}" +
                      (f"; problem: {restored[1]}" if restored[1] else ""))

    pal = QPalette()
    for role, color in [(QPalette.Window, C["bg"]), (QPalette.Base, C["surface2"]), (QPalette.AlternateBase, C["surface"]),
                        (QPalette.Text, C["text"]), (QPalette.WindowText, C["text"]), (QPalette.Button, C["surface2"]),
                        (QPalette.ButtonText, C["text"]), (QPalette.Highlight, C["accent"]),
                        (QPalette.HighlightedText, "#ffffff"), (QPalette.ToolTipBase, C["surface2"]),
                        (QPalette.ToolTipText, C["text"]), (QPalette.PlaceholderText, C["faint"])]:
        pal.setColor(role, QColor(color))
    app.setPalette(pal)

    families = set(QFontDatabase.families())
    font = QFont(next((f for f in ("Segoe UI Variable Text", "Segoe UI", "Inter") if f in families), app.font().family()))
    font.setPointSizeF(10)
    app.setFont(font)
    app.setStyleSheet(build_qss())
    ICON_FONT = find_icon_font()
    if load_material() and org is not None:
        player_mod.GLYPH_RESOLVER = lambda g: resolve_glyph(g) + (icon_font,)   # the player uses them too

    if org is None:
        QMessageBox.critical(None, APP_NAME, f"Couldn't load anime_organizer.py:\n\n{IMPORT_ERROR}")
        return 1

    started_by_windows = "--startup" in sys.argv
    quiet = "--selftest" in sys.argv or (started_by_windows and QSystemTrayIcon.isSystemTrayAvailable()
                                         and load_settings().get("start_minimized", True))
    first_run = not SETTINGS_FILE.exists()
    splash = None
    if not quiet:   # the loading screen (and the first time, setup) while the window is made
        splash = KuraSplash()
        splash.show()
        splash.set_step("Starting…", 0.02)
    win = MainWindow()
    if restored is not None:
        done, err = restored
        QTimer.singleShot(1500, lambda: win.notify(
            f"Restore didn't finish: {err}" if err else f"Restored {len(done)} files from the backup"))
    QTimer.singleShot(60_000, win.auto_backup)
    QTimer.singleShot(45_000, win.auto_update_check)
    if "--updated" in sys.argv:   # started by the update script
        QTimer.singleShot(2500, lambda: win.notify(f"Kura updated to {APP_VERSION}", keep=True))
    win.backup_timer = QTimer(win, interval=6 * 3600 * 1000, timeout=win.auto_backup)
    win.backup_timer.timeout.connect(win.auto_update_check)
    win.backup_timer.start()
    QLocalServer.removeServer(instance)
    server = QLocalServer(app)
    server.newConnection.connect(lambda: (server.nextPendingConnection(), win.show_window()))
    server.listen(instance)

    # Kura moved (the entry's program is gone): point the startup entry at this copy. Only then: a second copy (a
    # test install, a self-test) taking over another copy's entry looked like malware to Windows Defender, which
    # quarantined both exes and deleted the entry (Behavior:Win32/Persistence.A!ml, Oct 29 2026)
    target = startup_target() if "--selftest" not in sys.argv else None
    if target is not None and not target.exists():
        try:
            set_startup(True)
        except OSError:
            pass
    if splash is None:
        if not quiet or "--selftest" in sys.argv:
            win.show()
        # else: tray only (started with Windows)
    else:
        def ready():
            win.show()
            win.raise_()
            win.activateWindow()
            splash.close()

        def begin():
            if first_run:   # setup picked the folders and qBittorrent after the window was made: use them now
                win.on_settings_changed()   # library scan, Organize buttons, torrent checks
                win.downloads.apply_settings()   # qBittorrent's Web UI (it was set up as "not used")
                win.settings_page.sync_paths()
            warm_up(win, splash, ready)
        if first_run:
            splash.ensure_wall()
            splash.show_setup(win)
            splash.done.connect(begin)
        else:
            begin()

    if "--selftest" in sys.argv:   # used to check a built Kura.exe: write a report and quit
        report = [f"data folder: {SCRIPT_DIR}", f"frozen: {FROZEN}", f"tray: {win.tray.isVisible()}"]
        report_restore = {}
        global PLAYBACK_STATE_FILE   # the test playback must not touch your resume positions
        PLAYBACK_STATE_FILE = Path(tempfile.gettempdir()) / "kura_selftest_playback.json"

        def web_check():   # the same kind of player view a trailer uses, inside the window
            try:
                from PySide6.QtWebEngineCore import QWebEnginePage
                from PySide6.QtWebEngineWidgets import QWebEngineView
                view = QWebEngineView(win.centralWidget())
                page = QWebEnginePage(trailer_profile(), view)
                page.loadFinished.connect(lambda ok: report.append(f"video player view loads: {ok}"))
                view.setPage(page)
                view.setGeometry(0, 0, 320, 180)
                view.show()
                view.setHtml("<body style='background:#222'>ok</body>")
                win._selftest_page = page
            except Exception as e:
                report.append(f"video engine FAILED: {e}")

        def finish():
            try:
                engine = player_mod.load_mpv(mpv_dirs())
                report.append(f"player engine: mpv loaded ({engine.MPV(vo='null', ao='null').mpv_version})")
            except Exception as e:
                report.append(f"player engine FAILED: {e}")
            report.append(f"library shows: {len(win.library.items)}")
            try:
                d = Path(tempfile.gettempdir()) / "kura_selftest_backup"
                z = backup_mod.make(SCRIPT_DIR, d, "selftest")
                report.append(f"backup: {len(backup_mod.read_manifest(z)['files'])} files")
                shutil.rmtree(d, ignore_errors=True)
            except Exception as e:
                report.append(f"backup FAILED: {e}")
            report.append(f"anitopy parse: {org.parse('[SubsPlease] Sousou no Frieren - 05 (1080p).mkv')[:2]}")
            try:   # screenshots in every format (Pillow's plugins bundled) and the clip encoder on this card
                from PIL import Image, features
                tmp = Path(tempfile.gettempdir()) / "kura_selftest_shot.avif"
                Image.new("RGB", (64, 36), (124, 108, 255)).save(tmp, "AVIF")
                ok = Image.open(tmp).size == (64, 36)
                tmp.unlink()
                gpu = cap_mod.gpu_ok("h264") if subs_mod.ffmpeg_installed() else "no FFmpeg"
                full = cap_mod.has_placebo() if subs_mod.ffmpeg_installed() else "no FFmpeg"
                report.append(f"captures: avif {ok}, webp {features.check('webp')}, NVENC h264 {gpu}, "
                              f"full FFmpeg (enhanced clips) {full}")
            except Exception as e:
                report.append(f"captures FAILED: {e}")
            try:   # Windows' text recognition (Subtitle colours → Make text subtitles) bundled in the exe
                pgs_mod._engine()
                report.append("text recognition (OCR): available")
            except Exception as e:
                report.append(f"text recognition (OCR) FAILED: {e}")
            Path(tempfile.gettempdir(), "kura_selftest.txt").write_text("\n".join(report), encoding="utf-8")
            if hasattr(win, "_selftest_page"):
                import shiboken6
                shiboken6.delete(win._selftest_page)   # pages must go before the profile
            win.close_player()
            win.settings.update(report_restore)   # the test changes nothing you set
            win.quit_app()
        playing = {"wait": True}

        def player_check(tries=0):   # play the first library episode, muted, for a few seconds
            files = []
            for it in win.library.items.values():   # the first show with an episode on disk
                idx = it.data(INDEX_ROLE) or {}
                files = [f for sid in idx.get("seasons", []) if sid for f in (idx["local"].get(sid) or {}).values()
                         if Path(f).exists()]
                if files:
                    break
            if not files:
                if tries < 16:   # the library's first scan can take a few seconds
                    QTimer.singleShot(500, lambda: player_check(tries + 1))
                    return
                report.append("player check skipped: no episodes found")
                playing["wait"] = False
                return
            report_restore.update({k: win.settings.get(k) for k in ("player_volume", "player")})
            win.settings["player_volume"], win.settings["player"] = 0, "builtin"   # silent; put back in finish()
            win.play(files[0])

            def played():
                report.append(f"player plays: {bool(win.player and (win.player.mpv.time_pos or 0) > 0.5)} "
                              f"(at {round((win.player.mpv.time_pos or 0) if win.player else 0, 1)} s, decoder "
                              f"{win.player.mpv.hwdec_current if win.player else '?'})")
                playing["wait"] = False
            QTimer.singleShot(3500, played)

        def finish_when_done(waited=0):
            if playing["wait"] and waited < 10000:
                QTimer.singleShot(500, lambda: finish_when_done(waited + 500))
            else:
                finish()

        QTimer.singleShot(1500, web_check)
        QTimer.singleShot(2500, player_check)
        QTimer.singleShot(7000, finish_when_done)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
