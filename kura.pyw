        self.pick.setEditable(True)
        self.pick.setInsertPolicy(QComboBox.NoInsert)
        self.pick.lineEdit().setPlaceholderText("Pick a show from your library")
        self.pick.activated.connect(lambda _: self.load())
        row.addWidget(self.pick)
