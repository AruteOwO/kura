AIR_LOG_FILE = SCRIPT_DIR / "airing_log.json"


def on_schedule(m):
    """Whether a show is on the Schedule: airing (AniList says RELEASING or knows its next episode), or its last
    episode aired this past week (the airing log still has it)."""
    if not m:
        return False
    if m.get("status") == "RELEASING" or (m.get("nextAiringEpisode") or {}).get("airingAt"):
        return True
    times = (_read_json(AIR_LOG_FILE).get(str(m.get("id"))) or {}).values()
    return any(time.time() - ts < 7 * 86400 for ts in times)


def air_log(account=None):
    """When AniList said each episode airs ({"mid": {"ep": time}}), logged while it was the next one: your list
    only knows each show's next episode, and the Schedule's past days need the ones before. Kept 3 weeks."""
    log = _read_json(AIR_LOG_FILE)
    if account is not None and account.connected:
        now, changed = time.time(), False
        for mid, e in account.entries.items():
            nxt = (e.get("media") or {}).get("nextAiringEpisode") or {}
            if nxt.get("airingAt") and nxt.get("episode"):
                d = log.setdefault(str(mid), {})
                if d.get(str(nxt["episode"])) != nxt["airingAt"]:
                    d[str(nxt["episode"])] = nxt["airingAt"]
                    changed = True
        for mid in list(log):
            old = [k for k, ts in log[mid].items() if now - ts > 21 * 86400]
            for k in old:
                del log[mid][k]
                changed = True
            if not log[mid]:
                del log[mid]
        if changed:
            _write_json(AIR_LOG_FILE, log)
    return log


def aired_at(log, mid, ep, nxt):
    """When episode `ep` aired: logged, else counted back a week per episode from the next one."""
    ts = (log.get(str(mid)) or {}).get(str(ep))
    if ts:
        return ts
    if nxt and nxt.get("airingAt") and nxt.get("episode") and ep < nxt["episode"]:
        return nxt["airingAt"] - 7 * 86400 * (nxt["episode"] - ep)
    return None


class ArtCard(QFrame):
    """A card with the show's cover faded in behind it (Schedule tiles, Needs you): set_image() paints it."""
    clicked = Signal()

    def __init__(self, seed="", fade=0.88):
        super().__init__()
        self.img, self.pm, self.seed, self.fade = None, None, seed, fade
        self.setCursor(Qt.PointingHandCursor)
        self.setAttribute(Qt.WA_StyledBackground, False)

    def set_image(self, img):
        self.img, self.pm = img, None
        self.update()

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.position().toPoint()):
            self.clicked.emit()

    def resizeEvent(self, e):
        self.pm = None
        super().resizeEvent(e)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        path = QPainterPath()
        path.addRoundedRect(r, 12, 12)
        p.setClipPath(path)
        if self.img is not None:
            dpr = self.devicePixelRatioF()
            if self.pm is None:
                self.pm = cover_pixmap(self.img, self.width(), self.height(), dpr)
            p.setOpacity(0.55)
            p.drawPixmap(0, 0, self.pm)
            p.setOpacity(1)
        else:
            p.fillRect(r, placeholder_gradient(r, self.seed))
        g = QLinearGradient(0, 0, 0, self.height())
        g.setColorAt(0, QColor(23, 26, 34, 40))
        g.setColorAt(min(1.0, self.fade * 0.6), QColor(23, 26, 34, 200))
        g.setColorAt(1, QColor(23, 26, 34, 250))
        p.fillRect(r, g)
        p.setClipping(False)
        line = self.property("line") or "#2a2f3c"
        p.setPen(QPen(QColor(line), 1))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)


def pill_label(text, color, bg_alpha=0.2):
    c = QColor(color)
    lbl = QLabel(text)
    lbl.setStyleSheet(f"background: rgba({c.red()},{c.green()},{c.blue()},{bg_alpha}); color: {color};"
                      f" border-radius: 8px; padding: 1px 7px; font-size: 7.5pt; font-weight: 700;")
    lbl.setSizePolicy(QSizePolicy.Maximum, QSizePolicy.Fixed)
    return lbl


class FitTitle(QLabel):
    """A title that wraps onto as many lines as fit; only when even that runs out does the last line end in "…"
    (the full title is the tooltip)."""

    def __init__(self, text, px=12):
        super().__init__()
        self.full = text
        self.setToolTip(text)
        self.setWordWrap(True)
        self.setStyleSheet(f"font-weight: 700; font-size: {px}px; background: transparent;")
        self.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        self.base_px = px
        f = QFont(self.font())
        f.setPixelSize(px)
        self.base_line = QFontMetrics(f).lineSpacing()
        self.setText(text)

    def fit(self, width, lines, smallest=10):
        """Wrap into `lines` lines; a smaller font (down to `smallest` px) before anything is cut."""
        f = QFont(self.font())
        px = self.base_px
        while True:
            f.setPixelSize(px)
            fm = QFontMetrics(f)
            room = max(1, int(lines * self.base_line / fm.lineSpacing()))
            if fm.boundingRect(0, 0, max(20, width), 9999, Qt.TextWordWrap, self.full).height() <= fm.lineSpacing() * room                     or px <= smallest:
                break
            px -= 1
        self.setStyleSheet(f"font-weight: 700; font-size: {px}px; background: transparent;")
        lines = room
        text = self.full
        while text and fm.boundingRect(0, 0, max(20, width), 9999, Qt.TextWordWrap, text).height() > fm.lineSpacing() * lines:
            cut = text[:-1].rsplit(" ", 1)[0] if " " in text[:-1] else text[:-2]
            text = cut.rstrip(" ,:-·") + "…" if cut else ""
            if text == "…":
                break
        self.setText(text)


