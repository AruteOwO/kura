def secret_encode(text):
    """Settings-safe form of a password: encrypted for this Windows user (DPAPI)."""
    import base64
    if not text:
        return ""
    raw = text.encode()
    return base64.b64encode(acct._dpapi(raw, True) if org.IS_WINDOWS else raw).decode()


def secret_decode(text):
    import base64
    try:
        raw = base64.b64decode(text or "")
        return (acct._dpapi(raw, False) if org.IS_WINDOWS and raw else raw).decode()
    except (OSError, ValueError):
        return ""


def qbit_client(s):
    return tor.QBit(s.get("qbit_url"), s.get("qbit_user", ""), secret_decode(s.get("qbit_password")))


def load_settings():
    s = default_settings()
    try:
        saved = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        saved = {}
    s.update(saved)
    # Torrent options from before the Taiga-style settings
    if saved.get("torrent_interval") and "torrent_auto_check" not in saved:
        s["torrent_auto_check"], s["torrent_interval_min"] = True, int(saved["torrent_interval"])
    if saved.get("torrent_auto") and "torrent_new_action" not in saved:
        s["torrent_new_action"] = "download"
    if "torrent_app" not in saved and saved.get("torrent_client"):
