class CloseOverlay(QWidget):
    """"Closing Kura": two choice cards over the dimmed window (close_action = ask).
    chosen(choice, always) with choice "tray" / "quit"; cancelled()."""
    chosen = Signal(str, bool)
    cancelled = Signal()

    def __init__(self, host):
        super().__init__(host)
        self.setFocusPolicy(Qt.StrongFocus)
        self.panel = QFrame(self)
        self.panel.setObjectName("closepanel")
        self.panel.setStyleSheet(f"QFrame#closepanel {{ background: {C['surface']}; border: 1px solid {C['border_hi']};"
                                 f" border-radius: 16px; }}")
        self.panel.setFixedWidth(452)
        v = QVBoxLayout(self.panel)
        v.setContentsMargins(22, 20, 22, 18)
        v.setSpacing(4)
        t = QLabel("Closing Kura")
        t.setStyleSheet("font-size: 13pt; font-weight: 600; background: transparent;")
        v.addWidget(t)
        d = label("What should happen when you close the window?", "muted")
        d.setStyleSheet("background: transparent;")
        v.addWidget(d)
        v.addSpacing(12)
        cards = QHBoxLayout()
        cards.setSpacing(12)
        self.cards = {
            "tray": ChoiceCard("", C["accent"], "Keep running in the tray",
                               "Torrent checks and organizing keep going."),
            "quit": ChoiceCard("", C["bad"], "Quit Kura", "Everything stops until you open it again."),
        }
        for key, c in self.cards.items():
            c.clicked.connect(lambda k=key: self.select(k))
            c.activated.connect(lambda k=key: (self.select(k), self.confirm()))
            cards.addWidget(c)
        v.addLayout(cards)
        v.addSpacing(14)
        foot = QHBoxLayout()
        foot.setSpacing(10)
        self.always = Toggle(False)
        self.always.setFocusPolicy(Qt.NoFocus)
        foot.addWidget(self.always)
        txt = ClickLabel("Always do this")
        txt.setStyleSheet("background: transparent;")
        txt.clicked.connect(self.always.toggle)
        foot.addWidget(txt)
        foot.addStretch(1)
        cancel = QPushButton("Cancel")
        cancel.setStyleSheet(f"QPushButton {{ background: transparent; border: none; color: {C['muted']}; padding: 8px 12px; }}"
                             f" QPushButton:hover {{ color: {C['text']}; }}")
        cancel.setCursor(Qt.PointingHandCursor)
        cancel.clicked.connect(self.cancel)
        go = QPushButton("Continue")
        go.setObjectName("primary")
        go.setCursor(Qt.PointingHandCursor)
        go.clicked.connect(self.confirm)
        for b in (cancel, go):
            b.setFocusPolicy(Qt.NoFocus)
            foot.addWidget(b)
        v.addLayout(foot)
        self.choice = "tray"
        self.fade = None
        host.installEventFilter(self)
        self.hide()

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Resize and self.isVisible():
            self.setGeometry(obj.rect())
        return False

    def select(self, key):
        self.choice = key
        for k, c in self.cards.items():
            c.set_selected(k == key)

    def open(self):
        host = self.parentWidget()
        self.setGeometry(host.rect())
        self.select("tray")
        self.always.setChecked(False)
        self.place()
        self.show()
        self.raise_()
        self.setFocus()
        eff = QGraphicsOpacityEffect(self)
        self.setGraphicsEffect(eff)
        self.fade = QPropertyAnimation(eff, b"opacity", self)
        self.fade.setDuration(150)
        self.fade.setStartValue(0.0)
        self.fade.setEndValue(1.0)
        self.fade.finished.connect(lambda: self.setGraphicsEffect(None))
        self.fade.start()

    def place(self):
        self.panel.adjustSize()
        self.panel.move((self.width() - self.panel.width()) // 2, (self.height() - self.panel.height()) // 2)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.place()

    def paintEvent(self, _):
        QPainter(self).fillRect(self.rect(), QColor(5, 6, 10, 150))

    def mousePressEvent(self, e):
        if not self.panel.geometry().contains(e.position().toPoint()):
            self.cancel()   # a click on the dimmed window = Cancel

    def keyPressEvent(self, e):
        k = e.key()
        if k == Qt.Key_Escape:
            self.cancel()
        elif k in (Qt.Key_Return, Qt.Key_Enter, Qt.Key_Space):
            self.confirm()
        elif k in (Qt.Key_Left, Qt.Key_Right, Qt.Key_Tab):
            self.select("quit" if self.choice == "tray" else "tray")

    def confirm(self):
        self.hide()
        self.chosen.emit(self.choice, self.always.isChecked())

    def cancel(self):
        self.hide()
        self.cancelled.emit()


class CountdownBar(QWidget):
    """A thin bar that drains over `seconds`, timed by the clock (not by counting timer ticks), so it moves
    smoothly and ends on time; pause()/resume() while the mouse is on the notice."""
    done = Signal()

    def __init__(self, seconds):
        super().__init__()
        self.seconds = seconds
        self.setFixedHeight(3)
        self.clock = QElapsedTimer()
        self.used = 0.0          # seconds counted before the current run
        self.running = False
        self.timer = QTimer(self, interval=16, timeout=self.update)
        self.timer.setTimerType(Qt.PreciseTimer)

    def start(self):
        self.used, self.running = 0.0, True
        self.clock.start()
        self.timer.start()
        self.update()

    def elapsed(self):
        return self.used + (self.clock.elapsed() / 1000 if self.running else 0)

    def pause(self):
        if self.running:
            self.used, self.running = self.elapsed(), False

    def resume(self):
        if not self.running and self.timer.isActive():
            self.running = True
            self.clock.restart()

    def stop(self):
        self.timer.stop()
        self.running = False

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect())
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(255, 255, 255, 30))
        p.drawRoundedRect(r, 1.5, 1.5)
        left = max(0.0, 1 - self.elapsed() / self.seconds)
        if left > 0:
            p.setBrush(QColor(C["accent"]))
            p.drawRoundedRect(QRectF(0, 0, r.width() * left, r.height()), 1.5, 1.5)
        elif self.timer.isActive():
            self.stop()
            QTimer.singleShot(0, self.done.emit)


class TrayNotice(QWidget):
    """close_action = tray with close_tray_notice on: the window goes to the tray at once and this
    notification slides up at the bottom right of the screen: "Kura is still running", Quit Kura /
    Open Kura / Don't show again, disappearing after a countdown (the mouse on it pauses it)."""
    quit = Signal()
    reopen = Signal()
    never = Signal()   # "Don't show again"
    SECONDS = 6.0
    SHADOW = 18

    def __init__(self):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setAttribute(Qt.WA_ShowWithoutActivating)
        self.setFixedWidth(380 + 2 * self.SHADOW)
        v = QVBoxLayout(self)
        sh = self.SHADOW
        v.setContentsMargins(sh + 16, sh + 16, sh + 16, sh + 12)
        v.setSpacing(0)
        head = QHBoxLayout()
        head.setSpacing(12)
        logo = QLabel()
        logo.setPixmap(app_icon().pixmap(36, 36))
        logo.setFixedSize(36, 36)
        head.addWidget(logo, 0, Qt.AlignTop)
        texts = QVBoxLayout()
        texts.setSpacing(3)
        t = QLabel("Kura is still running")
        t.setStyleSheet("font-weight: 600; background: transparent;")
        texts.addWidget(t)
        d = label("It's in the tray, checking for new episodes and organizing downloads.", "muted", wrap=True)
        d.setStyleSheet("background: transparent; font-size: 9pt;")
        texts.addWidget(d)
        head.addLayout(texts, 1)
        x = QPushButton()
        x.setFixedSize(24, 24)
        x.setIcon(glyph_icon("\uE8BB", C["muted"], C["text"], px=10))
        x.setCursor(Qt.PointingHandCursor)
        x.setToolTip("Dismiss")
        x.setStyleSheet("QPushButton { background: transparent; border: none; border-radius: 6px; padding: 0px; }"
                        f" QPushButton:hover {{ background: {C['hover']}; }}")
        x.clicked.connect(lambda: self.finish(None))
        head.addWidget(x, 0, Qt.AlignTop)
        v.addLayout(head)
        v.addSpacing(14)
        acts = QHBoxLayout()
        acts.setSpacing(8)
        quit_btn = QPushButton("Quit Kura")
        quit_btn.clicked.connect(lambda: self.finish(self.quit))
        open_btn = QPushButton("Open Kura")
        open_btn.clicked.connect(lambda: self.finish(self.reopen))
        for b in (quit_btn, open_btn):
            b.setCursor(Qt.PointingHandCursor)
            b.setFocusPolicy(Qt.NoFocus)
            acts.addWidget(b)
        acts.addStretch(1)
        self.never_sw = Toggle(False)
        self.never_sw.setFocusPolicy(Qt.NoFocus)
        self.never_sw.setToolTip("Close to tray without this notification (Settings → App)")
        acts.addWidget(self.never_sw)
        never_lbl = ClickLabel("Don't show again")
        never_lbl.setStyleSheet(f"color: {C['muted']}; font-size: 9pt; background: transparent;")
        never_lbl.clicked.connect(self.never_sw.toggle)
        acts.addWidget(never_lbl)
        v.addLayout(acts)
        v.addSpacing(12)
        self.bar = CountdownBar(self.SECONDS)
        self.bar.done.connect(lambda: self.finish(None))
        v.addWidget(self.bar)
        self.anims = []
        self.hide()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        sh = self.SHADOW
        card = QRectF(self.rect()).adjusted(sh, sh, -sh, -sh)
        p.setPen(Qt.NoPen)
        for i in range(sh, 0, -2):   # soft shadow
            p.setBrush(QColor(0, 0, 0, int(40 * (1 - i / sh) ** 2) + 1))
            p.drawRoundedRect(card.adjusted(-i, -i + 4, i, i + 4), 14 + i, 14 + i)
        p.setBrush(QColor(C["surface"]))
        p.setPen(QPen(QColor(C["border_hi"]), 1))
        p.drawRoundedRect(card.adjusted(0.5, 0.5, -0.5, -0.5), 14, 14)

    def start(self, screen):
        """Show at the bottom right of `screen` (the one Kura's window was on), above the taskbar."""
        self.never_sw.setChecked(False)
        self.adjustSize()
        area = (screen or QApplication.primaryScreen()).availableGeometry()
        end = QPoint(area.right() + 1 - self.width() + self.SHADOW - 16,   # card 16 px from the corner
                     area.bottom() + 1 - self.height() + self.SHADOW - 16)
        self.move(end + QPoint(0, 30))
        self.setWindowOpacity(0.0)
        self.show()
        slide = QPropertyAnimation(self, b"pos", self)
        slide.setDuration(260)
        slide.setEasingCurve(QEasingCurve.OutCubic)
        slide.setStartValue(end + QPoint(0, 30))
        slide.setEndValue(end)
        fade = QPropertyAnimation(self, b"windowOpacity", self)
        fade.setDuration(200)
        fade.setStartValue(0.0)
        fade.setEndValue(1.0)
        self.anims = [slide, fade]
        slide.start()
        fade.start()
        self.bar.start()

    def enterEvent(self, e):
        self.bar.pause()

    def leaveEvent(self, e):
        self.bar.resume()

    def finish(self, signal):
        self.bar.stop()
        if self.never_sw.isChecked():
            self.never.emit()
        fade = QPropertyAnimation(self, b"windowOpacity", self)
        fade.setDuration(160)
        fade.setStartValue(self.windowOpacity())
        fade.setEndValue(0.0)
        fade.finished.connect(self.hide)
        self.anims = [fade]
        fade.start()
        if signal is not None:
            signal.emit()


