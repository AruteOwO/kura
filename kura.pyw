def sample_episode():
    """An episode to preview subtitles on: the last one you played, else one from the library."""
    try:
        state = json.loads(PLAYBACK_STATE_FILE.read_text(encoding="utf-8"))
        for path, _ in sorted(state.items(), key=lambda kv: -((kv[1] or {}).get("t") or 0)):
            if path.lower().endswith(".mkv") and Path(path).exists():
                return path
    except (OSError, ValueError, AttributeError):
        pass
    lib = APP.get("library")
    for folder in list(getattr(lib, "items", None) or {})[:40]:
        f = next(iter(sorted(Path(folder).rglob("*.mkv"))), None)
        if f:
            return str(f)
    return None


class SubPreviewEngine(QThread):
    """A real frame from one of your episodes with its own subtitles restyled: a hidden mpv paused on a line
    of dialogue. Each style change re-renders it (~25 ms). One for the whole app (`sub_preview_engine`)."""
    image = Signal(QImage)
    status = Signal(str)

    def __init__(self):
        super().__init__()
        self.lock, self.wake = threading.Lock(), threading.Event()
        self.want, self.m, self.path, self.header, self.height = {}, None, None, None, 1080
        self.style, self.mode = (False, {}), "player"
        self.dir = Path(tempfile.mkdtemp(prefix="kura_subs_"))
        self.n = 0
        self.slice, self.slice_events, self.added = None, [], None   # picture subtitles (Tools only)
        self.released = threading.Event()

    def request(self, **kw):
        """open=path, style=(on, style), next=True (another line), mode="player"/"files" (picture subtitles
        are only recoloured in files); only the latest of each counts."""
        with self.lock:
            self.want.update(kw)
        self.wake.set()

    def run(self):
        mod = None
        while not self.isInterruptionRequested():
            self.wake.wait(0.3)
            self.wake.clear()
            with self.lock:
                want, self.want = self.want, {}
            if not want:
                continue
            try:
                if want.get("close"):
                    self.close_player()
                    self.released.set()
                    continue
                if "style" in want:
                    self.style = want["style"]
                if "mode" in want and want["mode"] != self.mode:
                    self.mode = want["mode"]
                    if self.m is not None and getattr(self, "kind", "") == "picture":
                        self.path = None   # opened for the other mode: open again
                if want.get("open") and want["open"] != self.path:
                    if mod is None:
                        mod = player_mod.load_mpv(mpv_dirs())
                    self.open(mod, want["open"])
                elif want.get("next") and self.m:
                    self.status.emit("Finding another line…")
                    self.find_line()
                if self.m:
                    self.render()
            except Exception as e:
                self.status.emit(f"No preview ({e})")
        self.close_player()
        shutil.rmtree(self.dir, ignore_errors=True)

    def open(self, mod, path):
        self.close_player()
        self.path, self.header = path, None
        self.slice, self.slice_events, self.added = None, [], None
        self.status.emit("Finding a line of dialogue…")
        m = self.m = mod.MPV(vo="null", ao="null", audio="no", terminal=False, pause=True, start="30%", hwdec="no",
                             sub_auto="no", speed="3", ytdl=False, input_default_bindings=False, osc=False)
        m.play(str(path))
        end = time.time() + 15
        while time.time() < end and not self.isInterruptionRequested() and m.time_pos is None:
            time.sleep(0.05)
        track = next((t for t in m.track_list or [] if t.get("type") == "sub" and t.get("selected")), {})
        self.kind = ("none" if not track else "ass" if track.get("codec") in ("ass", "ssa") else
                     "picture" if track.get("codec") in subs_mod.IMAGE_SUBS else "text")
        end = time.time() + 4
        while self.kind == "ass" and not m.sub_ass_extradata and time.time() < end:
            time.sleep(0.05)
        self.header = m.sub_ass_extradata
        self.height = (m.video_params or {}).get("h") or 1080
        if self.kind in ("ass", "text"):
            self.find_line()
        elif self.kind == "picture" and self.mode == "files":
            self.open_pictures(path)

    def open_pictures(self, path):
        """Blu-ray picture subtitles: a few minutes of each picture track are cut out (only that part of the file
        is read), the busiest is recoloured and shown instead of the file's own track."""
        if not subs_mod.ffmpeg_installed():
            return
        m = self.m
        start = max(0.0, (m.time_pos or 0) - 5)
        best = None
        for t in (t for t in m.track_list or [] if t.get("type") == "sub" and t.get("codec") in subs_mod.PGS):
            dest = self.dir / f"slice_{t.get('ff-index')}.sup"
            subs_mod.extract_slice(path, t.get("ff-index"), start, 240, dest)
            found = pgs_mod.events(dest.read_bytes())
            if best is None or len(found) > len(best[1]):
                best = (dest, found)
        if best and best[1]:
            self.slice, self.slice_events = best[0].read_bytes(), best[1]
            self.goto_picture(start)

    def goto_picture(self, after):
        """Pause on the next picture subtitle after `after` seconds."""
        nxt = next((e for e in self.slice_events if e["start"] > after + 0.2), None) or             (self.slice_events[0] if self.slice_events else None)
        if nxt:
            self.m.command("seek", f"{min(nxt['start'] + 0.4, (nxt['start'] + nxt['end']) / 2):.3f}",
                           "absolute+exact")
            time.sleep(0.5)

    def find_line(self):
        """Play quickly until a line of dialogue (one line of text) is on screen, then pause there."""
        if self.kind == "picture":
            if self.slice_events:
                self.goto_picture(self.m.time_pos or 0)
            return
        m = self.m
        m.pause = False
        end = time.time() + 15
        while time.time() < end and not self.isInterruptionRequested():
            text = m.sub_text or ""
            if len(text) > 6 and "\n" not in text:
                time.sleep(0.15)
                break
            time.sleep(0.03)
        m.pause = True
        time.sleep(0.15)

    def render(self):
        on, style = self.style
        overrides = subs_mod.mpv_overrides(style, self.header, self.height) if on and self.header else []
        self.m["sub-ass-style-overrides"] = overrides
        self.n += 1
        if self.slice is not None:   # picture subtitles: show a recoloured copy of the cut-out part
            st = subs_mod.full_style(style)
            sup = self.dir / f"recolored{self.n}.sup"
            sup.write_bytes(pgs_mod.recolor(self.slice, st["text"], st["outline"]) if on else self.slice)
            if self.added is not None:
                try:
                    self.m.command("sub-remove", self.added)
                except Exception:
                    pass
            self.m.command("sub-add", str(sup), "select")
            self.added = self.m.sid
            self.m.command("seek", f"{self.m.time_pos:.3f}", "absolute+exact")   # redraw while paused
            time.sleep(0.35)
        out = self.dir / f"frame{self.n}.jpg"
        self.m.command("screenshot-to-file", str(out), "subtitles")
        img = QImage(str(out))
        out.unlink(missing_ok=True)
        if not img.isNull():
            self.image.emit(img)
            self.status.emit(self.note())

    def note(self):
        kind = getattr(self, "kind", "")
        if kind == "none":
            return "This episode has no subtitles"
        if kind != "picture":
            return ""
        if self.mode == "player":
            return ("This episode's subtitles are pictures (Blu-ray):\nKura's player can't restyle them.\n"
                    "Tools → Subtitles can recolor them, or turn them into text.")
        if self.slice is None:
            return ("Picture subtitles (Blu-ray / DVD).\nInstall FFmpeg above to preview them." if
                    not subs_mod.ffmpeg_installed() else "Picture subtitles Kura can't read (DVD).")
        return ""

    def release(self, timeout=5):
        """Close the episode the preview has open and wait until it's closed: Windows can't replace a file
        that's open, even by Kura (episode 01 was "left as it was" while the tool's preview showed it)."""
        self.released.clear()
        self.request(close=True)
        return self.released.wait(timeout)

    def close_player(self):
        if self.m is not None:
            try:
                self.m.terminate()
            except Exception:
                pass
            self.m, self.path = None, None


def sub_preview_engine():
    if APP.get("subprev") is None:
        APP["subprev"] = SubPreviewEngine()
        APP["subprev"].start()
    return APP["subprev"]


class ColorSwatch(QPushButton):
    """A colour you can click to change."""
    changed = Signal()

    def __init__(self, colour, title):
        super().__init__()
        self.colour, self.title = colour, title
        self.setFixedSize(52, 32)
        self.setCursor(Qt.PointingHandCursor)
        self.setToolTip(title)
        self.setStyleSheet("QPushButton { padding: 0px; }")
        self.clicked.connect(self.pick)

    def set_colour(self, colour):
        self.colour = colour
        self.update()

    def pick(self):
        c = QColorDialog.getColor(QColor(self.colour), self, self.title)
        if c.isValid() and c.name().upper() != self.colour.upper():
            self.set_colour(c.name().upper())
            self.changed.emit()

    def paintEvent(self, e):
        super().paintEvent(e)
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(QPen(QColor(255, 255, 255, 60), 1))
        p.setBrush(QColor(self.colour))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(6, 6, -6, -6), 5, 5)


class SubPreviewFrame(QWidget):
    """The preview picture (16:9, rounded) with a status line and Another line."""

    def __init__(self):
        super().__init__()
        self.img, self.text = None, ""
        sp = QSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        sp.setHeightForWidth(True)
        self.setSizePolicy(sp)
        self.setMinimumHeight(180)
        self.next_btn = QPushButton(" Another line", self)
        self.next_btn.setIcon(glyph_icon("skip_next", "white", px=15))
        self.next_btn.setCursor(Qt.PointingHandCursor)
        self.next_btn.setStyleSheet("QPushButton { background: rgba(10,12,16,0.72); color: white; border: 1px solid"
                                    " rgba(255,255,255,0.18); border-radius: 9px; padding: 5px 12px; }"
                                    " QPushButton:hover { background: rgba(30,32,40,0.9); }")

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        return min(420, int(w * 9 / 16))

    def sizeHint(self):
        return QSize(640, 360)

    def picture_rect(self):
        """Where the 16:9 picture goes: as big as fits, centred (never cropped: subtitles sit at the bottom)."""
        h = min(self.height(), self.heightForWidth(self.width()))
        w = min(self.width(), int(h * 16 / 9))
        h = int(w * 9 / 16)
        return QRectF((self.width() - w) / 2, (self.height() - h) / 2, w, h)

    def resizeEvent(self, e):
        self.next_btn.adjustSize()
        r = self.picture_rect()
        self.next_btn.move(int(r.right()) - self.next_btn.width() - 12, int(r.top()) + 12)

    def set_image(self, img):
        self.img = img
        self.update()

    def set_text(self, text):
        self.text = text
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        r = self.picture_rect()
        path = QPainterPath()
        path.addRoundedRect(r, 12, 12)
        p.fillPath(path, QColor("#0b0c10"))
        if self.img is not None:
            p.setClipPath(path)
            p.drawImage(r, self.img)
            p.setClipping(False)
        if self.text or self.img is None:
            if self.img is not None:
                p.fillPath(path, QColor(10, 12, 16, 150))
            p.setPen(QColor(C["text"]))
            p.drawText(r, Qt.AlignCenter, self.text or "No episode to preview")
        p.setPen(QPen(QColor(255, 255, 255, 22), 1))
        p.setBrush(Qt.NoBrush)
        p.drawPath(path)


class SubStyleEditor(QWidget):
