class RecGrid(QWidget):
    """Cards that wrap to the width; two rows until "Show all"."""
    GAP = 14

    def __init__(self, cards):
        super().__init__()
        self.cards, self.expanded = cards, False
        for c in cards:
            c.setParent(self)
        sp = QSizePolicy(QSizePolicy.Preferred, QSizePolicy.Preferred)
        sp.setHeightForWidth(True)
        self.setSizePolicy(sp)

    def cols(self, w):
        return max(1, (w + self.GAP) // (RecCard.W + self.GAP))

    def shown(self, w):
        return len(self.cards) if self.expanded else min(len(self.cards), self.cols(w) * 2)

    def card_h(self):
        return max((c.sizeHint().height() for c in self.cards), default=0)

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        n = self.shown(w)
        rows = math.ceil(n / self.cols(w)) if n else 0
        return rows * (self.card_h() + self.GAP) - self.GAP if rows else 0

    def sizeHint(self):
        return QSize(800, self.heightForWidth(800))

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.relayout()

    def relayout(self):
        w = self.width()
        cols, n, h = self.cols(w), self.shown(w), self.card_h()
        # spread the leftover width between the cards, like AniList's grid
        gap = (w - cols * RecCard.W) // max(1, cols - 1) if cols > 1 else 0
        for i, c in enumerate(self.cards):
            c.setVisible(i < n)
            if i < n:
                c.setGeometry((i % cols) * (RecCard.W + gap), (i // cols) * (h + self.GAP), RecCard.W, h)
        self.updateGeometry()

    def set_expanded(self, on):
        self.expanded = on
        self.relayout()


class FlowLayout(QLayout):
    """Widgets left to right, wrapping onto the next line when they don't fit (season pills)."""

    def __init__(self, parent=None, spacing=6):
        super().__init__(parent)
        self.items = []
        self.setContentsMargins(0, 0, 0, 0)
        self.setSpacing(spacing)

    def addItem(self, item):
        self.items.append(item)

    def count(self):
        return len(self.items)

    def itemAt(self, i):
        return self.items[i] if 0 <= i < len(self.items) else None

    def takeAt(self, i):
        return self.items.pop(i) if 0 <= i < len(self.items) else None

    def expandingDirections(self):
        return Qt.Orientations(0)

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, w):
        return self.place(QRect(0, 0, w, 0), move=False)

    def setGeometry(self, rect):
        super().setGeometry(rect)
        self.place(rect, move=True)

    def sizeHint(self):
        return self.minimumSize()

    def minimumSize(self):
        s = QSize()
        for it in self.items:
            s = s.expandedTo(it.minimumSize())
        return s

    def place(self, rect, move):
        x, y, line = rect.x(), rect.y(), 0
        sp = self.spacing()
        for it in self.items:
            hint = it.sizeHint()
            if x + hint.width() > rect.right() + 1 and line > 0:
                x, y, line = rect.x(), y + line + sp, 0
            if move:
                it.setGeometry(QRect(QPoint(x, y), hint))
            x += hint.width() + sp
            line = max(line, hint.height())
        return y + line - rect.y()


