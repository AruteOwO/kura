def short_ago(t):
    """'2h ago' / 'Yesterday' / '3d ago' / '2w ago' (Home's cards)."""
    s = max(0, time.time() - (t or 0))
    if s < 3600:
        return f"{max(1, int(s // 60))}m ago"
    if s < 86400:
        return f"{int(s // 3600)}h ago"
    if s < 2 * 86400:
        return "Yesterday"
    return f"{int(s // 86400)}d ago" if s < 14 * 86400 else f"{int(s // (7 * 86400))}w ago"


