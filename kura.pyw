    # ---- which episode
    def set_files(self, files, pick=None):
        self.ep.blockSignals(True)
        self.ep.clear()
        for f in files or []:
            self.ep.addItem(Path(f).name, f)
        i = self.ep.findData(pick) if pick else 0
        self.ep.setCurrentIndex(max(0, i))
        self.ep.blockSignals(False)
        self.load(self.ep.currentData())

    def load(self, path):
        self.path = path
        self.rows = []
        self.table.setRowCount(0)
        self.sync_buttons()
        if not path or not subs_mod.ffmpeg_installed():
            self.state.setText("" if path else "Pick a show or season on the left")
            return
        self.state.setText("Reading tracks…")
        call = self.loader = BgCall(lambda p=path: subs_mod.probe(p))
        call.done.connect(lambda res, err, c=call, p=path: self.on_loaded(c, p, res, err))
        call.start()

    def on_loaded(self, call, path, res, err):
        call.wait()
        if call is self.loader:
            self.loader = None
        if path != self.path:
            return
        if err:
            self.state.setText(f"Couldn't read it: {err}")
            return
        streams, _ = res
        subs = [t for t in streams if t["type"] == "subtitle"]
        self.state.setText(f"{len(subs)} subtitle track{'s' if len(subs) != 1 else ''}" +
                           ("  ·  changed by Kura" if subs_mod.has_backup(path) else ""))
        self.rows = [{"src": t["index"], "file": None, "codec": t["codec"], "lang": t.get("lang") or "und",
                      "title": t.get("title") or "", "default": bool(t.get("default")), "forced": bool(t.get("forced")),
                      "keep": True, "orig": (t["codec"], lang_code(t.get("lang")), t.get("title") or "")} for t in subs]
        self.fill()

    def fill(self):
        self.table.blockSignals(True)
        for r in range(self.table.rowCount()):   # the old dropdowns go now, not on Qt's next pass (drew twice)
            w = self.table.cellWidget(r, 2)
            if w is not None:
                self.table.removeCellWidget(r, 2)
                w.hide()
                w.setParent(None)
                w.deleteLater()
        self.table.setRowCount(len(self.rows))
        for r, row in enumerate(self.rows):
            keep = QTableWidgetItem()
            keep.setFlags(Qt.ItemIsUserCheckable | Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            keep.setCheckState(Qt.Checked if row["keep"] else Qt.Unchecked)
            self.table.setItem(r, 0, keep)
            name = QTableWidgetItem(row["title"])
            name.setFlags(Qt.ItemIsEditable | Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            if not row["keep"]:
                name.setForeground(QColor(C["faint"]))
            self.table.setItem(r, 1, name)
            lang = QComboBox()
            for code, nm in LANGS:
                lang.addItem(f"{nm} ({code})", code)
            code = lang_code(row["lang"])
            i = lang.findData(code)
            if i < 0:
                lang.addItem(code, code)
                i = lang.count() - 1
            lang.setCurrentIndex(i)
            lang.currentIndexChanged.connect(lambda _=0, rr=r, w=lang: self.rows[rr].update(lang=w.currentData()))
            holder = QWidget()   # a little air around it inside the cell
            hl = QHBoxLayout(holder)
            hl.setContentsMargins(4, 2, 8, 2)
            hl.addWidget(lang)
            self.table.setCellWidget(r, 2, holder)
            fmt = QTableWidgetItem("PGS (pictures)" if row["codec"] in subs_mod.PGS else (row["codec"] or "?").upper())
            if row["file"]:
                fmt.setText(fmt.text() + "  ·  new")
                fmt.setForeground(QColor(C["ok"]))
            fmt.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            self.table.setItem(r, 3, fmt)
            for c, key in ((4, "default"), (5, "forced")):
                it = QTableWidgetItem()
                it.setFlags(Qt.ItemIsUserCheckable | Qt.ItemIsEnabled | Qt.ItemIsSelectable)
                it.setCheckState(Qt.Checked if row[key] else Qt.Unchecked)
                self.table.setItem(r, c, it)
        self.table.blockSignals(False)
        self.sync_buttons()

    def on_item(self, it):
        r, c = it.row(), it.column()
        if r >= len(self.rows):
            return
        row = self.rows[r]
        if c == 0:
            row["keep"] = it.checkState() == Qt.Checked
            self.fill()
        elif c == 1:
            row["title"] = it.text().strip()
        elif c == 4:
            row["default"] = it.checkState() == Qt.Checked
            if row["default"]:   # one default subtitle track
                for o in self.rows:
                    if o is not row:
                        o["default"] = False
                self.fill()
        elif c == 5:
            row["forced"] = it.checkState() == Qt.Checked
        self.sync_buttons()

    def selected(self):
        rows = self.table.selectionModel().selectedRows() if self.table.selectionModel() else []
        return rows[0].row() if rows else -1

    def move(self, step):
        r = self.selected()
        n = r + step
        if r < 0 or not 0 <= n < len(self.rows):
            return
        self.rows[r], self.rows[n] = self.rows[n], self.rows[r]
        self.fill()
        self.table.selectRow(n)

    def add_file(self):
        if not self.path:
            return
        f, _ = QFileDialog.getOpenFileName(self, "Add a subtitle track", str(Path(self.path).parent),
                                           "Subtitles (*.ass *.ssa *.srt *.sup *.vtt)")
        if not f:
            return
        name = Path(f).stem
        m = re.search(r"\.([a-z]{2,3})$", name, re.I)
        lang = lang_code(m.group(1)) if m and lang_code(m.group(1)) in dict(LANGS) else "eng"
        codec = {".ass": "ass", ".ssa": "ass", ".srt": "subrip", ".sup": "hdmv_pgs_subtitle", ".vtt": "webvtt"}.get(
            Path(f).suffix.lower(), "ass")
        self.rows.append({"src": None, "file": f, "codec": codec, "lang": lang, "title": lang_name(lang),
                          "default": False, "forced": False, "keep": True, "orig": None})
        self.fill()

    def save_file(self):
        r = self.selected()
        if r < 0 or not self.path or self.rows[r]["src"] is None:
            return
        row = self.rows[r]
        ext = subs_mod.track_ext({"codec": row["codec"]})
        suggest = Path(self.path).with_name(f"{Path(self.path).stem}.{lang_code(row['lang'])}{ext}")
        f, _ = QFileDialog.getSaveFileName(self, "Save the track as a file", str(suggest), f"*{ext}")
        if not f:
            return
        try:
            subs_mod.extract_track(self.path, row["src"], f)
            self.tool.notify.emit(f"Saved {Path(f).name}")
        except Exception as e:
            QMessageBox.warning(self, "Subtitles", f"Couldn't save it: {e}")

    def sync_buttons(self):
        ready = bool(self.path) and subs_mod.ffmpeg_installed() and self.tool.job is None and self.loader is None
        r = self.selected()
        self.save_btn.setEnabled(ready and r >= 0 and self.rows[r]["src"] is not None)
        self.up_btn.setEnabled(ready and r > 0)
        self.down_btn.setEnabled(ready and 0 <= r < len(self.rows) - 1)
        self.add_btn.setEnabled(ready)
        self.tosho_btn.setEnabled(bool(self.path))
        self.restore_btn.setEnabled(ready and bool(self.path) and subs_mod.has_backup(self.path))
        ticked = self.tool.ticked_files()
        self.scope.buttons["ticked"].setEnabled(len(ticked) > 1)
        if self.scope.value() == "ticked" and len(ticked) <= 1:
            self.scope.buttons["one"].setChecked(True)
        n = len(ticked) if self.scope.value() == "ticked" else 1
        self.apply_btn.setEnabled(ready and bool(self.rows))
        self.apply_btn.setText(f"Apply to {n} episode{'s' if n != 1 else ''}" if n > 1 else "Apply")
        gone = sum(1 for x in self.rows if not x["keep"])
        new = sum(1 for x in self.rows if x["file"])
        self.note.setText("  ·  ".join(t for t in (f"{gone} to remove" if gone else "", f"{new} to add" if new else "")
                                       if t))

    # ---- applying
    def wanted_for(self, streams, here):
        """This page's tracks as edit_tracks() wants them, for one file (here = the episode shown)."""
        if here:
            return [{"src": r["src"], "file": r["file"], "codec": r["codec"], "lang": lang_code(r["lang"]),
                     "title": r["title"], "default": r["default"], "forced": r["forced"]}
                    for r in self.rows if r["keep"]]
        subs = [t for t in streams if t["type"] == "subtitle"]
        used, out = set(), []
        any_default = any(r["default"] for r in self.rows if r["keep"])
        for r in self.rows:
            if r["orig"] is None:
                continue   # added files: only the episode shown
            t = next((t for t in subs if t["index"] not in used and
                      (t["codec"], lang_code(t.get("lang")), t.get("title") or "") == r["orig"]), None)
            if t is None:
                continue
            used.add(t["index"])
            if r["keep"]:
                out.append({"src": t["index"], "codec": t["codec"], "lang": lang_code(r["lang"]), "title": r["title"],
                            "default": r["default"], "forced": r["forced"]})
        for t in subs:   # tracks this episode doesn't have: left as they are
            if t["index"] not in used:
                out.append({"src": t["index"], "codec": t["codec"], "lang": t.get("lang") or "", "title": t.get("title")
                            or "", "default": bool(t.get("default")) and not any_default, "forced": bool(t.get("forced"))})
        return out

    def apply(self):
        if not self.path or not self.rows:
            return
        files = self.tool.ticked_files() if self.scope.value() == "ticked" else [self.path]
        if self.path not in files:
            files = [self.path] + files
        if not any(r["keep"] for r in self.rows) and QMessageBox.question(
                self, "Subtitles", "Remove every subtitle track?") != QMessageBox.Yes:
            return
        n = len(files)
        if QMessageBox.question(self, "Subtitles", f"Change the subtitle tracks of {n} episode{'s' if n != 1 else ''}?"
                                f"\n\nEach file is copied with the new tracks next to the original, checked, then "
                                f"swapped in (about 1 GB written per episode). The originals are kept: Restore "
                                f"originals puts them back.") != QMessageBox.Yes:
            return
        here = self.path

        def one(f, say):
            streams, _ = subs_mod.probe(f)
            wanted = self.wanted_for(streams, os.path.normcase(f) == os.path.normcase(here))
            subs_mod.edit_tracks(f, wanted)
            return ""
        self.tool.start_job(FileJob(files, one, "tracks"), "Changed the tracks of", lambda: self.load(self.path))

    def restore(self):
        if not self.path:
            return
        files = [f for f in (self.tool.ticked_files() if self.scope.value() == "ticked" else [self.path])
                 if subs_mod.has_backup(f)] or [self.path]
        if QMessageBox.question(self, "Subtitles", f"Put the original subtitles back in {len(files)} episode"
                                f"{'s' if len(files) != 1 else ''}? This also undoes color changes and text tracks "
                                "made from pictures.") != QMessageBox.Yes:
            return
        self.tool.start_job(FileJob(files, lambda f, say: "" if subs_mod.restore_file(f) else "nothing to restore",
                                    "restore"), "Restored", lambda: self.load(self.path))


class SubDownloader(QWidget):
    """Subtitles → Download: subtitles from Anime Tosho for episodes that have none (or no English ones)."""
