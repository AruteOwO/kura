        self.r, self.name, self.avatar = r, name, avatar
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        rect = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        path = QPainterPath()
        path.addRoundedRect(rect, 18, 18)
        r = self.r
        color = QColor(((r or {}).get("top") or [{}])[0].get("color") or "#7c6cff") if r and r.get("top") else QColor("#7c6cff")
