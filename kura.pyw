        self.body.addWidget(self.anime_box, 1)
        self.add_buttons()

    # ---- conditions
    def add_condition(self, cond=None):
        cond = cond or {"element": "release_group", "op": "is", "value": ""}
        r = self.table.rowCount()
        self.table.insertRow(r)
        el = QComboBox()
        for k, (lbl, _, _) in tor.ELEMENTS.items():
            el.addItem(lbl, k)
        el.setCurrentIndex(max(0, list(tor.ELEMENTS).index(cond["element"]) if cond["element"] in tor.ELEMENTS else 0))
        op, val = QComboBox(), QComboBox()
        val.setEditable(True)
        self.table.setCellWidget(r, 0, el)
        self.table.setCellWidget(r, 1, op)
        self.table.setCellWidget(r, 2, val)
        self._fill(el, op, val, cond.get("op"), cond.get("value", ""))
        el.currentIndexChanged.connect(lambda *_, e=el, o=op, v=val: self._fill(e, o, v, None, None))
        self.table.selectRow(r)

    def _fill(self, el, op, val, op_key, value):
        _, kind, suggestions = tor.ELEMENTS[el.currentData()]
        op.clear()
        for k, text in tor.OPERATORS[kind]:
            op.addItem(text, k)
        keys = [k for k, _ in tor.OPERATORS[kind]]
        op.setCurrentIndex(keys.index(op_key) if op_key in keys else 0)
        current = val.currentText() if value is None else value
        val.clear()
        val.addItems(suggestions)
        val.setEditable(kind not in ("bool", "choice"))
        if kind in ("bool", "choice"):
            val.setCurrentIndex(max(0, suggestions.index(current)) if current in suggestions else 0)
        else:
            val.setEditText(current or "")

    def remove_condition(self):
        r = self.table.currentRow()
        if r >= 0:
            self.table.removeRow(r)

    def move_condition(self, delta):
        r = self.table.currentRow()
        conds = self.conditions()
        if 0 <= r < len(conds) and 0 <= r + delta < len(conds):
            conds[r], conds[r + delta] = conds[r + delta], conds[r]
            self.table.setRowCount(0)
            for c in conds:
                self.add_condition(c)
            self.table.selectRow(r + delta)

    def conditions(self):
        out = []
        for r in range(self.table.rowCount()):
            el, op, val = (self.table.cellWidget(r, c) for c in range(3))
            out.append({"element": el.currentData(), "op": op.currentData(), "value": val.currentText().strip()})
        return out

    def filter_anime(self, text):
        t = text.lower()
        for i in range(self.anime_list.count()):
            it = self.anime_list.item(i)
            it.setHidden(bool(t) and t not in it.text().lower())

    def result_filter(self):
        anime, scope = [], self.scope.value()
        if scope != "all":
            anime = [self.anime_list.item(i).data(Qt.UserRole) for i in range(self.anime_list.count())
                     if self.anime_list.item(i).checkState() == Qt.Checked]
        return {"name": self.name.text().strip() or "Untitled filter", "enabled": True,
                "action": self.action.currentData(), "match": self.match.currentData(),
                "discard": self.discard.currentData(), "anime": anime,
                "anime_mode": "except" if scope == "except" else "only", "conditions": self.conditions()}


