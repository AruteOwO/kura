    def recs_grid(self, recs):
        cards = []
        for r in recs:
            m = r["media"]
            c = RecCard(m, r["rating"], self.rec_badge(m["id"]))
            c.clicked.connect(lambda m=m, c=c: self.open_media.emit(m["id"], media_title(m), c.img.img))
            c.setContextMenuPolicy(Qt.CustomContextMenu)
            c.customContextMenuRequested.connect(lambda pos, m=m, c=c: self.rec_menu(m, c.mapToGlobal(pos)))
            self.slots.setdefault(f"rec:{m['id']}", []).append(c)
            cards.append(c)
        self.recs = RecGrid(cards)
        QTimer.singleShot(0, self.update_recs_toggle)
        return self.recs

    def update_recs_toggle(self):
        if getattr(self, "recs", None) is None:
            return
        hidden = len(self.recs.cards) - self.recs.shown(self.recs.width() or 800)
        self.recs_toggle.setVisible(self.recs.expanded or hidden > 0)
        self.recs_toggle.setText("Show fewer" if self.recs.expanded else f"Show all {len(self.recs.cards)}")

    def toggle_recs(self):
        self.recs.set_expanded(not self.recs.expanded)
        self.update_recs_toggle()

    def rec_menu(self, m, pos):
        menu = QMenu(self)
        title = media_title(m)
        menu.addAction(glyph_icon(G["library"], C["text"]), "Open", lambda: self.open_media.emit(m["id"], title, None))
        if self.tracking() and not self.account.entry(m["id"]):
            menu.addAction(glyph_icon(G["add"], C["text"]), "Add to Planning",
                           lambda: self.account.set_status(m["id"], "PLANNING", m))
        t = m.get("title") or {}
        menu.addAction(glyph_icon(G["search"], C["text"]), "Find torrents",
                       lambda: self.find_torrents.emit(t.get("romaji") or t.get("english") or title))
        if m.get("siteUrl"):
            menu.addAction(glyph_icon(G["globe"], C["text"]), "Open on AniList", lambda: webbrowser.open(m["siteUrl"]))
        menu.exec(pos)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        QTimer.singleShot(0, self.update_recs_toggle)

    def pick_section(self, n, remember=True):
        """Show one season's card (tabs)."""
        cards = getattr(self, "section_cards", [])
        if not cards:
            return
        n = max(0, min(n, len(cards) - 1))
        for k, c in enumerate(cards):
            c.setVisible(k == n)
        for k, b in enumerate(getattr(self, "tab_btns", [])):
            b.setChecked(k == n)
        if remember and self.result:
            self.section_pick[self.result.get("path") or self.result["name"]] = n
        self.load_thumbs(first=n)

    def set_ep_view(self, view):
        APP["settings"]["detail_ep_view"] = view
        save_settings(APP["settings"])
        if self.result is not None:
            pos = self.scroll.verticalScrollBar().value()
            self.render(self.result, self.cover)
            self.scroll.verticalScrollBar().setValue(pos)

    def on_filler(self, mid):
        """The filler guide for one of this page's seasons arrived: mark its episodes."""
        try:
            for grid in self.grids.values():
                if getattr(grid, "mid", None) == mid:
                    grid.kinds = filler_mod.episodes(mid)
                    grid.update()
        except RuntimeError:
            pass   # the page was rebuilt meanwhile

    def load_thumbs(self, first=None):
        """Episode pictures for the card grids (the season you're looking at first), in the background."""
        grids = [g for g in self.grids.values() if isinstance(g, EpisodeCards)]
        if not grids:
            return
        cards = getattr(self, "section_cards", [])
        visible = [g for g in grids if g.isVisibleTo(self) or (first is not None and cards and g.parentWidget() is cards[first])]
        order = visible + [g for g in grids if g not in visible]
        jobs, self.thumb_slots = [], {}
        for g in order:
            for key, kind, data in g.jobs():
                k = f"{id(g)}|{key}"
                self.thumb_slots[k] = (g, key[3:])
                jobs.append((k, kind, data))
        if self.thumbs is None:
            self.thumbs = ThumbWorker()
            self.thumbs.image.connect(self.on_thumb)
            self.thumbs.start()
