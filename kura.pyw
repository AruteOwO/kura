    def toggle_mini(self):
        """The mini player: small, on top, in a corner of the screen, while you use Kura (or anything else).
        Back = where it was before (inside Kura, or its own window)."""
        if self.player is None:
            return
        pp = self.player_popout
        if pp is not None and pp.mini:              # back to the full player
            pp.take_view()
            pp.close()
            pp.deleteLater()
            self.player_popout = None
            if getattr(self, "mini_from", "embedded") == "popout":
                self.popout_player()
            else:
                self.embed_player()
            return
        self.mini_from = "popout" if pp is not None else "embedded"
        screen = (pp or self).screen()
        if pp is not None:
            if pp.isFullScreen():
                pp.showNormal()
            pp.take_view()
            pp.close()
            pp.deleteLater()
            self.player_popout = None
        else:
            if self.isFullScreen():
                self.showNormal()
            self.unembed()
        mini = self.player_popout = player_mod.PopoutWindow(self.player, True, self.windowIcon(), mini=True)
        mini.closed.connect(self.close_player)
        self.player.set_mode("mini")
        mini.place_in_corner(screen)
        mini.show()
        self.player.setFocus()

    def toggle_popout(self):
        """Move the playing player between Kura and its own window (playback continues)."""
        if self.player is None:
            return
        if self.player_popout is not None and self.player_popout.mini:
            return self.toggle_mini()
        if self.player_popout is not None:          # back into Kura
            if self.player_popout.isFullScreen():
                self.player_popout.showNormal()
            self.player_popout.take_view()
            self.player_popout.close()
            self.player_popout.deleteLater()
            self.player_popout = None
            self.embed_player()
        else:                                        # out into its own window
            if self.isFullScreen():
                self.showNormal()
            self.unembed()
            self.popout_player()

