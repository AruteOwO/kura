class ChipRows(QWidget):
    """One titled row with chips that switch what it shows (For you / Because you watched… / ...)."""

    def __init__(self, title, sets, page_scroll, settings, key):
        super().__init__()
        self.settings, self.key = settings, key
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
        head = QHBoxLayout()
        head.setSpacing(8)
        head.addWidget(row_title(title))
        head.addSpacing(10)
        self.stack = QStackedWidget()
        self.chips, self.rows = [], []
        chosen = settings.get(key, 0)
        for i, (name, cards) in enumerate(sets):
            b = QPushButton()
            b.setText(QFontMetrics(b.font()).elidedText(name, Qt.ElideRight, 300))
            if b.text() != name:
                b.setToolTip(name)
            b.setCheckable(True)
            b.setCursor(Qt.PointingHandCursor)
            b.setStyleSheet(f"QPushButton {{ background: rgba(255,255,255,0.05); border: 1px solid {C['border']};"
                            f" border-radius: 14px; padding: 5px 13px; color: {C['muted']}; font-size: 9pt; }}"
                            f" QPushButton:hover {{ color: {C['text']}; }}"
                            f" QPushButton:checked {{ background: white; color: #111; border-color: white; font-weight: 600; }}")
            b.clicked.connect(lambda _=False, n=i: self.choose(n))
            head.addWidget(b)
            self.chips.append(b)
            r = HomeRow(None, cards, page_scroll)
            self.stack.addWidget(r)
            self.rows.append(r)
        head.addStretch(1)
        self.prev_btn, self.next_btn = round_arrows(head, lambda d: self.current().page(d))
        v.addLayout(head)
        v.addWidget(self.stack)
        self.choose(chosen if chosen < len(sets) else 0, save=False)

    def current(self):
        return self.rows[self.stack.currentIndex()]

    def choose(self, n, save=True):
        for i, b in enumerate(self.chips):
            b.setChecked(i == n)
        self.stack.setCurrentIndex(n)
        r = self.rows[n]
        self.stack.setFixedHeight(r.area.height())
        if save:
            self.settings[self.key] = n
            save_settings(self.settings)


def row_title(text):
    t = QLabel(text)
    t.setStyleSheet("font-family: 'Segoe UI Variable Display'; font-size: 13.5pt; font-weight: 600; background: transparent;")
    return t


def round_arrows(layout, step):
    """‹ › round buttons at the end of a row header."""
    btns = []
    for glyph, d in (("chevron_left", -1), ("chevron_right", 1)):
        b = QPushButton()
        b.setFixedSize(32, 32)
        b.setIcon(glyph_icon(glyph, C["muted"], C["text"], px=18))
        b.setIconSize(QSize(18, 18))
        b.setCursor(Qt.PointingHandCursor)
        b.setStyleSheet(f"QPushButton {{ background: rgba(255,255,255,0.05); border: 1px solid {C['border_hi']};"
                        f" border-radius: 16px; padding: 0px; }} QPushButton:hover {{ background: rgba(255,255,255,0.1); }}"
                        f" QPushButton:disabled {{ background: transparent; border-color: {C['border']}; }}")
        b.clicked.connect(lambda _=False, dd=d: step(dd))
        layout.addWidget(b)
        btns.append(b)
    return btns


class HomeLoader(QThread):
    """AniList details for what Home shows (banners, episode stills, recommendations): one
    request per 50 shows that aren't saved yet."""
    done = Signal(object)   # {AniList id: details} (a dict signal can't carry number keys)

    def __init__(self, ids):
        super().__init__()
        self.ids = ids

    def run(self):
        try:
            self.done.emit(fetch_details(self.ids))
        except Exception:
            self.done.emit({})


