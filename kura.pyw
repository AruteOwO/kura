def episode_still(details, mid, ep):
    """AniList's official still for an episode (from its streaming listing), if it has one. A list numbered on from
    the season before (Apothecary Diaries S2 = "Episode 25"...) matches by its place: 25 is this season's 1."""
    d = details.get(mid) or {}
    nums = list_numbers(d)
    shift = (min(nums) - 1) if nums and d.get("episodes") and min(nums) > d["episodes"] else 0
    for se in d.get("streamingEpisodes") or []:
        m = re.search(r"(?:episode|ep\.?)\s*(\d+)", se.get("title") or "", re.IGNORECASE)
        if m and int(m.group(1)) - shift == ep and se.get("thumbnail"):
            return se["thumbnail"], re.sub(r"^\s*(?:episode|ep\.?)\s*\d+\s*[-:–]?\s*", "", se["title"],
                                           flags=re.IGNORECASE).strip()
    return None, None


NOT_EPISODE_TITLES = {"repack", "proper", "uncensored", "uncut", "end", "final", "v2", "v3", "batch", "complete"}


@functools.lru_cache(maxsize=4096)
def file_episode_title(path):
    """The episode's name from its file name ("KAMUI ... S01E05 Bakeneko 1080p..." → "Bakeneko"), when it has one."""
    try:
        t = org.anitopy_parse(Path(path).name).get("episode_title")
    except Exception:
        return None
    t = (t if isinstance(t, str) else (t or [None])[0] or "").strip(" .-_")
    return t if len(t) > 1 and not t.isdigit() and t.lower() not in NOT_EPISODE_TITLES else None


def episode_name(details, mid, ep, path=None):
    """An episode's title: AniList's (from its streaming listing), else the one in the file name. None if neither."""
    title = episode_still(details, mid, ep)[1] if mid and ep else None
    if title and title.strip(" .-").lower() in ("untitled", "tba", "tbd"):
        title = None
    return title or (file_episode_title(str(path)) if path else None)


class ThumbWorker(QThread):
    """Preview images, one at a time in the background: a frame from your file (mpv grabs it
    without showing anything, ~1 s, saved in cover_cache/frames) or an AniList image."""
    image = Signal(str, QImage)

    def __init__(self):
        super().__init__()
        self.jobs, self.lock, self.wake = [], threading.Lock(), threading.Event()
        self.mpv_mod = None

    def queue(self, jobs):
        """[(key, "frame", (path, start)) or (key, "url", (url, file stem))]: replaces what's waiting."""
        with self.lock:
            self.jobs = list(jobs)
        self.wake.set()

    def run(self):
        while not self.isInterruptionRequested():
            with self.lock:
                job = self.jobs.pop(0) if self.jobs else None
            if job is None:
                self.wake.wait(0.5)
                self.wake.clear()
                continue
            key, kind, data = job
            try:
                img = self.grab(*data) if kind == "frame" else self.fetch(*data)
            except Exception:
                img = None
            if img is not None and not img.isNull():
                self.image.emit(key, img)

    def fetch(self, url, stem):
        suffix = Path(url.split("?")[0]).suffix or ".jpg"
        return cached_image(url, COVER_DIR / f"{stem}{suffix}")

    def grab(self, path, start):
        import hashlib
        dest = FRAME_DIR / (hashlib.sha1(f"{path}|{start}".encode("utf-8")).hexdigest()[:20] + ".jpg")
        if dest.exists():
            return QImage(str(dest))
        if not Path(path).exists():
            return None
        if self.mpv_mod is None:
            self.mpv_mod = player_mod.load_mpv(mpv_dirs())
        FRAME_DIR.mkdir(parents=True, exist_ok=True)
        # made next to the preview folder: os.replace can't move from Windows' temp folder on C: to E:
        tmp = Path(tempfile.mkdtemp(prefix="tmp_", dir=FRAME_DIR))
        m = self.mpv_mod.MPV(vo="image", ao="null", audio="no", sub="no", start=str(start), frames="1", hwdec="no",
                             vo_image_format="jpg", vo_image_jpeg_quality="85", vo_image_outdir=str(tmp),
                             vf="scale=640:-2", ytdl=False, input_default_bindings=False, osc=False, terminal=False)
        try:
            m.play(str(path))
            m.wait_for_playback(timeout=20)
        finally:
            m.terminate()
        import shutil
        try:
            shot = next(tmp.glob("*.jpg"), None)
            if shot is None:
                return None
            os.replace(shot, dest)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)   # never leave temporary folders behind
        return QImage(str(dest))


def icon_html(name, size=14, color=None):
    """A Material Symbol inside rich text (QLabel)."""
    ch = MATERIAL["cp"].get(name) if MATERIAL["family"] else None
    if not ch:
        return ""
    style = f"font-family:'{MATERIAL['family']}'; font-size:{size}px;" + (f" color:{color};" if color else "")
    return f"<span style=\"{style}\">{ch}</span>"


def countdown(ts):
    """'2h 14m' / '45m' / '3d 4h' until a time."""
    s = max(0, int(ts - time.time()))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{max(1, m)}m"


def greeting(name):
    h = datetime.now().hour
    part = "Good morning" if 5 <= h < 12 else "Good afternoon" if 12 <= h < 18 else "Good evening" if h < 24 and h >= 18 else "Up late"
    return f"{part}, {name}" if name else part


class ProgressRing(QWidget):
    """A small ring that fills up (downloads)."""

    def __init__(self, size=36, color=None):
        super().__init__()
        self.setFixedSize(size, size)
        self.frac, self.color = 0.0, QColor(color or C["accent"])

    def set(self, frac, color=None):
        self.frac = max(0.0, min(1.0, frac))
        if color:
            self.color = QColor(color)
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(3, 3, -3, -3)
        p.setPen(QPen(QColor(255, 255, 255, 22), 4))
        p.drawEllipse(r)
        if self.frac > 0:
            pen = QPen(self.color, 4)
            pen.setCapStyle(Qt.RoundCap)
            p.setPen(pen)
            p.drawArc(r, 90 * 16, -int(360 * 16 * self.frac))


