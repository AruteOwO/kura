    # ---- fixing what needs you
    def do_fix(self, e, how=None, records=None):
        tp = getattr(self, "torrents", None)
        if tp is None:
            return
        query = tp.fix_missed(e, how, records)
        if query:
            self.find_torrents.emit(query)

    def open_need(self, mid, ep):
        e = next((x for x in getattr(self, "needs", []) if x["mid"] == mid and ep in x["eps"]), None)
        if e is not None:
            self.show_need(e)

    def show_need(self, e):
        MissedDialog(self, e, self).exec()

    def all_needs(self):
        AllMissedDialog(self, getattr(self, "needs", []), self).exec()

    def fix_all(self):
        tp = getattr(self, "torrents", None)
        if tp is None:
            return
        dlg = FixAllDialog(self, getattr(self, "needs", []))
        if dlg.exec() == QDialog.Accepted:
            for e in dlg.chosen():
                tp.fix_missed(e)

    def showEvent(self, e):
        # Air times move on once an episode airs, so keep the list fairly fresh here
        if self.account and self.account.connected:
            self.account.refresh(max_age=3600)
        super().showEvent(e)
        if self.settings.get("schedule_view", "week") == "week":
            # built while hidden (the loading screen) its width was a guess: how many days fit / where Needs you
            # goes is checked again at the real width before it paints
            if self.layout():
                self.layout().activate()
            if self.scroll.viewport().width() != getattr(self, "shown_width", None):
                self.check_fit()
        if not hasattr(self, "ticker"):
            self.ticker, self.ticks = QTimer(self, interval=30000, timeout=self.on_tick), 0
        self.ticker.start()

    def hideEvent(self, e):
        super().hideEvent(e)
        if hasattr(self, "ticker"):
            self.ticker.stop()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        if self.isVisible() and self.settings.get("schedule_view", "week") == "week":
            if not hasattr(self, "refit"):
                self.refit = QTimer(self, singleShot=True, interval=200, timeout=self.check_fit)
            self.refit.start()

    def check_fit(self):
        """A resize that changes how many days fit rebuilds the board."""
        from datetime import date as _date, timedelta
        if not getattr(self, "shown_days", None) or not (self.account and self.account.connected):
            return
        have = None if self.show_all.isChecked() else self.library.library_ids()
        made = getattr(self, "week_made", None)
        if made and not self.dirty and made[0] == have:
            days, by_day = made[1], made[2]
        else:
            days, by_day, _ = self.week_data(have)
        fits = (len(self.fit_days(days, by_day, _date.today())), self.scroll.viewport().width() < 1180)
        if fits != self.shown_days:
            self.rebuild()

    def on_tick(self):
        """Every 30 s while shown: the countdown; every 5 min the whole board (what aired, what arrived)."""
        self.ticks += 1
        if self.ticks % 10 == 0:
            self.rebuild()
        elif getattr(self, "next_panel", None) is not None:
            try:
                self.next_panel.tick()
            except RuntimeError:
                pass

    def rebuild(self):
        for f in list(self.fetchers):
            f.requestInterruption()
        self.slots = {}
        a = self.account
        body = QWidget()
        col = QVBoxLayout(body)
        col.setContentsMargins(0, 0, 8, 0)
        col.setSpacing(12)
        if not (a and a.connected):
            col.addWidget(self.connect_prompt("Connect your AniList account to see when the shows you're "
                                              "watching air next."))
            col.addStretch(1)
            self.set_body(body)
            return

        wanted = {"CURRENT", "REPEATING", "PAUSED"} | ({"PLANNING"} if self.settings.get("schedule_planning", True) else set())
        items = []
        have = None if self.show_all.isChecked() else self.library.library_ids()
        for mid, e in a.view().items():
            nxt = (e.get("media") or {}).get("nextAiringEpisode") or {}
            if have is not None and mid not in have:
                continue   # only shows you have (toggle "Show not downloaded" for the rest)
            if e.get("status") in wanted and nxt.get("airingAt"):
                items.append((nxt["airingAt"], mid, e))
        items.sort(key=lambda x: x[0])

        week = self.settings.get("schedule_view", "week") == "week"
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        if week:
            col.addWidget(self.week_page(have))
            col.addStretch(1)
            self.set_body(body)
            return
        groups = {}
        today = datetime.now().date()
        for ts, mid, e in items:
            d = datetime.fromtimestamp(ts).date()
            days = (d - today).days
            key = (99, "Later", "") if days > 7 else (days, "Today" if days <= 0 else "Tomorrow" if days == 1
                                                     else d.strftime("%A"), d.strftime("%d %b").lstrip("0"))
            groups.setdefault(key, []).append((ts, mid, e))

        if not items:
            col.addWidget(EmptyState("event_available", "Nothing coming up",
                                     "Nothing on your list has an upcoming episode." if have is None else
                                     "None of the shows in your library have an upcoming episode. Turn on "
                                     "\"Show not downloaded\" to see the rest of your list."))
        for (_, name, day), rows in sorted(groups.items()):
            col.addSpacing(6)
            col.addWidget(label(f"{name.upper()}  ·  {day}" if day else name.upper(), "section"))
            box = card()
            v = QVBoxLayout(box)
            v.setContentsMargins(8, 6, 8, 6)
            v.setSpacing(0)
            for i, (ts, mid, e) in enumerate(rows):
                if i:
                    dv = QFrame()
                    dv.setObjectName("divider")
                    v.addWidget(dv)
                v.addWidget(self.row(ts, mid, e, later=name == "Later"))
            col.addWidget(box)
        col.addStretch(1)
        self.subtitle.setText(f"{len(items)} upcoming episodes  ·  times in your timezone")
        self.set_body(body)

    def row(self, ts, mid, e, later):
        m = e.get("media") or {}
        ep = m["nextAiringEpisode"]["episode"]
        w = ClickRow(f"Open {media_title(m)}")
        w.clicked.connect(lambda mid=mid, t=media_title(m): self.open_media.emit(mid, t, None))
        h = QHBoxLayout(w)
        h.setContentsMargins(10, 10, 10, 10)
        h.setSpacing(14)
        dt = datetime.fromtimestamp(ts)
        t = label(dt.strftime("%d %b") if later else dt.strftime("%H:%M"), "h2")
        t.setFixedWidth(64)
        h.addWidget(t)
        h.addWidget(self.thumb(mid, m, media_title(m)))
        text = QVBoxLayout()
        text.setSpacing(2)
        text.addWidget(label(media_title(m), "h2"))
        info = f"Episode {ep}" + (f" of {m['episodes']}" if m.get("episodes") else "")
        if ts < time.time():
            info += "  ·  aired"
        text.addWidget(label(info, "faint"))
        h.addLayout(text, 1)
        behind = (ep - 1) - (e.get("progress") or 0)
        if e["status"] in ("CURRENT", "REPEATING") and behind > 0:
            b = label(f"{behind} behind", "chip")
            b.setStyleSheet(status_style("PAUSED") + "font-weight: 600;")
            h.addWidget(b, 0, Qt.AlignVCenter)
        st = label(acct.STATUS_NAMES.get(e["status"], e["status"]), "chip")
        st.setStyleSheet(status_style(e["status"]) + "font-weight: 600;")
        h.addWidget(st, 0, Qt.AlignVCenter)
        return w


# ---------------------------------------------------------------- seasonal (like AniChart)

SEASONS = ["WINTER", "SPRING", "SUMMER", "FALL"]
SEASON_FILE = SCRIPT_DIR / "anilist_seasons.json"
SEASON_VERSION = 1
QUERY_SEASON = """query ($season: MediaSeason, $year: Int, $page: Int, $adult: Boolean) { Page(page: $page, perPage: 50) {
  pageInfo { hasNextPage }
  media(season: $season, seasonYear: $year, type: ANIME, isAdult: $adult, sort: POPULARITY_DESC) {
    id format status episodes duration season seasonYear averageScore popularity genres siteUrl
    source(version: 3) description(asHtml: false)
    title { romaji english native } coverImage { extraLarge large color }
    nextAiringEpisode { episode airingAt } startDate { year month day }
    studios(isMain: true) { nodes { name } }
} } }"""


def current_season():
    now = datetime.now()
    return SEASONS[(now.month - 1) // 3], now.year


def countdown(ts):
    s = int(ts - time.time())
    if s <= 0:
        return "now"
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


def airing_text(m):
    nxt = m.get("nextAiringEpisode") or {}
    eps = m.get("episodes")
    if nxt.get("airingAt"):
        return f"Ep {nxt['episode']}{f' of {eps}' if eps else ''} airing in {countdown(nxt['airingAt'])}"
    sd = m.get("startDate") or {}
    if m.get("status") == "NOT_YET_RELEASED":
        if sd.get("year") and sd.get("month"):
            return f"Starts {acct.format_date(sd)}"
        return "Not yet aired"
    if m.get("status") == "FINISHED":
        return f"Finished  ·  {eps} episodes" if eps and m.get("format") != "MOVIE" else "Released"
    return STATUS_TEXT.get(m.get("status"), "")


class SeasonLoader(QThread):
    """All anime of one season: one request per 50 shows, cached in anilist_seasons.json."""
    progress = Signal(int, str)
    loaded = Signal(int, list, str)   # load id, media, note/error

    def __init__(self, load_id, season, year, force=False):
        super().__init__()
        self.load_id, self.season, self.year, self.force = load_id, season, year, force
        self.adult = bool(acct.ADULT["on"])

    def run(self):
        key = f"{self.season}-{self.year}" + ("-adult" if self.adult else "")
        with _store_lock:
            rec = _read_json(SEASON_FILE).get(key)
        cur = current_season()
        upcoming = (self.year, SEASONS.index(self.season)) >= (cur[1], SEASONS.index(cur[0]))
        max_age = 6 * 3600 if upcoming else 30 * 86400   # past seasons barely change
        if rec and rec.get("v") == SEASON_VERSION and not self.force and time.time() - rec["t"] < max_age:
            self.loaded.emit(self.load_id, rec["media"], "")
            return
        media, page = [], 1
        while True:
            if self.isInterruptionRequested():
                return
            self.progress.emit(self.load_id, f"Loading from AniList…  page {page}")
            data = org.anilist(QUERY_SEASON, {"season": self.season, "year": self.year, "page": page,
                                              "adult": self.adult})
            if data is None:
                if rec:
                    self.loaded.emit(self.load_id, rec["media"], "Couldn't reach AniList, showing the saved list.")
                else:
                    self.loaded.emit(self.load_id, [], "Couldn't reach AniList. Try again in a minute.")
                return
            p = data.get("Page") or {}
            media += p.get("media") or []
            if not (p.get("pageInfo") or {}).get("hasNextPage") or page >= 10:
                break
            page += 1
        with _store_lock:
            store = _read_json(SEASON_FILE)
            store[key] = {"t": time.time(), "v": SEASON_VERSION, "media": media}
            _write_json(SEASON_FILE, store)
        self.loaded.emit(self.load_id, media, "")


def season_sort_key(m, key):
    if key == "SCORE":
        return -(m.get("averageScore") or 0)
    if key == "TITLE":
        return media_title(m).lower()
    if key == "AIRING":
        return (m.get("nextAiringEpisode") or {}).get("airingAt") or 10 ** 12   # not airing: last
    return -(m.get("popularity") or 0)


class SeasonFilter(QSortFilterProxyModel):
    OTHER = ("OVA", "ONA", "SPECIAL", "MUSIC")

    def __init__(self, parent, fmt, key):
        super().__init__(parent)
        self.fmt, self.key = fmt, key
        self.setFilterCaseSensitivity(Qt.CaseInsensitive)

    def set_format(self, fmt):
        self.fmt = fmt
        self.refilter()

    def set_key(self, key):
        self.key = key
        self.invalidate()
        self.sort(0)

    def refilter(self):
        """Re-run filterAcceptsRow (Qt 6.10+ way of saying the filter changed)."""
        self.beginFilterChange()
        self.endFilterChange()

    def filterAcceptsRow(self, row, parent):
        f = (self.sourceModel().index(row, 0, parent).data(MEDIA_ROLE) or {}).get("format")
        if self.fmt == "OTHER" and f not in self.OTHER:
            return False
        if self.fmt not in ("ALL", "OTHER") and f != self.fmt:
            return False
        return super().filterAcceptsRow(row, parent)

    def lessThan(self, a, b):
        return season_sort_key(a.data(MEDIA_ROLE) or {}, self.key) < season_sort_key(b.data(MEDIA_ROLE) or {}, self.key)


SC_W, SC_H, SC_COVER = 430, 214, 140


def season_card_rect(rect):
    return QRectF(rect.x() + 6, rect.y() + 6, rect.width() - 12, SC_H - 12)


def season_pill_font():
    f = QFont(QApplication.font())
    f.setPointSizeF(8.5)
    f.setWeight(QFont.DemiBold)
    return f


def season_pill_rect(rect, text):
    c = season_card_rect(rect)
    w = QFontMetrics(season_pill_font()).horizontalAdvance(text) + 22
    return QRectF(c.right() - 12 - w, c.bottom() - 12 - 24, w, 24)


class SeasonDelegate(QStyledItemDelegate):
    """AniChart-style card: cover on the left; title, studio, airing countdown,
    description and genres on the right; your list status as a clickable pill."""

    def __init__(self, page):
        super().__init__(page)
        self.page = page
        self._cache = {}

    def sizeHint(self, option, index):
        return QSize(self.page.card_w, SC_H)

    def paint(self, p, option, index):
        m = index.data(MEDIA_ROLE) or {}
        mid = m.get("id")
        p.save()
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        hover = bool(option.state & QStyle.State_MouseOver)
        c = season_card_rect(option.rect)
        shape = QPainterPath()
        shape.addRoundedRect(c, 12, 12)
        p.fillPath(shape, QColor(C["surface2"] if hover else C["surface"]))

        # cover
        cov = QRectF(c.left(), c.top(), SC_COVER, c.height())
        p.save()
        p.setClipPath(shape)
        img = index.data(COVER_ROLE)
        if isinstance(img, QImage) and not img.isNull():
            dpr = p.device().devicePixelRatioF()
            key = (mid, img.cacheKey(), dpr)
            pm = self._cache.get(key)
            if pm is None:
                pm = self._cache[key] = cover_pixmap(img, SC_COVER, int(c.height()), dpr)
            p.drawPixmap(cov.topLeft(), pm)
        else:
            col = QColor((m.get("coverImage") or {}).get("color") or C["surface2"])
            p.fillRect(cov, col.darker(160))
        p.restore()
        p.setPen(QPen(QColor(C["border_hi"] if hover else C["border"]), 1))
        p.setBrush(Qt.NoBrush)
        p.drawPath(shape)

        if self.page.in_library(mid):
            f = QFont(option.font)
            f.setPointSizeF(8)
            f.setWeight(QFont.Bold)
            p.setFont(f)
            text = "In library"
            w = QFontMetrics(f).horizontalAdvance(text) + 16
            pill = QRectF(cov.left() + 8, cov.top() + 8, w, 20)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(C["ok"]))
            p.drawRoundedRect(pill, 10, 10)
            p.setPen(QColor("#0b2a1c"))
            p.drawText(pill, Qt.AlignCenter, text)

        x = cov.right() + 14
        w = c.right() - 14 - x
        y = c.top() + 12

        # score, top right
        score_w = 0
        if m.get("averageScore"):
            f = QFont(option.font)
            f.setPointSizeF(9)
            f.setWeight(QFont.DemiBold)
            p.setFont(f)
            s = f"★ {m['averageScore']}%"
            score_w = QFontMetrics(f).horizontalAdvance(s) + 10
            p.setPen(QColor(C["ok"] if m["averageScore"] >= 75 else C["warn"] if m["averageScore"] >= 60 else C["muted"]))
            p.drawText(QRectF(c.right() - 14 - score_w, y, score_w, 20), Qt.AlignRight | Qt.AlignVCenter, s)

        # title (up to two lines)
        f = QFont(option.font)
        f.setPointSizeF(10.5)
        f.setWeight(QFont.DemiBold)
        p.setFont(f)
        fm = QFontMetrics(f)
        tw = w - score_w
        title = media_title(m)
        if fm.horizontalAdvance(title) > tw * 2 - 20:
            title = fm.elidedText(title, Qt.ElideRight, int(tw * 2 - 20))
        lines = 1 if fm.horizontalAdvance(title) <= tw else 2
        tr = QRectF(x, y, tw, fm.lineSpacing() * lines + 2)
        p.setPen(QColor(C["text"]))
        p.drawText(tr, Qt.TextWordWrap | Qt.AlignLeft | Qt.AlignTop, title)
        y = tr.bottom() + 3

        def line(text, color, size, bold=False, height=18):
            nonlocal y
            if not text:
                return
            ff = QFont(option.font)
            ff.setPointSizeF(size)
            if bold:
                ff.setWeight(QFont.DemiBold)
            p.setFont(ff)
            p.setPen(QColor(color))
            p.drawText(QRectF(x, y, w, height), Qt.AlignLeft | Qt.AlignVCenter,
                       QFontMetrics(ff).elidedText(text, Qt.ElideRight, int(w)))
            y += height

        studios = ", ".join(n["name"] for n in ((m.get("studios") or {}).get("nodes") or []))
        line(studios, C["accent_hi"], 8.5, bold=True)
        nxt = (m.get("nextAiringEpisode") or {}).get("airingAt")
        line(airing_text(m), C["text"] if nxt else C["muted"], 9, bold=bool(nxt), height=20)
        src = (m.get("source") or "").replace("_", " ").title()
        line("  ·  ".join(x_ for x_ in (FORMAT_TEXT.get(m.get("format"), ""), src) if x_), C["faint"], 8.5)

        # description fills what's left above the bottom row
        bottom = c.bottom() - 12 - 24
        desc = re.sub(r"\s+", " ", clean_description(m.get("description")))
        if desc and bottom - y > 20:
            ff = QFont(option.font)
            ff.setPointSizeF(8.5)
            p.setFont(ff)
            fm2 = QFontMetrics(ff)
            n_lines = int((bottom - y - 6) // fm2.lineSpacing())
            if n_lines > 0:
                if fm2.horizontalAdvance(desc) > w * n_lines - 40:
                    desc = fm2.elidedText(desc, Qt.ElideRight, int(w * n_lines - 40))
                p.setPen(QColor(C["muted"]))
                p.drawText(QRectF(x, y + 4, w, fm2.lineSpacing() * n_lines), Qt.TextWordWrap | Qt.AlignLeft | Qt.AlignTop, desc)

        # bottom row: genres, then your list status
        pill_text = self.page.pill_text(mid)
        right = c.right() - 12
        if pill_text:
            pr = season_pill_rect(option.rect, pill_text)
            entry = self.page.account.entry(mid) if self.page.account else None
            col = QColor(STATUS_COLORS.get(entry["status"], C["muted"]) if entry else C["muted"])
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(col.red(), col.green(), col.blue(), 40 if entry else 25))
            p.drawRoundedRect(pr, 12, 12)
            p.setFont(season_pill_font())
            p.setPen(col if entry else QColor(C["text"]))
            p.drawText(pr, Qt.AlignCenter, pill_text)
            right = pr.left() - 8
        gf = QFont(option.font)
        gf.setPointSizeF(8)
        p.setFont(gf)
        gfm = QFontMetrics(gf)
        gx = x
        for g in (m.get("genres") or [])[:3]:
            gw = gfm.horizontalAdvance(g) + 16
            if gx + gw > right:
                break
            gr = QRectF(gx, bottom + 2, gw, 20)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(255, 255, 255, 16))
            p.drawRoundedRect(gr, 10, 10)
            p.setPen(QColor(C["muted"]))
            p.drawText(gr, Qt.AlignCenter, g)
            gx += gw + 6
        p.restore()


class SeasonalPage(Page):
    open_show = Signal(str, object)
    open_media = Signal(int, str, object)

    FORMATS = [("ALL", "All"), ("TV", "TV"), ("TV_SHORT", "TV Short"), ("MOVIE", "Movies"), ("OTHER", "OVA / ONA")]
    SORTS = [("POPULARITY", "Popular"), ("SCORE", "Score"), ("AIRING", "Next airing"), ("TITLE", "Title")]

    def __init__(self, settings, account, library):
        super().__init__("Seasonal", "", )
        self.settings, self.account, self.library = settings, account, library
        self.season, self.year = current_season()
        self.load_id = 0
        self.loaders, self.fetchers = set(), set()
        self.covers = {}
        self.lib_ids = set()

        # season + year picker
        self.season_pick = Segmented([(s, s.title()) for s in SEASONS], self.season)
        self.season_pick.changed.connect(self.pick_season)
        prev = QPushButton()
        prev.setObjectName("icon")
        prev.setIcon(glyph_icon("", C["text"], px=14))
        prev.setToolTip("Previous year")
        prev.clicked.connect(lambda: self.go_to(self.season, self.year - 1))
        # the arrows change the year (the season buttons pick the season); the year itself is a list to jump with
        self.year_lbl = QComboBox()
        self.year_lbl.setToolTip("Year")
        for y in range(datetime.now().year + 1, 1959, -1):
            self.year_lbl.addItem(str(y), y)
        self.year_lbl.setMaxVisibleItems(15)
        self.year_lbl.activated.connect(lambda _i: self.go_to(self.season, self.year_lbl.currentData()))
        nxt = QPushButton()
        nxt.setObjectName("icon")
        nxt.setIcon(glyph_icon("", C["text"], px=14))
        nxt.setToolTip("Next year")
        nxt.clicked.connect(lambda: self.go_to(self.season, self.year + 1))
        now = QPushButton("This season")
        now.setObjectName("ghost")
        now.clicked.connect(lambda: self.go_to(*current_season()))
        refresh = QPushButton()
        refresh.setObjectName("icon")
        refresh.setIcon(glyph_icon(G["refresh"], C["text"], px=14))
        refresh.setToolTip("Reload from AniList")
        refresh.clicked.connect(lambda: self.load(force=True))
        for wdg in (now, self.season_pick, prev, self.year_lbl, nxt, refresh):
            self.actions.addWidget(wdg)

        # filters
        row = QHBoxLayout()
        row.setSpacing(10)
        self.fmt_pick = Segmented(self.FORMATS, settings.get("seasonal_format", "ALL"))
        self.fmt_pick.buttons["OTHER"].setToolTip("OVAs, ONAs (web series) and specials")
        self.fmt_pick.changed.connect(self.pick_format)
        row.addWidget(self.fmt_pick)
        row.addStretch(1)
        row.addWidget(label("Sort", "muted"))
        self.sort_pick = Segmented(self.SORTS, settings.get("seasonal_sort", "POPULARITY"))
        self.sort_pick.changed.connect(self.pick_sort)
        row.addWidget(self.sort_pick)
        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Search this season")
        self.search.addAction(glyph_icon(G["search"]), QLineEdit.LeadingPosition)
        self.search.setClearButtonEnabled(True)
        row.addWidget(self.search)
        self.outer.addLayout(row)
        self.filter_row = row
        self.search_row = QHBoxLayout()   # the search box moves here when the window is narrow
        self.outer.addLayout(self.search_row)

        self.busy = QProgressBar()
        self.busy.setObjectName("busy")
        self.busy.setRange(0, 0)
        self.busy.hide()
        self.outer.addWidget(self.busy)

        self.model = QStandardItemModel(self)
        self.proxy = SeasonFilter(self, settings.get("seasonal_format", "ALL"), settings.get("seasonal_sort", "POPULARITY"))
        self.proxy.setSourceModel(self.model)
        self.proxy.sort(0)
        self.search.textChanged.connect(self.proxy.setFilterFixedString)

        self.grid = QListView()
        self.grid.setObjectName("grid")
        self.grid.setModel(self.proxy)
        self.grid.setItemDelegate(SeasonDelegate(self))
        self.grid.setViewMode(QListView.IconMode)
        self.grid.setResizeMode(QListView.Adjust)
        self.grid.setMovement(QListView.Static)
        self.grid.setUniformItemSizes(True)
        self.card_w = SC_W
        self.grid.setGridSize(QSize(SC_W, SC_H))
        self.grid.viewport().installEventFilter(self)   # cards widen to fill the row on resize
        self.grid.setMouseTracking(True)
        self.grid.setVerticalScrollMode(QListView.ScrollPerPixel)
        self.grid.verticalScrollBar().setSingleStep(30)
        self.grid.clicked.connect(self.on_click)
        self.outer.addWidget(self.grid, 1)
        self.skeleton = SkeletonOverlay(self.grid.viewport(), "wide", card=(360, 214), gap=(14, 14))
        self.update_header()
        self.loaded_key = None

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Resize and obj is self.grid.viewport():
            self.fit_cards()
        return False

    def resizeEvent(self, e):
        super().resizeEvent(e)
        # Formats + sort + search don't fit side by side in a narrow window: search gets its own line
        m = self.outer.contentsMargins()
        need = (self.fmt_pick.sizeHint().width() + self.sort_pick.sizeHint().width()
                + self.search.minimumSizeHint().width() + 120)
        narrow = self.width() - m.left() - m.right() < need
        if narrow and self.search_row.indexOf(self.search) < 0:
            self.search_row.addWidget(self.search)
        elif not narrow and self.filter_row.indexOf(self.search) < 0:
            self.filter_row.addWidget(self.search)

    def fit_cards(self):
        """As many columns as fit at ~SC_W each, then the cards share the leftover width."""
        width = steady_width(self.grid) - 12   # Qt wraps a column early without some slack
        cols = max(1, width // (SC_W - 70))
        w = max(SC_W - 70, width // cols)
        if w != self.card_w:
            self.card_w = w
            self.grid.setGridSize(QSize(w, SC_H))

    # ---- helpers the delegate uses
    def in_library(self, mid):
        return mid in self.lib_ids

    def pill_text(self, mid):
        if not (self.account and self.account.connected):
            return None
        e = self.account.entry(mid)
        return acct.STATUS_NAMES.get(e["status"], e["status"]) if e else "+  Add to list"

    # ---- season navigation
    def update_header(self):
        i = self.year_lbl.findData(self.year)
        if i < 0:   # outside the list (a far year from the keyboard): add it
            self.year_lbl.addItem(str(self.year), self.year)
            i = self.year_lbl.count() - 1
        self.year_lbl.setCurrentIndex(i)
        self.season_pick.buttons[self.season].setChecked(True)

    def go_to(self, season, year):
        year = min(max(int(year), 1940), datetime.now().year + 2)
        if (season, year) != (self.season, self.year):
            self.season, self.year = season, year
            self.update_header()
            self.load()

    def step(self, delta):
        i = SEASONS.index(self.season) + delta
        self.go_to(SEASONS[i % 4], self.year + i // 4)

    def pick_season(self, season):
        self.go_to(season, self.year)

    def pick_format(self, fmt):
        self.settings["seasonal_format"] = fmt
        save_settings(self.settings)
        self.proxy.set_format(fmt)
        self.update_count()

    def pick_sort(self, key):
        self.settings["seasonal_sort"] = key
        save_settings(self.settings)
        self.proxy.set_key(key)

    def showEvent(self, e):
        super().showEvent(e)
        self.lib_ids = self.library.library_ids()
        if self.loaded_key != (self.season, self.year, acct.ADULT["on"]):   # load() keeps the side too (it reloaded
            self.load()                                                     # on every visit before)
        else:
            self.grid.viewport().update()

    # ---- loading
    def load(self, force=False):
        for ld in list(self.loaders):
            ld.requestInterruption()
        for f in list(self.fetchers):
            f.requestInterruption()
        self.load_id += 1
        self.loaded_key = (self.season, self.year, acct.ADULT["on"])
        self.model.clear()
        self.busy.show()
        self.skeleton.card = (360, 214)
        self.skeleton.start()
        self.subtitle.setText(f"{self.season.title()} {self.year}  ·  loading…")
        ld = SeasonLoader(self.load_id, self.season, self.year, force)
        ld.progress.connect(lambda i, text: i == self.load_id and self.subtitle.setText(f"{self.season.title()} {self.year}  ·  {text}"))
        ld.loaded.connect(self.on_loaded)
        ld.finished.connect(lambda: self.loaders.discard(ld))
        self.loaders.add(ld)
        ld.start()

    def on_loaded(self, load_id, media, note):
        if load_id != self.load_id:
            return
        self.busy.hide()
        self.skeleton.stop()
        jobs = []
        for m in media:
            it = QStandardItem(media_title(m))
            it.setEditable(False)
            it.setData(m, MEDIA_ROLE)
            t = m.get("title") or {}
            it.setData(" ".join(x for x in (t.get("english"), t.get("romaji"), t.get("native")) if x), Qt.ToolTipRole)
            mid = m["id"]
            if mid in self.covers:
                it.setData(self.covers[mid], COVER_ROLE)
            else:
                cov = m.get("coverImage") or {}
                big = COVER_DIR / f"{mid}.jpg"
                if big.exists() and cov.get("extraLarge"):
                    jobs.append((str(mid), cov["extraLarge"], str(mid)))          # already on disk
                elif cov.get("large"):
                    jobs.append((str(mid), cov["large"], f"{mid}_l"))             # smaller is plenty here
            self.model.appendRow(it)
        self.proxy.sort(0)
        self.note = note
        self.update_count()
        self.grid.scrollToTop()
        if jobs:
            f = ImageFetcher(jobs)
            f.image.connect(lambda key, img, lid=load_id: self.on_cover(lid, key, img))
            f.finished.connect(lambda: self.fetchers.discard(f))
            self.fetchers.add(f)
            f.start()

    def on_cover(self, load_id, key, img):
        mid = int(key)
        self.covers[mid] = img
        if load_id != self.load_id:
            return
        for row in range(self.model.rowCount()):
            it = self.model.item(row)
            if (it.data(MEDIA_ROLE) or {}).get("id") == mid:
                it.setData(img, COVER_ROLE)
                break

    def update_count(self):
        shown, total = self.proxy.rowCount(), self.model.rowCount()
        text = f"{self.season.title()} {self.year}  ·  {total} anime"
        if shown != total:
            text += f"  ·  {shown} shown"
        if getattr(self, "note", ""):
            text += f"  ·  {self.note}"
        self.subtitle.setText(text)

    # ---- clicks
    def on_click(self, idx):
        m = self.proxy.data(idx, MEDIA_ROLE) or {}
        mid = m.get("id")
        text = self.pill_text(mid)
        pos = self.grid.viewport().mapFromGlobal(QCursor.pos())
        if text and season_pill_rect(self.grid.visualRect(idx), text).contains(QPointF(pos)):
            self.status_menu(m)
            return
        path = self.library.path_for_media(mid)
        cover = self.proxy.data(idx, COVER_ROLE)
        if path:
            self.open_show.emit(path, cover)
        else:
            self.open_media.emit(mid, media_title(m), cover)

    def status_menu(self, m):
        mid = m["id"]
        e = self.account.entry(mid)
        menu = QMenu(self)
        for st in acct.STATUS_ORDER:
            a = menu.addAction(acct.STATUS_NAMES[st], lambda s=st: self.account.set_status(mid, s, m))
            a.setCheckable(True)
            a.setChecked(bool(e and e["status"] == st))
        if e:
            menu.addSeparator()
            menu.addAction("Remove from list", lambda: self.account.remove(mid))
        menu.exec(QCursor.pos())


# ---------------------------------------------------------------- torrents (like Taiga)

def build_matcher(library, account):
    """What torrent releases are matched against: library folders and the titles AniList
    knows for them (no requests made), plus your list with its alternative titles.
    Returns (matcher, describe(mid) for the filters, {id: title})."""
    cache = _read_json(org.CACHE_FILE)
    details = details_by_id()
    connected = bool(account and account.connected)
    list_media = {mid: e.get("media") or {} for mid, e in account.entries.items()} if connected else {}
    names, seasons, totals, local, titles, airing, lib_ids = {}, {}, {}, {}, {}, {}, set()

    def add(title, mid):
        key = tor.norm(title)
        if key and mid:
            names.setdefault(key, mid)

    def remember(mid, info):
        t = info.get("title") or {"romaji": info.get("romaji"), "english": info.get("english")}
        for x in (t.get("romaji"), t.get("english"), *(info.get("synonyms") or [])):
            add(x, mid)
        if totals.get(mid) is None:
            totals[mid] = info.get("episodes")
        if info.get("status"):
            airing.setdefault(mid, info["status"])
        if mid not in titles and (t.get("romaji") or t.get("english")):
            titles[mid] = media_title({"title": t})

    for path, idx in library.indexes().items():
        if not idx:
            continue
        first = next((s for s in idx["seasons"] if s), idx["mid"])
        add(Path(path).name, first)
        titles.setdefault(first, Path(path).name)
        lib_ids |= {i for i in idx["chain"] if i}
        for sid in idx["chain"]:
            remember(sid, media_info(sid, cache, details, list_media))
        for sid in idx["seasons"]:
            if sid:
                seasons[sid] = idx["seasons"]
                local[sid] = set(idx["local"].get(sid, {}))
    for mid, m in list_media.items():
        remember(mid, m)
    for key, al in ((APP.get("settings") or {}).get("torrent_aliases") or {}).items():
        if al.get("mid"):   # names you added and spellings Kura learned (Torrents → a show's name chips)
            names[tor.norm(al.get("text") or key)] = al["mid"]
            for k in (key, tor.norm(tor.search_name(al.get("text") or ""))):
                names.setdefault(k, al["mid"])
    follow = set(lib_ids) | {mid for mid, e in (account.entries.items() if connected else [])
                             if e.get("status") in ("CURRENT", "REPEATING", "PLANNING", "PAUSED")}

    def describe(mid):
        e = account.entry(mid) if connected else None
        return {"title": titles.get(mid), "status": e["status"] if e else None,
                "progress": (e or {}).get("progress") or 0, "airing": airing.get(mid),
                "in_library": mid in lib_ids, "local": local.get(mid, set())}
    return tor.Matcher(names, seasons, totals, close=follow), describe, titles


class FeedLoader(QThread):
    done = Signal(int, list, str, int, int)   # load id, items, error, page, last page (0 = no pages)

    def __init__(self, load_id, url, page=0):
        super().__init__()
        self.load_id, self.url, self.page = load_id, url, page

    def run(self):
        try:
            if isinstance(self.url, list):   # every name of a show, merged
                items, last = tor.search_pages(self.url, self.page)
                self.done.emit(self.load_id, items, "", self.page, last)
            elif self.page:   # Nyaa search, one results page
                items, page, last = tor.fetch_nyaa_page(self.url, self.page)
                self.done.emit(self.load_id, items, "", page, last)
            else:
                self.done.emit(self.load_id, tor.fetch(self.url), "", 0, 0)
        except Exception as e:
            self.done.emit(self.load_id, [], f"Couldn't load the torrent feed ({e})", 0, 0)


class Pager(QWidget):
    """‹ Previous  1 … 4 5 6 … 14  Next › for search results. page_clicked(n)."""
    page_clicked = Signal(int)

    def __init__(self):
        super().__init__()
        self.lay = QHBoxLayout(self)
        self.lay.setContentsMargins(0, 2, 0, 2)
        self.lay.setSpacing(4)
        self.page = self.last = 0
        self.loading = None

    def numbers(self):
        """Which page numbers to show: the first, the last and five in a row around the current one
        (1 2 3 4 5 … 14 on page 1, not just 1 2 3 … 14)."""
        p, last = self.page, self.last
        start = max(1, min(p - 2, last - 4))
        want = sorted({1, last} | set(range(start, min(last, start + 4) + 1)))
        out, prev = [], 0
        for n in want:
            if n - prev > 1:
                out.append(None)   # …
            out.append(n)
            prev = n
        return out

    def set(self, page, last, loading=None):
        self.page, self.last, self.loading = page, last, loading
        while self.lay.count():
            it = self.lay.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        self.setVisible(last > 1)
        if last <= 1:
            return
        base = (f"QPushButton {{ background: {C['surface']}; border: 1px solid {C['border']}; border-radius: 8px;"
                f" padding: 6px 11px; min-width: 18px; color: {C['text']}; }}"
                f" QPushButton:hover {{ background: {C['hover']}; border-color: {C['border_hi']}; }}"
                f" QPushButton:disabled {{ color: {C['faint']}; background: transparent; border-color: transparent; }}")
        current = (f"QPushButton {{ background: {C['accent']}; border: 1px solid {C['accent']}; border-radius: 8px;"
                   f" padding: 6px 11px; min-width: 18px; color: white; font-weight: 600; }}")
        busy = loading is not None

        def button(text, target, style=base, enabled=True, tip=""):
            b = QPushButton(text)
            b.setStyleSheet(style)
            b.setCursor(Qt.PointingHandCursor)
            b.setEnabled(enabled and not busy)
            if tip:
                b.setToolTip(tip)
            b.clicked.connect(lambda _=False, n=target: self.page_clicked.emit(n))
            self.lay.addWidget(b)
            return b

        self.lay.addStretch(1)
        button("‹  Previous", page - 1, enabled=page > 1)
        for n in self.numbers():
            if n is None:
                self.lay.addWidget(label("…", "faint"))
            elif n == loading:
                button(f"{n} …", n, style=current, enabled=False)
            else:
                button(str(n), n, style=current if n == page and not busy else base, enabled=n != page)
        button("Next  ›", page + 1, enabled=page < last)
        self.lay.addStretch(1)


