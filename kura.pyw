def option_row(layout, title, desc, control, stretch_control=False):
    w = QWidget()
    h = QHBoxLayout(w)
    h.setContentsMargins(0, 8, 0, 8)
    h.setSpacing(18)
    text_box = QWidget()
    text = QVBoxLayout(text_box)
    text.setContentsMargins(0, 0, 0, 0)
    text.setSpacing(2)
    if title:
        text.addWidget(label(title, "h2"))
    if desc:
        text.addWidget(label(desc, "faint", wrap=True))
    if stretch_control:
