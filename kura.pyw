        self.track = Toggle(bool(ch.get("track")))
        trow.addWidget(self.track)
        trow.addWidget(label("Update my AniList progress when I watch this channel", "muted"))
        trow.addStretch(1)
        self.summary = label("", "faint")
        trow.addWidget(self.summary)
        self.body.addLayout(trow)
        for w in (self.genres, self.status, self.picks):
            w.itemChanged.connect(lambda *_: self.count())
        for sp in (self.y_from, self.y_to, self.min_score):
            sp.valueChanged.connect(lambda *_: self.count())
        self.ok = self.add_buttons("Save channel")
        self.count()

    def value(self):
        ch = {"id": self.ch.get("id") or f"user:{int(time.time() * 1000)}", "name": self.name.text().strip() or "My channel",
              "colour": self.colour.currentData(), "number": self.number.value() or None,
              "mode": self.order.value(), "block": self.block.value(), "track": self.track.isChecked()}
        if self.how.value() == "pick":
            off = set(self.picks.unchecked())
            ch["pick"] = [self.picks.item(i).data(Qt.UserRole) for i in range(self.picks.count())
                          if self.picks.item(i).data(Qt.UserRole) not in off]
        else:
            g_off, s_off = set(self.genres.unchecked()), set(self.status.unchecked())
            genres = [self.genres.item(i).data(Qt.UserRole) for i in range(self.genres.count())
                      if self.genres.item(i).data(Qt.UserRole) not in g_off]
            status = [self.status.item(i).data(Qt.UserRole) for i in range(self.status.count())
                      if self.status.item(i).data(Qt.UserRole) not in s_off]
            ch["rules"] = {"genres": genres if len(genres) < self.genres.count() else [],
                           "status": status if len(status) < self.status.count() else [],
                           "year_from": self.y_from.value() if self.y_from.value() > 1960 else None,
                           "year_to": self.y_to.value() if self.y_to.value() < 2030 else None,
                           "min_score": self.min_score.value() or None}
        if self.slot_show.currentData() and re.match(r"^\d{1,2}:\d\d$", self.slot_time.text().strip()):
            ch["slots"] = [{"show": self.slot_show.currentData(), "time": self.slot_time.text().strip()}]
        return ch

    def count(self):
        members = livetv_mod.custom_channel_shows(self.value(), self.shows)
        hours = sum(e["dur"] for s in members for e in s["eps"]) / 3600
        self.summary.setText(f"{len(members)} show{'s' if len(members) != 1 else ''} · about {hours:.0f} hours")
        self.ok.setEnabled(bool(members))


