        if self.player is not None and self.player.current:
            self.player.subtitle.setText(self.player.current.get("subtitle") or "")
            kind = self.player.episode_kind(self.player.current)
            if kind:
                self.player.subtitle.setText(f"{self.player.subtitle.text()}  ·  {kind.title()}")
        if self.pages.currentWidget() is self.detail:
            self.detail.on_filler(mid)

