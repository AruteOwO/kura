    def player_episodes(self, playlist):
        """For the player's episode list, per playlist item: the episode's title and still (AniList), watched (your
        list), length; and the aired episodes of those seasons that aren't on disk ("missing")."""
        details = details_file()
        items, seasons = [], {}
        for it in playlist:
            mid, ep = it.get("mid"), it.get("episode")
            listed = media_for(mid, self.account) if mid else {}
            saved = ((details.get(str(mid)) or {}).get("data") or {}) if mid else {}
            url = name = None
            if mid and isinstance(ep, (int, float)) and ep == int(ep):
                url, name = episode_still({mid: saved or listed}, mid, int(ep))
            name = name or file_episode_title(it["path"])   # "S01E05 Bakeneko ...": the file's own title
            e = self.account.entry(mid) if mid and self.account and self.account.connected else None
            watched = bool(e and ep and (e.get("status") == "COMPLETED" or (e.get("progress") or 0) >= ep))
            items.append({"name": name, "watched": watched, "minutes": (listed or saved).get("duration"),
                          "pic": ("url", (url, still_stem(url))) if url else ("frame", (it["path"], "15%"))})
            if mid:
                s = seasons.setdefault(mid, {"season": it.get("season"), "eps": set(), "media": listed or saved,
                                             "saved": saved})
                s["eps"].add(ep)
        missing = []
        for mid, s in seasons.items():
            m = s["media"]
            if m.get("status") == "NOT_YET_RELEASED":
                continue
            nxt = (m.get("nextAiringEpisode") or {}).get("episode")
            aired = (nxt - 1) if nxt else m.get("episodes")
            if not aired:
                continue
            have = {int(e) for e in s["eps"] if isinstance(e, (int, float))}
            last = max(have, default=0)
            gaps = [e for e in range(1, min(aired, last) + 1) if e not in have]
            new = list(range(last + 1, aired + 1))
            # a long show you only have part of: just the gaps when there are few, and what aired after your last
            for ep in (gaps if len(gaps) <= 60 else []) + new[:60]:
                url, name = episode_still({mid: s["saved"] or m}, mid, ep)
                missing.append({"mid": mid, "season": s["season"], "episode": ep, "name": name})
        return {"items": items, "missing": missing}

