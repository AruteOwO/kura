def mpv_dirs():
    """Where libmpv-2.dll is: the mpv folder next to the script, or inside Kura.exe's runtime."""
    dirs = [SCRIPT_DIR / "mpv"]
    if FROZEN:
        dirs.insert(0, Path(getattr(sys, "_MEIPASS", SCRIPT_DIR)))
    return dirs


def media_for(mid, account):
    """Title, cover, episodes and AniList page for an id, from your list or saved details (no requests)."""
    e = account.entries.get(mid) if account and mid else None
    m = (e or {}).get("media") or {}
    if not m and mid:
        m = (details_file().get(str(mid)) or {}).get("data") or {}
    return m


_DETAILS_CACHE = {}


def details_file():
    """anilist_details.json, read again only when it changed (it's several MB: reading it for each show not on
    your list made opening the search take ~2 s)."""
    try:
        st = DETAILS_FILE.stat()
        key = (str(DETAILS_FILE), st.st_size, st.st_mtime)
    except OSError:
        return {}
    if _DETAILS_CACHE.get("key") != key:
        data = _read_json(DETAILS_FILE)
        learn_shared_stills({k: (v or {}).get("data") for k, v in data.items()})
        fix_episodes({k: (v or {}).get("data") for k, v in data.items()})
        _DETAILS_CACHE.update(key=key, data=data)
    return _DETAILS_CACHE["data"]


def mal_id(mid):
    """MyAnimeList id (AniSkip uses it); one AniList request the first time per show."""
    return (fetch_details([mid]).get(mid) or {}).get("idMal")


class JellyfinPoller(QThread):
    done = Signal(list, str)

    def __init__(self, url, key, user):
        super().__init__()
        self.args = (url, key, user)

    def run(self):
        try:
            self.done.emit(recog.jellyfin_now_playing(*self.args), "")
        except Exception as e:
            self.done.emit([], str(e))


class NowPlaying(QObject):
    """Works out what you're watching (Kura's player, media players, Jellyfin, browsers),
    updates your AniList progress the way Playback settings say, and drives Discord."""
    notify = Signal(str)
    ask = Signal(str, object)   # question, function to run on "yes"
    POLL = 5

    def __init__(self, settings, account, library):
        super().__init__()
        self.settings, self.account, self.library = settings, account, library
        self.now = None              # what's playing: mid, ep, title, source, ...
        self.builtin = None          # last report from Kura's player
        self.missing_since = None
        self.last_tick = time.time()
        self._matcher = (0, None, None)
        self.jelly, self.jelly_at, self.jelly_error, self.jelly_poller = [], 0, "", None
        self.cr_latest, self.cr_at, self.cr_poller, self.cr_client = None, 0, None, None
        self.presence = None
        self.not_on_list = set()
        self.timer = QTimer(self, interval=self.POLL * 1000, timeout=self.poll)
        self.apply_settings()

    # ---- setup
    def apply_settings(self):
        s = self.settings
        app_id = (s.get("discord_app_id") or "").strip()
        want = bool(s.get("discord_enabled") and app_id.isdigit())
        if self.presence and (not want or self.presence.client_id != app_id):
            self.presence.stop()
            self.presence = None
        if want and not self.presence:
            self.presence = recog.DiscordPresence(app_id)
            self.presence.start()
        self.timer.start()
        self.invalidate()
        self.update_discord()

    def invalidate(self):
        self._matcher = (0, None, None)

    def matcher(self):
        if time.time() - self._matcher[0] > 300 or self._matcher[1] is None:
            m, _, titles = build_matcher(self.library, self.account)
            self._matcher = (time.time(), m, titles)
        return self._matcher[1], self._matcher[2]

    def title_of(self, mid, fallback=""):
        """The AniList title (English or romaji, as in Settings) rather than the folder name."""
        m = media_for(mid, self.account)
        if m.get("title"):
            return media_title(m)
        return self.matcher()[1].get(mid) or fallback

    def recognize(self, text, source):
        """'[Group] Title S2 - 05 (1080p)' -> {mid, ep, title, group, source} or None."""
        p = tor.parse_release(text)
        ep = p["episodes"][-1] if p["episodes"] else None
        mid, ep = self.matcher()[0].match(p["name"], p["season"], ep)
        if not mid or not ep:
            return None
        return {"mid": mid, "ep": ep, "title": self.title_of(mid, p["name"]),
                "group": p["group"], "source": source}

    # ---- detecting
    def detect(self):
        s, b = self.settings, self.builtin
        if b and time.time() - b["at"] < 8:   # Kura's own player: exact
            cand = None
            if b.get("mid") and b.get("episode"):
                cand = {"mid": b["mid"], "ep": b["episode"], "group": tor.parse_release(Path(b["path"]).name)["group"],
                        "title": self.title_of(b["mid"], b.get("title") or ""), "source": "Kura player"}
            else:
                cand = self.recognize(Path(b["path"]).name, "Kura player")
            if cand:
                return {**cand, "builtin": True, "paused": b.get("paused"), "pos": b.get("pos"), "duration": b.get("duration"),
                        "no_update": bool(b.get("live") and not b.get("track"))}
        if not s.get("recog_enabled", True):
            return None
        if s.get("recog_players", True):
            off = set(s.get("recog_player_list") or [])
            for name, text in recog.from_players({n for n in recog.PLAYERS.values() if n not in off}):
                cand = self.recognize(text, name)
                if cand:
                    return cand
        if s.get("recog_jellyfin") and self.jelly:
            matcher = self.matcher()[0]
            for j in self.jelly:
                mid, ep = matcher.match(j["series"], j["season"], j["episode"])
                if mid and ep:
                    return {"mid": mid, "ep": ep, "title": self.title_of(mid, j["series"]), "group": "",
                            "source": f"Jellyfin ({j['device']})" if j["device"] else "Jellyfin", "paused": j["paused"]}
        if s.get("recog_crunchyroll") and self.cr_latest:
            cand = self.crunchyroll_candidate(self.cr_latest)
            if cand:
                return cand
        if s.get("recog_browsers", True):
            off = set(s.get("recog_sites") or [])
            for name, text in recog.from_browsers({k for k in recog.SITES if k not in off}):
                cand = self.recognize(text, name)
                if cand:
                    return cand
        return None

    def poll_jellyfin(self):
        s = self.settings
        if not (s.get("recog_enabled", True) and s.get("recog_jellyfin") and s.get("jellyfin_url") and s.get("jellyfin_key")):
            self.jelly = []
            return
        if self.jelly_poller or time.time() - self.jelly_at < 15:
            return
        self.jelly_at = time.time()
        self.jelly_poller = JellyfinPoller(s["jellyfin_url"], s["jellyfin_key"], s.get("jellyfin_user", ""))
        self.jelly_poller.done.connect(self.on_jellyfin)
        self.jelly_poller.start()

    def on_jellyfin(self, sessions, err):
        self.jelly, self.jelly_error = sessions, err
        self.jelly_poller = None

    # ---- Crunchyroll (your account): its newest history entry, while it's being played
    CR_LIVE_S = 150   # Crunchyroll saves where you are about every 30 s; older than this = not playing

    def poll_crunchyroll(self):
        s = self.settings
        if not (s.get("recog_enabled", True) and s.get("recog_crunchyroll")):
            self.cr_latest = None
            return
        if self.cr_poller or time.time() - self.cr_at < 30:
            return
        self.cr_at = time.time()
        if self.cr_client is None:
            creds = crunchy.load_creds()
            if not creds:
                return
            self.cr_client = crunchy.Crunchyroll(creds)
        client = self.cr_client
        self.cr_poller = BgCall(client.latest)
        self.cr_poller.done.connect(self.on_crunchyroll)
        self.cr_poller.start()

    def on_crunchyroll(self, latest, err):
        self.cr_poller.wait()
        self.cr_poller = None
        if err:
            # the import tool may have renewed (rotated) the sign-in, or you signed out:
            # read it from disk again on the next poll
            self.cr_latest, self.cr_client = None, None
            return
        self.cr_latest = latest

    def crunchyroll_candidate(self, e):
        try:
            played = datetime.fromisoformat(e["played"].replace("Z", "+00:00")).timestamp()
        except (KeyError, ValueError, AttributeError):
            return None
        if time.time() - played > self.CR_LIVE_S or not e.get("episode"):
            return None
        mine = crunchy.load_map().get(e["season_id"]) or {}
        if "mid" in mine:   # your choice in the Crunchyroll import tool
            mid, ep = mine["mid"], e["episode"]
        else:
            matcher = self.matcher()[0]
            mid, ep = matcher.match(e["season_title"], None, e["episode"])
            if not mid:
                mid, ep = matcher.match(e["series_title"], e.get("season_number"), e["episode"])
        if not mid or not ep:
            return None
        return {"mid": mid, "ep": ep, "title": self.title_of(mid, e["season_title"]), "group": "",
                "source": "Crunchyroll", "pos": e.get("playhead"), "duration": e.get("duration")}

    def poll(self):
        now_t = time.time()
        elapsed, self.last_tick = now_t - self.last_tick, now_t
        self.poll_jellyfin()
        self.poll_crunchyroll()
        try:
            cand = self.detect()
        except Exception:
            cand = None
        if cand:
            self.missing_since = None
            key = (cand["mid"], cand["ep"])
            if self.now is None or self.now["key"] != key:
                if self.now:
                    self.finish(self.now)
                self.now = {**cand, "key": key, "started": now_t, "watched": 0.0, "updated": False}
                if self.settings.get("recog_notify", True) and not cand.get("builtin"):
                    self.notify.emit(f"Now playing: {cand['title']} · Episode {cand['ep']}  ({cand['source']})")
            else:
                self.now.update({k: cand.get(k) for k in ("paused", "pos", "duration", "source")})
                if not cand.get("paused"):
                    self.now["watched"] += min(elapsed, self.POLL * 3)
            self.check_update(self.now, closing=False)
            self.update_discord()
        elif self.now:
            if self.missing_since is None:
                self.missing_since = now_t
            if now_t - self.missing_since > 8 or self.now.get("builtin"):
                self.finish(self.now)
                self.now = None
                self.update_discord()

    # ---- list updates
    def ready(self, n):
        if n.get("builtin"):
            return bool(n.get("duration")) and n.get("pos", 0) / n["duration"] * 100 >= int(self.settings.get("progress_percent", 80))
        return n["watched"] >= int(self.settings.get("progress_delay", 120))

    def check_update(self, n, closing):
        s = self.settings
        if n["updated"] or n.get("no_update") or s.get("progress_mode", "auto") == "off" or not self.ready(n):
            return
        if s.get("progress_wait_close") and not closing:
            return
        self.update_progress(n)

    def finish(self, n):
        self.check_update(n, closing=True)

    def update_progress(self, n):
        n["updated"] = True
        a = self.account
        if not (a and a.connected):
            return
        mid, ep, title = n["mid"], n["ep"], n["title"]
        entry = a.entry(mid)
        if not entry:
            if mid not in self.not_on_list:
                self.not_on_list.add(mid)
                self.notify.emit(f"{title} isn't on your AniList list, so your progress wasn't updated.")
            return
        progress = entry.get("progress") or 0
        if ep <= progress:
            return
        if self.settings.get("recog_ignore_ahead") and ep > progress + 1:
            self.notify.emit(f"Skipped updating {title}: episode {ep} is past your next episode ({progress + 1}).")
            return
        if self.settings.get("progress_mode") == "ask":
            self.ask.emit(f"Mark {title} episode {ep} as watched?", lambda: self.apply_progress(mid, ep, title))
        else:
            self.apply_progress(mid, ep, title)

    def apply_progress(self, mid, ep, title):
        self.account.set_progress(mid, ep, media_for(mid, self.account))
        self.notify.emit(f"Updated {title} to episode {ep} on AniList")

    # ---- Kura's player
    def builtin_progress(self, d):
        first = self.builtin is None
        self.builtin = {**d, "at": time.time()}
        if first:
            self.poll()

    def builtin_closed(self):
        self.builtin = None
        self.poll()

    # ---- Discord
    def update_discord(self):
        if not self.presence:
            return
        n, s = self.now, self.settings
        if not n:
            self.presence.update(None)
            return
        m = media_for(n["mid"], self.account)
        user = ((self.account.user or {}).get("name") or "") if self.account else ""
        if s.get("adult_discord_hide", True) and acct.is_adult(m):   # 18+: "Watching anime", nothing more
            self.presence.update(recog.activity_for(
                "Anime", None, total=None, group="", cover="", url="", started=n["started"], username=user,
                show_group=False, show_elapsed=s.get("discord_show_elapsed", True),
                show_username=s.get("discord_show_user", True), paused=bool(n.get("paused"))))
            return
        self.presence.update(recog.activity_for(
            n["title"], n["ep"], total=m.get("episodes"), group=n.get("group", ""),
            cover=(m.get("coverImage") or {}).get("extraLarge") or "", url=m.get("siteUrl") or "",
            started=n["started"], username=user, show_group=s.get("discord_show_group", True),
            show_elapsed=s.get("discord_show_elapsed", True), show_username=s.get("discord_show_user", True),
            paused=bool(n.get("paused"))))

    def shutdown(self):
        self.timer.stop()
        if self.cr_poller is not None:
            self.cr_poller.wait(5000)
        if self.presence:
            self.presence.stop()
            self.presence.join(3)


class CheckList(QListWidget):
    """Checkable list (media players, sites); unchecked names are stored."""

