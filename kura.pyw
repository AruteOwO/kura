    # ---- filter list
    def anime_text(self, f):
        ids = f.get("anime") or []
        if not ids:
            return "All"
        names = dict(self.anime_choices)
        text = names.get(ids[0], "1 anime") if len(ids) == 1 else f"{len(ids)} anime"
        return f"All except {text}" if f.get("anime_mode") == "except" else text

    def fill_filters(self, select=None):
        self.ftree.blockSignals(True)
        self.ftree.clear()
        for f in self.filters:
            it = QTreeWidgetItem([f["name"], tor.ACTIONS[f["action"]].split(" matched")[0]
                                  + (" (hide)" if f["action"] == "discard" and f.get("discard") == "hide" else ""),
                                  self.anime_text(f)])
            it.setIcon(0, dot_icon(ACTION_COLORS[f["action"]]))
            it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
            it.setCheckState(0, Qt.Checked if f.get("enabled", True) else Qt.Unchecked)
            it.setForeground(1, QColor(ACTION_COLORS[f["action"]]))
            self.ftree.addTopLevelItem(it)
        self.ftree.blockSignals(False)
        if select is not None and 0 <= select < len(self.filters):
            self.ftree.setCurrentItem(self.ftree.topLevelItem(select))

    def current(self):
        it = self.ftree.currentItem()
        return self.ftree.indexOfTopLevelItem(it) if it else -1

    def toggled_filter(self, it, col):
        i = self.ftree.indexOfTopLevelItem(it)
        if col == 0 and 0 <= i < len(self.filters):
            self.filters[i]["enabled"] = it.checkState(0) == Qt.Checked

    def add_filter(self):
        pd = PresetDialog(self)
        if pd.exec() != QDialog.Accepted:
            return
        fd = FilterDialog(self, pd.preset(), self.anime_choices)
        if fd.exec() == QDialog.Accepted:
            self.filters.append(fd.result_filter())
            self.fill_filters(len(self.filters) - 1)

    def edit_filter(self):
        i = self.current()
        if i < 0:
            return
        fd = FilterDialog(self, self.filters[i], self.anime_choices)
        if fd.exec() == QDialog.Accepted:
            f = fd.result_filter()
            f["enabled"] = self.filters[i].get("enabled", True)
            self.filters[i] = f
            self.fill_filters(i)

    def remove_filter(self):
        i = self.current()
        if i >= 0:
            del self.filters[i]
            self.fill_filters(min(i, len(self.filters) - 1))

    def move_filter(self, delta):
        i = self.current()
        if 0 <= i < len(self.filters) and 0 <= i + delta < len(self.filters):
            self.filters[i], self.filters[i + delta] = self.filters[i + delta], self.filters[i]
            self.fill_filters(i + delta)

    def duplicate_filter(self):
        i = self.current()
        if i >= 0:
            f = json.loads(json.dumps(self.filters[i]))
            f["name"] += " (copy)"
            self.filters.insert(i + 1, f)
            self.fill_filters(i + 1)

    def reset_filters(self):
        box = QMessageBox(QMessageBox.Question, "Reset filters", "Replace your filters with the defaults?",
                          QMessageBox.Yes | QMessageBox.Cancel, self)
        if box.exec() == QMessageBox.Yes:
            self.filters[:] = tor.default_filters()
            self.fill_filters()

    # ---- profiles
    def fill_profiles(self):
        self.profile_box.blockSignals(True)
        self.profile_box.clear()
        for name in self.profiles:
            self.profile_box.addItem(name)
        self.profile_box.setCurrentText(self.active)
        self.profile_box.blockSignals(False)
        self.delete_btn.setEnabled(len(self.profiles) > 1)

    def switch_profile(self, name):
        if name in self.profiles:
            self.active = name
            self.filters = self.profiles[name]
            self.fill_filters()

    def ask_name(self, title, text, current=""):
        name, ok = QInputDialog.getText(self, title, text, text=current)
        name = name.strip()
        if not ok or not name:
            return None
        if name in self.profiles and name != current:
            QMessageBox.information(self, title, f"There's already a profile called “{name}”.")
            return None
        return name

    def new_profile(self):
        name = self.ask_name("Save as new profile", "Name for a copy of the current filters:")
        if name:
            self.profiles[name] = json.loads(json.dumps(self.filters))
            self.switch_profile(name)
            self.fill_profiles()

    def rename_profile(self):
        name = self.ask_name("Rename profile", "New name:", self.active)
        if name and name != self.active:
            self.profiles = {(name if k == self.active else k): v for k, v in self.profiles.items()}
            self.active = name
            self.fill_profiles()

    def delete_profile(self):
        if len(self.profiles) < 2:
            return
        box = QMessageBox(QMessageBox.Question, "Delete profile", f"Delete the profile “{self.active}”?",
                          QMessageBox.Yes | QMessageBox.Cancel, self)
        if box.exec() == QMessageBox.Yes:
            del self.profiles[self.active]
            self.switch_profile(next(iter(self.profiles)))
            self.fill_profiles()

    def export_data(self):
        return tor.export_profile(self.active, self.filters, dict(self.anime_choices))

    def export_file(self):
        safe = re.sub(r'[\\/:*?"<>|]', "", self.active) or "filters"
        path, _ = QFileDialog.getSaveFileName(self, "Export filter profile", str(Path.home() / f"{safe}.kura-filters"),
                                              "Kura filter profile (*.kura-filters);;JSON (*.json)")
        if path:
            Path(path).write_text(json.dumps(self.export_data(), indent=1, ensure_ascii=False), encoding="utf-8")

    def export_clipboard(self):
        QApplication.clipboard().setText(json.dumps(self.export_data(), ensure_ascii=False))
        QMessageBox.information(self, "Copied", f"“{self.active}” is on the clipboard. Paste it anywhere to share; "
                                "others can use Import → From clipboard.")

    def import_file(self):
        path, _ = QFileDialog.getOpenFileName(self, "Import filter profile", str(Path.home()),
                                              "Kura filter profile (*.kura-filters *.json);;All files (*)")
        if path:
            try:
                self.import_text(Path(path).read_text(encoding="utf-8"))
            except OSError as e:
                QMessageBox.warning(self, "Import", f"Couldn't read that file ({e}).")

    def import_text(self, text):
        try:
            name, filters, notes = tor.import_profile(text)
        except ValueError as e:
            QMessageBox.warning(self, "Import", str(e))
            return
        name = tor.unique_name(name, self.profiles)
        self.profiles[name] = filters
        self.switch_profile(name)
        self.fill_profiles()
        msg = f"Imported “{name}” with {len(filters)} filters. It's now the active profile (press Save to keep it)."
        if notes:
            msg += "\n\nSome parts were left out:\n• " + "\n• ".join(notes[:8])
        QMessageBox.information(self, "Import", msg)

    def save(self):
        s = self.s
        s["torrent_feed"] = self.feed.text().strip() or tor.DEFAULT_FEED
        s["torrent_search_feed"] = self.search_feed.text().strip() or tor.DEFAULT_SEARCH_FEED
        s["torrent_auto_check"] = self.auto_check.isChecked()
        s["torrent_interval_min"] = self.interval.value()
        s["torrent_new_action"] = self.new_action.value()
        s["torrent_catchup"] = self.catchup_t.isChecked()
        s["torrent_fallback"] = self.fallback.isChecked()
        s["torrent_fallback_hours"] = self.fallback_hours.value()
        s["torrent_sort"] = self.sort.value()
        s["torrent_sort_order"] = self.order.value()
        s["torrent_use_anime_folder"] = self.anime_folder.isChecked()
        s["torrent_use_fallback"] = self.use_fallback.isChecked()
        s["torrent_fallback_folder"] = self.fallback_dir.edit.text().strip()
        s["torrent_subfolder"] = self.subfolder.isChecked()
        s["torrent_app"] = self.app.value()
        s["torrent_client"] = self.client.text().strip()
        s["qbit_url"] = self.qbit_url.text().strip()
        s["qbit_user"] = self.qbit_user.text().strip()
        s["qbit_password"] = secret_encode(self.qbit_pass.text())
        s["qbit_organize"] = self.qbit_organize.isChecked()
        s["qbit_remove"] = self.qbit_remove.isChecked()
        s["torrent_only_missing"] = self.only_missing.isChecked()
        s["torrent_skip_junk"] = self.skip_junk.isChecked()
        save_settings(s)
        tor.save_profiles(self.filters_on.isChecked(), self.active, self.profiles)


