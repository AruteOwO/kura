        col.addSpacing(8)

        presets = QHBoxLayout()
        presets.setSpacing(8)
        presets.addWidget(label("Presets", "muted"))
        for key, name, values in subs_mod.PRESETS:
            b = QPushButton(name)
            b.setCursor(Qt.PointingHandCursor)
