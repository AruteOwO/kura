                for f in files:
                    tile = ExtraTile(f, kind)
                    tile.menu_asked.connect(lambda p, pos, k=kind, s=season: self.menu(p, k, s, pos))
                    grid.add(tile)
                v.addWidget(grid)

    def menu(self, path, kind, season, pos):
        m = QMenu(self)
        m.addAction(glyph_icon(G["play"], C["text"]), "Play", lambda: play_video(path))
        if kind != "menu":
            skipped = extras_skipped(path)
            m.addAction(glyph_icon("block", C["text"]), "Use on Live TV again" if skipped else "Not this one: don't use on Live TV",
                        lambda: self.toggle_skip(path))
        move = m.addMenu("Move to")
        for k, name in org.EXTRA_KIND_FOLDERS.items():
            if k != kind:
                move.addAction(glyph_icon(EXTRA_GLYPHS[k], C["text"]), name, lambda k=k: self.move_to(path, k, season))
        m.addSeparator()
        m.addAction(glyph_icon(G["folder"], C["text"]), "Show in folder", lambda: subprocess_open_select(path))
        m.exec(pos)

    def toggle_skip(self, path):
        s = APP["settings"]
        skip = list(s.get("extras_skip") or [])
        key = os.path.normcase(str(path))
        skip.remove(key) if key in skip else skip.append(key)
        s["extras_skip"] = skip
        save_settings(s)
        self.changed()

    def move_to(self, path, kind, season):
        """Another kind (the name said "PV" but it's an ending...): the file moves to that kind's folder."""
        dest_dir = self.extras_dir / org.EXTRA_KIND_FOLDERS[kind]
        if season:
            dest_dir = dest_dir.joinpath(*season.split(" / "))
        dest = dest_dir / Path(path).name
        if dest.exists():
            QMessageBox.information(self, APP_NAME, f"{dest_dir.name} already has a file called {dest.name}.")
            return
        try:
            dest_dir.mkdir(parents=True, exist_ok=True)
            shutil.move(path, str(dest))
            src_dir = Path(path).parent
            while src_dir != self.extras_dir and src_dir.is_dir() and not any(src_dir.iterdir()):
                src_dir.rmdir()
                src_dir = src_dir.parent
        except OSError as e:
            QMessageBox.warning(self, APP_NAME, f"Couldn't move it: {e}")
            return
        s = APP["settings"]   # a "not this one" follows the file
        key, new = os.path.normcase(str(path)), os.path.normcase(str(dest))
        if key in (s.get("extras_skip") or []):
            s["extras_skip"] = [new if x == key else x for x in s["extras_skip"]]
            save_settings(s)
        self.changed()


