                                ("", "\uE74B", lambda: self.move_filter(1)), ("Duplicate", G["copy"], self.duplicate_filter)]:
            b = QPushButton(f" {text}" if text else "")
            b.setObjectName("small" if text else "icon")
            b.setIcon(glyph_icon(glyph, C["text"], px=13))
