class HomeRow(QWidget):
    """A titled row of cards that scrolls sideways with the ‹ › buttons (the wheel scrolls the page)."""

    def __init__(self, title, cards, page_scroll, note=""):
        super().__init__()
        self.page_scroll = page_scroll
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
        if title is not None:
            head = QHBoxLayout()
            head.setSpacing(10)
            head.addWidget(row_title(title))
            if note:
                head.addWidget(label(note, "faint"))
            head.addStretch(1)
            self.prev_btn, self.next_btn = round_arrows(head, self.page)
            v.addLayout(head)
        else:   # ChipRows has the header (and its arrows page this row)
            self.prev_btn, self.next_btn = QPushButton(self), QPushButton(self)
            self.prev_btn.hide()
            self.next_btn.hide()
        self.area = QScrollArea()
        self.area.setFrameShape(QFrame.NoFrame)
        self.area.setWidgetResizable(True)
        self.area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.area.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        inner = QWidget()
        h = QHBoxLayout(inner)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(16)
        for c in cards:
            h.addWidget(c, 0, Qt.AlignTop)
        h.addStretch(1)
        self.area.setWidget(inner)
        self.area.setFixedHeight(max((c.sizeHint().height() for c in cards), default=0) + 4)
        self.area.viewport().installEventFilter(self)
        self.area.horizontalScrollBar().rangeChanged.connect(lambda *_: self.update_buttons())
        self.area.horizontalScrollBar().valueChanged.connect(lambda *_: self.update_buttons())
        v.addWidget(self.area)
        self.anim = None
        QTimer.singleShot(0, self.update_buttons)

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Wheel:   # the page scrolls, not the row
            if e.modifiers() & Qt.ShiftModifier:
                bar = self.area.horizontalScrollBar()
                bar.setValue(bar.value() - e.angleDelta().y())
            else:
                QApplication.sendEvent(self.page_scroll.viewport(), e)
            return True
        return False

    def page(self, direction):
        bar = self.area.horizontalScrollBar()
        target = max(0, min(bar.maximum(), bar.value() + direction * int(self.area.viewport().width() * 0.85)))
        self.anim = QPropertyAnimation(bar, b"value", self)
        self.anim.setDuration(320)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)
        self.anim.setStartValue(bar.value())
        self.anim.setEndValue(target)
        self.anim.start()

    def update_buttons(self):
        try:
            bar = self.area.horizontalScrollBar()
        except RuntimeError:   # Home was rebuilt before this row's first update ran
            return
        if self.prev_btn.parent() is self:   # no header of its own
            return
        self.prev_btn.setVisible(bar.maximum() > 0)
        self.next_btn.setVisible(bar.maximum() > 0)
        self.prev_btn.setEnabled(bar.value() > 0)
        self.next_btn.setEnabled(bar.value() < bar.maximum())


class HeroScrim(QWidget):
    """Over the banner's trailer: the same shading as over the art (text stays readable), and the
    banner's rounded corners (the video itself is square)."""

    def __init__(self, parent):
        super().__init__(parent)
        self.setAttribute(Qt.WA_TransparentForMouseEvents)

    def paintEvent(self, _):
        p = QPainter(self)
        paint_hero_shade(p, QRectF(self.rect()))


def paint_hero_shade(p, r):
    """Over the banner's art or trailer: dark on the left so the words read, a little at the top (greeting and
    pills), and down into the page's colour at the bottom (the banner runs into the rows below)."""
    side = QLinearGradient(r.topLeft(), r.topRight())
    side.setColorAt(0, QColor(10, 12, 16, 235))
    side.setColorAt(0.45, QColor(10, 12, 16, 150))
    side.setColorAt(0.8, QColor(10, 12, 16, 0))
    p.fillRect(r, side)
    top = QLinearGradient(r.topLeft(), r.bottomLeft())
    top.setColorAt(0, QColor(10, 12, 16, 130))
    top.setColorAt(0.25, QColor(10, 12, 16, 0))
    p.fillRect(r, top)
    bottom = QLinearGradient(r.bottomLeft(), r.topLeft())
    bg = QColor(C["bg"])
    bottom.setColorAt(0, bg)
    clear = QColor(bg)
    clear.setAlpha(0)
    bottom.setColorAt(0.55, clear)
    p.fillRect(r, bottom)


