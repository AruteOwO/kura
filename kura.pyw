    def move_adult_shows(self):
        """Settings → Adult content → Move: 18+ shows sitting in the Anime library go to the adult one."""
        lib = Path(anime_library(self.settings) or "")
        dest = Path(adult_value(self.settings, "library") or "")
        if not lib.is_dir() or not str(dest):
            QMessageBox.information(self, APP_NAME, "Set the Anime library and the hentai library folder first.")
            return
        cache = org.load_cache()
        found = []
        idxs = self.library.root_cache.get(str(lib)) or [{"path": p, "index": it.data(INDEX_ROLE)}
                                                         for p, it in self.library.items.items()]
        unknown = []
        for sh in idxs:
            idx = sh.get("index")
            if not idx:
                continue
            m = media_for(idx["mid"], self.account) or {}
            if idx.get("adult") is not None or m.get("isAdult") is not None:
                if index_adult(idx, self.account):
                    found.append(sh["path"])
            else:
                unknown.append((sh["path"], idx["mid"]))
        if unknown:
            self.notify("Checking your library with AniList…", keep=False)

        def work():   # shows AniList hasn't told Kura about yet (50 per request, then cached)
            adult = org.adult_ids([mid for _, mid in unknown], cache)
            org.save_cache(cache)
            return [path for path, mid in unknown if mid in adult]
        call = BgCall(work)

        def done(more, err, c=call):
            c.wait()
            shows = sorted(set(found) | set(more or []))
            if not shows:
                QMessageBox.information(self, APP_NAME, "No hentai in your Anime library.")
                return
            dlg = AdultMoveDialog(self, shows, dest)
            if dlg.exec() != QDialog.Accepted:
                return
            moved, failed = 0, []
            dest.mkdir(parents=True, exist_ok=True)
            for f in dlg.picked():
                target = dest / Path(f).name
                try:
                    if target.exists():
                        raise OSError("a folder with that name is already there")
                    shutil.move(f, str(target))
                    moved += 1
                except OSError as e:
                    failed.append(f"{Path(f).name}: {e}")
            klog.info(f"Moved {moved} adult show(s) to {dest}")
            self.notify(f"Moved {moved} show{'s' if moved != 1 else ''} to {dest}")
            if failed:
                QMessageBox.warning(self, APP_NAME, "\n".join(failed))
            self.library.root_cache.clear()
            self.library.refresh()
        call.done.connect(done)
        self.mode_calls = getattr(self, "mode_calls", []) + [call]
        call.start()

