        self.sound_btn.clicked.connect(self.toggle_sound)
        self.sound_btn.hide()
        self.trailer_timer = QTimer(self, singleShot=True, interval=4000, timeout=self.start_trailer)

    def start_trailer(self):
        s = self.settings
        it = self.items[self.index] if self.items else {}
        tr = it.get("trailer")
        if (not s or not s.get("home_trailer", True) or not tr or not self.isVisible()
                or (APP["previews"] and APP["previews"].card.isVisible()) or not self.window().isActiveWindow()):
            return
        if self.video is None:
            self.video = TrailerVideo(s, self, loop=False)
            self.video.started.connect(self.on_trailer_started)
            self.video.ended.connect(self.stop_trailer)
            self.video.failed.connect(lambda *_: self.stop_trailer())
        self.video.setGeometry(0, 0, 1, 1)
        self.video.show()
        self.video.lower()
        self.video.play_trailer(tr, not s.get("home_trailer_sound", False), s.get("preview_volume", 60))

    def cover_rect(self):
        """The video fills the banner like the art does: as wide as the banner, the middle band shown
        (the banner is much wider than 16:9; it was letterboxed with black bars)."""
        w = max(self.width(), int(self.height() * 16 / 9))
        h = int(w * 9 / 16)
        return QRect((self.width() - w) // 2, int((self.height() - h) * 0.45), w, h)

    def on_trailer_started(self):
        self.playing = True
        self.video.setGeometry(self.cover_rect())
        self.scrim.setGeometry(self.rect())
        self.scrim.show()
        self.scrim.lower()
        self.video.lower()   # video, then the shading, then the text and buttons on top
        self.sound_btn.move(self.width() - 52, 64)   # under the pills
        self.sound_btn.show()
        self.sound_btn.raise_()
        self.update_sound_icon()

    def stop_trailer(self):
        self.trailer_timer.stop()
        self.playing = False
        if self.video is not None:
            self.video.stop()
            self.video.hide()
        self.scrim.hide()
        self.sound_btn.hide()

    def toggle_sound(self):
        s = self.settings
        s["home_trailer_sound"] = not s.get("home_trailer_sound", False)
        save_settings(s)
        if self.video is not None:
            self.video.set_muted(not s["home_trailer_sound"])
        self.update_sound_icon()

    def update_sound_icon(self):
        on = bool(self.settings and self.settings.get("home_trailer_sound", False))
        self.sound_btn.setIcon(glyph_icon("\uE767" if on else "\uE74F", "white", px=14))
        self.sound_btn.setToolTip("Sound on" if on else "Sound off")

    def resizeEvent(self, e):
        super().resizeEvent(e)
        if self.playing:
            self.video.setGeometry(self.cover_rect())
            self.scrim.setGeometry(self.rect())
            self.sound_btn.move(self.width() - 52, 64)

    def hideEvent(self, e):
        super().hideEvent(e)
        self.stop_trailer()

    def shutdown(self):
        self.stop_trailer()
        if self.video is not None:
            self.video.shutdown()

    def set_items(self, items):
        """New banner items. Home is rebuilt now and then (an episode organized, your list synced): the banner stays
        on the item it was showing, wherever it moved to, without restarting its timer or trailer."""
        prev = self.items[self.index] if self.items and self.index < len(self.items) else None
        self.items = items[:5]
        paths = [it.get("path") for it in self.items]
        same = prev is not None and prev.get("path") in paths
        self.index = paths.index(prev["path"]) if same else min(self.index, max(0, len(self.items) - 1))
        for t in self.thumbs:
            t.deleteLater()
        self.thumbs = []
        if len(self.items) > 1:
            for i, it in enumerate(self.items):
                key = it.get("banner_key") or it.get("poster_key") or it.get("thumb_key")   # the art, like the banner
                t = HeroThumb(it["title"], key)
                if key in self.images:
                    t.set_image(self.images[key])
                t.clicked.connect(lambda n=i: self.show_item(n))
                self.thumb_row.addWidget(t, 0, Qt.AlignBottom)
                self.thumbs.append(t)
        self.fit_thumbs()
        if same:
            self.fill_item()   # the words may have changed (minutes left...), nothing restarts
        else:
            self.show_item(self.index)
        if not self.timer.isActive():
            self.timer.start()

    def show_item(self, n):
        if not self.items:
            return
        self.index = n % len(self.items)
        self.fill_item()
        self.stop_trailer()
        self.trailer_timer.start()
        self.timer.start()   # a full 9 s on the item you picked (or the next one)

    def fill_item(self):
        """The current item's words, buttons and page markers."""
        if not self.items:
            return
        it = self.items[self.index]
        kick = {"resume": "CONTINUE WATCHING", "new": "NEW EPISODE", "start": "IN YOUR LIBRARY",
                "discover": "POPULAR THIS SEASON"}.get(it.get("kind"), "UP NEXT")
        tint = QColor(C["accent_hi"]).lighter(130).name()
        if it.get("kind") == "new":   # arrived since you last watched: filled, like its card's ribbon
            kick += f" · ARRIVED {short_ago(it.get('arrived')).upper()}"
            self.kicker.setStyleSheet(f"color: white; background: {C['accent']}; border: 1px solid {C['accent']};"
                                      " border-radius: 12px; padding: 3px 11px; font-size: 8pt; font-weight: 800;")
            self.kicker.setText(icon_html("bolt", 14, "white") + "&nbsp; " + kick)
        else:
            self.kicker.setStyleSheet(f"color: {tint}; background: rgba({accent_rgb()},0.22); border: 1px solid rgba({accent_rgb()},0.40);"
                                      " border-radius: 12px; padding: 3px 11px; font-size: 8pt; font-weight: 700;")
            self.kicker.setText(icon_html("auto_awesome" if it.get("kind") in ("start", "discover") else "play_circle", 14, tint)
                                + "&nbsp; " + kick)
        self.title.setText(it["title"])
        self.info.setText(it["info"])
        self.watched_btn.setVisible(bool(it.get("can_mark")))
        self.changed.emit(self.index)
        desc = it.get("desc") or ""
        if len(desc) > 260:
            desc = desc[:260].rsplit(" ", 1)[0] + "…"
        self.desc.setText(desc)
        self.desc.setVisible(bool(desc))
        self.play_btn.setText(f"  {it.get('verb', 'Play')}")
        self.show_btn.setVisible(bool(it.get("path")))
        self.play_btn.setIcon(glyph_icon("play_arrow:fill" if it.get("path") else "info", "#0d0f14", "#0d0f14", px=16))   # a show you don't have: its Show button is the main one
        for i, t in enumerate(self.thumbs):
            t.set_on(i == self.index)
        self.update()

    def eventFilter(self, obj, e):
        if obj is self.thumb_box and e.type() == QEvent.Resize:
            self.fit_thumbs()
        return False

    def fit_thumbs(self):
        """As many previews as fit beside the buttons (the first ones)."""
        room = self.thumb_box.width() - 20
        for i, t in enumerate(self.thumbs):
            t.setVisible((i + 1) * (t.width() + 6) <= room)

    def set_header(self, widget):
        """The greeting and pills along the top (new ones each time Home is built)."""
        while self.top.count():
            w = self.top.takeAt(0).widget()
            if w is not None:
                w.deleteLater()
        self.top.addWidget(widget)

    def auto_next(self):
        if len(self.items) > 1 and not self.underMouse() and not self.playing:
            self.show_item(self.index + 1)

    def set_image(self, key, img):
        self.images[key] = img
        for t in self.thumbs:
            if t.key == key:
                t.set_image(img)
        if self.items and key in (self.items[self.index].get(k) for k in ("banner_key", "poster_key", "thumb_key")):
            self.update()

    def paint_poster(self, p, r, key, poster):
        """No wide art: the poster blurred across the banner, and the poster itself on the right."""
        dpr = self.devicePixelRatioF()
        cache = getattr(self, "_poster_bg", None)
        if not cache or cache[0] != (key, self.width(), self.height()):
            small = poster.scaled(24, 36, Qt.IgnoreAspectRatio, Qt.SmoothTransformation)   # tiny, then up = blurred
            bg = small.scaled(self.size() * dpr, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
            self._poster_bg = cache = ((key, self.width(), self.height()), bg)
        bg = cache[1]
        sx, sy = (bg.width() - self.width() * dpr) / 2, (bg.height() - self.height() * dpr) / 2
        p.drawImage(r, bg, QRectF(sx, sy, self.width() * dpr, self.height() * dpr))
        p.fillRect(r, QColor(10, 12, 16, 110))
        ph = self.height() - 190   # between the pills and the previews strip
        pw = ph * 2 / 3
        box = QRectF(self.width() - pw - 72, 66, pw, ph)
        clip = QPainterPath()
        clip.addRoundedRect(box, 14, 14)
        p.save()
        p.setClipPath(clip)
        p.drawImage(box, poster.scaled(int(pw * dpr), int(ph * dpr), Qt.KeepAspectRatioByExpanding,
                                       Qt.SmoothTransformation))
        p.restore()
        p.setPen(QPen(QColor(255, 255, 255, 40), 1))
        p.drawRoundedRect(box, 14, 14)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        r = QRectF(self.rect())
        it = self.items[self.index] if self.items else {}
        img = self.images.get(it.get("banner_key"))
        poster = self.images.get(it.get("poster_key"))
        if (img is None or img.isNull()) and poster is not None and not poster.isNull():
            self.paint_poster(p, r, it.get("poster_key"), poster)
            paint_hero_shade(p, r)
            return
        if img is None and not it.get("poster_key"):   # no art at all: the episode's frame after all
            img = self.images.get(it.get("thumb_key"))
        if img is not None and not img.isNull():
            scaled = img.scaled(self.size() * self.devicePixelRatioF(), Qt.KeepAspectRatioByExpanding,
                                Qt.SmoothTransformation)
            sx = (scaled.width() - self.width() * self.devicePixelRatioF()) / 2
            sy = (scaled.height() - self.height() * self.devicePixelRatioF()) / 3
            p.drawImage(r, scaled, QRectF(sx, sy, self.width() * self.devicePixelRatioF(),
                                          self.height() * self.devicePixelRatioF()))
        else:
            g = QLinearGradient(r.topLeft(), r.bottomRight())
            g.setColorAt(0, QColor(C["surface2"]))
            g.setColorAt(1, QColor(C["accent"]).darker(300))
            p.fillRect(r, g)
        paint_hero_shade(p, r)



class HomeSkeleton(QWidget):
    """Loading screen in Home's own shape: banner, row titles and cards as soft placeholders with a
    light sweeping across them (instead of plain "Loading…")."""

    def __init__(self):
        super().__init__()
        self.phase = 0.0
        self.timer = QTimer(self, interval=16, timeout=self.step)
        self.setMinimumHeight(1000)

    def showEvent(self, e):
        super().showEvent(e)
        self.timer.start()

    def hideEvent(self, e):
        super().hideEvent(e)
        self.timer.stop()

    def step(self):
        self.phase = (self.phase + 0.012) % 1.6
        self.update()

    def shapes(self):
        """(rect, radius) of everything, laid out like Home: the banner across the top, then rows (32 px margins)."""
        w = self.width() - 64
        x, H = 32, HomeHero.H
        out = [(QRectF(0, 0, self.width(), H), 0)]
        y = H + 14
        for row in range(2):
            out.append((QRectF(x, y, 160, 10), 5))                 # row title
            y += 26
            cx = x
            while cx < x + w:   # like the real rows: the last card runs off the edge
                cut = lambda width: min(width, x + w - cx)
                out.append((QRectF(cx, y, cut(288), 162), 10))          # preview
                if cut(200) > 20:
                    out.append((QRectF(cx, y + 172, cut(200), 11), 5))  # title
                if cut(130) > 20:
                    out.append((QRectF(cx, y + 192, cut(130), 9), 4))   # episode line
                cx += 288 + 16
            y += 162 + 72
        # the banner's text, drawn as lines on the banner itself
        out += [(QRectF(40, H - 250, 120, 9), 4), (QRectF(40, H - 228, 460, 30), 8),
                (QRectF(40, H - 186, 220, 11), 5), (QRectF(40, H - 158, 400, 9), 4),
                (QRectF(40, H - 142, 340, 9), 4), (QRectF(40, H - 100, 120, 38), 10)]
        return out

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        base = QColor(C["surface"])
        shapes = self.shapes()
        # the sweep: a soft diagonal band of light moving left to right across the whole page
        span = self.width() * 1.6
        cx = -0.3 * self.width() + self.phase * span
        g = QLinearGradient(QPointF(cx - 260, 0), QPointF(cx + 260, 140))
        hi = QColor(C["hover"])
        hi.setAlpha(255)
        g.setColorAt(0.0, base)
        g.setColorAt(0.5, hi)
        g.setColorAt(1.0, base)
        for i, (r, radius) in enumerate(shapes):
            banner_text = i >= len(shapes) - 6
            p.setBrush(QColor(C["surface2"]) if i == 0 else QColor(C["border_hi"]) if banner_text else base)
            p.drawRoundedRect(r, radius, radius)
            if i == 0 or banner_text:
                continue   # the banner (and its text lines) get their own, slower glow below
            p.setBrush(g)
            p.drawRoundedRect(r, radius, radius)
        # banner: a faint glow drifting across it
        hero = shapes[0][0]
        glow = QLinearGradient(hero.topLeft(), hero.topRight())
        t = (self.phase / 1.6)
        accent = QColor(C["accent"])
        for stop, alpha in ((max(0.0, t - 0.25), 0), (t, 34), (min(1.0, t + 0.25), 0)):
            c = QColor(accent)
            c.setAlpha(alpha)
            glow.setColorAt(stop, c)
        p.setBrush(glow)
        p.drawRect(hero)

class HomePage(QWidget):
    """Home: the banner across the top (the greeting and status pills on it), Continue watching (Crunchyroll-style:
    a show jumps to the front when its next episode arrives), Fresh in your library (tabs), and Recommended."""
    open_show = Signal(str, object)
    open_media = Signal(int, str, object)
    want_settings = Signal()
    open_downloads = Signal()

    def pad_start(self):
        """Controller: start on the banner's Play."""
        b = self.hero.play_btn
        return (b, b.rect()) if b.isVisible() else None
    go_page = Signal(int)

    def __init__(self, settings, account, library):
        super().__init__()
        self.settings, self.account, self.library = settings, account, library
        self.downloads = None
        self.details, self.images, self.slots = {}, {}, {}
        self.loader, self.loaded_at, self.dirty = None, 0, True
        self.mtimes = {}   # file → modified time (≈ when it was downloaded), until the library changes
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.scroll.verticalScrollBar().setSingleStep(24)
        lay.addWidget(self.scroll)
        self.hero = HomeHero()
        self.hero.settings = settings
        self.hero.play.connect(lambda it: play_video(it["path"]) if it.get("path") else self.open_item(it))
        self.hero.open.connect(self.open_item)
        self.hero.watched.connect(lambda it: self.account.set_progress(it["mid"], it["ep"]))
        self.notes_unseen = 0
        self.thumbs = ThumbWorker()
        self.thumbs.image.connect(self.on_image)
        self.thumbs.start()
        self.rebuild_timer = QTimer(self, singleShot=True, interval=300, timeout=self.rebuild)
        library.updated.connect(lambda *_: self.mtimes.clear())
        library.updated.connect(self.mark_dirty)
        if account:
            account.changed.connect(self.mark_dirty)
            account.entry_changed.connect(lambda *_: self.mark_dirty())

    def set_downloads(self, downloads):
        self.downloads = downloads
        downloads.changed.connect(self.on_downloads_changed)

    def mark_dirty(self):
        self.dirty = True
        if self.isVisible():
            self.rebuild_timer.start()

    def showEvent(self, e):
        super().showEvent(e)
        if self.dirty:
            self.rebuild_timer.start(0)

    def switch_side(self):
        """Anime / 18+: the placeholder at once, then the other side's Home built once and faded in."""
        self.shown_sig = None
        self.dirty = True
        self.hero.stop_trailer()
        old = self.scroll.takeWidget()
        if old is not None and not isinstance(old, HomeSkeleton):
            if old.isAncestorOf(self.hero):
                self.hero.setParent(None)
        if old is not None:
            old.deleteLater()
        self.scroll.setWidget(HomeSkeleton())
        if self.isVisible():
            self.rebuild_timer.start(120)   # after the switch has painted

    def hideEvent(self, e):
        super().hideEvent(e)
        self.hero.stop_trailer()

    def shutdown(self):
        self.hero.shutdown()
        self.thumbs.requestInterruption()
        self.thumbs.wake.set()
        self.thumbs.wait(25000)
        if self.loader is not None:
            self.loader.wait(5000)

    # ---- what to show
    def tracking(self):
        return bool(self.account and self.account.connected)

    def media(self, mid):
        return media_for(mid, self.account) or self.details.get(mid) or {}

    def collect(self):
        """Everything Home shows, from what's on disk and saved (no requests)."""
        lib, a, tracking = self.library, self.account, self.tracking()
        saved = details_by_id()
        self.details = {**saved, **self.details}
        hidden = self.settings.get("home_hidden") or {}
        files, local_by_mid = {}, {}
        for path, it in lib.items.items():
            idx = it.data(INDEX_ROLE)
            if not idx:
                continue
            for n, sid in enumerate(idx["seasons"], 1):
                if not sid:
                    continue
                eps = idx["local"].get(sid) or {}
                local_by_mid.setdefault(sid, (path, eps))
                for ep, f in eps.items():
                    files[os.path.normcase(f)] = {"path": f, "show": path, "name": it.text(), "mid": sid,
                                                  "ep": ep, "season": n}

        # Continue watching: half-watched episodes (where you stopped), then what's next
        per_show = {}
        for f, r in _read_json(PLAYBACK_STATE_FILE).items():
            info = files.get(os.path.normcase(f))
            if not info or not r.get("dur") or r.get("pos", 0) < 30:
                continue
            item = {**info, "kind": "resume", "pos": r["pos"], "dur": r["dur"], "t": r.get("t", 0)}
            if item["t"] > per_show.get(info["show"], {}).get("t", -1):
                per_show[info["show"]] = item
        if tracking:
            for path, it in lib.items.items():
                _, _, _, nxt = show_state(it.data(INDEX_ROLE), a)
                if not nxt:
                    continue
                info = files.get(os.path.normcase(nxt["path"]))
                if not info:
                    continue
                item = {**info, "kind": "next", "t": nxt["updated"] or 0}
                cur = per_show.get(path)
                if cur is None or (cur["kind"] == "next" and item["t"] > cur["t"]):
                    per_show[path] = item
        # Crunchyroll-style: episodes that arrived after you last watched move the show to the front. If it's the
        # episode you'd play next, the card says New ("2 New" if more came)
        for c in per_show.values():
            eps = (local_by_mid.get(c["mid"]) or (None, {}))[1]
            first = c["ep"] if c["kind"] == "next" else c["ep"] + 1
            arrived = [self.mtime(f) for ep, f in eps.items() if ep >= first and self.mtime(f) > c["t"]]
            if c["kind"] == "next" and self.mtime(c["path"]) > c["t"]:
                c["kind"], c["arrived"] = "new", max(arrived)   # the latest one: why it's at the front
            c["fresh"], c["sort"] = len(arrived), max([c["t"]] + arrived)
        cont = [c for c in per_show.values() if hidden.get(c["path"], -1) < c["sort"]]
        cont.sort(key=lambda c: -c["sort"])
        cont = cont[:20]

        # New episodes: downloaded, unwatched, for the shows you're watching (last 30 days)
        new = []
        cutoff = time.time() - 30 * 86400
        if tracking:
            for mid, e in a.view().items():
                if e.get("status") not in ("CURRENT", "REPEATING") or mid not in local_by_mid:
                    continue
                show, eps = local_by_mid[mid]
                p = e.get("progress") or 0
                for ep, f in eps.items():
                    if ep <= p:
                        continue
                    mtime = self.mtime(f)
                    if mtime >= cutoff:
                        info = files.get(os.path.normcase(f)) or {}
                        new.append({**info, "kind": "new", "t": mtime})
            new.sort(key=lambda n: -n["t"])

        # Airing soon: the next episode of shows you're watching, this week
        airing = []
        if tracking:
            now = time.time()
            for mid, e in a.view().items():
                m = e.get("media") or {}
                nxt = m.get("nextAiringEpisode") or {}
                if e.get("status") in ("CURRENT", "REPEATING") and nxt.get("airingAt") and 0 < nxt["airingAt"] - now < 7 * 86400:
                    airing.append((nxt["airingAt"], mid, m, nxt["episode"]))
            airing.sort()

        # Start something you have: on your Planning list and already downloaded
        planned = []
        if tracking:
            for mid, e in a.view().items():
                if e.get("status") == "PLANNING" and mid in local_by_mid and local_by_mid[mid][1]:
                    show, eps = local_by_mid[mid]
                    planned.append((e.get("updatedAt") or 0, mid, e.get("media") or {}, eps[min(eps)], len(eps)))
            planned.sort(key=lambda x: -x[0])

        # Popular this season, not on your list
        season, year = current_season()
        sdata = (_read_json(SEASON_FILE).get(f"{season}-{year}" + ("-adult" if acct.ADULT["on"] else ""))
                 or {}).get("media") or []
        popular = [m for m in sorted(sdata, key=lambda m: -(m.get("popularity") or 0))
                   if not (tracking and a.entry(m["id"])) and not lib.path_for_media(m["id"])][:15]
        # Spotlight: fills the banner when there's little to continue (a new library, the 18+ side): shows you
        # have but haven't started (newest first), then this season's popular ones
        spot = []
        if len(cont) < 5:
            for path, it in lib.items.items():
                idx = it.data(INDEX_ROLE)
                if not idx or path in per_show:
                    continue
                sid = next((s for s in idx["seasons"] if s and (idx["local"].get(s) or {})), None)
                e = a.entry(sid) if (tracking and sid) else None
                if not sid or (e and e.get("status") not in ("PLANNING",)):
                    continue
                eps = idx["local"][sid]
                first = eps[min(eps)]
                t = self.mtime(first)
                if not t:
                    continue
                spot.append({**(files.get(os.path.normcase(first)) or {"path": first, "show": path, "name": it.text(),
                                                                       "mid": sid, "ep": min(eps), "season": 1}),
                             "kind": "start", "t": t})
            spot.sort(key=lambda c: -c["t"])
            spot += [{"path": None, "show": None, "name": media_title(m), "mid": m["id"], "ep": None, "season": None,
                      "kind": "discover", "media": m, "t": 0} for m in popular[:5]]
            spot = spot[:5 - len(cont)]
        return {"continue": cont, "new": new, "airing": airing[:15], "planned": planned[:15],
                "popular": popular, "seeds": self.seeds(), "spotlight": spot,
                "fresh": self.fresh(lib, new, cutoff, hidden)}

    def mtime(self, path):
        t = self.mtimes.get(path)
        if t is None:
            try:
                t = os.path.getmtime(path)
            except OSError:
                t = 0
            self.mtimes[path] = t
        return t

    def fresh(self, lib, new, cutoff, hidden):
        """Fresh in your library: shows and seasons that arrived since `cutoff` (a new show, a new season, or
        Complete: a finished one, every episode), then new episodes of shows you watch, one item per show
        (a show or season that's new itself already covers its episodes). Newest first."""
        tracking = self.tracking()
        out, covered = [], set()

        def complete(sid, eps):
            m = self.media(sid)
            return m.get("status") == "FINISHED" and bool(m.get("episodes")) and len(eps) >= m["episodes"]

        for path, it in lib.items.items():
            idx = it.data(INDEX_ROLE)
            if not idx:
                continue
            seasons = [(n, sid, idx["local"][sid]) for n, sid in enumerate(idx["seasons"], 1) if sid and idx["local"].get(sid)]
            if not seasons:
                continue
            times = {sid: [self.mtime(f) for f in eps.values()] for _, sid, eps in seasons}
            base = {"show": path, "name": it.text()}
            if min(min(ts) for ts in times.values()) >= cutoff:   # the whole folder arrived lately
                n0, sid0, eps0 = seasons[0]
                out.append({**base, "kind": "complete" if all(complete(sid, eps) for _, sid, eps in seasons) else "show",
                            "mid": sid0, "season": n0, "ep": min(eps0), "path": eps0[min(eps0)],
                            "t": max(max(ts) for ts in times.values()), "count": sum(len(eps) for _, _, eps in seasons),
                            "seasons": [n for n, _, _ in seasons]})
                covered |= set(times)
                continue
            for n, sid, eps in seasons:
                if min(times[sid]) < cutoff:
                    continue
                e = self.account.entry(sid) if tracking else None
                nxt = ((e or {}).get("progress") or 0) + 1
                ep = nxt if nxt in eps else min(eps)
                out.append({**base, "kind": "complete" if complete(sid, eps) else "season", "mid": sid, "season": n,
                            "ep": ep, "path": eps[ep], "t": max(times[sid]), "count": len(eps), "seasons": [n]})
                covered.add(sid)
        groups = {}
        for c in new:
            if c.get("mid") and c["mid"] not in covered:
                groups.setdefault(c["mid"], []).append(c)
        for cs in groups.values():
            cs.sort(key=lambda c: c["ep"])
            out.append({**cs[0], "kind": "ep", "t": max(c["t"] for c in cs), "count": len(cs), "last": cs[-1]["ep"]})
        out = [f for f in out if hidden.get(f["path"], -1) < f["t"]]
        out.sort(key=lambda f: -f["t"])
        return out[:40]

    def seeds(self):
        """The shows your recommendations come from: what you're watching, what you rated highly."""
        a = self.account
        if not self.tracking():
            return [(idx["mid"], 1.0) for idx in self.library.indexes().values() if idx][:40]
        scores = sorted(e.get("score") or 0 for e in a.view().values() if (e.get("score") or 0) > 0)
        good = scores[int(len(scores) * 0.7)] if scores else 0
        out = []
        for mid, e in a.view().items():
            st, sc = e.get("status"), e.get("score") or 0
            if st in ("CURRENT", "REPEATING"):
                out.append((e.get("updatedAt") or 0, mid, 1.0))
            elif st == "COMPLETED" and good and sc >= good:
                out.append((e.get("updatedAt") or 0, mid, 1.5))
        out.sort(key=lambda x: -x[0])
        return [(mid, w) for _, mid, w in out[:40]]

    def last_completed(self):
        if not self.tracking():
            return None
        done = [(e.get("updatedAt") or 0, mid) for mid, e in self.account.view().items() if e.get("status") == "COMPLETED"]
        return max(done)[1] if done else None

    def recommendations(self, seeds, exclude):
        """AniList users' recommendations from all your seed shows added up: titles several of your
        shows point to come first. [(media, score, [seed titles])]"""
        recs = {}
        for mid, w in seeds:
            for node in (((self.details.get(mid) or {}).get("recommendations") or {}).get("nodes") or []):
                m = node.get("mediaRecommendation")
                if not m or m["id"] in exclude:
                    continue
                r = recs.setdefault(m["id"], {"media": m, "score": 0.0, "from": []})
                r["score"] += w * max(1, node.get("rating") or 0) ** 0.5
                r["from"].append((w * max(1, node.get("rating") or 0), mid))
        out = sorted(recs.values(), key=lambda r: -r["score"])
        for r in out:
            r["from"] = [media_title(self.media(mid)) for _, mid in sorted(r["from"], reverse=True)[:2]
                         if self.media(mid).get("title")]
        return out

    # ---- building the page
    def custom_banner_for(self, path):
        """Your own banner for the show this episode belongs to (Tools → Captures)."""
        target = os.path.normcase(os.path.abspath(path or ""))
        for folder in getattr(self.library, "items", {}) or {}:
            if target.startswith(os.path.normcase(os.path.abspath(folder)) + os.sep):
                return custom_art(folder, "banner")
        return None

    def signature(self, model):
        """What Home would show: if this didn't change, it isn't rebuilt (images fill in by themselves)."""
        def still(c):
            return bool(c["kind"] != "resume" and episode_still(self.details, c["mid"], c["ep"])[0])
        seeds = model["seeds"]
        exclude = {mid for mid, _ in seeds} | (set(self.account.entries) if self.tracking() else set())
        exclude |= {i for idx in self.library.indexes().values() if idx for i in idx["chain"]}
        last = self.last_completed()
        return (
            tuple((c["path"], c["kind"], int(c.get("pos", 0) // 60), still(c), c.get("fresh"),
                   bool((self.details.get(c["mid"]) or {}).get("bannerImage")), self.custom_banner_for(c["path"]))
                  for c in model["continue"]),
            len(model["new"]),
            tuple((f["kind"], f["path"], f["count"], f["t"], still({**f, "kind": "start"})) for f in model["fresh"]),
            tuple((c["mid"], c["kind"], bool((self.details.get(c["mid"]) or {}).get("bannerImage")))
                  for c in model.get("spotlight", [])),
            tuple((mid, ep) for _, mid, _, ep in model["airing"]),
            tuple(r["media"]["id"] for r in self.recommendations(seeds, exclude)[:20]),
            (last, tuple(r["media"]["id"] for r in self.recommendations([(last, 1.0)], exclude)[:15]) if last else ()),
            tuple(mid for _, mid, _, _, _ in model["planned"]),
            tuple(m["id"] for m in model["popular"]),
            tuple(sorted((self.settings.get("home_hidden") or {}).items())),
        )

    def rebuild(self):
        if self.settings.get("library") and not self.library.scanned:
            self.dirty = True   # the library is still being read: wait, rather than show half a Home
            if self.scroll.widget() is None:
                self.scroll.setWidget(HomeSkeleton())
            return
        self.dirty = False
        model = self.collect()
        self.refresh_details(model)   # missing banners/stills/recommendations (at most every 10 min)
        first = getattr(self, "shown_sig", None) is None
        if first and self.loader is not None and not getattr(self, "waited", False):
            # The first time, wait for those (at most 3 s) so Home appears once, complete
            self.dirty, self.waited = True, True
            QTimer.singleShot(3000, self.mark_dirty)
            if self.scroll.widget() is None:
                self.scroll.setWidget(HomeSkeleton())
            return
        sig = self.signature(model)
        if sig == getattr(self, "shown_sig", None):
            return   # nothing you'd see changed
        self.shown_sig = sig
        self.slots = {}
        jobs = []
        content = QWidget()
        col = QVBoxLayout(content)
        col.setContentsMargins(0, 0, 0, 40)
        col.setSpacing(0)
        a = self.account

        # the banner across the top: the front of Continue watching (then spotlight), greeting and pills on it
        hero_items = []
        for c in model["continue"][:5] + model.get("spotlight", []):
            m = c.get("media") or self.media(c["mid"])
            hero_items.append(self.hero_item(c, m, jobs))
        body = QVBoxLayout()
        body.setContentsMargins(32, 6, 32, 0)
        body.setSpacing(38)
        if hero_items:
            col.addWidget(self.hero)   # first: a widget shown while it has no parent is its own window
            self.hero.set_header(self.header(model))
            self.hero.set_items(hero_items)
        else:
            body.setContentsMargins(32, 22, 32, 0)
            body.setSpacing(22)
            body.addWidget(self.header(model))
            body.addWidget(self.empty_card())
        col.addLayout(body)

        # Continue watching: what you're in the middle of and what's next, newly arrived episodes first
        if model["continue"]:
            body.addWidget(HomeRow("Continue watching", [self.episode_card(c, jobs) for c in model["continue"]], self.scroll))

        # Fresh in your library: tabs for new episodes / shows / seasons / complete
        self.fresh_section = None
        if model["fresh"]:
            self.fresh_section = FreshSection([self.fresh_card(f, jobs) for f in model["fresh"]], self.settings)
            body.addWidget(self.fresh_section)

        # Recommended, with chips: for you / because you watched… / popular / start something you have
        seeds = model["seeds"]
        exclude = {mid for mid, _ in seeds}
        if self.tracking():
            exclude |= set(a.entries)
        exclude |= {i for idx in self.library.indexes().values() if idx for i in idx["chain"]}
        sets = []
        recs = self.recommendations(seeds, exclude)
        if recs:
            cards = []
            for r in recs[:20]:
                why = f"Because you watched {' and '.join(r['from'])}" if r["from"] else None
                cards.append(self.poster(r["media"], jobs=jobs, tip=why, note=f"Like {r['from'][0]}" if r["from"] else None))
            sets.append(("For you", cards))
        last = self.last_completed()
        if last:
            own = self.recommendations([(last, 1.0)], exclude)
            if own:
                sets.append((f"Because you watched {media_title(self.media(last))}",
                             [self.poster(r["media"], jobs=jobs) for r in own[:15]]))
        if model["popular"]:
            season, year = current_season()
            sets.append((f"Popular in {season.title()}", [self.poster(m, jobs=jobs) for m in model["popular"]]))
        if model["planned"]:
            cards = []
            for _, mid, m, first, n in model["planned"]:
                c = self.poster(m, note=f"Start · {n} episode{'s' if n != 1 else ''} here", jobs=jobs,
                                badge=("Planning", STATUS_COLORS["PLANNING"]))
                c.clicked.disconnect()
                c.clicked.connect(lambda f=first: play_video(f))
                cards.append(c)
            sets.append(("Start something you have", cards))
        if sets:
            body.addWidget(ChipRows("Recommended", sets, self.scroll, self.settings, "home_rec_chip"))
        col.addStretch(1)
        pos = self.scroll.verticalScrollBar().value()
        old = self.scroll.takeWidget()
        self.scroll.setWidget(content)
        if isinstance(old, HomeSkeleton):   # first appearance: fade in
            fx = QGraphicsOpacityEffect(content)
            content.setGraphicsEffect(fx)
            self.fade = QPropertyAnimation(fx, b"opacity", self)
            self.fade.setDuration(420)
            self.fade.setStartValue(0.0)
            self.fade.setEndValue(1.0)
            self.fade.setEasingCurve(QEasingCurve.OutCubic)
            self.fade.finished.connect(lambda c=content: c.setGraphicsEffect(None))
            self.fade.start()
        if old is not None:
            if old.isAncestorOf(self.hero):   # reused by the next build
                self.hero.setParent(None)
            old.deleteLater()
        self.scroll.verticalScrollBar().setValue(pos)
        self.thumbs.queue(jobs)

    def refresh_details(self, model):
        """Fetch what isn't saved yet (banners, stills, recommendations), then build again (every 10 min)."""
        if self.loader is not None or time.time() - self.loaded_at < 600:
            return
        ids = [c["mid"] for c in model["continue"]] + [c["mid"] for c in model["new"]] + [f["mid"] for f in model["fresh"]]
        ids += [c["mid"] for c in model.get("spotlight") or [] if c["mid"] not in self.details]
        ids += [mid for mid, _ in model["seeds"]]
        last = self.last_completed()
        if last:
            ids.append(last)
        ids = list(dict.fromkeys(i for i in ids if i))
        if not ids:
            return
        self.loader = HomeLoader(ids)
        self.loader.done.connect(self.on_details)
        self.loader.start()

    def on_details(self, details):
        self.loader.wait()
        self.loader = None
        self.loaded_at = time.time()
        if details:
            self.details.update(details)
            self.mark_dirty()

    # ---- greeting, notifications, panels
    def header(self, model):
        """On the banner: the greeting, and pills for downloads (kept up to date by update_pills), the next
        episode to air and how many new episodes are waiting (click: Fresh's New episodes tab)."""
        w = QWidget()
        w.setStyleSheet("background: transparent;")
        row = QHBoxLayout(w)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(8)
        name = (self.account.user or {}).get("name") if self.tracking() else ""
        t = QLabel(greeting(name))
        t.setStyleSheet("color: white; font-family: 'Segoe UI Variable Display'; font-size: 12.5pt; font-weight: 600;")
        row.addWidget(t)
        row.addStretch(1)
        self.dl_pill = HomePill("downloading", C["ok"])
        self.dl_pill.clicked.connect(self.open_downloads.emit)
        row.addWidget(self.dl_pill)
        if model["airing"]:
            at, mid, m, ep = model["airing"][0]
            air = HomePill("schedule", "#8fd3ff")
            name = QFontMetrics(air.font()).elidedText(media_title(m), Qt.ElideRight, 220)
            air.setText(f"{name} · Ep {ep} in {countdown(at)}")
            air.setToolTip(f"{media_title(m)} episode {ep}\nAirs {when(at)}")
            air.clicked.connect(lambda: self.go_page.emit(5))
            row.addWidget(air)
        fresh = model["fresh"]
        if fresh:
            new = HomePill("new_releases", C["accent_hi"], f"{len(fresh)} new in your library")
            kinds = [(sum(1 for f in fresh if f["kind"] == k), FRESH_KINDS[k][1]) for k in FRESH_KINDS]
            new.setToolTip("\n".join(f"{n} × {name}" for n, name in kinds if n) + "\nClick to see them")
            new.clicked.connect(self.show_fresh)
            row.addWidget(new)
        self.update_pills()
        return w

    def show_fresh(self):
        """The "new in your library" pill: Fresh in your library (All), scrolled into view."""
        f = getattr(self, "fresh_section", None)
        if f is None:
            return
        try:
            f.choose("all")
            y = f.mapTo(self.scroll.widget(), QPoint(0, 0)).y()
        except RuntimeError:
            return
        self.scroll.verticalScrollBar().setValue(max(0, y - 16))

    def download_title(self, t):
        mid = t.get("mid")
        m = self.media(mid) if mid else {}
        title = media_title(m) if m.get("title") else (tor.parse_release(t.get("name", ""))["name"] or t.get("name", ""))
        return title

    def empty_card(self):
        box = card()
        v = QVBoxLayout(box)
        v.setContentsMargins(28, 26, 28, 26)
        v.setSpacing(6)
        v.addWidget(label("Welcome to Kura", "h1"))
        v.addWidget(label("Play an episode from your Library and it shows up here, ready to continue. With your "
                          "AniList account connected, Home also shows your next episodes, new downloads, what airs "
                          "this week and recommendations.", "muted", wrap=True))
        return box

    # ---- cards
    def episode_line(self, c):
        line = f"Season {c['season']} · Episode {c['ep']}"
        if c["kind"] == "resume":
            left = max(0, c["dur"] - c["pos"])
            line += f" · {int(left // 60) or 1} min left"
            if c.get("fresh"):
                line += f" · {c['fresh']} new"
        elif c["kind"] == "new" and c.get("arrived"):
            line += f" · arrived {short_ago(c['arrived']).lower()}"
        elif c["kind"] == "next":
            line += " · up next" + (f" · {c['fresh']} new" if c.get("fresh") else "")
        return line

    def thumb_for(self, c, jobs):
        """Where you stopped: a frame from there. Otherwise AniList's still, else an early frame."""
        if c["kind"] == "resume":
            start = int(c["pos"] // 20 * 20)
            key = f"frame:{c['path']}:{start}"
            jobs.append((key, "frame", (c["path"], start)))
            return key, None
        url, ep_title = episode_still(self.details, c["mid"], c["ep"])
        if url:
            key = f"still:{url}"
            jobs.append((key, "url", (url, still_stem(url))))
            return key, ep_title
        key = f"frame:{c['path']}:15%"
        jobs.append((key, "frame", (c["path"], "15%")))
        return key, None

    def episode_card(self, c, jobs):
        m = self.media(c["mid"])
        title = media_title(m) if m.get("title") else c["name"]
        key, ep_title = self.thumb_for(c, jobs)
        line = self.episode_line(c)
        ribbon = (f"{c['fresh']} NEW" if c.get("fresh", 0) > 1 else "NEW") if c["kind"] == "new" else None
        progress = c["pos"] / c["dur"] if c["kind"] == "resume" and c.get("dur") else None
        tip = f"{title}\n{line}" + (f"\n{ep_title}" if ep_title else "") + f"\n{Path(c['path']).name}"
        card_ = EpisodeCard(title, line + (f" · {ep_title}" if ep_title else ""), None, progress, tip, ribbon)
        self.slot(key, card_)
        card_.clicked.connect(lambda p=c["path"]: play_video(p))
        card_.setContextMenuPolicy(Qt.CustomContextMenu)
        card_.customContextMenuRequested.connect(lambda pos, c=c, w=card_: self.episode_menu(c, w.mapToGlobal(pos)))
        return card_

    def hero_item(self, c, m, jobs):
        if c["kind"] == "discover":
            return self.discover_item(c, m, jobs)
        title = media_title(m) if m.get("title") else c["name"]
        key, ep_title = self.thumb_for(c, jobs)
        d = self.details.get(c["mid"]) or {}
        own = self.custom_banner_for(c["path"])
        banner = own or d.get("bannerImage")
        banner_key = None
        if banner:
            banner_key = f"banner:{c['mid']}" + (":own" if own else "")
            jobs.insert(0, (banner_key, "url", (banner, f"banner_{c['mid']}")))
        # no wide art: the poster cover (the episode's own frame is already on its Continue watching card)
        cover = ((d.get("coverImage") or {}).get("extraLarge") or (m.get("coverImage") or {}).get("extraLarge"))
        poster_key = None
        if cover and not banner:
            poster_key = f"cover:{c['mid']}"
            jobs.insert(0, (poster_key, "url", (cover, str(c["mid"]))))
        bits = [html.escape(self.episode_line(c))]
        if ep_title:
            bits.append(html.escape(ep_title))
        if d.get("averageScore"):
            bits.append(icon_html("star", 14, C["warn"]) + f"&nbsp;{d['averageScore']}%")
        if d.get("genres"):
            bits.append(html.escape(", ".join(d["genres"][:2])))
        info = "&nbsp; · &nbsp;".join(bits)
        return {**c, "title": title, "info": info, "can_mark": bool(self.tracking() and self.account.entry(c["mid"])),
                "desc": clean_description(d.get("description") or ""),
                "trailer": d.get("trailer") if (d.get("trailer") or {}).get("site") in ("youtube", "dailymotion") else None,
                "banner_key": banner_key, "poster_key": poster_key, "thumb_key": key,
                "verb": "Resume" if c["kind"] == "resume" else f"Play episode {c['ep']}",
                "progress": c["pos"] / c["dur"] if c["kind"] == "resume" and c.get("dur") else None}

    def discover_item(self, c, m, jobs):
        """A banner item for a show you don't have yet (Popular this season): its art, trailer and Show button."""
        d = {**m, **(self.details.get(c["mid"]) or {})}
        banner = d.get("bannerImage")
        banner_key = None
        if banner:
            banner_key = f"banner:{c['mid']}"
            jobs.insert(0, (banner_key, "url", (banner, f"banner_{c['mid']}")))
        cover = (d.get("coverImage") or {}).get("extraLarge")
        thumb_key = None
        if cover:
            thumb_key = f"cover:{c['mid']}"
            jobs.append((thumb_key, "url", (cover, str(c["mid"]))))
        bits = [html.escape(" · ".join(str(x) for x in (FORMAT_TEXT.get(d.get("format"), d.get("format")),
                                                         d.get("seasonYear")) if x))]
        if d.get("averageScore"):
            bits.append(icon_html("star", 14, C["warn"]) + f"&nbsp;{d['averageScore']}%")
        if d.get("genres"):
            bits.append(html.escape(", ".join(d["genres"][:2])))
        return {**c, "title": media_title(d) or c["name"], "info": "&nbsp; · &nbsp;".join(b for b in bits if b),
                "can_mark": False, "desc": clean_description(d.get("description") or ""),
                "trailer": d.get("trailer") if (d.get("trailer") or {}).get("site") in ("youtube", "dailymotion") else None,
                "banner_key": banner_key, "poster_key": None if banner_key else thumb_key, "thumb_key": thumb_key,
                "verb": "Show", "progress": None}

    def poster(self, m, note=None, jobs=None, tip=None, badge=None):
        if badge is None:
            e = self.account.entry(m["id"]) if self.tracking() else None
            if e:
                badge = (acct.STATUS_NAMES.get(e["status"], e["status"]), STATUS_COLORS.get(e["status"], C["muted"]))
            elif self.library.path_for_media(m["id"]):
                badge = ("In library", C["ok"])
        c = BigRecCard(m, 0, badge, note=note, tip=tip)
        url = (m.get("coverImage") or {}).get("extraLarge")
        if url and jobs is not None:
            key = f"cover:{m['id']}"
            jobs.append((key, "url", (url, str(m["id"]))))
            self.slot(key, c)
        c.clicked.connect(lambda m=m, c=c: self.open_media.emit(m["id"], media_title(m), c.img.img))
        c.setContextMenuPolicy(Qt.CustomContextMenu)
        c.customContextMenuRequested.connect(lambda pos, m=m, c=c: self.poster_menu(m, c.mapToGlobal(pos)))
        return c

    def fresh_card(self, f, jobs):
        """A Fresh in your library card: episodes and seasons play (the first new one), shows open their page."""
        m = self.media(f["mid"])
        title = media_title(m) if m.get("title") else f["name"]
        kind, n, seasons = f["kind"], f["count"], f.get("seasons") or [f["season"]]
        glyph, text, color = FRESH_KINDS[kind]
        if kind == "show" and m.get("format") == "MOVIE":
            text = "New movie"
        eps = f"{n} episode{'s' if n != 1 else ''}"
        if kind == "ep":
            line = f"Season {f['season']} · " + (f"Episode {f['ep']}" if n == 1 else f"Episodes {f['ep']}–{f['last']}")
            action = f"Play episode {f['ep']}"
        elif kind == "season":
            line, action = f"Season {f['season']} · {eps}", f"Play S{f['season']} E{f['ep']}"
        else:
            line = (f"Seasons {seasons[0]}–{seasons[-1]} · " if len(seasons) > 1 else "") + eps
            if self.tracking():
                e = self.account.entry(f["mid"])
                line += f" · {acct.STATUS_NAMES.get(e['status'], e['status'])}" if e else " · not on your list"
            action = "Show page"
        key, _ = self.thumb_for({**f, "kind": "start"}, jobs)
        tip = f"{title}\n{line}\n{text} · {short_ago(f['t'])}"
        card_ = FreshCard(kind, (glyph, text, color), title, line, short_ago(f["t"]), action, tip)
        card_.t = f["t"]   # when it arrived: FreshSection's range menu (Today / This week / Last 30 days)
        self.slot(key, card_)
        if kind in ("show", "complete"):
            card_.clicked.connect(lambda f=f: self.open_item(f))
        else:
            card_.clicked.connect(lambda p=f["path"]: play_video(p))
        card_.setContextMenuPolicy(Qt.CustomContextMenu)
        card_.customContextMenuRequested.connect(lambda pos, f=f, w=card_: self.episode_menu(f, w.mapToGlobal(pos)))
        return card_

    def slot(self, key, widget):
        self.slots.setdefault(key, []).append(widget)
        if key in self.images:
            widget.set_image(self.images[key])

    def on_image(self, key, img):
        self.images[key] = img
        for w in self.slots.get(key, []):
            try:
                w.set_image(img)
            except RuntimeError:
                pass
        self.hero.set_image(key, img)

    # ---- downloads (qBittorrent Web UI)
    def downloading(self):
        d = self.downloads
        if not d or not d.enabled:
            return []
        return [t for t in d.torrents.values() if not tor.is_done(t)]

    @staticmethod
    def download_note(t):
        ep = t.get("episode") or (episode_ranges(t["episodes"]) if t.get("episodes") else "")
        return f"{f'Ep {ep} · ' if ep else ''}{int(float(t.get('progress', 0)) * 100)}%"

    def update_pills(self):
        """The downloads pill on the banner (it changes as downloads go, without rebuilding Home)."""
        try:
            pill = self.dl_pill
            dl = self.downloading()
            pill.setVisible(bool(dl))
            if not dl:
                return
            pct = int(float(dl[0].get("progress", 0)) * 100)
            if len(dl) == 1:
                name = QFontMetrics(pill.font()).elidedText(self.download_title(dl[0]), Qt.ElideRight, 230)
                pill.setText(f"{name} · {pct}%")
            else:
                pill.setText(f"{len(dl)} downloading · {pct}%")
            more = f"\n+ {len(dl) - 8} more" if len(dl) > 8 else ""
            pill.setToolTip("\n".join(f"{self.download_title(t)} · {self.download_note(t)}" for t in dl[:8]) + more)
        except (RuntimeError, AttributeError):   # not built yet, or rebuilt since
            pass

    def on_downloads_changed(self):
        self.update_pills()

    # ---- menus
    def open_item(self, c):
        mid = c.get("mid")
        if c.get("show"):
            self.open_show.emit(c["show"], None)
        elif mid:
            self.open_media.emit(mid, "", None)

    def episode_menu(self, c, pos):
        menu = QMenu(self)
        menu.addAction(glyph_icon(G["play"], C["text"]), "Play", lambda: play_video(c["path"]))
        if self.tracking() and self.account.entry(c["mid"]):
            menu.addAction(glyph_icon(G["add"], C["text"]), f"Mark episode {c['ep']} as watched",
                           lambda: self.account.set_progress(c["mid"], c["ep"]))
        menu.addAction(glyph_icon(G["minus"], C["text"]), "Remove from this row", lambda: self.hide_item(c))
        menu.addSeparator()
        menu.addAction(glyph_icon(G["library"], C["text"]), "Open show", lambda: self.open_item(c))
        menu.exec(pos)

    def hide_item(self, c):
        """Hidden until something new happens with it (you play it again, or a newer episode)."""
        hidden = dict(self.settings.get("home_hidden") or {})
        hidden[c["path"]] = max(c.get("t", 0), time.time())
        if len(hidden) > 300:
            hidden = dict(sorted(hidden.items(), key=lambda kv: -kv[1])[:300])
        self.settings["home_hidden"] = hidden
        save_settings(self.settings)
        self.mark_dirty()

    def poster_menu(self, m, pos):
        menu = QMenu(self)
        title = media_title(m)
        menu.addAction(glyph_icon(G["library"], C["text"]), "Open", lambda: self.open_media.emit(m["id"], title, None))
        if self.tracking() and not self.account.entry(m["id"]):
            menu.addAction(glyph_icon(G["add"], C["text"]), "Add to Planning",
                           lambda: self.account.set_status(m["id"], "PLANNING", m))
        if m.get("siteUrl"):
            menu.addAction(glyph_icon(G["globe"], C["text"]), "Open on AniList", lambda: webbrowser.open(m["siteUrl"]))
        menu.exec(pos)


def when_short(ts):
    """'today 18:30' / 'tomorrow 09:00' / 'Sat 14:00'."""
    dt = datetime.fromtimestamp(ts)
    days = (dt.date() - datetime.now().date()).days
    day = "today" if days == 0 else "tomorrow" if days == 1 else dt.strftime("%a")
    return f"{day} {dt.strftime('%H:%M')}"

# ---------------------------------------------------------------- statistics

def _num(n):
    return f"{int(round(n or 0)):,}"


def _ago(t):
    if not t:
        return "never"
    s = time.time() - t
    if s < 90:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)} min ago"
    if s < 86400:
        return f"{int(s // 3600)} h ago"
    return f"{int(s // 86400)} days ago"


class StatTile(QWidget):
    """A number with an icon and a soft coloured glow (top of the Statistics page)."""

    def __init__(self, glyph, color):
        super().__init__()
        self.glyph, self.color = glyph, QColor(color)
        self.value, self.unit, self.caption = "–", "", ""
        self.setFixedHeight(118)
        self.setMinimumWidth(128)

    def set(self, value, unit, caption):
        self.value, self.unit, self.caption = value, unit, caption
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        path = QPainterPath()
        path.addRoundedRect(r, 16, 16)
        p.fillPath(path, QColor(C["surface"]))
        p.save()
        p.setClipPath(path)
        g = QRadialGradient(QPointF(r.right() - 16, r.top() + 12), 120)
        c = QColor(self.color)
        c.setAlpha(64)
        g.setColorAt(0, c)
        c.setAlpha(0)
        g.setColorAt(1, c)
        p.fillRect(r, g)
        p.restore()
        p.setPen(QPen(QColor(C["border"]), 1))
        p.drawPath(path)
        chip = QRectF(18, 16, 34, 34)
        c = QColor(self.color)
        c.setAlpha(42)
        p.setPen(Qt.NoPen)
        p.setBrush(c)
        p.drawRoundedRect(chip, 10, 10)
        p.drawPixmap(QPointF(chip.x() + 8, chip.y() + 8), glyph_pixmap(self.glyph, self.color.name(), 18))
        f = QFont(self.font())
        f.setPixelSize(27)
        f.setWeight(QFont.Bold)
        p.setFont(f)
        p.setPen(QColor(C["text"]))
        fm = QFontMetrics(f)
        base = 88
        p.drawText(QPointF(18, base), self.value)
        if self.unit:
            u = QFont(self.font())
            u.setPixelSize(13)
            p.setFont(u)
            p.setPen(QColor(C["muted"]))
            p.drawText(QPointF(18 + fm.horizontalAdvance(self.value) + 4, base), self.unit)
        cf = QFont(self.font())
        cf.setPixelSize(12)
