            ("crunchyroll", "Crunchyroll", SCRIPT_DIR / "crunchyroll.log")]
    TAIL = 600_000   # bytes read from the end of a big log
    PROBLEM = re.compile(r"error|traceback|exception|failed|couldn't|could not|critical|warning|^\s+File ", re.I)

    def __init__(self, settings):
        super().__init__()
        self.settings, self.sig = settings, None
