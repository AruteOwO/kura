class ResponsiveGrid(QWidget):
    """Cards in up to `max_cols` columns of at least `min_col` px; spans shrink in a narrow window."""

    def __init__(self, min_col=320, max_cols=3, spacing=16):
        super().__init__()
        self.min_col, self.max_cols, self.sp = min_col, max_cols, spacing
        self.grid = QGridLayout(self)
        self.grid.setContentsMargins(0, 0, 0, 0)
        self.grid.setSpacing(spacing)
        self.items, self.cols = [], 0

    def add(self, w, span=1):
        self.items.append((w, span))
        self.relayout(force=True)
        return w

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.relayout()

    def relayout(self, force=False):
        width = self.width() if self.width() > 50 else 1200
        cols = max(1, min(self.max_cols, (width + self.sp) // (self.min_col + self.sp)))
        if cols == self.cols and not force:
            return
        self.cols = cols
        for w, _ in self.items:
            self.grid.removeWidget(w)
        for c in range(self.max_cols):
            self.grid.setColumnStretch(c, 1 if c < cols else 0)
        r = c = 0
        for w, span in self.items:
            s = min(span, cols)
            if c + s > cols:
                r, c = r + 1, 0
            self.grid.addWidget(w, r, c, 1, s)
            c += s
            if c >= cols:
                r, c = r + 1, 0


