    def back_clicked(self):
        if self.origin:
            page = self.origin["page"]
            self.set_origin(None)
            self.go_back.emit(page)

    def resolve_show(self, query):
        """(AniList id, the rest of the text) when the search starts with a show's name ("Sousou no Frieren 2nd
        Season 04" → its season 2, "04"), else None."""
        matcher, _, self.titles = build_matcher(self.library, self.account)
        words = tor.norm(query).split()
        for n in range(len(words), 0, -1):
            mid = matcher.names.get(" ".join(words[:n])) or matcher.compact.get("".join(words[:n]))
            if mid and (n >= 2 or n == len(words) or words[n].isdigit()):
                return mid, " ".join(words[n:])
        return None

    def show_names(self, mid):
        """A show's names to search: romaji and English (on), names you added and spellings Kura learned (on), its other
        AniList titles (off until you tick them). "2nd Season" and the like are left out (tor.search_name)."""
        m = media_for(mid, self.account) or {}
        if not m.get("title"):
            m = media_info(mid, _read_json(org.CACHE_FILE), {}, {})
        t = m.get("title") or {"romaji": m.get("romaji"), "english": m.get("english")}
        picks = (self.settings.get("torrent_name_pick") or {}).get(str(mid)) or {}
        out, seen = [], set()

        def add(text, kind, on):
            name = tor.search_name(text)
            key = tor.norm(name)
            if key and key not in seen:
                seen.add(key)
                out.append({"text": name, "kind": kind, "key": key, "on": picks.get(key, on)})
        add(t.get("romaji"), "romaji", True)
        add(t.get("english"), "english", True)
        for al in (self.settings.get("torrent_aliases") or {}).values():
            if al.get("mid") == mid:
                add(al.get("text"), al.get("by") or "learned", True)
        plain = [x for x in (m.get("synonyms") or []) if x and re.fullmatch(r"[\x20-\x7e\u2018-\u201f]+", x)]
        for syn in plain[:2]:   # plain-letter ones only (AniList also lists French, Polish... titles)
            add(syn, "synonym", False)
        return out

    def set_show_context(self):
        found = self.resolve_show(self.query) if self.query else None
        if found:
            mid, extra = found
            self.show_ctx = {"mid": mid, "names": self.show_names(mid), "extra": extra}
        else:
            self.show_ctx = None
        self.fill_chips()
        self.fill_strip()

    def search_terms(self):
        """What is searched: every ticked name of the show + the rest of what you typed, or just your text."""
        ctx = self.show_ctx
        if not ctx or not ctx["names"]:
            self.term_kinds = [None]
            return [self.query]
        names = [n for n in ctx["names"] if n["on"]] or ctx["names"][:1]
        self.term_kinds = [n["kind"] for n in names]
        return [f"{n['text']} {ctx['extra']}".strip() for n in names]

    def found_text(self, it):
        kinds = getattr(self, "term_kinds", [None])
        found = it.get("found") or []
        if len(kinds) < 2 or not found:
            return ""
        if len(set(found)) == len(kinds):
            return "Every name"
        return " · ".join(dict.fromkeys(self.NAME_KINDS.get(kinds[i], "") for i in found if i < len(kinds)))

    def fill_chips(self):
        while self.chip_lay.count():
            w = self.chip_lay.takeAt(0).widget()
            if w is not None:
                w.deleteLater()
        ctx = self.show_ctx
        if not ctx:
            self.chip_box.hide()
            return
        self.chip_lay.addWidget(label("Also searching every name of this show:", "muted"))
        ar = accent_rgb()
        for n in ctx["names"]:
            b = QPushButton(("✓  " if n["on"] else "") + n["text"])
            b.setCursor(Qt.PointingHandCursor)
            b.setToolTip(f"{self.NAME_KINDS.get(n['kind'], '')} · click to {'stop searching' if n['on'] else 'search'}"
                         f" this name" + ("\nRight-click to remove it" if n["kind"] in ("yours", "learned") else ""))
            b.setStyleSheet(f"QPushButton {{ border-radius: 13px; padding: 5px 12px; font-size: 9pt;"
                            f" background: {f'rgba({ar},0.16)' if n['on'] else 'transparent'};"
                            f" border: 1px solid {f'rgba({ar},0.55)' if n['on'] else C['border_hi']};"
                            f" color: {'white' if n['on'] else C['muted']}; }}"
                            f" QPushButton:hover {{ border-color: {C['accent_hi']}; }}")
            b.clicked.connect(lambda _=False, name=n: self.toggle_name(name))
            if n["kind"] in ("yours", "learned"):
                b.setContextMenuPolicy(Qt.CustomContextMenu)
                b.customContextMenuRequested.connect(lambda _p, name=n: self.remove_name(name))
            self.chip_lay.addWidget(b)
        add = QPushButton("+ Another name")
        add.setCursor(Qt.PointingHandCursor)
        add.setStyleSheet(f"QPushButton {{ border-radius: 13px; padding: 5px 12px; font-size: 9pt; background: transparent;"
                          f" border: 1px dashed {C['border_hi']}; color: {C['muted']}; }}"
                          f" QPushButton:hover {{ color: {C['text']}; }}")
        add.clicked.connect(self.add_name)
        self.chip_lay.addWidget(add)
        self.chip_box.show()

    def toggle_name(self, name):
        mid = self.show_ctx["mid"]
        name["on"] = not name["on"]
        if not any(n["on"] for n in self.show_ctx["names"]):
            name["on"] = True   # one name at least
            return
        picks = dict(self.settings.get("torrent_name_pick") or {})
        mine = dict(picks.get(str(mid)) or {})
        mine[name["key"]] = name["on"]
        picks[str(mid)] = mine
        self._remember("torrent_name_pick", picks)
        self.fill_chips()
        self.fill_strip()
        self.check()

    def remember_alias(self, mid, text, by):
        aliases = dict(self.settings.get("torrent_aliases") or {})
        aliases[tor.norm(text)] = {"mid": mid, "text": text, "by": by}
        self._remember("torrent_aliases", aliases)

    def add_name(self):
        ctx = self.show_ctx
        title = self.titles.get(ctx["mid"]) or "this show"
        text, ok = QInputDialog.getText(self, "Another name", f"Another name to search for {title}\n"
                                        "(it's also used to recognize its releases):")
        if ok and text.strip():
            self.remember_alias(ctx["mid"], text.strip(), "yours")
            ctx["names"] = self.show_names(ctx["mid"])
            self.fill_chips()
            self.check()

    def remove_name(self, name):
        mid = self.show_ctx["mid"]
        aliases = {k: v for k, v in (self.settings.get("torrent_aliases") or {}).items()
                   if not (v.get("mid") == mid and tor.norm(tor.search_name(v.get("text"))) == name["key"])}
        self._remember("torrent_aliases", aliases)
        self.show_ctx["names"] = self.show_names(mid)
        self.fill_chips()
        self.check()

    def fill_strip(self):
        ctx = self.show_ctx
        if not ctx:
            self.strip.hide()
            return
        mid = ctx["mid"]
        m = media_for(mid, self.account) or {}
        self.strip_title.setText(self.titles.get(mid) or media_title(m))
        f = cover_file(mid)
        img = QImage(str(f)) if f else QImage()
        if not img.isNull():
            pm = QPixmap.fromImage(img.scaled(104, 148, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
            pm = pm.copy((pm.width() - 104) // 2, (pm.height() - 148) // 2, 104, 148)
            pm.setDevicePixelRatio(2)
            self.strip_cover.setPixmap(pm)
        else:
            self.strip_cover.clear()
        e = self.account.entry(mid) if self.account and self.account.connected else None
        have = set()
        for idx in self.library.indexes().values():
            have |= set(((idx or {}).get("local") or {}).get(mid) or {})
        aired = aired_count(m) or 0
        missing = [n for n in range(1, aired + 1) if n not in have]
        later = [n for n in missing if n > ((e or {}).get("progress") or 0)]
        nxt = (later or missing or [None])[0]
        bits = [tor.STATUS_TEXT.get((e or {}).get("status"), "Not on your list")]
        if nxt:
            bits.append(f"episode {nxt} aired, not downloaded" + (f" (+{len(missing) - 1} more)" if len(missing) > 1 else ""))
        elif aired:
            bits.append("you have every aired episode")
        on = sum(1 for n in ctx["names"] if n["on"])
        if on > 1:
            bits.append(f"searching {on} names")
        self.strip_sub.setText("  ·  ".join(bits))
        while self.strip_picks.count():
            w = self.strip_picks.takeAt(0).widget()
            if w is not None:
                w.deleteLater()
        picks = ([(f"Episode {nxt}", f"{nxt:02d}")] if nxt else []) + [("All episodes", "")]
        ar = accent_rgb()
        for text, extra in picks:
            b = QPushButton(text)
            b.setCursor(Qt.PointingHandCursor)
            cur = tor.norm(extra) == tor.norm(ctx["extra"])
            b.setStyleSheet(f"QPushButton {{ border-radius: 14px; padding: 6px 12px; font-weight: 600; font-size: 9pt;"
                            f" background: {f'rgba({ar},0.25)' if cur else 'rgba(255,255,255,0.06)'};"
                            f" border: 1px solid {f'rgba({ar},0.6)' if cur else C['border_hi']}; }}")
            b.clicked.connect(lambda _=False, x=extra: self.pick_extra(x))
            self.strip_picks.addWidget(b)
        came_from_it = bool(self.origin and self.origin.get("mid") == mid)
        self.strip_show.setVisible(not came_from_it)   # the back pill already goes there
        self.strip.show()

    def pick_extra(self, extra):
        ctx = self.show_ctx
        ctx["extra"] = extra
        base = next((n["text"] for n in ctx["names"] if n["on"]), "")
        text = f"{base} {extra}".strip()
        self.search_box.blockSignals(True)
        self.search_box.setText(text)
        self.search_box.blockSignals(False)
        self.query = text
        self.fill_strip()
        self.check()

    def learn_spellings(self, items):
        """Releases of the show you searched that Kura didn't recognise, downloaded by hand: their way of writing
        the name is remembered (searched and recognised from now on)."""
        ctx = self.show_ctx
        if not ctx:
            return
        import difflib
        known = [n["key"] for n in ctx["names"]]
        learned = []
        for it in items:
            name = (it.get("parsed") or {}).get("name") or ""
            key = tor.norm(name)
            if it.get("mid") or not key or key in known:
                continue
            if max((difflib.SequenceMatcher(None, key, k).ratio() for k in known), default=0) < 0.5:
                continue   # something else that turned up in the search
            self.remember_alias(ctx["mid"], name, "learned")
            known.append(key)
            learned.append(name)
        if learned:
            title = self.titles.get(ctx["mid"]) or "this show"
            self.notify.emit(f"Kura will now recognize “{learned[0]}” as {title}")
            ctx["names"] = self.show_names(ctx["mid"])
            self.fill_chips()

    def count_as_show(self, it):
        ctx = self.show_ctx
        name = (it.get("parsed") or {}).get("name") or ""
        if ctx and name:
            self.remember_alias(ctx["mid"], name, "learned")
            ctx["names"] = self.show_names(ctx["mid"])
            self.fill_chips()
            self.refilter()

    # ---- downloads (qBittorrent Web UI)
    DL_COLS = ["Anime", "Ep", "Progress", "Size", "Speed", "ETA", "Seeds", "State"]

    def build_downloads_view(self):
        box = QWidget()
        col = QVBoxLayout(box)
        col.setContentsMargins(0, 0, 0, 0)
        col.setSpacing(14)
        bar = QHBoxLayout()
        self.dl_status = label("", "muted", wrap=True)
        bar.addWidget(self.dl_status, 1)
        self.dl_setup = QPushButton("Set up qBittorrent")
        self.dl_setup.clicked.connect(lambda: self.open_settings(1))
        bar.addWidget(self.dl_setup)
        col.addLayout(bar)
        self.dl_tree = QTreeWidget()
        self.dl_tree.setObjectName("torrents")
        self.dl_tree.setColumnCount(len(self.DL_COLS))
        self.dl_tree.setHeaderLabels(self.DL_COLS)
        self.dl_tree.setRootIsDecorated(False)
        self.dl_tree.setUniformRowHeights(True)
        self.dl_tree.setSelectionMode(QTreeWidget.ExtendedSelection)
        self.dl_tree.setItemDelegateForColumn(2, ProgressDelegate(self.dl_tree))
        head = self.dl_tree.header()
        head.setStretchLastSection(False)
        head.setSectionResizeMode(QHeaderView.ResizeToContents)
        head.setSectionResizeMode(0, QHeaderView.Stretch)
        head.setSectionResizeMode(2, QHeaderView.Fixed)
        head.resizeSection(2, 170)
        ds = self.settings.get("torrents_dl_sort")
        head.setSortIndicator(ds[0], Qt.SortOrder(ds[1])) if ds else head.setSortIndicator(-1, Qt.AscendingOrder)
        self.dl_tree.setSortingEnabled(True)   # a click on a header sorts, like Explorer (ValueSortItem: numbers by value)
        head.sortIndicatorChanged.connect(lambda c, o: (self.settings.__setitem__("torrents_dl_sort", [c, o.value]),
                                                        save_settings(self.settings)))
        self.dl_tree.currentItemChanged.connect(lambda *_: self.update_files())
        self.dl_tree.setContextMenuPolicy(Qt.CustomContextMenu)
        self.dl_tree.customContextMenuRequested.connect(self.download_menu)
        self.dl_tree.itemDoubleClicked.connect(lambda row, _: self.open_download_folder(self.download_of(row)))
        col.addWidget(self.dl_tree, 1)
        col.addWidget(label("Torrents Kura sends get the “Kura” category in qBittorrent. Finished ones are sorted "
                            "into your library. Give any torrent that category in qBittorrent to have Kura organize "
                            "it too.", "faint", wrap=True))
        return box

    def set_view(self, view):
        self.stack.setCurrentIndex(1 if view == "downloads" else 0)
        for w in self.feed_only:
            w.setVisible(view != "downloads")
        if view == "downloads":
            self.fill_downloads()
        else:
            self.populate()
        self.update_files()   # the panel shows that view's selection

    def set_downloads(self, downloads):
        self.downloads = downloads
        downloads.changed.connect(self.on_downloads_changed)

    def on_downloads_changed(self):
        n = len(self.downloads.torrents) if self.downloads else 0
        self.view_switch.buttons["downloads"].setText(f"Downloads  {n}" if n else "Downloads")
        if not self.isVisible():
            return
        if self.stack.currentIndex() == 1:
            self.fill_downloads()
        elif any(it["hash"] in self.downloads.torrents for it in self.items if it.get("hash")):
            self.update_feed_status()

    def download_of(self, row):
        return self.downloads.torrents.get(row.data(0, Qt.UserRole)) if self.downloads else None

    def fill_downloads(self):
        d = self.downloads
        on = d is not None and d.enabled
        self.dl_setup.setVisible(not on or not d.connected)
        if not on:
            self.dl_status.setText("Send torrents to qBittorrent's Web UI to follow them here and have Kura organize "
                                   "them when they finish (Torrent settings → Downloads).")
        elif not d.connected:
            self.dl_status.setText(d.status or "Connecting to qBittorrent…")
        torrents = d.torrents if on else {}
        for h in [h for h in self.dl_rows if h not in torrents]:
            self.dl_tree.takeTopLevelItem(self.dl_tree.indexOfTopLevelItem(self.dl_rows.pop(h)))
        down = 0
        for h, t in torrents.items():
            row = self.dl_rows.get(h)
            if row is None:
                row = self.dl_rows[h] = ValueSortItem()
                row.setData(0, Qt.UserRole, h)
                self.dl_tree.addTopLevelItem(row)
            mid, ep = t.get("mid"), t.get("episode")
            title = (self.titles.get(mid) or media_title(media_for(mid, self.account))) if mid else ""
            done = tor.is_done(t)
            speed = t.get("dlspeed", 0)
            down += speed
            eta = t.get("eta", 8640000)
            values = [title or tor.parse_release(t.get("name", ""))["name"] or t.get("name", ""),
                      str(ep or ""), "", fmt_bytes(t.get("size", 0)),
                      f"{fmt_bytes(speed)}/s" if speed else "", "" if done or eta >= 8640000 else fmt_eta(eta),
                      f"{t.get('num_seeds', 0)} ({t.get('num_complete', 0)})", QBIT_STATES.get(t.get("state"), t.get("state", ""))]
            for c, v in enumerate(values):
                if row.text(c) != v:
                    row.setText(c, v)
            row.setData(2, Qt.UserRole, float(t.get("progress", 0)))
            try:
                ep_v = float(ep or 0)
            except (TypeError, ValueError):
                ep_v = 0.0
            for c, v in ((1, ep_v), (2, float(t.get("progress", 0))), (3, t.get("size", 0)), (4, speed),
                         (5, 10 ** 12 if done else eta), (6, t.get("num_seeds", 0))):
                if row.data(c, SORT_ROLE) != v:
                    row.setData(c, SORT_ROLE, v)
            row.setData(2, Qt.UserRole + 1, "done" if done else "paused" if "paused" in t.get("state", "")
                        or "stopped" in t.get("state", "") else "error" if t.get("state") in ("error", "missingFiles")
                        else "active")
            row.setToolTip(0, t.get("name", ""))
        if on and d.connected:
            active = sum(1 for t in torrents.values() if not tor.is_done(t))
            self.dl_status.setText(f"{len(torrents)} torrent{'s' if len(torrents) != 1 else ''} in qBittorrent"
                                   + (f"  ·  {active} downloading" if active else "")
                                   + (f"  ·  {fmt_bytes(down)}/s" if down else ""))
        self.dl_tree.viewport().update()

    def download_menu(self, pos):
        row = self.dl_tree.itemAt(pos)
        t = self.download_of(row) if row else None
        if t is None:
            return
        picked = [x for x in (self.download_of(r) for r in self.dl_tree.selectedItems()) if x] or [t]
        hashes = [x["hash"] for x in picked]
        qbit = self.downloads.client
        n = f" {len(picked)} torrents" if len(picked) > 1 else ""
        menu = QMenu(self)
        menu.addAction(glyph_icon("", C["text"]), f"Pause{n}", lambda: self.downloads.run(lambda: qbit.pause(hashes)))
        menu.addAction(glyph_icon("", C["text"]), f"Resume{n}", lambda: self.downloads.run(lambda: qbit.resume(hashes)))
        menu.addSeparator()
        menu.addAction(glyph_icon(G["folder"], C["text"]), "Open folder", lambda: self.open_download_folder(t))
        if t.get("mid"):
            menu.addAction(glyph_icon(G["library"], C["text"]), "Show anime",
                           lambda: self.open_media.emit(t["mid"], self.titles.get(t["mid"]) or "", None))
        menu.addSeparator()
        menu.addAction(glyph_icon(G["minus"], C["text"]), f"Remove{n} (keep files)",
                       lambda: self.downloads.run(lambda: qbit.delete(hashes)))
        menu.addAction(glyph_icon(G["minus"], C["bad"]), f"Remove{n} and delete files",
                       lambda: self.remove_with_files(hashes))
        menu.exec(self.dl_tree.viewport().mapToGlobal(pos))

    def remove_with_files(self, hashes):
        box = QMessageBox(QMessageBox.Question, "Delete files",
                          f"Remove {'these torrents' if len(hashes) > 1 else 'this torrent'} and delete the "
                          "downloaded files?", QMessageBox.Yes | QMessageBox.Cancel, self)
        if box.exec() == QMessageBox.Yes:
            qbit = self.downloads.client
            self.downloads.run(lambda: qbit.delete(hashes, delete_files=True))

    def open_download_folder(self, t):
        if not t:
            return
        path = Path(t.get("content_path") or Path(t.get("save_path", "")) / t.get("name", ""))
        folder = path if path.is_dir() else path.parent
        if folder.exists() and os.name == "nt":
            os.startfile(folder)

    def update_feed_status(self):
        """Feed rows that are in qBittorrent show how far along they are."""
        for i in range(self.tree.topLevelItemCount()):
            row = self.tree.topLevelItem(i)
            if self.item_of(row) is None:
                continue
            text = self.download_text(self.item_of(row))
            if text and row.text(7) != text:
                row.setText(7, text)

    def download_text(self, it):
        t = self.downloads.torrents.get(it.get("hash")) if self.downloads and it.get("hash") else None
        if t is None:
            return ""
        return "In library soon" if tor.is_done(t) else f"Downloading {int(t.get('progress', 0) * 100)}%"

    def _remember(self, key, value):
        self.settings[key] = value
        save_settings(self.settings)

    def showEvent(self, e):
        super().showEvent(e)
        if self.stack.currentIndex() == 1:
            self.fill_downloads()
        if self.checked_at is None or time.time() - self.checked_at > 600:
            self.check()
        else:
            self.refilter()

    # ---- settings & filters
    def anime_choices(self):
        _, _, titles = build_matcher(self.library, self.account)
        return sorted(titles.items(), key=lambda kv: kv[1].lower())

    def open_settings(self, tab=0):
        """Torrent settings live in Settings now (Feeds / Downloads / Filters)."""
        self.open_section.emit(["torrent_feeds", "torrent_downloads", "torrent_filters"][max(0, min(2, tab))])

    def update_filters_btn(self):
        enabled, filters = torrent_filters(self.settings)
        n = sum(1 for f in filters if f.get("enabled", True))
        profiles = tor.load_profiles()
        name = profiles[1] if profiles and len(profiles[2]) > 1 else ""
        text = f"Filters: {n} active" if enabled else "Filters: off"
        self.filters_btn.setText(f"{name} · {text}" if name else text)

    def add_quick_filter(self, flt):
        enabled, filters = torrent_filters(self.settings)
        if flt["action"] == "prefer":   # specific preferences go before the general ones
            i = next((n for n, f in enumerate(filters) if f["action"] == "prefer"), len(filters))
            filters.insert(i, flt)
        else:
            filters.append(flt)
        tor.save_filters(enabled, filters)
        self.update_filters_btn()
        self.notify.emit(f"Added filter “{flt['name']}”")
        self.refilter()

    def use_group_for(self, mid, title, group):
        """Get this anime from another group: it becomes an exception to "only one group"
        filters (Discard: group is not X), and the group is preferred for it."""
        enabled, filters = torrent_filters(self.settings)
        for f in filters:
            strict = f["action"] == "discard" and any(c["element"] == "release_group" and c["op"] == "is_not"
                                                      for c in f.get("conditions") or [])
            if strict and not (f.get("anime") and f.get("anime_mode", "only") == "only"):
                f["anime_mode"] = "except"
                f["anime"] = sorted(set(f.get("anime") or []) | {mid})
        flt = tor._f(f"[{group}] {title}", "prefer", [("release_group", "is", group)], anime=[mid])
        filters.insert(next((n for n, f in enumerate(filters) if f["action"] == "prefer"), len(filters)), flt)
        tor.save_filters(enabled, filters)
        self.update_filters_btn()
        self.notify.emit(f"{title} will now come from {group}")
        self.refilter()

    # ---- loading
    def search(self, query):
        self.query = query or None
        if self.search_box.text() != (query or ""):
            self.search_box.setText(query or "")
        self.back_btn.setVisible(bool(self.query))
        self.set_show_context()
        cached = getattr(self, "feed_cache", None)
        if not self.query and cached and time.time() - cached["at"] < 600 and not self.loaders:
            # back to the feed: the one loaded before the search, at once (checked again after 10 min)
            self.load_id += 1
            self.items, self.page, self.last_page = list(cached["items"]), 0, 0
            self.checked_at = cached["at"]
            self.search_url = cached["url"]
            self.page_cache = {}
            self.picks, self.seen_pages = {}, set()
            self.pager.hide()
            self.refilter()
            return
        self.check()

    def check(self, auto=False, ask=False):
        """Load the feed (or the search). `ask`: you pressed Check feed, so new episodes get offered (Ask about new)."""
        if auto and self.query:
            return   # you're looking through a search: the next automatic check does the feed
        self.ask_after = ask and not auto
        if not auto:
            self.picks, self.seen_pages = {}, set()
        for ld in list(self.loaders):
            ld.requestInterruption()
        self.load_id += 1
        self.search_gen += 1
        self.page = self.last_page = 0
        self.page_cache = {}
        self.pager.hide()
        page = 0
        if self.query:
            feed = self.settings.get("torrent_search_feed")
            urls = [tor.search_url(feed, t) for t in self.search_terms()]
            url = urls if len(urls) > 1 else urls[0]
            page = 1 if tor.is_nyaa(urls[0]) else 0   # Nyaa: results pages, so there can be more than 75
        else:
            url = (self.settings.get("torrent_feed") or "").strip() or tor.DEFAULT_FEED
        self.search_url = url
        self.start_loader(FeedLoader(self.load_id, url, page), auto, append=False)
        if not auto:
            self.subtitle.setText(f"Searching for “{self.query}”…" if self.query else "Checking the feed…")

    def go_page(self, n):
        """Another page of the search results: at once if it was seen (or fetched ahead), else loaded."""
        if not self.page or n == self.page or not 1 <= n <= self.last_page:
            return
        if n in self.page_cache:
            self.show_page(n)
            return
        for ld in list(self.loaders):
            ld.requestInterruption()
        self.load_id += 1
        self.pager.set(self.page, self.last_page, loading=n)
        self.subtitle.setText(f"Loading page {n} of {self.last_page}…")
        self.start_loader(FeedLoader(self.load_id, self.search_url, n), False, append=False)

    def store_page(self, page, items):
        """Keep a results page; releases an earlier page already showed are left out (Nyaa's pages shift
        when new torrents are uploaded, so page 2 can repeat the end of page 1)."""
        seen = {i["hash"] or i["page"] for n, its in self.page_cache.items() if n < page for i in its}
        self.page_cache[page] = [i for i in items if (i["hash"] or i["page"]) not in seen]

    def show_page(self, n):
        self.items = list(self.page_cache[n])
        self.page = n
        self.seen_pages.add(n)
        self.refilter()
        self.pager.set(n, self.last_page)
        self.tree.scrollToTop()
        self.prefetch(n + 1)

    def prefetch(self, n):
        """Fetch the next page quietly, so Next is instant."""
        if not (1 < n <= self.last_page) or n in self.page_cache or self.prefetchers:
            return
        gen, url = self.search_gen, self.search_url
        ld = FeedLoader(-1, url, n)
        ld.done.connect(lambda _i, items, err, page, last, g=gen: self.on_prefetched(g, items, err, page))
        ld.finished.connect(lambda: self.prefetchers.discard(ld))
        self.prefetchers.add(ld)
        ld.start()

    def on_prefetched(self, gen, items, err, page):
        if gen == self.search_gen and not err and page not in self.page_cache:
            self.store_page(page, items)

    def start_loader(self, ld, auto, append):
        ld.done.connect(lambda i, items, err, page, last, a=auto, ap=append: self.on_loaded(i, items, err, a, page, last, ap))
        ld.finished.connect(lambda: self.loaders.discard(ld))
        self.loaders.add(ld)
        self.busy.show()
        ld.start()

    def on_loaded(self, load_id, items, err, auto, page=0, last=0, append=False):
        if load_id != self.load_id:
            return
        self.busy.hide()
        if err:
            self.subtitle.setText(err)
            self.pager.set(self.page, self.last_page)
            if not auto:
                self.notify.emit(err)
            return
        self.checked_at = time.time()
        if page:   # a page of search results
            self.last_page = max(last, self.last_page if self.page_cache else 0)
            self.store_page(page, items)
            self.show_page(page)
        else:
            self.items = items
            self.page, self.last_page = 0, 0
            if not self.query:
                self.feed_cache = {"items": list(items), "at": self.checked_at, "url": self.search_url}
            self.refilter()
        new = [i for i in self.items if i["selected"]]
        ask, self.ask_after = getattr(self, "ask_after", False), False
        if auto and not self.query and new:
            if self.settings.get("torrent_new_action") == "download":
                self.download(new, auto=True)
            else:
                fresh = [i for i in new if i["hash"] not in self.notified]
                if fresh:
                    self.notified |= {i["hash"] for i in fresh}
                    names = ", ".join(dict.fromkeys(self.titles.get(i["mid"]) or i["facts"]["anime_title"] for i in fresh))
                    self.notify.emit(f"{len(fresh)} new torrent{'s' if len(fresh) != 1 else ''}: {names}")
        elif ask and not self.query and new and self.settings.get("torrent_manual_ask", True):
            fresh = [i for i in new if i["hash"] not in self.asked]
            if fresh:
                self.asked |= {i["hash"] for i in fresh}
                QTimer.singleShot(0, lambda f=fresh: self.ask_download(f))
        if auto and not self.query and self.settings.get("torrent_catchup", True):
            QTimer.singleShot(3000, self.catch_up)

    def ask_download(self, items):
        """After a manual Check feed: these are episodes you don't have. Download them?"""
        lines = []
        for i in items[:12]:
            ep = (i.get("parsed") or {}).get("episodes") or []
            name = self.titles.get(i.get("mid")) or i["facts"]["anime_title"]
            lines.append(f"•  {name}" + (f"  episode {episode_ranges(ep)}" if ep else ""))
        if len(items) > 12:
            lines.append(f"…and {len(items) - 12} more")
        box = QMessageBox(QMessageBox.Question, "New episodes",
                          f"The feed has {len(items)} episode{'s' if len(items) != 1 else ''} you don't have yet:\n\n"
                          + "\n".join(lines) + "\n\nDownload them now?", QMessageBox.Yes | QMessageBox.No, self)
        box.button(QMessageBox.Yes).setText("Download")
        box.button(QMessageBox.No).setText("Not now")
        if box.exec() == QMessageBox.Yes:
            self.download(items)

    def refilter(self):
        """Re-run the filters (list, library or filters may have changed)."""
        if self.items:
            matcher, describe, self.titles = build_matcher(self.library, self.account)
            enabled, filters = torrent_filters(self.settings)
            tor.evaluate(self.items, matcher, describe, tor.load_history(), filters, enabled,
                         tracking=bool(self.account and self.account.connected))
            for it in self.items:   # what you ticked or unticked yourself wins over the filters
                if self.pick_key(it) in self.sent_keys:
                    it["selected"] = False
                on = self.picks.get(self.pick_key(it))
                if on is not None:
                    it["selected"] = on
            self.annotate_batches()
        self.populate()

    BATCH_TAGS = {"gaps": "Fills your gaps", "complete": "Complete season", "new": "New episodes",
                  "have": "Already have all", "unknown": ""}

    def annotate_batches(self):
        """What each batch covers compared with your library, and whether it's worth it."""
        have = {}
        for idx in self.library.indexes().values():
            for sid, eps in ((idx or {}).get("local") or {}).items():
                if sid:
                    have.setdefault(sid, set()).update(eps)
        for it in self.items:
            for k in ("batch_eps", "batch_have", "batch_new", "batch_tag", "suggested", "covered"):
                it.pop(k, None)
        batches = []
        for it in self.items:
            p, mid = it.get("parsed") or {}, it.get("mid")
            if not p.get("batch"):
                continue
            batches.append(it)
            m = media_for(mid, self.account) if mid else {}
            eps = list(p.get("episodes") or [])
            if not eps and mid:   # "[Batch]" without numbers: the whole season (what has aired)
                total = m.get("episodes") or aired_count(m) or 0
                eps = list(range(1, total + 1))
            got = have.get(mid, set())
            it["batch_eps"] = eps
            it["batch_have"] = [e for e in eps if e in got]
            it["batch_new"] = [e for e in eps if e not in got]
            if not mid or not eps:
                tag = "unknown"
            elif not it["batch_new"]:
                tag = "have"
            elif it["batch_have"]:
                tag = "gaps"
            elif m.get("status") == "FINISHED" and m.get("episodes") and len(eps) >= m["episodes"]:
                tag = "complete"
            else:
                tag = "new"
            it["batch_tag"] = tag
            # Worth it over single episodes: several new ones, most of the batch
            it["suggested"] = tag != "have" and len(it["batch_new"]) >= 3 and len(it["batch_new"]) * 2 >= len(eps)
        # A batch your filters picked replaces the single episodes it brings
        for b in batches:
            if b.get("selected"):
                self.untick_covered(b)

    def untick_covered(self, batch, rows=False):
        """Single episodes this batch brings don't need downloading too."""
        new = set(batch.get("batch_new") or [])
        n = 0
        for it in self.items:
            if (it is not batch and not (it.get("parsed") or {}).get("batch") and it.get("mid") == batch.get("mid")
                    and it.get("episode") in new and it.get("selected")):
                it["selected"], it["covered"] = False, True
                it["state"] = "neutral"
                n += 1
        if rows and n:
            self.tree.blockSignals(True)
            for i in range(self.tree.topLevelItemCount()):
                row = self.tree.topLevelItem(i)
                it = self.item_of(row)
                if it is not None and it.get("covered"):
                    row.setCheckState(0, Qt.Unchecked)
                    row.setText(7, "In the batch")
            self.tree.blockSignals(False)
        return n

    def on_item_changed(self, row, col):
        it = self.item_of(row)
        if it is not None and col == 0:
            it["selected"] = row.checkState(0) == Qt.Checked
            self.picks[self.pick_key(it)] = it["selected"]
            if it["selected"] and (it.get("parsed") or {}).get("batch"):
                n = self.untick_covered(it, rows=True)
                if n:
                    self.notify.emit(f"Unticked {n} single episode{'s' if n != 1 else ''} the batch already has")
        self.update_button()

    def toggle_batches(self, row):
        if row.data(0, Qt.UserRole) == -1:
            self._remember("torrents_batches_open", not self.settings.get("torrents_batches_open", True))
            self.populate()

    # ---- table
    def populate(self):
        self.tree.blockSignals(True)
        self.tree.clear()
        show_hidden = self.show_all.isChecked()
        rows = [(i, it) for i, it in enumerate(self.items) if show_hidden or not it.get("hidden")]
        rows.sort(key=lambda r: (bool((r[1].get("parsed") or {}).get("batch")),
                                 not r[1].get("suggested"), TORRENT_ORDER.index(r[1].get("state", "neutral")), r[0]))
        if self.fsort:   # a clicked column, within the single episodes and within the batches (the group stays below)
            col, desc = self.fsort
            is_batch = lambda r: bool((r[1].get("parsed") or {}).get("batch"))
            rows = [r for grp in (False, True) for r in sorted((r for r in rows if is_batch(r) == grp),
                                                               key=lambda r: self.sort_key(r[1], col), reverse=desc)]
        batches_open = self.settings.get("torrents_batches_open", True)
        n_batches = sum(1 for _, it in rows if (it.get("parsed") or {}).get("batch"))
        header_done = False
        for i, it in rows:
            p = it.get("parsed") or {}
            if p.get("batch") and not header_done:
                header_done = True
                head = QTreeWidgetItem([f"{'▾' if batches_open else '▸'}  Batches  ·  {n_batches}"])
                head.setData(0, Qt.UserRole, -1)
                head.setFlags(Qt.ItemIsEnabled)
                head.setForeground(0, QColor(C["accent_hi"]))
                f = head.font(0)
                f.setWeight(QFont.DemiBold)
                head.setFont(0, f)
                head.setToolTip(0, "Whole seasons in one torrent. Click to show or hide.")
                self.tree.addTopLevelItem(head)
                head.setFirstColumnSpanned(True)
            if p.get("batch") and not batches_open:
                continue
            state = it.get("state", "neutral")
            name = self.titles.get(it.get("mid")) or p.get("name") or it["title"]
            ep = str(it.get("episode") or "")
            status = (self.download_text(it)
                      or ("In the batch" if it.get("covered") else "")
                      or {"selected": "Selected", "downloaded": "Downloaded", "discarded": "Discarded"}.get(state, ""))
            if p.get("batch"):
                eps = it.get("batch_eps") or p.get("episodes") or []
                ep = episode_ranges(eps) if eps else "All"
                new, got = it.get("batch_new") or [], it.get("batch_have") or []
                if got and new:
                    ep += f"  ({len(new)} new)"
                tag = self.BATCH_TAGS.get(it.get("batch_tag"), "")
                if it.get("suggested") and state != "selected":
                    tag = f"Suggested · {tag}" if tag else "Suggested"
                status = self.download_text(it) or (f"{status} · {tag}" if status and tag else status or tag)
            row = QTreeWidgetItem(["", name, ep, p.get("group", ""), p.get("resolution", ""), it["size"],
                                   str(it["seeders"]) if it["hash"] else "", status, it.get("reason", ""),
                                   self.found_text(it)])
            row.setData(0, Qt.UserRole, i)
            row.setFlags(row.flags() | Qt.ItemIsUserCheckable)
            row.setCheckState(0, Qt.Checked if it.get("selected") else Qt.Unchecked)
            row.setToolTip(1, it["title"])
            row.setToolTip(8, it.get("reason", ""))
            dim = state != "selected"
            for col in range(1, len(self.COLS)):
                row.setForeground(col, QColor(C["muted"] if dim else C["text"]))
            row.setForeground(7, QColor({"selected": C["accent_hi"], "downloaded": C["ok"]}.get(state, C["faint"])))
            row.setForeground(8, QColor(C["faint"]))
            if state == "selected":
                f = row.font(1)
                f.setWeight(QFont.DemiBold)
                row.setFont(1, f)
                row.setFont(7, f)
            if it.get("trusted"):
                row.setForeground(3, QColor(C["ok"] if not dim else C["muted"]))
                row.setToolTip(3, "Trusted uploader")
            if it.get("hidden"):
                for col in range(1, len(self.COLS)):
                    row.setForeground(col, QColor(C["faint"]))
            if p.get("batch") and it.get("batch_tag"):
                color = {"gaps": C["accent_hi"], "complete": C["ok"], "new": C["text"],
                         "have": C["faint"]}.get(it["batch_tag"], C["muted"])
                row.setForeground(7, QColor(color if state == "selected" or it.get("suggested")
                                            or it["batch_tag"] == "have" else C["muted"]))
                eps, got = it.get("batch_eps") or [], it.get("batch_have") or []
                tip = (f"Episodes {episode_ranges(eps)}" if eps else "Episode range unknown")
                if got:
                    tip += f"\nYou have {episode_ranges(got)}"
                if it.get("batch_new") and got:
                    tip += f"\nNew for you: {episode_ranges(it['batch_new'])}"
                    if self.settings.get("torrent_app") == "qbit" and self.settings.get("torrent_only_missing", True):
                        tip += "\nOnly the new ones will be downloaded"
                row.setToolTip(2, tip)
                row.setToolTip(7, tip)
            self.tree.addTopLevelItem(row)
        self.tree.blockSignals(False)
        self.tree.setColumnHidden(9, not (self.query and len(getattr(self, "term_kinds", [])) > 1))
        sel = sum(1 for it in self.items if it.get("selected"))
        hidden = sum(1 for it in self.items if it.get("hidden"))
        parts = [f"Results for “{self.query}”" if self.query else "Latest releases",
                 f"{len(self.items)} releases" + (f" (page {self.page} of {self.last_page})" if self.page else ""),
                 f"{sel} selected"]
        if hidden and not show_hidden:
            parts.append(f"{hidden} hidden")
        if self.checked_at:
            parts.append("checked " + time.strftime("%H:%M", time.localtime(self.checked_at)))
        self.subtitle.setText("  ·  ".join(parts))
        self.update_button()

    # ---- sorting by a column (Explorer-like)
    def sort_by(self, col):
        first_desc = col in (5, 6)   # Size, Seeds: biggest first
        cur = self.fsort
        if not cur or cur[0] != col:
            self.fsort = (col, first_desc)
        elif cur[1] == first_desc:
            self.fsort = (col, not first_desc)
        else:
            self.fsort = None   # third click: Kura's own order (ticked and suggested first)
        self.settings["torrents_sort"] = list(self.fsort) if self.fsort else None
        save_settings(self.settings)
        self.show_sort()
        self.populate()

    def show_sort(self):
        head = self.tree.header()
        head.setSortIndicatorShown(bool(self.fsort))
        if self.fsort:
            head.setSortIndicator(self.fsort[0], Qt.DescendingOrder if self.fsort[1] else Qt.AscendingOrder)

    def sort_key(self, it, col):
        p = it.get("parsed") or {}
        if col == 0:
            return 0 if it.get("selected") else 1
        if col == 1:
            return (self.titles.get(it.get("mid")) or p.get("name") or it["title"]).casefold()
        if col == 2:
            eps = it.get("batch_eps") or p.get("episodes") or []
            try:
                return float(min(eps) if eps else it.get("episode") or 0)
            except (TypeError, ValueError):
                return 0.0
        if col == 3:
            return (p.get("group") or "").casefold()
        if col == 4:
            return int(re.sub(r"\D", "", p.get("resolution") or "") or 0)
        if col == 5:
            return tor._size_mib(it.get("size"))
        if col == 6:
            return it.get("seeders") or 0
        if col == 7:
            state = it.get("state", "neutral")
            return TORRENT_ORDER.index(state) if state in TORRENT_ORDER else len(TORRENT_ORDER)
        if col == 8:
            return (it.get("reason") or "").casefold()
        return self.found_text(it).casefold()

    # ---- the Files panel
    def toggle_files(self, on):
        self.settings["torrent_files_panel"] = on
        save_settings(self.settings)
        self.files_panel.setVisible(on)
        for col in (8, 9):   # Filter, Found by: room for the names while the panel is open (their hover hint stays)
            self.tree.setColumnHidden(col, on)
        if on:
            self.update_files()

    def show_files_for(self, tree, row):
        tree.setCurrentItem(row)
        self.files_btn.setChecked(True)
        self.update_files()

    def update_files(self):
        if not self.files_panel.isVisible():
            return
        self.files_gen += 1
        if self.stack.currentIndex() == 1:
            row = self.dl_tree.currentItem()
            self.show_download_files(self.download_of(row) if row is not None else None)
        else:
            self.show_feed_files(self.item_of(self.tree.currentItem()))

    def show_feed_files(self, it):
        panel = self.files_panel
        if it is None:
            return panel.empty()
        p = it.get("parsed") or {}
        title = self.titles.get(it.get("mid")) or p.get("name") or it["title"]
        page = ("Torrent page", lambda i=it: self.open_page(i)) if it.get("page") else None
        key = it.get("hash") or it.get("link") or it["title"]
        cached = self.file_cache.get(key)
        if cached is None:
            link = it.get("link") or ""
            if not link.endswith(".torrent"):
                return panel.message(title, it["title"], "This release has no .torrent file to read; its page lists "
                                     "the files.", page)
            panel.message(title, it["title"], "Reading the file list…")
            gen = self.files_gen
            call = BgCall(lambda u=link: tor.torrent_files(u))

            def done(res, err, k=key, i=it, c=call):
                c.wait()
                self.files_calls.discard(c)
                if res:
                    self.file_cache[k] = res
                if gen != self.files_gen:
                    return
                if res:
                    self.show_feed_files(i)
                else:
                    panel.message(title, i["title"], f"Couldn't read the file list ({err}).", page)
            call.done.connect(done)
            self.files_calls.add(call)
            call.start()
            return
        _, files = cached
        have, new = set(it.get("batch_have") or []), set(it.get("batch_new") or [])
        rows = []
        for path, size in files:
            fname = path.rsplit("/", 1)[-1]
            video = Path(fname).suffix.lower() in org.VIDEO_EXTS
            eps = set(tor.parse_release(fname).get("episodes") or []) if video else set()
            if not eps:
                glyph, color, dim = "description", C["faint"], True   # extras: fonts, NCOP, subtitles...
            elif have and eps <= have:
                glyph, color, dim = "check_circle", C["ok"], True
            else:
                glyph, color, dim = "movie", accent_soft(), False
            rows.append({"path": path, "size": size, "glyph": glyph, "color": color, "dim": dim})
        n, total = len(files), sum(size for _, size in files)
        meta = f"{it['title']}\n{n} file{'s' if n != 1 else ''} · {fmt_bytes(total)}"
        chips = []
        if have:
            chips.append((f"You have {episode_ranges(sorted(have))}", C["ok"], "rgba(62,207,142,0.14)"))
        if have and new:
            chips.append((f"New for you: {episode_ranges(sorted(new))}", accent_soft(), "rgba(124,108,255,0.18)"))
        s = self.settings
        only_new = bool(have and new and s.get("torrent_app") == "qbit" and s.get("torrent_only_missing", True))
        get = (f"Download the {len(new)} new" if only_new else "Download", lambda i=it: self.download([i]))
        panel.show_files(title, meta, rows, chips, primary=get, secondary=page)

    def show_download_files(self, t):
        panel = self.files_panel
        if t is None:
            return panel.empty("Pick a download to see its files.")
        title = self.titles.get(t.get("mid")) or tor.parse_release(t.get("name", ""))["name"] or t.get("name", "")
        client = self.downloads.client if self.downloads else None
        if client is None:
            return panel.message(title, t.get("name", ""), "qBittorrent's Web UI isn't connected.")
        panel.message(title, t.get("name", ""), "Asking qBittorrent for the file list…")
        gen, h = self.files_gen, t.get("hash")

        def done(files, err):
            if gen != self.files_gen:
                return
            if err or files is None:
                return panel.message(title, t.get("name", ""), f"qBittorrent didn't list the files ({err}).")
            rows = []
            for f in files:
                prog, skip = float(f.get("progress", 0)), f.get("priority", 1) == 0
                glyph, color = (("block", C["faint"]) if skip else ("check_circle", C["ok"]) if prog >= 1
                                else ("downloading", accent_soft()))
                rows.append({"path": f.get("name", ""), "size": int(f.get("size", 0)), "glyph": glyph,
                             "color": color, "dim": skip or prog >= 1,
                             "done": "Skipped" if skip else f"{prog * 100:.0f}%", "done_v": -1.0 if skip else prog})
            meta = f"{t.get('name', '')}\n{len(files)} file{'s' if len(files) != 1 else ''} · " \
                   f"{fmt_bytes(t.get('size', 0))}"
            panel.show_files(title, meta, rows, done_col=True,
                             primary=("Open folder", lambda: self.open_download_folder(t)))
        self.downloads.run(lambda: client.files(h), done)

    def item_of(self, row):
        i = row.data(0, Qt.UserRole) if row is not None else None
        return self.items[i] if isinstance(i, int) and 0 <= i < len(self.items) else None   # -1 = Batches header

    @staticmethod
    def pick_key(it):
        return it.get("hash") or it.get("page") or it.get("title")

    def checked_items(self):
        rows = (self.tree.topLevelItem(i) for i in range(self.tree.topLevelItemCount()))
        return [self.item_of(r) for r in rows if self.item_of(r) is not None and r.checkState(0) == Qt.Checked]

    def other_pages_checked(self):
        """[(release, page)] ticked on the other pages of this search you've looked at."""
        out = []
        if self.page:
            for n in sorted(self.seen_pages - {self.page}):
                out += [(it, n) for it in self.page_cache.get(n, []) if it.get("selected")]
        return out

    def all_checked(self):
        here = self.checked_items()
        keys = {self.pick_key(i) for i in here}
        return here + [it for it, _ in self.other_pages_checked() if self.pick_key(it) not in keys]

    def update_button(self):
        others = self.other_pages_checked()
        n = len(self.checked_items()) + len(others)
        self.dl_btn.setEnabled(n > 0)
        self.dl_btn.setText(f"Download {n}" if n else "Download")
        self.dl_btn.setToolTip(f"Includes {len(others)} ticked on other pages" if others else "")
        self.picked_btn.setText(f"✓  {n} selected")
        self.picked_btn.setVisible(bool(self.page and n and len(self.seen_pages) > 1))

    def download_ticked(self):
        items = self.all_checked()
        self.download(items)
        if items:
            self.picks = {}   # sent: the next ticks start fresh

    def untick(self, items):
        """Sent (or already in qBittorrent): untick them on every page of this search, not just this one."""
        keys = {self.pick_key(i) for i in items}
        self.sent_keys |= keys
        for k in keys:   # sending can finish before download_ticked clears the picks
            self.picks.pop(k, None)
        for page in [self.items, *self.page_cache.values()]:
            for it in page:
                if self.pick_key(it) in keys:
                    it["selected"] = False

    def review_picks(self):
        here = [(it, self.page) for it in self.checked_items()]
        dlg = SelectedDialog(self, here + self.other_pages_checked())
        if dlg.exec() != QDialog.Accepted:
            return
        for it in dlg.unticked():
            it["selected"] = False
            self.picks[self.pick_key(it)] = False
        self.populate()

    # ---- downloading
    def save_path(self, it):
        s = self.settings
        if s.get("torrent_use_anime_folder") and it.get("mid"):
            path = self.library.path_for_media(it["mid"])
            if path:
                return path
        if s.get("torrent_use_fallback", True):
            base = (s.get("torrent_fallback_folder") or s.get("downloads") or "").strip()
            if base and s.get("torrent_subfolder"):
                title = self.titles.get(it.get("mid")) or (it.get("parsed") or {}).get("name") or ""
                if title:
                    base = str(Path(base) / org.safe_name(title))
            return base
        return ""

    def download(self, items, auto=False):
        if not items:
            return
        if not auto and self.query:
            self.learn_spellings(items)
        s = self.settings
        if s.get("torrent_sort") == "date":
            from email.utils import parsedate_to_datetime

            def key(i):
                try:
                    return parsedate_to_datetime(i["date"]).timestamp()
                except (TypeError, ValueError):
                    return 0
        else:
            def key(i):
                return (self.titles.get(i.get("mid")) or "", i.get("episode") or 0)
        items = sorted(items, key=key, reverse=s.get("torrent_sort_order") == "desc")
        client = (s.get("torrent_client") or "").strip() if s.get("torrent_app") == "custom" else ""
        by_path = {}
        for it in items:
            by_path.setdefault(self.save_path(it), []).append(it)
        if s.get("torrent_app") == "qbit" and self.downloads is not None:
            for it in items:   # batches: skip the episodes you already have (picked once the files are known)
                if it.get("batch_have") and it.get("batch_new") and s.get("torrent_only_missing", True):
                    it["only_missing"], it["batch_eps"] = True, it["batch_new"]
                if (it.get("parsed") or {}).get("batch") and s.get("torrent_skip_junk", True):
                    it["skip_junk"] = True
            qbit = self.downloads.client
            have = set(self.downloads.torrents)
            if not auto:
                self.untick([i for i in items if i["hash"] and i["hash"] in have])
            items = [i for i in items if not i["hash"] or i["hash"] not in have]   # already in qBittorrent
            if not items:
                self.populate()
                return
            groups = [(p, [i for i in g if i in items]) for p, g in by_path.items()]

            def add():
                for path, group in groups:
                    if group:
                        qbit.add([tor.magnet(i) for i in group], path)

            def sent(_, err):
                if not err:
                    self.after_send(items, auto, "qBittorrent")
                    return
                # Web UI not answering: hand them to qbittorrent.exe instead, in the same category,
                # so Kura still organizes them once it can reach the Web UI again
                exe = (s.get("torrent_client") or "").strip() or tor.find_qbittorrent()
                try:
                    if not exe or not Path(exe).exists():
                        raise OSError("qbittorrent.exe not found")
                    for path, group in groups:
                        if group:
                            tor.send(group, exe, path, category=tor.QBit.CATEGORY)
                except Exception as e:
                    self.notify.emit(f"Couldn't send the torrents to qBittorrent ({err}; {e})")
                    return
                self.notify.emit(f"qBittorrent's Web UI didn't answer ({err}), so the torrents went to the "
                                 "qBittorrent app directly")
                self.after_send(items, auto, "qBittorrent")
            self.downloads.run(add, sent)
            return
        try:
            for path, group in by_path.items():
                tor.send(group, client, path)
        except Exception as e:
            self.notify.emit(f"Couldn't hand the torrents to your torrent app ({e})")
            return
        self.after_send(items, auto, "qBittorrent" if client and "qbittorrent" in client.lower() else "your torrent app")

    def after_send(self, items, auto, app):
        tor.add_history(items)
        def what(i):
            name = self.titles.get(i.get("mid")) or (i.get("parsed") or {}).get("name") or i["title"]
            if (i.get("parsed") or {}).get("batch"):
                eps = i.get("batch_eps")
                return f"{name} {episode_ranges(eps)} (batch)" if eps else f"{name} (batch)"
            return f"{name} {i['episode']}" if i.get("episode") else name
        names = ", ".join(what(i) for i in items[:3])
        more = f" and {len(items) - 3} more" if len(items) > 3 else ""
        self.notify.emit(f"{'Auto-downloading' if auto else 'Sent to'} {app}: {names}{more}")
        self.untick(items)
        self.refilter()

    def open_page(self, it):
        if it.get("page"):
            webbrowser.open(it["page"])

    def open_in_browser(self):
        if self.query:
            template = (self.settings.get("search_url") or "").strip() or DEFAULT_SEARCH_URL
            webbrowser.open(template.replace("{query}", urllib.parse.quote_plus(self.query)))
        else:
            webbrowser.open("https://nyaa.si/")

