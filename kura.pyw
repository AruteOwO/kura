    def load_notes(self):
        try:
            notes = json.loads(NOTES_FILE.read_text(encoding="utf-8"))
            return [n for n in notes if isinstance(n, dict) and n.get("text")][-150:]
        except (OSError, ValueError):
            return []

    def save_notes(self):
        try:
            tmp = NOTES_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.notes[-150:], ensure_ascii=False), encoding="utf-8")
            os.replace(tmp, NOTES_FILE)
        except OSError:
            pass

    def visible_notes(self):
        """The side you're on: hentai notifications only on the Hentai side."""
        on = bool(acct.ADULT["on"])
        return [n for n in self.notes if bool(n.get("adult")) == on]

    def remember_note(self, text, kind="kura", mid=None, button=None, run=None, sub="", act=None, adult=None):
        """Keep a notification for the bell. act = what the button does after a restart ({"play": [mid, ep]},
        {"media": mid}, {"page": n}); run = what it does now. Episodes of one show join into one note."""
        now = time.time()
        if adult is None:
            adult = bool(acct.ADULT["on"]) or bool(mid and acct.is_adult(media_for(mid, self.account) or {}))
        n = 1
        if kind == "episode" and mid:
            for old in reversed(self.notes[-20:]):
                if old.get("kind") == "episode" and old.get("mid") == mid and not old.get("read") and now - old["t"] < 6 * 3600:
                    self.notes.remove(old)
                    self.note_runs.pop(old["id"], None)
                    n = old.get("count", 1) + 1
                    title = media_title(media_for(mid, self.account) or {}) or text
                    text = f"{title}: {n} episodes ready"
                    break
        note = {"id": f"{now:.6f}", "t": now, "text": text, "sub": sub, "kind": kind, "mid": mid, "button": button,
                "act": act, "read": False, "adult": adult, "count": n}
        self.notes.append(note)
        del self.notes[:-150]
        if run:
            self.note_runs[note["id"]] = run
        self.save_notes()
        self.update_bell()

    def update_bell(self):
        unread = sum(1 for n in self.visible_notes() if not n.get("read"))
        self.strip.caps.bell.dot.setVisible(unread > 0)
        self.strip.caps.bell.setToolTip(f"Notifications · {unread} new" if unread else "Notifications")

    def open_notifications(self):
        NotificationPanel(self, self.strip.caps.bell).show()

    def read_note(self, note):
        for n in self.visible_notes():
            if note is None or n["id"] == note["id"]:
                n["read"] = True
        self.save_notes()
        self.update_bell()

    def drop_note(self, note):
        ids = {n["id"] for n in self.visible_notes()} if note is None else {note["id"]}
        self.notes = [n for n in self.notes if n["id"] not in ids]
        self.save_notes()
        self.update_bell()

    def run_note(self, note):
        self.read_note(note)
        run = self.note_runs.get(note["id"])
        act = note.get("act") or {}
        if run:
            run()
        elif act.get("update"):
            self.check_updates(manual=True)
        elif act.get("play"):
            self.play_episode(*act["play"])
        elif act.get("page") is not None:
            self.go(act["page"])
        elif note.get("mid"):
            self.show_media(note["mid"], "", None)

    def notify(self, text, keep=None):
        """In-app message when the window is open, a Windows notification when it's in the tray.
        The bell keeps problems, downloads, AniList updates and such; confirmations only pop up."""
        if keep is not False:
            kind = next((k for rx, k in NOTE_KEEP if rx.search(text)), None)
            if kind or keep:
                page = self.TORRENTS if kind == "download" else None
                self.remember_note(text, kind or "kura", button="Open Torrents" if page else None,
                                   act={"page": page} if page is not None else None)
        if self.isVisible() and not self.isMinimized():
            self.toast.show_text(text)
        elif self.tray.isVisible():
            self.tray.showMessage(APP_NAME, text, self.windowIcon(), 8000)

    def quit_app(self):
        self.quitting = True
        if self.job is not None:   # closeEvent will explain; make sure the window is visible for that
            self.show_window()
        self.close()
        self.quitting = False   # still here if a job blocked it

    def remember_close(self, key, value):
        """A choice from the close overlay / tray notice saved, and Settings → App shows it."""
        self.settings[key] = value
        save_settings(self.settings)
        sp = self.settings_page
        if key == "close_action" and getattr(sp, "close_choice", None) is not None:
            sp.close_choice.buttons[value].setChecked(True)
        if key == "close_tray_notice" and getattr(sp, "tray_notice_sw", None) is not None:
            sp.tray_notice_sw.blockSignals(True)
            sp.tray_notice_sw.setChecked(value)
            sp.tray_notice_sw.blockSignals(False)

    def on_close_chosen(self, choice, always):
        if always:
            self.remember_close("close_action", choice)
        if choice == "tray":
            self.to_tray()
        else:
            self.quit_app()

    def to_tray(self, balloon=True):
        """Keep running in the tray (torrent checks continue); Quit is in the tray menu."""
        self.close_overlay.hide()
        if self.player_overlay is not None:   # the player is inside this window: stop it
            self.close_player()
        self.settings["geometry"] = bytes(self.saveGeometry().toBase64()).decode()
        save_settings(self.settings)
        if self.detail.trailer is not None:
            self.detail.trailer.stop()
        self.hide()
        if balloon and not self.settings.get("tray_hint_shown"):
            self.settings["tray_hint_shown"] = True
            save_settings(self.settings)
            self.tray.showMessage(APP_NAME, "Kura is still running in the tray. Right-click the icon to quit.",
                                  self.windowIcon(), 6000)

    def closeEvent(self, e):
        tray_ok = QSystemTrayIcon.isSystemTrayAvailable() and self.tray.isVisible()
        if not self.quitting and tray_ok:
            action = self.settings.get("close_action", "ask")
            if action == "ask":
                e.ignore()
                if self.isMinimized() or not self.isVisible():
                    self.show_window()
                self.close_overlay.open()
                return
            if action == "tray":
                e.ignore()
                notice = self.settings.get("close_tray_notice", True) and self.isVisible()
                screen = self.screen()
                self.to_tray(balloon=not notice)
                if notice:   # the window is gone; a notification at the corner offers Quit / Open
                    self.tray_notice.start(screen)
                return
        if self.job is not None:
            QMessageBox.information(self, APP_NAME, "A job is still running. Wait for it to finish before closing.")
            e.ignore()
            return
        self.tray_notice.hide()
        self.close_player()
        if self.player_thumbs is not None:
            self.player_thumbs.requestInterruption()
            self.player_thumbs.wake.set()
            self.player_thumbs.wait(25000)
        self.downloads.stop()
        self.previews.shutdown()
        self.settings_page.save_dirty()
        self.home.shutdown()
        self.detail.shutdown()
        self.stats.shutdown()
        self.watchlog.save()
        self.tools.crunchy.shutdown()
        self.tools.subtool.shutdown()
        for t in (self.tools.health, self.tools.storage, self.tools.upgrades, self.tools.order, self.tools.backups,
                  self.tools.captures):
            t.shutdown()
        self.kickoff.shutdown()
        self.livetv.shutdown()
        if getattr(self, "sequel_call", None) is not None:
            self.sequel_call.wait(60000)
        if APP.get("subprev") is not None:
            APP["subprev"].requestInterruption()
            APP["subprev"].wake.set()
            APP["subprev"].wait(5000)
        if self.settings_page.cr_signer is not None:
            self.settings_page.cr_signer.wait(5000)
        self.now_playing.shutdown()   # clears your Discord status
        self.account.flush()   # send list edits that are still waiting
        for s in (list(self.library.scanners) + list(self.detail.loaders)
                  + list(self.todo.fetchers) + list(self.schedule.fetchers) + list(self.library.fetchers)
                  + list(self.seasonal.loaders) + list(self.seasonal.fetchers) + list(self.torrents.loaders)
                  + list(self.torrents.prefetchers) + [t for t in [self.torrents.catchup] if t is not None]):
            s.requestInterruption()
            s.wait(2000)
        self.settings["geometry"] = bytes(self.saveGeometry().toBase64()).decode()
        save_settings(self.settings)
        if self.detail.trailer is not None:
            self.detail.trailer.stop()
        shut_down_trailers()
        self.tray.hide()
        super().closeEvent(e)
        if getattr(self, "restart_after", False):   # a restore: the new Kura waits for this one to be gone
            from PySide6.QtCore import QProcess
            if FROZEN:
                QProcess.startDetached(sys.executable, ["--restart"])
            else:
                pyw = Path(sys.executable).with_name("pythonw.exe")
                QProcess.startDetached(str(pyw if pyw.exists() else sys.executable),
                                       [str(Path(__file__).resolve()), "--restart"])
        klog.info("Kura closed" + (" (restarting)" if getattr(self, "restart_after", False) else ""))
        QApplication.quit()

    def restart(self):
        """Close and open again (a restore puts the files back in between)."""
        if self.job is not None:
            QMessageBox.information(self, APP_NAME, "A job is still running. The restore happens the next time Kura "
                                                    "starts.")
            return
        self.restart_after = True
        self.quit_app()
        if self.isVisible():   # something kept Kura open
            self.restart_after = False

    def auto_backup(self):
        """The weekly backup (checked a minute after starting and every 6 h)."""
        if SELFTEST or not self.settings.get("backup_auto", True):
            return
        if backup_mod.due(self.settings.get("backup_last")):
            self.tools.backups.make("auto")

    # ---- updates (GitHub Releases, updater.py)
    def auto_update_check(self):
        """Once a day (checked after starting and every 6 h), when Settings → App → Updates is on."""
        if (SELFTEST or not FROZEN or not UPDATE_REPO or not self.settings.get("update_auto", True)
                or time.time() - (self.settings.get("update_checked") or 0) < 20 * 3600):
            return
        self.check_updates()

    def check_updates(self, manual=False, quiet=False):
        """Ask GitHub for the newest release. New: a note in the bell (manual: the update window at once; quiet,
        from Settings → About: only About's card says what was found)."""
        if not UPDATE_REPO:
            if manual:
                self.notify("Updates aren't set up in this copy of Kura", keep=False)
            return
        if getattr(self, "update_job", None) is not None:
            return
        self.update_job = BgCall(lambda: upd_mod.latest_release(UPDATE_REPO))

        def done(rel, err):
            self.update_job.wait()
            self.update_job = None
            self.settings["update_checked"] = time.time()
            save_settings(self.settings)
            sp = self.settings_page
            if err or not rel:
                sp.set_update_state("error", str(err) if err else "no updates published yet")
                if manual and not quiet:
                    self.notify(f"Couldn't check for updates: {err}" if err else "No updates published yet",
                                keep=False)
                return
            self.latest_release = rel
            if not upd_mod.is_newer(rel["version"], APP_VERSION):
                sp.set_update_state("latest")
                if manual and not quiet:
                    self.notify(f"Kura {APP_VERSION} is the newest version", keep=False)
                return
            sp.set_update_state("available", rel)
            if quiet:
                return
            if manual:
                UpdateDialog(self, rel).exec()
            elif self.settings.get("update_noted") != rel["version"]:   # one note per version
                self.settings["update_noted"] = rel["version"]
                save_settings(self.settings)
                self.remember_note(f"Kura {rel['version']} is available", "kura", button="See what's new",
                                   sub=f"You have {APP_VERSION}", act={"update": True},
                                   run=lambda r=rel: UpdateDialog(self, r).exec())
        self.update_job.done.connect(done)
        self.update_job.start()


class UpdateDialog(QDialog):
    """A new Kura: what's new, then Update now: a backup of your data, the download (only what changed, each file
    checked), then Kura closes, the files are swapped (updater.apply_script) and it opens again."""
    progress = Signal(object, object)   # bytes done, total (can pass 2 GB)

    def __init__(self, win, rel):
        super().__init__(win)
        self.win, self.rel, self.job, self.cancelled = win, rel, None, False
        self.setWindowTitle("Update Kura")
        self.resize(580, 540)
        v = QVBoxLayout(self)
        v.setContentsMargins(22, 20, 22, 18)
        v.setSpacing(10)
        v.addWidget(label(f"Kura {rel['version']}", "h2"))
        size = upd_mod.download_size(rel["manifest"], SCRIPT_DIR) / 2 ** 20
        v.addWidget(label(f"You have {APP_VERSION}. The download is {size:.0f} MB. Your settings, lists, history and "
                          "library aren't touched, and they're backed up first.", "muted", wrap=True))
        notes = QTextBrowser()
        notes.setOpenExternalLinks(True)
        notes.setMarkdown(rel.get("notes") or "No notes for this version.")
        v.addWidget(notes, 1)
        self.bar = QProgressBar()
        self.bar.setRange(0, 1000)
        self.bar.setTextVisible(False)
        self.bar.hide()
        v.addWidget(self.bar)
        self.status = label("", "faint", wrap=True)
        v.addWidget(self.status)
        row = QHBoxLayout()
        if rel.get("url"):
            web = LinkButton("On GitHub  ›")
            web.clicked.connect(lambda: webbrowser.open(rel["url"]))
            row.addWidget(web)
        row.addStretch(1)
        later = QPushButton("Later")
        later.clicked.connect(self.reject)
        self.ok = QPushButton("Update now")
        self.ok.setObjectName("primary")
        self.ok.clicked.connect(self.start)
        row.addWidget(later)
        row.addWidget(self.ok)
        v.addLayout(row)
        self.progress.connect(self.on_progress)
        if not FROZEN:
            self.ok.setEnabled(False)
            self.status.setText("Updates install into Kura.exe. This is the script version: update it with git pull.")

    def start(self):
        if self.win.job is not None:
            self.status.setText("The organizer is running. Update when it's done.")
            return
        self.ok.setEnabled(False)
        self.bar.show()
        self.status.setText("Backing up your data…")
        manifest, settings = self.rel["manifest"], self.win.settings

        def work():
            backup_mod.make(SCRIPT_DIR, backup_dir(settings), "update")
            stage = upd_mod.prepare(manifest, SCRIPT_DIR, progress=self.progress.emit, cancelled=lambda: self.cancelled)
            new_runtime = (stage / "new" / upd_mod.RUNTIME / upd_mod.RUNTIME_ID_FILE).exists()
            return upd_mod.apply_script(SCRIPT_DIR, stage, os.getpid(), SCRIPT_DIR / "Kura.exe",
                                        upd_mod.scripts_to_replace(manifest, SCRIPT_DIR), new_runtime)
        self.job = BgCall(work)
        self.job.done.connect(self.on_done)
        self.job.start()

    def on_progress(self, done, total):
        self.bar.setValue(int(1000 * done / max(1, total)))
        self.status.setText(f"Downloading… {done / 2 ** 20:.0f} of {total / 2 ** 20:.0f} MB")

    def on_done(self, script, err):
        self.job.wait()
        self.job = None
        if err:
            if not self.cancelled:
                self.status.setText(f"The update didn't download: {err}. Nothing was changed.")
                self.ok.setText("Try again")
                self.ok.setEnabled(True)
            return
        klog.info(f"Update to {self.rel['version']}: downloaded, restarting to install")
        self.status.setText("Restarting Kura to finish the update…")
        upd_mod.launch_apply(script)
        QTimer.singleShot(300, self.win.quit_app)
        self.accept()

    def reject(self):
        if self.job is not None:   # stop the download first
            self.cancelled = True
            self.job.wait()
        super().reject()


