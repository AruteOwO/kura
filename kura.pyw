    def showEvent(self, e):
        super().showEvent(e)
        if self.sizer is None and self.job is None:
            self.load()

    def load(self):
        shows = library_shows(self.library)
        self.show_drive()
        self.summary.setText("Measuring your shows…")
        self.sizer = BgCall(lambda: stats_mod.library_sizes([s["folder"] for s in shows]))
        self.sizer.done.connect(lambda sizes, err: self.on_sizes(shows, sizes or {}))
        self.sizer.start()

    def show_drive(self):
        lib = (self.settings.get("library") or "").strip()
        try:
            du = shutil.disk_usage(lib)
        except OSError:
            self.drive.hide()
            return
        self.drive.show()
        drive = Path(lib).anchor
        self.drive_text.setText(f"{drive}  ·  {human(du.used)} used of {human(du.total)}  ·  {human(du.free)} free")
        self.drive_bar.setRange(0, 1000)
        self.drive_bar.setValue(int(du.used / du.total * 1000))

    def last_watched(self):
        """{show folder: last time Kura's player had one of its episodes}"""
        state = _read_json(PLAYBACK_STATE_FILE) or {}
        out = {}
        folders = list(getattr(self.library, "items", {}) or {})
        for path, v in state.items():
            for f in folders:
                if path.startswith(f + os.sep):
                    out[f] = max(out.get(f, 0), (v or {}).get("t", 0))
                    break
        return out

    def on_sizes(self, shows, sizes):
        self.sizer.wait()
        self.sizer = None
        self.sizes = sizes
        watched = self.last_watched()
        self.tree.blockSignals(True)
        self.tree.setSortingEnabled(False)
        self.tree.clear()
        a = self.account
        for s in shows:
            size = sizes.get(s["folder"], 0)
            idx = s["index"] or {}
            eps = sum(len(v) for v in (idx.get("local") or {}).values())
            statuses = [((a.entry(m) or {}).get("status") if a and a.connected else None) for m in idx.get("seasons") or []]
            statuses = [x for x in statuses if x]
            status = ("Completed" if statuses and all(x == "COMPLETED" for x in statuses) else
                      acct.STATUS_NAMES.get(statuses[0], statuses[0]) if statuses else "")
            last = watched.get(s["folder"])
            old = not last or time.time() - last > 60 * 86400
            suggest = status == "Completed" and old
            it = SortItem([s["name"], human(size), str(eps) if eps else "", status,
                           time.strftime("%d %b %Y", time.localtime(last)) if last else "Not in Kura",
                           "Finished with?" if suggest else ""])
            it.setData(1, Qt.UserRole, size)
            it.setData(2, Qt.UserRole, eps)
            it.setData(4, Qt.UserRole, last or 0)
            it.setData(0, Qt.UserRole + 1, s["folder"])
            it.setFlags(it.flags() | Qt.ItemIsUserCheckable)
            it.setCheckState(0, Qt.Unchecked)
            if suggest:
                it.setForeground(5, QColor(C["ok"]))
                it.setToolTip(5, "Completed on your list and not watched in Kura for 2 months")
            self.tree.addTopLevelItem(it)
        self.tree.setSortingEnabled(True)
        self.tree.sortItems(1, Qt.DescendingOrder)
        self.tree.blockSignals(False)
        total = sum(sizes.values())
        self.summary.setText(f"{len(shows)} shows · {human(total)}")
        self.update_buttons()

    def ticked(self):
        out = []
        for i in range(self.tree.topLevelItemCount()):
            it = self.tree.topLevelItem(i)
            if it.checkState(0) == Qt.Checked:
                out.append(it.data(0, Qt.UserRole + 1))
        return out

    def update_buttons(self):
        t = self.ticked()
        busy = self.job is not None
        self.move_btn.setEnabled(bool(t) and not busy)
        self.bin_btn.setEnabled(bool(t) and not busy)
        if t:
            self.summary.setText(f"{len(t)} ticked · {human(sum(self.sizes.get(f, 0) for f in t))}")

    def recycle_ticked(self):
        t = self.ticked()
        size = sum(self.sizes.get(f, 0) for f in t)
        if QMessageBox.question(self, "Storage", f"Send {len(t)} show{'s' if len(t) != 1 else ''} ({human(size)}) to "
                                "the Recycle Bin?\n\n" + "\n".join(Path(f).name for f in t[:10]) +
                                "\n\nThey stay in the Recycle Bin until you empty it (Windows asks first if "
                                "something is too big for it).") != QMessageBox.Yes:
            return
        err = recycle(t)
        if err:
            QMessageBox.warning(self, "Storage", err)
        else:
            self.notify.emit(f"Sent {len(t)} show{'s' if len(t) != 1 else ''} to the Recycle Bin")
        self.library_changed.emit()
        QTimer.singleShot(1500, self.load)

    def move_ticked(self):
        t = self.ticked()
        dest = QFileDialog.getExistingDirectory(self, "Move the shows to…", self.settings.get("storage_archive", ""))
        if not dest:
            return
        if os.path.normcase(os.path.abspath(dest)).startswith(os.path.normcase(os.path.abspath(
                self.settings.get("library") or "?"))):
            QMessageBox.information(self, "Storage", "Pick a folder outside your library.")
            return
        self.settings["storage_archive"] = dest
        save_settings(self.settings)
        size = sum(self.sizes.get(f, 0) for f in t)
        try:
            free = shutil.disk_usage(dest).free
        except OSError as e:
            QMessageBox.warning(self, "Storage", str(e))
            return
        if free < size * 1.02:
            QMessageBox.warning(self, "Storage", f"Not enough space there ({human(free)} free, {human(size)} needed).")
            return
        clash = [f for f in t if (Path(dest) / Path(f).name).exists()]
        if clash:
            QMessageBox.warning(self, "Storage", "Already there: " + ", ".join(Path(f).name for f in clash[:5]))
            return
        self.busy.setRange(0, len(t))
        self.busy.setValue(0)
        self.busy.show()
        bar = self.busy

        def work():
            done = []
            for n, f in enumerate(t):
                shutil.move(f, str(Path(dest) / Path(f).name))
                done.append(f)
                QTimer.singleShot(0, bar, lambda n=n: bar.setValue(n + 1))
            return done
        self.job = BgCall(work)
        self.job.done.connect(lambda done, err: self.on_moved(done or [], err, dest))
        self.job.start()
        self.update_buttons()

    def on_moved(self, done, err, dest):
        self.job.wait()
        self.job = None
        self.busy.hide()
        if err:
            QMessageBox.warning(self, "Storage", f"Stopped: {err}")
        if done:
            self.notify.emit(f"Moved {len(done)} show{'s' if len(done) != 1 else ''} to {dest}")
        self.library_changed.emit()
        QTimer.singleShot(1500, self.load)

    def shutdown(self):
        for w in (self.job, self.sizer):
            if w is not None:
                w.wait(60000)


class SortItem(QTreeWidgetItem):
    """Sorts by the number in Qt.UserRole when a column has one (sizes, counts, dates)."""

    def __lt__(self, other):
        col = self.treeWidget().sortColumn() if self.treeWidget() else 0
        a, b = self.data(col, Qt.UserRole), other.data(col, Qt.UserRole)
        if isinstance(a, (int, float)) and isinstance(b, (int, float)):
            return a < b
        return self.text(col).lower() < other.text(col).lower()


BD_WORDS = re.compile(r"\b(BD|BDRip|BluRay|Blu-?Ray|BDMV|BDRemux)\b", re.I)


class UpgradeTool(QWidget):
    """Tools → Upgrade finder: shows you have as web releases (TV airings) that now have Blu-ray batches on Nyaa."""
    back = Signal()
    find_torrents = Signal(str)
    CACHE = SCRIPT_DIR / "upgrades_cache.json"
    COLS = ["Show", "You have", "Best Blu-ray batch on Nyaa", "Size", "Seeders", ""]

    def __init__(self, library, account):
        super().__init__()
        self.library, self.account, self.job, self.cancel = library, account, None, False
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
        tool_top(v, "Upgrade finder", "Shows you have as web (TV broadcast) releases that have finished airing: "
                 "Kura looks for Blu-ray batches on Nyaa (better picture, often fixed animation). Nothing is "
                 "downloaded; Find opens the search in Torrents.", self.back)
        row = QHBoxLayout()
        self.status = label("", "muted", wrap=True)
        row.addWidget(self.status, 1)
        self.bar = QProgressBar()
        self.bar.setFixedWidth(200)
        self.bar.hide()
        row.addWidget(self.bar)
        self.run_btn = QPushButton(" Look for Blu-rays")
        self.run_btn.setObjectName("primary")
        self.run_btn.setIcon(glyph_icon("search", "white"))
        self.run_btn.clicked.connect(self.run)
        row.addWidget(self.run_btn)
        v.addLayout(row)
        self.tree = QTreeWidget()
        self.tree.setObjectName("torrents")
        self.tree.setColumnCount(len(self.COLS))
        self.tree.setHeaderLabels(self.COLS)
        self.tree.setRootIsDecorated(False)
        hd = self.tree.header()
        hd.setStretchLastSection(False)
        hd.setSectionResizeMode(QHeaderView.ResizeToContents)
        hd.setSectionResizeMode(2, QHeaderView.Stretch)
        hd.setSectionResizeMode(5, QHeaderView.Fixed)
        self.tree.setColumnWidth(5, 96)
        v.addWidget(self.tree, 1)
        cached = _read_json(self.CACHE) or {}
        self.results = cached.get("results") or []
        self.when = cached.get("t")
        self.fill()

    def candidates(self):
        """Library shows whose files are web releases and whose AniList entries have all finished airing."""
        out = []
        for s in library_shows(self.library):
            idx = s["index"] or {}
            files = [f for eps in (idx.get("local") or {}).values() for f in eps.values()]
            if not files or any(BD_WORDS.search(Path(f).name) for f in files):
                continue
            seasons = [m for m in idx.get("seasons") or [] if m]
            media = [media_for(m, self.account) for m in seasons]
            if not media or any((m or {}).get("status") != "FINISHED" for m in media):
                continue
            groups = sorted({m.group(1) for f in files[:30] if (m := re.match(r"^\[([^\]]+)\]", Path(f).name))})
            for n, (m, sid) in enumerate(zip(media, seasons), 1):
                t = (m or {}).get("title") or {}
                title = t.get("romaji") or t.get("english") or s["name"]
                have = sum(len(v) for k, v in (idx.get("local") or {}).items() if k == sid)
                if have:
                    out.append({"show": s["name"] + (f" · Season {n}" if len(seasons) > 1 else ""), "title": title,
                                "season": n, "have": f"{have} ep · " + (", ".join(groups[:2]) or "web")})
        return out

    @staticmethod
    def fits_season(release, n):
        """A later season's upgrade has to say it's that season (Spy x Family Season 3 matched the 1-2 batch)."""
        if n <= 1:
            return True
        words = {2: "2nd", 3: "3rd"}.get(n, f"{n}th")
        return bool(re.search(rf"(\bS0?{n}\b|\bS0?{n}E|Season {n}\b|{words} Season|\bS0?\d[-~]S0?{n}\b|"
                              rf"\bS0?[1-{max(1, n - 1)}][-~]S?0?(?:[{n}-9]))", release, re.I))

    def run(self):
        if self.job is not None:
            self.cancel = True
            return
        todo = self.candidates()
        if not todo:
            self.status.setText("No finished shows with web releases in your library.")
            return
        self.cancel = False
        self.bar.setRange(0, len(todo))
        self.bar.setValue(0)
        self.bar.show()
        self.run_btn.setText(" Stop")
        bar = self.bar

        def work():
            out = []
            for n, c in enumerate(todo):
                if self.cancel:
                    break
                url = ("https://nyaa.si/?page=rss&f=0&c=1_2&s=seeders&o=desc&q=" +
                       urllib.parse.quote(f"{c['title']} (BD|BluRay|Blu-ray) 1080p"))
                best = None
                try:
                    items, _, _ = tor.fetch_nyaa_page(url)
                    for it in items:
                        t = it["title"]
                        if not BD_WORDS.search(t) or it.get("remake") or it.get("seeders", 0) < 1:
                            continue
                        if not re.search(r"\b(batch|complete|\d{1,2}\s*[-~]\s*\d{1,3}|S\d{2}\b(?!E))", t, re.I):
                            continue   # single episodes aren't an upgrade for a whole season
                        if not self.fits_season(t, c.get("season", 1)):
                            continue
                        best = it
                        break
                except Exception:
                    pass
                out.append({**c, "best": best})
                QTimer.singleShot(0, bar, lambda n=n: bar.setValue(n + 1))
                time.sleep(1.2)   # gentle with Nyaa
            return out
        self.status.setText(f"Searching Nyaa for {len(todo)} season{'s' if len(todo) != 1 else ''}…")
        self.job = BgCall(work)
        self.job.done.connect(self.on_done)
        self.job.start()

    def on_done(self, results, err):
        self.job.wait()
        self.job = None
        self.bar.hide()
        self.run_btn.setText(" Look for Blu-rays")
        if err:
            self.status.setText(f"Couldn't finish: {err}")
            return
        self.results, self.when = results or [], time.time()
        try:
            self.CACHE.write_text(json.dumps({"t": self.when, "results": self.results}), encoding="utf-8")
        except OSError:
            pass
        self.fill()

    def fill(self):
        self.tree.clear()
        found = [r for r in self.results if r.get("best")]
        for r in sorted(found, key=lambda r: -r["best"].get("seeders", 0)):
            b = r["best"]
            it = QTreeWidgetItem([r["show"], r["have"], b["title"], b.get("size", ""), str(b.get("seeders", 0)), ""])
            it.setToolTip(2, b["title"])
            self.tree.addTopLevelItem(it)
            btn = QPushButton(" Find")
            btn.setObjectName("ghost")
            btn.setIcon(glyph_icon("search", C["text"]))
            btn.clicked.connect(lambda _=False, q=f"{r['title']} BD 1080p": self.find_torrents.emit(q))
            self.tree.setItemWidget(it, 5, btn)
        if self.when:
            missing = len(self.results) - len(found)
            self.status.setText(f"Checked {len(self.results)} finished season{'s' if len(self.results) != 1 else ''} "
                                f"you have as web releases · {time.strftime('%d %b %H:%M', time.localtime(self.when))}"
                                f" · {len(found)} with a Blu-ray batch" + (f", {missing} without (yet)" if missing else ""))
        else:
            self.status.setText("Press Look for Blu-rays: one Nyaa search per finished season you have as a web "
                                "release (about a second each).")

    def shutdown(self):
        if self.job is not None:
            self.cancel = True
            self.job.wait(30000)


class WatchOrderTool(QWidget):
    """Tools → Watch order: a franchise's entries in release order, main story marked, what you have/watched."""
    back = Signal()
    open_media = Signal(int, str, object)
    REL = {"This show": "", "PREQUEL": "Main story", "SEQUEL": "Main story", "PARENT": "Main story",
           "SIDE_STORY": "Side story", "SUMMARY": "Recap", "SPIN_OFF": "Spin-off", "ALTERNATIVE": "Alternative"}

    def __init__(self, library, account):
        super().__init__()
        self.library, self.account, self.job, self.entries = library, account, None, []
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
        tool_top(v, "Watch order", "A franchise in release order, from AniList's relations: the main story "
                 "(prequels and sequels) marked, side stories, movies and OVAs where they came out. AniList doesn't "
                 "record story-chronological order, so this is the order they were released.", self.back)
