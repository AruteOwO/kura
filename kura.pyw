class TrailerVideo(QWidget):
    """One video surface for trailers and clips, with either engine: YouTube's embedded player
    (Kura's web view) or mpv (yt-dlp finds the stream; a local file plays directly)."""
    started = Signal()          # the picture is moving
    failed = Signal(str)
    ended = Signal()
    fullscreen_requested = Signal()
    activity = Signal()         # the mouse moved over the video (interactive: shows the controls)

    def __init__(self, settings, parent=None, loop=True, interactive=False):
        super().__init__(parent)
        self.settings, self.loop, self.interactive = settings, loop, interactive
        self.setAttribute(Qt.WA_StyledBackground)
        self.setStyleSheet("background: black;")
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.web = self.mpvw = None
        self.token, self.calls, self.pending = 0, set(), None
        self.muted, self.volume, self.playing, self.web_started_at = True, 60, False, 0
        self.poll = QTimer(self, interval=120, timeout=self._poll)
        self.ramp = QTimer(self, interval=40, timeout=self._ramp)
        self.ramp_to = 0
        self.watchdog = QTimer(self, singleShot=True, interval=25000, timeout=lambda: self._fail("took too long"))
        if not interactive:
            self.setAttribute(Qt.WA_TransparentForMouseEvents)

    # ---- starting
    def play_trailer(self, trailer, muted, volume):
        self.stop()
        tok = self.token
        self.muted, self.volume = muted, volume
        self.trailer = trailer
        self.watchdog.start()
        if trailer_engine() == "mpv":
            hit = trl.cached(trailer)
            if hit:
                self._mpv_load(hit["video"], hit.get("audio"))
                return
            call = BgCall(lambda: trl.resolve(trailer))
            call.done.connect(lambda res, err, t=tok, c=call: self._resolved(t, c, res, err))
            self.calls.add(call)
            call.start()
        else:
            self._web_load(trl.embed_url(trailer, muted=muted, controls=self.interactive, loop=self.loop))

    def play_clip(self, path, start="25%", length=45):
        """A muted moment from your own episode (no trailer to show)."""
        self.stop()
        self.muted, self.trailer = True, None
        self.watchdog.start()
        self._mpv_load(str(path), None, start=start, length=length)

    def _resolved(self, tok, call, res, err):
        call.wait()
        self.calls.discard(call)
        if tok != self.token:
            return
        if err:
            self._fail(err)
            return
        self._mpv_load(res["video"], res.get("audio"))

    def _fail(self, err):
        if self.playing:
            return
        self.watchdog.stop()
        self.poll.stop()
        self.failed.emit(err)

    # ---- mpv
    def _mpv(self):
        if self.mpvw is None:
            mod = player_mod.load_mpv(mpv_dirs())
            hw = self.settings.get("player_hwdec", True)
            self.mpvw = player_mod.MpvWidget(
                mod, self, keep_open="yes", input_default_bindings=False, osc=False, input_vo_keyboard=False,
                hwdec="auto-copy-safe" if hw else "no", vf="format=yuv420p10", ytdl=False, sub_visibility=False,
                volume=0, volume_max=130, audio_display="no", demuxer_max_bytes="64MiB")
            self.mpvw.ready.connect(self._flush)
            if not self.interactive:
                self.mpvw.setAttribute(Qt.WA_TransparentForMouseEvents)
            else:
                self.mpvw.setMouseTracking(True)
            self.mpvw.installEventFilter(self)
            self.lay.addWidget(self.mpvw)
        return self.mpvw

    def _mpv_load(self, url, audio, start=None, length=None):
        w = self._mpv()
        self._show(w)
        self.pending = (url, audio, start, length)
        if w.ctx is not None:
            self._flush()

    def _flush(self):
        if self.pending is None or self.mpvw is None or self.mpvw.ctx is None:
            return
        url, audio, start, length = self.pending
        self.pending = None
        m = self.mpvw.mpv
        try:
            m["audio-files"] = [audio] if audio else []   # (a property: stream URLs can contain commas)
            m.loop_file = "inf" if self.loop else "no"
            m.mute = self.muted
            m.volume = 0 if not self.muted else self.volume
            opts = {}
            if start:
                opts["start"] = start
            if length:
                opts["length"] = str(length)
            m.loadfile(url, **opts)
        except Exception as e:
            self._fail(str(e))
            return
        self.playing = False
        self.poll.start()

    def _poll(self):
        if self.mpvw is None:
            return
        m = self.mpvw.mpv
        try:
            pos, idle, eof = m.time_pos, m.core_idle, m.eof_reached
        except Exception:
            return
        if not self.playing and pos is not None and not idle:
            self.playing = True
            self.watchdog.stop()
            self.started.emit()
            if not self.muted:
                self.ramp_to = self.volume
                self.ramp.start()
        elif self.playing and eof and not self.loop:
            self.poll.stop()
            self.ended.emit()

    def _ramp(self):
        """The sound comes up over half a second instead of all at once."""
        m = self.mpvw.mpv
        v = min(self.ramp_to, (m.volume or 0) + max(2, self.ramp_to // 12))
        m.volume = v
        if v >= self.ramp_to:
            self.ramp.stop()

    # ---- YouTube's player (web)
    def _web_view(self):
        if self.web is None:
            from PySide6.QtWebEngineCore import QWebEnginePage
            from PySide6.QtWebEngineWidgets import QWebEngineView
            view = QWebEngineView(self)
            page = QWebEnginePage(trailer_profile(), view)
            view.setPage(page)
            page.loadFinished.connect(self._web_loaded)
            if not self.interactive:
                view.setAttribute(Qt.WA_TransparentForMouseEvents)
                view.setFocusPolicy(Qt.NoFocus)
            self.lay.addWidget(view)
            self.web = view
        return self.web

    def _web_load(self, url):
        try:
            v = self._web_view()
        except ImportError:
            self._fail("no web engine")
            return
        self._show(v)
        v.page().setAudioMuted(self.muted)
        self.playing = False
        v.load(QUrl(url))

    def _web_loaded(self, ok):
        if self.web is None or self.web.url().toString() == "about:blank":
            return
        tok = self.token
        # YouTube's player needs a moment after the page to start the video
        QTimer.singleShot(1300, lambda: tok == self.token and not self.playing and self._web_started())
        if not self.loop:
            dur = 150000   # can't see the end of a YouTube video: give up the stage after 2.5 min
            QTimer.singleShot(dur, lambda: tok == self.token and self.ended.emit())

    def _web_started(self):
        self.playing = True
        self.watchdog.stop()
        self.started.emit()

    # ---- control
    def _show(self, w):
        for other in (self.web, self.mpvw):
            if other is not None:
                other.setVisible(other is w)

    def set_muted(self, muted):
        self.muted = muted
        if self.web is not None and self.web.isVisible():
            self.web.page().setAudioMuted(muted)
        if self.mpvw is not None and self.mpvw.isVisible():
            m = self.mpvw.mpv
            m.mute = muted
            if not muted and not (m.volume or 0):
                m.volume = self.volume

    def toggle_pause(self):
        if self.mpvw is not None and self.mpvw.isVisible():
            self.mpvw.mpv.pause = not self.mpvw.mpv.pause

    def state(self):
        """(position, duration, paused) while mpv plays, else None."""
        if not self.playing or self.mpvw is None or not self.mpvw.isVisible():
            return None
        m = self.mpvw.mpv
        try:
            return m.time_pos or 0.0, m.duration or 0.0, bool(m.pause)
        except Exception:
            return None

    def seek_to(self, t):
        if self.state() is not None:
            try:
                self.mpvw.mpv.seek(t, "absolute")
            except Exception:
                pass

    def set_volume(self, v):
        """The volume slider: stops the fade-in, and moving it up unmutes."""
        self.volume = v
        self.ramp.stop()
        if self.mpvw is not None and self.mpvw.isVisible():
            m = self.mpvw.mpv
            if self.muted and v > 0:
                self.muted = False
                m.mute = False
            m.volume = v

    def stop(self):
        self.token += 1
        self.pending = None
        self.playing = False
        for t in (self.poll, self.ramp, self.watchdog):
            t.stop()
        if self.mpvw is not None:
            try:
                self.mpvw.mpv.command("stop")
            except Exception:
                pass
        if self.web is not None and self.web.url().toString() not in ("", "about:blank"):
            self.web.load(QUrl("about:blank"))

    def shutdown(self):
        self.stop()
        for c in list(self.calls):
            c.wait(5000)
        if self.mpvw is not None:
            self.mpvw.shutdown()
            self.mpvw = None
        if self.web is not None:
            self.web.load(QUrl("about:blank"))
            self.web = None   # its page goes with the view

    def eventFilter(self, obj, e):
        if self.interactive and obj is self.mpvw:
            if e.type() == QEvent.MouseMove:
                self.activity.emit()
            elif e.type() == QEvent.MouseButtonDblClick:
                self.fullscreen_requested.emit()
                return True
            if e.type() == QEvent.MouseButtonRelease and e.button() == Qt.LeftButton:
                self.toggle_pause()
        return False


class PreviewMedia(QWidget):
    """Top of the preview card: the show's art slowly zooming (Ken Burns), until the video plays over it."""

    def __init__(self, parent, w, h):
        super().__init__(parent)
        self.setFixedSize(w, h)
        self.img, self.t = None, 0.0
        self.fade = None   # colour the bottom fades into (the tinted card's panel)
        self.timer = QTimer(self, interval=33, timeout=self.step)

    def set_image(self, img):
        self.img = img
        self.update()

    def step(self):
        self.t += 0.033
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        r = QRectF(self.rect())
        if self.img is None or self.img.isNull():
            g = QLinearGradient(r.topLeft(), r.bottomRight())
            g.setColorAt(0, QColor(C["surface2"]))
            g.setColorAt(1, QColor(C["accent"]).darker(320))
            p.fillRect(r, g)
            return
        zoom = 1.06 + 0.05 * math.sin(self.t / 4)   # slow drift in and out
        pan = 0.5 + 0.35 * math.sin(self.t / 6)
        iw, ih = self.img.width(), self.img.height()
        scale = max(r.width() / iw, r.height() / ih) * zoom
        sw, sh = r.width() / scale, r.height() / scale
        sx = (iw - sw) * pan
        sy = (ih - sh) * 0.35
        p.drawImage(r, self.img, QRectF(sx, sy, sw, sh))
        if self.fade is not None:
            g = QLinearGradient(r.bottomLeft(), r.topLeft())
            g.setColorAt(0, self.fade)
            end = QColor(self.fade)
            end.setAlpha(0)
            g.setColorAt(0.3, end)
            p.fillRect(r, g)


def mix_color(a, b, f):
    """a blended into b: f = how much of a."""
    a, b = QColor(a), QColor(b)
    return QColor(int(a.red() * f + b.red() * (1 - f)), int(a.green() * f + b.green() * (1 - f)),
                  int(a.blue() * f + b.blue() * (1 - f)))


class PreviewInfo(QWidget):
    """The card's text and buttons. Immersive: over the video on a soft fade. Tinted: a panel under the
    video in a dark shade of the show's cover colour."""
    BASE = QColor(14, 15, 19)

    def __init__(self, parent):
        super().__init__(parent)
        self.mode, self.tint = "immersive", QColor(C["accent"])

    def panel_color(self):
        return mix_color(self.tint, "#16181c", 0.16)

    def paintEvent(self, _):
        p = QPainter(self)
        r = QRectF(self.rect())
        g = QLinearGradient(r.topLeft(), r.bottomLeft())
        if self.mode == "immersive":
            c = mix_color(self.tint, self.BASE, 0.08)
            for stop, alpha in ((0, 0), (0.28, 170), (0.55, 232), (1, 248)):
                c.setAlpha(alpha)
                g.setColorAt(stop, QColor(c))
        else:
            g.setColorAt(0, self.panel_color())
            g.setColorAt(1, mix_color(self.tint, "#121416", 0.07))
        p.fillRect(r, g)


class ThinBar(QWidget):
    """Your progress through the show: a 4 px rounded bar."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(84, 4)
        self.frac, self.color = 0.0, QColor(C["accent"])

    def set(self, frac, color):
        self.frac, self.color = max(0.0, min(1.0, frac)), QColor(color)
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(255, 255, 255, 46))
        p.drawRoundedRect(QRectF(self.rect()), 2, 2)
        if self.frac > 0:
            p.setBrush(self.color)
            p.drawRoundedRect(QRectF(0, 0, max(4.0, self.width() * self.frac), self.height()), 2, 2)


class CardShadow(QWidget):
    """A soft shadow under the preview card (a graphics effect can't be used: the card holds a video surface)."""
    SPREAD = 26

    def __init__(self, parent):
        super().__init__(parent)
        self.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.hide()

    def follow(self, card):
        s = self.SPREAD
        self.setGeometry(card.geometry().adjusted(-s, -s + 8, s, s + 14))
        self.stackUnder(card)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        s = self.SPREAD
        inner = QRectF(self.rect()).adjusted(s, s - 8, -s, -s - 14)
        for i in range(s, 0, -2):   # layered rounded rects, fainter outwards
            p.setBrush(QColor(0, 0, 0, int(46 * (1 - i / s) ** 2) + 2))
            p.drawRoundedRect(inner.adjusted(-i, -i + 6, i, i + 6), 14 + i, 14 + i)


def round_button(parent, size, primary=False):
    b = QPushButton(parent)
    b.setFixedSize(size, size)
    b.setCursor(Qt.PointingHandCursor)
    rad = size // 2
    flat = "padding: 0px; margin: 0px;"   # no app button padding: it squeezes the icon out
    if primary:
        b.setStyleSheet(f"QPushButton {{ background: #ffffff; border: none; border-radius: {rad}px; {flat} }}"
                        f"QPushButton:hover {{ background: #dfe0ea; }}")
    else:
        b.setStyleSheet(f"QPushButton {{ background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);"
                        f" border-radius: {rad}px; {flat} }} QPushButton:hover {{ background: rgba(255,255,255,0.24); }}")
    b.setIconSize(QSize(size // 2 - 4, size // 2 - 4))
    return b


class PreviewCard(QFrame):
    """The hover preview: trailer (or a clip, or the art zooming), title, details, synopsis, buttons.
    Two looks (`preview_style`): "immersive" = the video fills the card and the info sits on a fade over
    it; "tinted" = video on top, a panel in the cover's colour under it with the details as chips."""
    W, RADIUS = 420, 14
    MEDIA_H = {"immersive": 300, "tinted": 236}

    def __init__(self, host, ctl):
        super().__init__(host)
        self.ctl = ctl
        self.setObjectName("previewcard")
        self.setAttribute(Qt.WA_StyledBackground)
        self.setStyleSheet("#previewcard { background: #121418; border: none; }")
        self.setFixedWidth(self.W)
        self.setCursor(Qt.PointingHandCursor)
        self.shadow = CardShadow(host)
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.lay.setSpacing(0)
        self.media = PreviewMedia(self, self.W, self.MEDIA_H["tinted"])
        self.lay.addWidget(self.media)
        self.video = TrailerVideo(ctl.settings, self.media, loop=True)
        self.video.setGeometry(0, 0, 1, 1)
        self.video.started.connect(self.on_started)
        self.video.failed.connect(self.on_failed)
        self.mute_btn = QPushButton(self.media)
        self.mute_btn.setCursor(Qt.PointingHandCursor)
        self.mute_btn.clicked.connect(self.toggle_mute)
        self.mute_btn.setFixedSize(32, 32)
        self.mute_btn.setIconSize(QSize(14, 14))
        self.mute_btn.setStyleSheet("QPushButton { background: rgba(0,0,0,0.5); border: none; border-radius: 16px;"
                                    " padding: 0px; }"
                                    "QPushButton:hover { background: rgba(0,0,0,0.72); }")

        self.info = PreviewInfo(self)
        self.info_lay = info = QVBoxLayout(self.info)
        info.setSpacing(4)
        self.title = QLabel()
        self.title.setWordWrap(True)
        self.title.setStyleSheet("color: #ffffff; font-size: 13pt; font-weight: 700; background: transparent;")
        info.addWidget(self.title)
        self.meta = QLabel()
        self.meta.setWordWrap(True)
        self.meta.setTextFormat(Qt.RichText)
        self.meta.setStyleSheet("color: #c9cad6; font-size: 9pt; background: transparent;")
        info.addWidget(self.meta)
        self.chips = QWidget()
        self.chips_lay = QHBoxLayout(self.chips)
        self.chips_lay.setContentsMargins(0, 4, 0, 0)
        self.chips_lay.setSpacing(6)
        info.addWidget(self.chips)
        self.synopsis = QLabel()
        self.synopsis.setWordWrap(True)
        self.synopsis.setStyleSheet("color: #c3c4cf; font-size: 9.5pt; background: transparent;")
        info.addSpacing(4)
        info.addWidget(self.synopsis)
        info.addSpacing(8)
        row = QHBoxLayout()
        row.setSpacing(10)
        self.play_btn = round_button(self.info, 42, primary=True)
        self.play_btn.setIcon(glyph_icon("\uF5B0", "#111111", "#111111", px=15))   # solid play
        self.play_btn.clicked.connect(self.play)
        self.list_btn = round_button(self.info, 38)
        self.list_btn.clicked.connect(self.list_menu)
        self.show_btn = round_button(self.info, 38)
        self.show_btn.setIcon(glyph_icon("\uE946", "white", "white", px=15))
        self.show_btn.setToolTip("Open the show")
        self.show_btn.clicked.connect(self.open_show)
        for b in (self.play_btn, self.list_btn, self.show_btn):
            row.addWidget(b)
        row.addStretch(1)
        self.prog_lbl = QLabel()
        self.prog_lbl.setStyleSheet("color: #d6d7e0; font-size: 9pt; background: transparent;")
        self.prog_bar = ThinBar()
        row.addWidget(self.prog_lbl)
        row.addWidget(self.prog_bar)
        info.addLayout(row)
        self.lay.addWidget(self.info)

        self.style_name = None
        self.target, self.m, self.play_path, self.anim, self.show_path = None, {}, None, None, None
        self.img_call = None
        self.apply_style("immersive")
        self.hide()

    # ---- the two looks
    def apply_style(self, style):
        if style not in self.MEDIA_H:
            style = "immersive"
        if style == self.style_name:
            return
        self.style_name = style
        mh = self.MEDIA_H[style]
        self.media.setFixedSize(self.W, mh)
        self.mute_btn.move(self.W - 42, 10)
        self.info.mode = style
        if style == "immersive":
            self.lay.removeWidget(self.info)
            self.info.setParent(self.media)
            self.info_lay.setContentsMargins(18, 56, 18, 16)
            self.media.fade = None
        else:
            self.info.setParent(self)
            self.lay.addWidget(self.info)
            self.info_lay.setContentsMargins(18, 12, 18, 16)
        self.meta.setVisible(style == "immersive")
        self.chips.setVisible(style == "tinted")
        self.info.show()

    def set_width(self, w):
        """420 px over posters; a bit wider than a wide card (Seasonal) so it grows out of it."""
        self.W = w
        self.media.setFixedSize(w, self.MEDIA_H[self.style_name])
        self.mute_btn.move(w - 42, 10)

    def place_info(self):
        """Immersive: the info sits at the bottom of the video."""
        if self.style_name != "immersive":
            return
        mh = self.media.height()
        h = min(mh, self.info_lay.totalHeightForWidth(self.W))   # wrapped text: its real height at this width
        self.info.setGeometry(0, mh - h, self.W, h)
        self.info.raise_()
        self.mute_btn.raise_()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), self.RADIUS, self.RADIUS)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))
        self.shadow.follow(self)

    def moveEvent(self, e):
        super().moveEvent(e)
        self.shadow.follow(self)

    def showEvent(self, e):
        super().showEvent(e)
        self.shadow.follow(self)
        self.shadow.show()

    def hideEvent(self, e):
        super().hideEvent(e)
        self.shadow.hide()

    # ---- opening
    def open(self, target, details):
        self.target = target
        self.apply_style(self.ctl.settings.get("preview_style", "immersive"))
        host = self.parentWidget()
        src = target["rect"].translated(-host.mapToGlobal(QPoint(0, 0)))
        wide = src.width() > src.height()   # a landscape card (Seasonal) rather than a poster
        self.set_width(max(PreviewCard.W, src.width() + 28) if wide else PreviewCard.W)
        self.fill(details)
        self.place_info()
        self.adjustSize()
        w, h = self.W, self.sizeHint().height()
        pages = self.ctl.window.pages
        left = pages.mapTo(host, QPoint(0, 0)).x() + 12   # stays over the page, not the sidebar
        x = max(left, min(src.center().x() - w // 2, host.width() - w - 12))
        top = src.center().y() - h // 2 if wide else src.top() - 16   # wide cards: centred on the card
        y = max(12, min(top, host.height() - h - 12))
        end = QRect(x, y, w, h)
        # grows out of the poster: same centre, poster-sized, then out to the card
        sw, sh = max(src.width(), 80), max(src.height(), 80)
        start = QRect(src.center().x() - sw // 2, src.center().y() - sh // 2, sw, sh)
        self.setMinimumHeight(0)
        self.setMinimumWidth(0)
        self.setMaximumWidth(16777215)
        self.setGeometry(start)
        self.show()
        self.raise_()
        self.shadow.follow(self)
        self.anim = QPropertyAnimation(self, b"geometry", self)
        self.anim.setDuration(240)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)
        self.anim.setStartValue(start)
        self.anim.setEndValue(end)
        self.anim.finished.connect(lambda: self.setFixedWidth(self.W))
        self.anim.start()
        self.start_media()

    def tint_color(self, m):
        c = QColor((m.get("coverImage") or {}).get("color") or C["accent"])
        return c if c.isValid() else QColor(C["accent"])

    def fill(self, details):
        t = self.target
        m = {**(t.get("media") or {}), **{k: v for k, v in (details or {}).items() if v}}
        self.m = m
        style = self.style_name
        tint = self.tint_color(m)
        self.info.tint = tint
        self.info.update()
        self.media.fade = self.info.panel_color() if style == "tinted" else None
        self.media.update()
        bright = mix_color(tint, "#ffffff", 0.55)   # the cover colour, light enough to read on dark
        self.title.setText(media_title(m) if m.get("title") else t.get("title", ""))
        fmt = FORMAT_TEXT.get(m.get("format"), m.get("format") or "")
        when = season_label(m)
        score = f"★ {m['averageScore']}%" if m.get("averageScore") else ""
        eps = f"{m['episodes']} eps" if m.get("episodes") else ""
        airing = "Airing" if m.get("status") == "RELEASING" else ""
        genres = (m.get("genres") or [])
        if style == "immersive":
            bits = [fmt, when, f"<span style='color:{C['ok']}'>{score}</span>" if score else "", eps, airing,
                    genres[0] if genres else ""]
            self.meta.setText("  ·  ".join(html.escape(b) if "<span" not in b else b for b in bits if b))
        else:
            while self.chips_lay.count():
                it = self.chips_lay.takeAt(0)
                if it.widget():
                    it.widget().deleteLater()
            chips = [(" · ".join(b for b in (fmt, when) if b), False), (score, True), (eps, False), (airing, False)]
            chips += [(g, False) for g in genres[:3]]
            room = self.W - 36   # chips that don't fit on the one line are left out (no clipped "Adventu")
            for text, hi in chips:
                if not text:
                    continue
                c = QLabel(text)
                bg = (f"rgba({tint.red()},{tint.green()},{tint.blue()},0.24)" if hi else "rgba(255,255,255,0.08)")
                c.setStyleSheet(f"background: {bg}; color: {bright.name() if hi else '#d7d8e2'}; border-radius: 9px;"
                                f" padding: 2px 9px; font-size: 8.5pt;")
                need = c.sizeHint().width()
                if need > room:
                    c.deleteLater()
                    continue
                room -= need + self.chips_lay.spacing()
                self.chips_lay.addWidget(c)
            self.chips_lay.addStretch(1)
        desc = clean_description(m.get("description") or "").replace("\n", " ")
        max_lines = 2 if style == "immersive" else 3
        fm = QFontMetrics(self.synopsis.font())
        lines = desc
        while lines and fm.boundingRect(0, 0, self.W - 36, 9999, Qt.TextWordWrap, lines + "…").height() > \
                fm.lineSpacing() * max_lines:
            lines = lines[:max(0, len(lines) - 12)].rsplit(" ", 1)[0]
        self.synopsis.setText(lines + ("…" if lines and len(lines) < len(desc) else ""))
        self.synopsis.setVisible(bool(desc))
        # your list and your library
        a = self.ctl.account
        e = a.entry(m.get("id")) if a and a.connected and m.get("id") else None
        show = t.get("show_path") or (self.ctl.library.path_for_media(m["id"]) if m.get("id") else None)
        self.show_path = show
        total = m.get("episodes")
        if e:
            name = acct.STATUS_NAMES.get(e["status"], e["status"])
            prog = e.get("progress") or 0
            if e["status"] in ("CURRENT", "REPEATING", "PAUSED"):
                count = f"{prog} / {total}" if total else f"Episode {prog}"   # no "68 / ?" before it's announced
                self.prog_lbl.setText(count if style == "immersive" else f"{name}  ·  {count}")
                self.prog_bar.set(prog / total if total else 0, bright)
                self.prog_bar.setVisible(bool(total))
            else:
                self.prog_lbl.setText(name + ("  ·  In your library" if show else ""))
                self.prog_bar.hide()
        else:
            self.prog_lbl.setText("In your library" if show else "")
            self.prog_bar.hide()
        self.prog_lbl.setVisible(bool(self.prog_lbl.text()))
        self.play_path, verb = self.ctl.play_target(m.get("id"), show)
        self.play_btn.setToolTip(verb)
        self.play_btn.setVisible(bool(self.play_path))
        tracking = bool(a and a.connected and m.get("id"))
        self.list_btn.setVisible(tracking)
        if tracking:
            if e:
                color = STATUS_COLORS.get(e["status"], C["text"])
                self.list_btn.setIcon(glyph_icon("\uE73E", color, color, px=14))
                self.list_btn.setToolTip(f"{acct.STATUS_NAMES.get(e['status'], e['status'])} · change")
            else:
                self.list_btn.setIcon(glyph_icon(G["add"], "white", "white", px=14))
                self.list_btn.setToolTip("Add to your list")
        self.update_mute()
        self.info.adjustSize()
        self.place_info()

    def start_media(self):
        m = self.m
        self.video.stop()
        self.video.setGeometry(0, 0, 1, 1)
        self.mute_btn.hide()
        self.media.set_image(None)
        self.media.timer.start()
        self.load_art()
        trailer = m.get("trailer")
        if trailer and trailer.get("id") and trailer.get("site") in ("youtube", "dailymotion"):
            s = self.ctl.settings
            muted = not s.get("preview_sound", True) or s.get("preview_muted", False)
            self.video.play_trailer(trailer, muted, s.get("preview_volume", 60))
        else:
            self.play_clip_or_art()

    def play_clip_or_art(self):
        if self.ctl.settings.get("preview_clip", True) and self.play_path and Path(self.play_path).exists():
            self.video.play_clip(self.play_path)   # a muted moment from your own episode

    def load_art(self):
        m = self.m
        url = m.get("bannerImage") or ((m.get("coverImage") or {}).get("extraLarge"))
        if not url:
            return
        stem = (f"banner_{m.get('id')}" if m.get("bannerImage") else str(m.get("id"))) if m.get("id") else "x"
        mid = m.get("id")
        call = BgCall(lambda: cached_image(url, COVER_DIR / f"{stem}{Path(url.split('?')[0]).suffix or '.jpg'}"))
        call.done.connect(lambda img, err, c=call, mid=mid: self.on_art(c, img, mid))
        self.ctl.keep(call)
        call.start()

    def on_art(self, call, img, mid):
        self.ctl.release(call)
        if self.isVisible() and self.m.get("id") == mid and img is not None:
            self.media.set_image(img)

    def video_rect(self):
        """16:9 video covering the media area (the immersive card is taller: the sides are cropped)."""
        mw, mh = self.media.width(), self.media.height()
        w = max(mw, int(mh * 16 / 9))
        h = int(w * 9 / 16)
        return QRect((mw - w) // 2, (mh - h) // 2, w, h)

    def on_started(self):
        self.video.setGeometry(self.video_rect())
        self.media.timer.stop()
        self.mute_btn.setVisible(self.video.trailer is not None)
        self.place_info()
        self.mute_btn.raise_()

    def on_failed(self, err):
        if self.video.trailer is not None:   # the trailer can't play: a clip of your own, else the art
            self.play_clip_or_art()

    def update_mute(self):
        muted = not self.ctl.settings.get("preview_sound", True) or self.ctl.settings.get("preview_muted", False)
        self.mute_btn.setIcon(glyph_icon("\uE74F" if muted else "\uE767", "white", "white", px=13))
        self.mute_btn.setToolTip("Sound off" if muted else "Sound on")

    def toggle_mute(self):
        s = self.ctl.settings
        if not s.get("preview_sound", True):
            s["preview_sound"], s["preview_muted"] = True, False
        else:
            s["preview_muted"] = not s.get("preview_muted", False)
        save_settings(s)
        self.update_mute()
        self.video.set_muted(s["preview_muted"])

    # ---- actions
    def play(self):
        path = self.play_path
        self.ctl.close()
        if path:
            play_video(path)

    def open_show(self):
        m, show = self.m, self.show_path
        self.ctl.close()
        if show:
            self.ctl.window.show_details(show, None)
        elif m.get("id"):
            self.ctl.window.show_media(m["id"], media_title(m) if m.get("title") else "", None)

    def list_menu(self):
        m, a = self.m, self.ctl.account
        menu = QMenu(self)
        for st in ("CURRENT", "PLANNING", "COMPLETED", "PAUSED", "DROPPED"):
            menu.addAction(acct.STATUS_NAMES.get(st, st), lambda st=st: (a.set_status(m["id"], st, m), self.fill({})))
        menu.exec(self.list_btn.mapToGlobal(QPoint(0, self.list_btn.height())))

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.position().toPoint()):
            self.open_show()

    def close_card(self):
        if self.anim is not None:
            self.anim.stop()
        self.video.stop()
        self.media.timer.stop()
        self.hide()
        self.target = None


class HoverPreviews(QObject):
    """Hover a show (Library, Seasonal, Home, recommendations) for a moment: a
    card opens over it with its trailer and synopsis. Moving away, scrolling or clicking closes it."""

    def __init__(self, window, settings, account, library):
        super().__init__(window)
        self.window, self.settings, self.account, self.library = window, settings, account, library
        self.card = PreviewCard(window.centralWidget(), self)
        self.card.installEventFilter(self)
        self.views, self.widgets = {}, {}
        self.pending, self.calls = None, set()
        self.details = {}
        self.open_timer = QTimer(self, singleShot=True, timeout=self.open_pending)
        self.close_timer = QTimer(self, singleShot=True, interval=220, timeout=self.maybe_close)
        import shiboken6
        for w, fn in PENDING_PREVIEWS:
            if shiboken6.isValid(w):   # cards made before this existed
                self.add_widget(w, fn)
        PENDING_PREVIEWS.clear()

    # ---- what can be hovered
    def add_view(self, view, resolver):
        """A list/grid view: resolver(index) → {mid, media, show_path} for the item under the mouse."""
        vp = view.viewport()
        self.views[vp] = (view, resolver)
        vp.installEventFilter(self)
        view.verticalScrollBar().valueChanged.connect(lambda *_: self.close())

    def add_widget(self, widget, target_fn):
        self.widgets[widget] = target_fn
        widget.setAttribute(Qt.WA_Hover)
        widget.installEventFilter(self)
        widget.destroyed.connect(lambda *_, w=widget: self.widgets.pop(w, None))

    def enabled(self):
        w = self.window
        return (self.settings.get("preview_enabled", True) and w.player is None and w.isActiveWindow()
                and not w.isMinimized())

    def eventFilter(self, obj, e):
        t = e.type()
        if obj is self.card:
            if t == QEvent.Enter:
                self.close_timer.stop()
            elif t == QEvent.Leave:
                self.close_timer.start()
            return False
        if obj in self.views:
            if t == QEvent.MouseMove:
                view, resolver = self.views[obj]
                idx = view.indexAt(e.position().toPoint())
                target = resolver(idx) if idx.isValid() else None
                if target:
                    r = view.visualRect(idx)
                    target["rect"] = QRect(obj.mapToGlobal(r.topLeft()), r.size())
                    target["source"] = (id(obj), idx.row())
                self.hover(target)
            elif t == QEvent.Leave:
                self.leave()
            elif t in (QEvent.Wheel, QEvent.MouseButtonPress):
                self.close()
            return False
        if obj in self.widgets:
            if t in (QEvent.Enter, QEvent.HoverEnter):
                target = self.widgets[obj]()
                if target and target.get("mid"):
                    target["rect"] = QRect(obj.mapToGlobal(QPoint(0, 0)), obj.size())
                    target["source"] = (id(obj), 0)
                    self.hover(target)
            elif t in (QEvent.Leave, QEvent.HoverLeave):
                self.leave()
            elif t in (QEvent.Wheel, QEvent.MouseButtonPress):
                self.close()
        return False

    # ---- hover → wait → open
    def hover(self, target):
        if target is None or not target.get("mid"):
            self.leave()
            return
        cur = self.card.target if self.card.isVisible() else None
        if cur and cur.get("source") == target["source"]:
            self.close_timer.stop()
            return
        if self.pending and self.pending.get("source") == target["source"]:
            return
        if cur:
            self.close()
        self.pending = target
        self.open_timer.start(int(self.settings.get("preview_delay", 600)))
        self.prefetch(target)

    def leave(self):
        self.open_timer.stop()
        self.pending = None
        if self.card.isVisible():
            self.close_timer.start()

    def maybe_close(self):
        if self.card.isVisible() and (self.card.underMouse() or QApplication.activePopupWidget()):
            return
        src = (self.card.target or {}).get("rect")
        if src is not None and src.contains(QCursor.pos()):
            return
        self.close()

    def open_pending(self):
        t, self.pending = self.pending, None
        if not t or not self.enabled():
            return
        if not QRect(t["rect"]).adjusted(-4, -4, 4, 4).contains(QCursor.pos()):
            return   # the mouse moved on meanwhile
        home = getattr(self.window, "home", None)
        if home is not None:
            home.hero.stop_trailer()   # one sound at a time
        self.card.open(t, self.details.get(t["mid"]) or saved_details(t["mid"]))

    def close(self):
        self.open_timer.stop()
        self.close_timer.stop()
        self.pending = None
        if self.card.isVisible():
            self.card.close_card()

    # ---- getting ready while you hover
    def prefetch(self, target):
        mid = target["mid"]
        d = self.details.get(mid) or saved_details(mid)
        if d:
            self.details[mid] = d
            self.prefetch_stream(d)
            return
        call = BgCall(lambda: fetch_details([mid]).get(mid) or {})
        call.done.connect(lambda res, err, c=call, mid=mid: self.on_details(c, mid, res))
        self.keep(call)
        call.start()

    def on_details(self, call, mid, d):
        self.release(call)
        if not d:
            return
        self.details[mid] = d
        if self.card.isVisible() and (self.card.target or {}).get("mid") == mid:
            had_trailer = bool(self.card.m.get("trailer"))
            self.card.fill(d)
            if not had_trailer and d.get("trailer"):
                self.card.start_media()
        self.prefetch_stream(d)

    def prefetch_stream(self, d):
        """mpv engine: look the trailer's stream up now, so it starts as soon as the card opens."""
        tr = d.get("trailer")
        if trailer_engine() != "mpv" or not tr or trl.cached(tr) or any(getattr(c, "is_stream", False) for c in self.calls):
            return
        call = BgCall(lambda: trl.resolve(tr))
        call.is_stream = True
        call.done.connect(lambda *_, c=call: self.release(c))
        self.keep(call)
        call.start()

    def keep(self, call):
        self.calls.add(call)

    def release(self, call):
        call.wait()
        self.calls.discard(call)

    def play_target(self, mid, show_path):
        """What Play does: the episode to continue / the next one / the first one you have."""
        if not show_path:
            return None, ""
        it = self.library.items.get(show_path)
        idx = it.data(INDEX_ROLE) if it is not None else None
        if not idx:
            return None, ""
        resume = _read_json(PLAYBACK_STATE_FILE)
        files = [f for sid in idx["seasons"] if sid for _, f in sorted((idx["local"].get(sid) or {}).items())]
        for f in files:
            r = resume.get(f)
            if r and r.get("pos", 0) > 30:
                return f, "Resume"
        _, _, _, nxt = show_state(idx, self.account)
        if nxt:
            return nxt["path"], f"Play S{nxt['season']} · E{nxt['ep']}"
        return (files[0], "Play") if files else (None, "")

    def shutdown(self):
        self.close()
        self.card.video.shutdown()
        for c in list(self.calls):
            c.wait(5000)


