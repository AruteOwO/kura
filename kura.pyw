                head.addWidget(label("·  disc menus: never played on Live TV", "faint"))
            head.addStretch(1)
            v.addLayout(head)
            for season, files in groups.items():
                if season:
                    sl = label(season, "faint")
                    sl.setContentsMargins(26, 0, 0, 0)
