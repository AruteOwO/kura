class DetailPage(QWidget):
    version_changed = Signal()   # you picked another version of a show (the library re-reads it)
    back = Signal()
    find_torrents = Signal(str)   # search text for the Torrents page
    open_media = Signal(int, str, object)   # a recommended show: AniList id, title, cover

    def pad_start(self):
        """Controller: start on your next episode (else the first one shown)."""
        grids = [w for w in self.findChildren(QWidget) if isinstance(w, (EpisodeGrid, EpisodeCards)) and w.isVisible()]
        for g in grids:
            for i, (text, *_rest) in enumerate(g.chips):
                if g.next_n is not None and text == str(g.next_n):
                    return g, g._rect(i).toRect()
        for g in grids:
            if g.chips:
                return g, g._rect(0).toRect()
        return None

    def __init__(self, account=None):
        super().__init__()
        self.account = account
        self.load_id = 0
        self.loaders = set()
        self.path = None
        self.media_id = None
        self.name = None
        self.result, self.cover = None, None
        self.slots = {}
        self.bars, self.grids = {}, {}
        self.next_btn = None
        self.next_path = None
        self.trailer = None
        self.recs = None
        self.library_has = None   # (AniList id) → in the library? (MainWindow sets it)
        self.thumbs = None        # episode thumbnails (stills / frames), started when first needed
        self.images = {}          # pictures already loaded for this show (a rebuild puts them back)
        self.thumb_slots = {}
        self.section_pick = {}    # show folder → the season tab you picked
        self.editing = False      # Edit info: the page's editable parts are dashed (user's pick C)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.verticalScrollBar().setSingleStep(24)
        lay.addWidget(self.scroll)

    def open(self, path, cover=None, force=False, media_id=None, name=None, quiet=False):
        """path = the show's folder, or None for a show you haven't downloaded (media_id + name).
        quiet: the same show read again (another version picked): the page stays up, no loading screen, and keeps
        its scroll position."""
        if quiet and self.result and path == self.path and media_id is None:
            for ld in list(self.loaders):
                ld.requestInterruption()
            self.load_id += 1
            ld = DetailLoader(self.load_id, path, False, self.media_id, self.name)
            pos = self.scroll.verticalScrollBar().value()

            def done(i, r, c=self.cover):
                if i == self.load_id:
                    self.render(r, c)
                    self.restore_images()
                    QTimer.singleShot(0, lambda: self.scroll.verticalScrollBar().setValue(pos))
            ld.loaded.connect(done)
            ld.image.connect(self.on_image)
            ld.finished.connect(lambda l=ld: self.loaders.discard(l))
            self.loaders.add(ld)
            ld.start()
            return
        if media_id is not None or path != self.path:
            self.media_id = media_id
        if name or path != self.path:
            self.name = name or (Path(path).name if path else "?")
        if path != self.path or media_id is not None:
            self.images = {}   # another show
            if path != self.path:
                self.editing = False
        self.path = path
        self.result = None
        for ld in list(self.loaders):
            ld.requestInterruption()
        self.load_id += 1
        self.render({"name": self.name, "path": path, "loading": True}, cover)
        ld = DetailLoader(self.load_id, path, force, self.media_id, self.name)
        ld.loaded.connect(lambda i, r, c=cover: i == self.load_id and self.render(r, c))
        ld.image.connect(self.on_image)
        ld.finished.connect(lambda l=ld: self.loaders.discard(l))
        self.loaders.add(ld)
        ld.start()

    def on_image(self, load_id, key, img):
        if load_id == self.load_id:
            self.images[key] = img
            for w in self.slots.get(key, []):
                w.set_image(img)

    def restore_images(self):
        """After a rebuild (Cards/Compact, Refresh, list changes): the pictures that were already loaded."""
        for key, widgets in self.slots.items():
            img = self.images.get(key)
            if img is not None:
                for w in widgets:
                    w.set_image(img)

    def tracking(self):
        return bool(self.account and self.account.connected)

    def hideEvent(self, e):
        super().hideEvent(e)
        # Only when you switch pages; minimizing (or Qt recreating the window) keeps it playing
        if self.trailer is not None and not self.isVisibleTo(self.window()):
            self.trailer.stop()

    def on_account_changed(self):
        if self.result is not None:
            pos = self.scroll.verticalScrollBar().value()
            self.render(self.result, self.cover)
            self.scroll.verticalScrollBar().setValue(pos)

    def on_entry_changed(self, mid):
        for bar in self.bars.get(mid, []):
            bar.refresh()
        self.update_progress()

    def on_downloads_changed(self):
        """Episodes qBittorrent is downloading show how far along they are."""
        d = getattr(self, "downloads", None)
        if not self.grids or not self.isVisible():
            return
        for grid in self.grids.values():
            got = {}
            for t in (d.torrents.values() if d else ()):
                if grid.mid and t.get("mid") == grid.mid:
                    frac = float(t.get("progress", 0))
                    if t.get("episode"):
                        got[str(t["episode"])] = frac
                    elif t.get("episodes"):   # a batch Kura sent: the episodes it has
                        got.update({str(e): frac for e in t["episodes"] if str(e) not in got})
                    else:   # a batch of unknown range: every missing episode
                        got.update({c[0]: frac for c in grid.chips if c[1] == MISSING and c[0] not in got})
            grid.set_downloading(got)

    def refresh_stats(self):
        """Your progress / status tiles and the season cards' lines, after you watched or changed the entry."""
        r = self.result
        box = getattr(self, "stats_box", None)
        if r and box is not None:
            try:
                lay = box.layout()
                while lay.count():
                    it = lay.takeAt(0)
                    sub = it.layout()
                    if sub is not None:
                        while sub.count():
                            w = sub.takeAt(0).widget()
                            if w:
                                w.deleteLater()
                lay.addLayout(self.stats_row(r, r.get("hero") or {}))
            except RuntimeError:   # the page was made again meanwhile
                pass
        for b in getattr(self, "tab_btns", []):
            if getattr(b, "sec", None) is not None:
                try:
                    b.set_sub(*self.section_state(b.sec))
                except RuntimeError:
                    pass

    def update_progress(self):
        """Dim watched episodes, ring the next one, and update the Play next button."""
        if not self.result or not self.tracking():
            return
        self.refresh_stats()
        nxt = next_episode(self.result["sections"], self.account)
        for s in self.result["sections"]:
            grid = self.grids.get(id(s))
            if grid is None or not s["id"]:
                continue
            e = self.account.entry(s["id"])
            here = nxt and nxt["section"] is s
            grid.set_progress((e or {}).get("progress") or 0 if e else None, nxt["n"] if here else None)
        if self.next_btn is not None:
            if nxt is None:
                self.next_btn.hide()
                return
            title = nxt["section"]["title"].replace("Season ", "S")
            self.next_btn.show()
            self.next_btn.setEnabled(bool(nxt["path"]))
            self.next_btn.setText(f" Play {title} · E{nxt['n']}" if nxt["path"]
                                  else f" Next: {title} · E{nxt['n']} (not downloaded)")
            self.next_btn.setToolTip(Path(nxt["path"]).name if nxt["path"] else "")
            self.next_path = nxt["path"]

    # ---- building the page
    def render(self, r, cover=None):
        if self.trailer is not None:
            # a playing trailer (Kura's player) must be shut down before its page is thrown away: deleting a
            # running video surface with the page crashed Kura (play a trailer, then Refresh from AniList)
            self.trailer.stop()
        self.slots = {}
        self.recs = None
        self.bars, self.grids = {}, {}
        self.section_cards, self.tab_btns = [], []
