        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(3, 3, self.W, self.H)
        clip = QPainterPath()
        clip.addRoundedRect(r, 9, 9)
        p.setClipPath(clip)
        if self.img is not None and not self.img.isNull():
            dpr = self.devicePixelRatioF()
            if self._pm is None or self._pm.devicePixelRatio() != dpr:
                self._pm = cover_pixmap(self.img, self.W, self.H, dpr)
            p.drawPixmap(3, 3, self._pm)
        else:
            p.fillRect(r, placeholder_gradient(r, self.title))
        if not self.on:
            p.fillRect(r, QColor(10, 12, 16, 100))
        p.setClipping(False)
        p.setBrush(Qt.NoBrush)
        if self.on:
            p.setPen(QPen(QColor("white"), 2))
            p.drawRoundedRect(r.adjusted(-1.5, -1.5, 1.5, 1.5), 10, 10)
        else:
            p.setPen(QPen(QColor(255, 255, 255, 40), 1))
            p.drawRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), 9, 9)


