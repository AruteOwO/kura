class Job(QThread):
    """Runs anime_organizer.main() with the given arguments on a worker thread."""
    done = Signal(bool)

    def __init__(self, argv):
        super().__init__()
        self.argv = argv

    def run(self):
        old_argv = sys.argv
        sys.argv = ["anime_organizer.py", *self.argv]
        ok = True
        try:
            org.main()
        except SystemExit as e:
            ok = not e.code
            if e.code and not isinstance(e.code, int):
                org.log.error(str(e.code))
        except Exception:
            org.log.exception("Unexpected error")
            ok = False
        finally:
            sys.argv = old_argv
        self.done.emit(ok)


class BgCall(QThread):
    """Runs fn() on a worker thread: done(result, "") or done(None, error text)."""
    done = Signal(object, str)

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.done.emit(self.fn(), "")
        except Exception as e:
            self.done.emit(None, str(e) or type(e).__name__)


class Downloads(QObject):
    """Kura's torrents in qBittorrent (category "Kura"), through its Web UI. Polls every 2 s
    while Kura's window is open and every 20 s from the tray; `finished` fires once per
    torrent when it completes."""
    changed = Signal()
    finished = Signal(dict)            # the torrent, with Kura's "mid"/"episode" added
    error = Signal(str)

    def __init__(self, settings, parent=None):
        super().__init__(parent)
        self.settings = settings
        self.torrents = {}             # hash → torrent (qBittorrent's fields + mid/episode)
        self.connected, self.status = False, ""
        self.handled = set()           # finished torrents already passed on
        self.first = True              # the first poll only learns what was already done
        self.hook = False              # qBittorrent's own run-on-finish runs anime_organizer
        self.client, self.poller, self.calls = None, None, set()
        self.describe = None           # (name) → (mid, episode) for torrents not sent by Kura
        self.guesses = {}
        self.pick_files = None         # (torrent) → skips a batch's episodes you already have
        self.picking = set()
        self.timer = QTimer(self, timeout=self.poll)
        self.apply_settings()

    @property
    def enabled(self):
        return self.settings.get("torrent_app") == "qbit"

    def apply_settings(self):
        self.client = qbit_client(self.settings) if self.enabled else None
        self.torrents, self.connected, self.status = {}, False, ""
        self.first, self.hook = True, False
        if self.enabled:
            self.timer.start(2000)
            QTimer.singleShot(0, self.poll)
        else:
            self.timer.stop()
        self.changed.emit()

    def set_fast(self, fast):
        if self.enabled:
            self.timer.setInterval(2000 if fast else 20000)

    def poll(self):
        if self.poller is not None or self.client is None:
            return
        client, first = self.client, self.first

        def fetch():
            hook = False
            if first:
                prefs = client.preferences()
                hook = bool(prefs.get("autorun_enabled")) and "anime_organizer" in (prefs.get("autorun_program") or "")
            return client.torrents(), hook
        self.poller = BgCall(fetch)
        self.poller.done.connect(lambda res, err, c=client: self.on_polled(c, res, err))
        self.poller.start()

    def on_polled(self, client, result, err):
        self.poller.wait()
        self.poller = None
        if client is not self.client:   # settings changed meanwhile
            return
        if err:   # shown on the Downloads tab, not as a message every 2 s (qBittorrent may just be closed)
            self.connected, self.status = False, err
            self.changed.emit()
            return
        torrents, hook = result
        if self.first:
            self.hook = hook
        history = tor.load_history()
        fresh = {}
        for t in torrents:
            h = t.get("hash", "").lower()
            old = self.torrents.get(h) or {}
            known = history.get(h) or {}
            t["episodes"] = known.get("episodes")   # a batch's episodes, when Kura sent it
            if old.get("mid"):
                t["mid"], t["episode"] = old["mid"], old["episode"]
            else:
                mid, ep = known.get("mid"), known.get("episode")
                if not mid and self.describe:
                    if h not in self.guesses:
                        self.guesses[h] = self.describe(t.get("name", ""))
                    mid, ep = self.guesses[h]
                t["mid"], t["episode"] = mid, ep
            fresh[h] = t
            # "Only what you're missing": once qBittorrent knows the files, skip the ones you have
            if ((known.get("only_missing") or known.get("skip_junk")) and not known.get("files_picked") and h not in self.picking
                    and self.pick_files and t.get("state") not in ("metaDL", "forcedMetaDL")
                    and not tor.is_done(t)):
                self.picking.add(h)
                self.pick_files(t)
        self.torrents, self.connected, self.status = fresh, True, ""
        for h, t in fresh.items():
            if tor.is_done(t) and h not in self.handled:
                self.handled.add(h)
                if not self.first:
                    self.finished.emit(t)
        if self.first:   # finished before Kura started: still organize them (no "new" spam)
            for h, t in fresh.items():
                if tor.is_done(t):
                    self.finished.emit(t)
        self.first = False
        self.changed.emit()

    def run(self, fn, done=None):
        """An API call on a worker thread; done(result, error) on the GUI thread."""
        if self.client is None:
            return
        call = BgCall(fn)

        def finished(res, err):
            call.wait()
            self.calls.discard(call)
            if done:
                done(res, err)
            elif err:
                self.error.emit(err)
            self.poll()
        call.done.connect(finished)
        self.calls.add(call)
        call.start()

    def for_episode(self, mid, episode):
        """The torrent downloading this episode (a batch counts for all of its episodes)."""
        for t in self.torrents.values():
            if t.get("mid") == mid and (t.get("episode") == episode or t.get("episode") is None):
                return t
        return None

    def stop(self):
        self.timer.stop()
        for c in [self.poller, *self.calls]:
            if c is not None:
                c.wait(3000)


# ---------------------------------------------------------------- library scanning

SEASON_RE = re.compile(r"season\s*0*(\d+)(?:\s*[-\u2013\u2014:]\s*.*)?", re.IGNORECASE)   # "Season 2 - Name" too
SKIP_DIRS = {"$recycle.bin", "system volume information"}


def scan_show(d):
    seasons, extras, episodes, related = 0, [], 0, 0
    try:
        for c in d.iterdir():
            if not c.is_dir():
                episodes += c.suffix.lower() in org.VIDEO_EXTS
                continue
            if c.name in (org.SPINOFF_FOLDER, org.SIDE_STORY_FOLDER):
                related += sum(1 for x in c.iterdir() if org.is_link(x) or x.suffix.lower() == ".lnk")
                continue
            if org.is_link(c):
                continue
            if SEASON_RE.fullmatch(c.name):
                seasons += 1
            else:
                extras.append(c.name)
            episodes += sum(1 for f in c.iterdir() if f.is_file() and f.suffix.lower() in org.VIDEO_EXTS)
    except OSError:
        pass

    parts = []
    if seasons:
        parts.append(f"{seasons} season{'s' if seasons != 1 else ''}")
    elif extras:
        parts.append(extras[0])
    if episodes:
        parts.append(f"{episodes} ep")
    if related:
        parts.append(f"+{related} related")
    return {"path": str(d), "name": d.name, "subtitle": " · ".join(parts) or "Empty",
            "episodes": episodes}


def ico_image(show_dir):
    """The folder icon the organizer made, cropped back to the poster shape."""
    ico = show_dir / f"{show_dir.name}.ico"
    if not ico.exists():
        ico = next(iter(show_dir.glob("*.ico")), None)
        if ico is None:
            return None
    try:
        import io
        from PIL import Image
        img = Image.open(ico)
        img.load()
        img = img.convert("RGBA")
        box = img.getchannel("A").getbbox()
        if box:
            img = img.crop(box)
        buf = io.BytesIO()
        img.save(buf, "PNG")
        q = QImage()
        q.loadFromData(buf.getvalue(), "PNG")
        return q
    except Exception:
        return None


def media_info(mid, cache, details, list_media):
    """What we know about an AniList entry without asking AniList."""
    return (list_media.get(mid) or details.get(mid) or (cache.get(f"rel:{mid}") or {}).get("entry")
            or cache.get(f"id:{mid}") or {})


def cached_chain(mid, cache):
    """A show's prequel/sequel run in order, using only relations already in the cache."""
    cur, seen = mid, {mid}
    for _ in range(20):
        info = cache.get(f"rel:{cur}")
        prev = org.next_in_chain(info, "PREQUEL") if info else None
        if not prev or prev["id"] in seen:
            break
        seen.add(prev["id"])
        cur = prev["id"]
    order = []
    for _ in range(25):
        order.append(cur)
        info = cache.get(f"rel:{cur}")
        nxt = org.next_in_chain(info, "SEQUEL") if info else None
        if not nxt or nxt["id"] in order:
            break
        cur = nxt["id"]
    return order


def media_holder(show_dir):
    """The first subfolder holding videos (Movies, OVAs, Specials...), not Extras: where a movie's own folder keeps
    its file."""
    try:
        subs = sorted(c for c in show_dir.iterdir() if c.is_dir() and not org.is_link(c)
                      and c.name not in (org.EXTRAS_FOLDER, org.SPINOFF_FOLDER, org.SIDE_STORY_FOLDER))
    except OSError:
        return None
    return next((c for c in subs if any(local_videos(c))), None)


def season_folders(show_dir):
    folders = {}
    loose = False
    groups = org.season_version_groups(show_dir)
    mine = org.FOLDER_SEASONS.get(show_dir.name.lower(), {})   # Edit info: this folder counts as Season N
    try:
        for c in show_dir.iterdir():
            m = SEASON_RE.fullmatch(c.name)
            if c.name in mine and c.is_dir():
                folders[mine[c.name]] = c
            elif m and c.is_dir() and not org.is_link(c) and int(m.group(1)) not in mine.values():
                folders[int(m.group(1))] = c
            elif c.is_file() and c.suffix.lower() in org.VIDEO_EXTS:
                loose = True
    except OSError:
        pass
    if not folders and (loose or org.version_dirs(show_dir)):
        folders[1] = show_dir   # episodes right in the show folder (One Piece) or in version folders there
    for n, g in groups.items():   # "Season 1 - Korean" + "Season 1 - Japanese": one season, two versions
        folders[n] = SeasonGroup(show_dir, n, g)
    return folders


def shift_episodes(eps, offset, total):
    """Some groups number later seasons continuously (S2E1 = "13"); shift those back. Also while a season airs with
    no total on AniList yet (Apothecary Diaries' season 3 "52" = episode 4). Never files that say their season
    ("S02E13" is episode 13 of its season, whatever the count)."""
    if (eps and offset and min(eps) > offset and (not total or max(eps) <= offset + total)
            and not any(org.parse(Path(p).name)[1] is not None for p in eps.values())):
        return {n - offset: p for n, p in eps.items()}
    return from_zero(eps, total)


def fit_numbering(eps, total):
    """OVAs / specials numbered on from the TV series (Bikini Warriors' 6 OVAs are 13-18): when every number is
    past the entry's own count and they fit inside it, count them from 1."""
    if eps and total and min(eps) > total and max(eps) - min(eps) < total:
        start = min(eps) - 1
        return {n - start: p for n, p in eps.items()}
    return from_zero(eps, total)


def from_zero(eps, total):
    """A season starting at episode 0 that AniList counts as its first (High School DxD HERO: files 00-12, AniList
    13 episodes): 00 is episode 1. Only when the files end exactly one short of AniList's count, so a show where
    AniList leaves the 0 out (00-12 with 12 episodes) keeps its 00 as an extra."""
    if eps and total and 0 in eps and max(eps) == total - 1:
        return {n + 1: p for n, p in eps.items()}
    return eps


LATE_PREQUEL_FIX = True


def drop_late_prequels(seasons, mid, cache, details, list_media):
    """A "prequel" that aired after the show itself isn't its first season: AniList links One Piece's 2024
    MONSTERS web special as its prequel, so it became Season 1 and episodes 1090+ fit nowhere."""
    if mid not in seasons:
        return seasons
    year = media_info(mid, cache, details, list_media).get("seasonYear")
    if not year:
        return seasons
    k = seasons.index(mid)
    before = [s for s in seasons[:k]
              if not (media_info(s, cache, details, list_media).get("seasonYear") or 0) > year]
    return before + seasons[k:]


def index_adult(idx, account=None):
    """A library show is 18+ (AniList): from the organizer's cache, else your list / saved details."""
    if not idx:
        return False
    if idx.get("adult") is not None:
        return bool(idx["adult"])
    m = media_for(idx.get("mid"), account) or {}
    return acct.is_adult(m) if (m.get("isAdult") is not None or m.get("genres")) else False


def library_index(show_dir, cache, details, list_media, title_ids):
    """Which AniList entries a show folder covers, and the episodes on disk for each season."""
    name = show_dir.name.lower()
    entry = cache.get(f"{name}|show") or cache.get(f"{name}|movie")
    mine = org.OVERRIDES.get(name)   # Edit info: you picked this folder's AniList entry
    mid = ((mine["id"] if isinstance(mine, dict) else mine) or title_ids.get(name)
           or (entry.get("id") if isinstance(entry, dict) else None))
    if not mid:
        return None
    chain = cached_chain(mid, cache)
    seasons = [i for i in chain if media_info(i, cache, details, list_media).get("format") in org.TV_FORMATS] or [mid]
    standalone = mid not in seasons and seasons != [mid]
    if standalone:   # a movie / OVA folder of its own inside a TV franchise (Legend of Crimson): just that entry,
        chain = seasons = [mid]   # not the TV seasons its prequel/sequel links lead to
    if LATE_PREQUEL_FIX and not standalone:
        seasons = drop_late_prequels(seasons, mid, cache, details, list_media)
    for n, sid in org.SEASON_COVERS.get(name, {}).items():
        seasons += [None] * (n - len(seasons))
        seasons[n - 1] = sid
    folders = season_folders(show_dir)
    if (standalone or seasons == [mid]) and not folders:   # one entry whose file sits in Movies / OVAs / Specials
        holder = media_holder(show_dir)
        if holder is not None:
            folders[1] = holder
    fam = org.show_family({"id": mid}, cache, offline=True)
    if fam:   # folders named after a season ("Queen's Blade Rebellion")
        try:
            subs = [c for c in show_dir.iterdir() if c.is_dir() and not org.is_link(c)
                    and not SEASON_RE.fullmatch(c.name) and c.name not in (org.SPINOFF_FOLDER, org.SIDE_STORY_FOLDER)]
        except OSError:
            subs = []
        for c in subs:
            k = org.classify_folder(c.name, fam)
            if k and k.get("season") and k["season"] not in folders:
                folders[k["season"]] = c
    local, offset, versions, version_files = {}, 0, {}, []
    for n, sid in enumerate(seasons, 1):
        if not sid:
            offset = None
            continue
        info = media_info(sid, cache, details, list_media)
        total = info.get("episodes")
        eps = one_episode(local_videos(folders.get(n)), total, info.get("format"))[0]
        if n == 1 and info.get("format") not in org.TV_FORMATS:   # an OVA entry of its own numbered on from the TV
            eps = fit_numbering(eps, total)                        # run (Bikini Warriors' specials 13-18 = 1-6)
        local[sid] = shift_episodes(eps, offset, total)
        vers = local_versions(folders.get(n))
        if len(vers) > 1:
            versions[sid] = {name: sorted(shift_episodes(eps, offset, total)) for name, eps in vers.items()}
            version_files.extend(f for eps in vers.values() for f in eps.values())
        offset = offset + total if (offset is not None and total) else None
    adult = entry.get("adult") if isinstance(entry, dict) and entry.get("adult") is not None else cache.get(f"adult:{mid}")
    return {"mid": mid, "chain": chain, "seasons": seasons, "local": local, "versions": versions,
            "version_files": version_files, "adult": adult}


class LibraryScanner(QThread):
    listed = Signal(int, list)
    cover = Signal(int, str, QImage)

    def __init__(self, scan_id, library, list_media=None, title_ids=None, shows=None):
        super().__init__()
        self.scan_id = scan_id
        self.library = Path(library)
        self.list_media = list_media or {}
        self.title_ids = title_ids or {}
        self.known = shows   # covers only, for shows already listed (switching sides restores the list)

    def run(self):
        if self.known is not None:
            cache = _read_json(org.CACHE_FILE)
            shows = self.known
        else:
            shows, cache = self.scan()
        self.load_covers(shows, cache)

    def scan(self):
        try:
            dirs = sorted((p for p in self.library.iterdir()
                           if p.is_dir() and not org.is_link(p) and not p.name.startswith(".")
                           and p.name.lower() not in SKIP_DIRS), key=lambda p: p.name.lower())
        except OSError:
            dirs = []
        cache = _read_json(org.CACHE_FILE)
        details = details_by_id()
        shows = []
        for d in dirs:
            s = scan_show(d)
            try:
                s["index"] = library_index(d, cache, details, self.list_media, self.title_ids)
            except Exception:
                s["index"] = None
            shows.append(s)
        self.listed.emit(self.scan_id, shows)
        return shows, cache

    def load_covers(self, shows, cache):
        # Local covers first (instant), then fetch sharper ones from AniList's CDN
        to_download = []
        for s in shows:
            if self.isInterruptionRequested():
                return
            entry = cache.get(f"{s['name'].lower()}|show") or cache.get(f"{s['name'].lower()}|movie")
            if not isinstance(entry, dict) and s["index"]:
                m = self.list_media.get(s["index"]["mid"]) or {}
                entry = {"id": m.get("id"), "cover": (m.get("coverImage") or {}).get("extraLarge")}
            hd = None
            if isinstance(entry, dict) and entry.get("cover") and entry.get("id"):
                suffix = Path(entry["cover"].split("?")[0]).suffix or ".jpg"
                hd = COVER_DIR / f"{entry['id']}{suffix}"
                if not hd.exists():
                    to_download.append((s["path"], entry["cover"], hd))
                    hd = None
            img = QImage(str(hd)) if hd else ico_image(Path(s["path"]))
            if img is not None and not img.isNull():
                self.cover.emit(self.scan_id, s["path"], img)

        for path, url, dest in to_download:
            if self.isInterruptionRequested():
                return
            img = cached_image(url, dest)
            if img is not None:
                self.cover.emit(self.scan_id, path, img)


def custom_art(folder, kind):
    """Your own picture for a show ("banner" / "icon"), set from Tools → Captures, if it's still there."""
    if not folder:
        return None
    path = ((APP.get("settings") or {}).get("custom_art") or {}).get(os.path.normcase(str(folder)), {}).get(kind)
    return path if path and os.path.isfile(path) else None


def still_stem(url):
    """An episode still's file name in cover_cache. It used Python's hash(), which changes every time Kura starts:
    stills were downloaded again each session and the old copies piled up."""
    return "still_" + hashlib.sha1(url.encode("utf-8")).hexdigest()[:16]


def cached_image(url, dest):
    """Download an image from AniList's CDN once (no API rate limit there) and keep it. A local file (your own
    banner) is read as it is."""
    if url and not str(url).startswith(("http://", "https://")) and os.path.isfile(url):
        img = QImage(str(url))
        if img.isNull():   # AVIF and the like: Qt can't read them
            try:
                from PIL import Image
                pil = Image.open(url).convert("RGB")
                img = QImage(pil.tobytes("raw", "RGB"), pil.width, pil.height, pil.width * 3,
                             QImage.Format_RGB888).copy()
            except Exception:
                return None
        return img
    if not dest.exists():
        try:
            COVER_DIR.mkdir(exist_ok=True)
            req = urllib.request.Request(url, headers={"User-Agent": org.USER_AGENT})
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = resp.read()
            tmp = dest.with_suffix(dest.suffix + ".part")
            tmp.write_bytes(data)
            os.replace(tmp, dest)
        except Exception:
            return None
    img = QImage(str(dest))
    return None if img.isNull() else img


# ---------------------------------------------------------------- show details

QUERY_DETAILS = """query ($ids: [Int]) { Page(perPage: 50) { media(id_in: $ids, type: ANIME) {
  id format status episodes duration season seasonYear averageScore genres siteUrl bannerImage
  description(asHtml: false)
  title { romaji english native }
  coverImage { extraLarge color }
  nextAiringEpisode { episode airingAt }
  studios(isMain: true) { nodes { name } }
  trailer { id site thumbnail }
  idMal
  streamingEpisodes { title thumbnail }
  recommendations(perPage: 12, sort: RATING_DESC) { nodes { rating mediaRecommendation {
    id format status episodes season seasonYear averageScore siteUrl synonyms
    title { romaji english } coverImage { extraLarge } nextAiringEpisode { episode airingAt } } } }
} } }"""
DETAILS_VERSION = 5   # bump when QUERY_DETAILS gains fields, so saved details are refetched

_store_lock = threading.Lock()


def _read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def _write_json(path, data):
    tmp = path.with_suffix(".gui.tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, path)


def _is_fresh(rec, force):
    if force or not rec or rec.get("v") != DETAILS_VERSION:
        return False
    # Airing shows change (next episode, episode count); finished ones rarely do
    max_age = 6 * 3600 if rec["data"].get("status") in ("RELEASING", "NOT_YET_RELEASED") else 30 * 86400
    return time.time() - rec["t"] < max_age


EPISODE_FIX = {}   # AniList id -> the episode count Kura uses instead of AniList's (fix_episodes)


def watchlist_count(d):
    """AniList's own watch list (streamingEpisodes) numbered 1..N with nothing missing, for a finished show that
    claims a few more episodes: Chobits says 26, its watch list (and every release) has 24."""
    eps = d.get("episodes")
    if d.get("status") != "FINISHED" or not eps:
        return None
    nums = set()
    for se in d.get("streamingEpisodes") or []:
        m = re.search(r"(?:episode|ep\.?)\s*(\d+)", se.get("title") or "", re.IGNORECASE)
        if m:
            nums.add(int(m.group(1)))
    if not nums:
        return None
    top = max(nums)
    if nums == set(range(1, top + 1)) and eps * 0.75 <= top < eps:
        return top
    return None


SHARED_STILLS = {}   # AniList id -> the id whose episode list it is (several seasons given the same list)


def stills_key(m):
    return tuple(sorted(se.get("thumbnail") or se.get("title") or "" for se in m.get("streamingEpisodes") or []))


def learn_shared_stills(media_by_id):
    """Seasons AniList gives the very same watch list (KONOSUBA S1 and S2: one Crunchyroll listing that only covers
    season 1): the list is the earliest season's. Later seasons don't use its pictures and titles (they showed season
    1's: frames from your own files instead)."""
    groups = {}
    for m in media_by_id.values():
        if isinstance(m, dict) and m.get("id") and len(m.get("streamingEpisodes") or []) >= 2:
            groups.setdefault(stills_key(m), []).append(m)
    order = {"WINTER": 0, "SPRING": 1, "SUMMER": 2, "FALL": 3}
    for ms in groups.values():
        if len(ms) > 1:
            ms = sorted(ms, key=lambda m: (m.get("seasonYear") or 9999, order.get(m.get("season"), 4), m["id"]))
            owner = ms[0]
            nums = list_numbers(owner)
            if nums and min(nums) > (owner.get("episodes") or 10 ** 6):   # numbered on (Apothecary Diaries 25-48):
                start = 0                                                  # the season those numbers continue into
                for m in ms:
                    if min(nums) == start + 1:
                        owner = m
                        break
                    start += m.get("episodes") or 0
            for m in ms:
                SHARED_STILLS[m["id"]] = owner["id"]


def list_numbers(m):
    """Episode numbers in an AniList watch list's titles ("Episode 25 - ...")."""
    out = []
    for se in m.get("streamingEpisodes") or []:
        x = re.search(r"(?:episode|ep\.?)\s*(\d+)", se.get("title") or "", re.IGNORECASE)
        if x:
            out.append(int(x.group(1)))
    return out


def fix_episodes(media_by_id):
    """Put the episode count Kura trusts into these media dicts (AniList's own is kept as "episodes_anilist"):
    yours (show page → status menu → Episode count…) first, else AniList's complete watch list. A watch list that
    belongs to an earlier season (SHARED_STILLS) is set aside as "streamingEpisodes_shared"."""
    mine = (APP.get("settings") or {}).get("episode_counts") or {}
    for mid, m in media_by_id.items():
        if not isinstance(m, dict) or not m.get("id"):
            continue
        owner = SHARED_STILLS.get(m["id"])
        if owner and owner != m["id"] and m.get("streamingEpisodes"):
            m["streamingEpisodes_shared"], m["streamingEpisodes"] = m["streamingEpisodes"], []
        orig = m.get("episodes_anilist", m.get("episodes"))
        split = org.EPISODE_SPLIT.get(str(m["id"]))   # two-in-one: AniList's 24 are 12 files
        n = (mine.get(str(m["id"])) or (-(-orig // split) if split and orig else None) or EPISODE_FIX.get(m["id"])
             or watchlist_count(dict(m, episodes=orig)))
        if n and n != orig:
            EPISODE_FIX[m["id"]] = n
            m["episodes_anilist"], m["episodes"] = orig, n
        elif "episodes_anilist" in m and not n:
            m["episodes"] = m.pop("episodes_anilist")


def details_by_id():
    """Saved details as {id: media}, with the episode counts Kura trusts (fix_episodes). Made again only when the
    file changed (it's several MB: reading it on every To download / Torrents / Schedule visit cost ~0.15 s)."""
    data = details_file()   # (learn_shared_stills + fix_episodes already ran on it)
    if _DETAILS_CACHE.get("by_id_key") != _DETAILS_CACHE.get("key") or "by_id" not in _DETAILS_CACHE:
        _DETAILS_CACHE["by_id"] = {int(k): v["data"] for k, v in data.items() if (v or {}).get("data")}
        _DETAILS_CACHE["by_id_key"] = _DETAILS_CACHE.get("key")
    return dict(_DETAILS_CACHE["by_id"])


def fix_list_episodes(account):
    """The same for your list's copies of each show (they have no watch list: the saved details tell)."""
    details_file()
    if account is not None:
        fix_episodes({mid: e.get("media") for mid, e in account.entries.items() if e.get("media")})


def fetch_details(ids, force=False):
    """{id: AniList media} for all ids, in one request for whatever isn't cached."""
    ids = list(dict.fromkeys(i for i in ids if i))
    with _store_lock:
        store = _read_json(DETAILS_FILE)
    need = [i for i in ids if not _is_fresh(store.get(str(i)), force)]
    fetched = {}
    for start in range(0, len(need), 50):
        data = org.anilist(QUERY_DETAILS, {"ids": need[start:start + 50]})
        for m in ((data or {}).get("Page") or {}).get("media") or []:
            fetched[str(m["id"])] = {"t": time.time(), "v": DETAILS_VERSION, "data": m}
    if fetched:
        with _store_lock:
            store = _read_json(DETAILS_FILE)
            store.update(fetched)
            _write_json(DETAILS_FILE, store)
    out = {i: store[str(i)]["data"] for i in ids if str(i) in store}
    learn_shared_stills({k: (v or {}).get("data") for k, v in store.items()})
    fix_episodes(out)
    return out


# ---- characters (show pages; cached like details, in their own file: descriptions are long)
CHAR_FILE = SCRIPT_DIR / "anilist_characters.json"
CHAR_DAYS = 30
QUERY_CHARS = """query ($ids: [Int]) { Page(perPage: 10) { media(id_in: $ids) { id
  characters(sort: [ROLE, RELEVANCE, ID], perPage: 25) { pageInfo { total }
    edges { role node { id name { full native } image { large } description(asHtml: false) age gender siteUrl }
      voiceActors(language: JAPANESE, sort: [RELEVANCE, ID]) { id name { full native } image { large } siteUrl } } } } } }"""
_char_lock = threading.Lock()
_char_mem = {}


def characters_store():
    """anilist_characters.json, read again only when it changed."""
    try:
        st = CHAR_FILE.stat()
        key = (st.st_size, st.st_mtime)
    except OSError:
        return {}
    if _char_mem.get("key") != key:
        _char_mem.update(key=key, data=_read_json(CHAR_FILE), vas=None)
    return _char_mem["data"]


def fetch_characters(ids, force=False, offline=False):
    """{id: {"total", "edges"}} for AniList entries; asked 10 entries per request for what isn't cached (30 days)."""
    ids = [i for i in dict.fromkeys(ids) if i]
    store = characters_store()
    need = [] if offline else [i for i in ids if force or not store.get(str(i))
                               or time.time() - store[str(i)].get("t", 0) > CHAR_DAYS * 86400]
    fetched = {}
    for start in range(0, len(need), 10):
        data = org.anilist(QUERY_CHARS, {"ids": need[start:start + 10]})
        for m in ((data or {}).get("Page") or {}).get("media") or []:
            c = m.get("characters") or {}
            fetched[str(m["id"])] = {"t": time.time(), "total": (c.get("pageInfo") or {}).get("total"),
                                     "edges": c.get("edges") or []}
        for i in need[start:start + 10]:   # nothing on AniList: remembered too
            fetched.setdefault(str(i), {"t": time.time(), "total": 0, "edges": []})
    if fetched:
        with _char_lock:
            disk = _read_json(CHAR_FILE)
            disk.update(fetched)
            _write_json(CHAR_FILE, disk)
        store = characters_store()
    return {i: store[str(i)] for i in ids if str(i) in store}


def show_characters(seasons, offline=False):
    """One list for a show: [(label, AniList id)] of its seasons → characters by id, main ones first, each with
    its voice actor and the seasons it's in."""
    data = fetch_characters([sid for _, sid in seasons], offline=offline)
    out, total = {}, 0
    for label, sid in seasons:
        got = data.get(sid) or {}
        total = max(total, got.get("total") or 0)
        for e in got.get("edges") or []:
            n = e.get("node") or {}
            if not n.get("id"):
                continue
            c = out.get(n["id"])
            if c is None:
                va = (e.get("voiceActors") or [None])[0] or {}
                c = out[n["id"]] = {"id": n["id"], "name": (n.get("name") or {}).get("full") or "?",
                                    "native": (n.get("name") or {}).get("native") or "",
                                    "image": (n.get("image") or {}).get("large"), "desc": n.get("description") or "",
                                    "age": n.get("age"), "gender": n.get("gender"), "url": n.get("siteUrl"),
                                    "main": False, "seasons": [], "order": len(out),
                                    "va": {"id": va.get("id"), "name": (va.get("name") or {}).get("full") or "",
                                           "native": (va.get("name") or {}).get("native") or "",
                                           "image": (va.get("image") or {}).get("large"), "url": va.get("siteUrl")}
                                    if va else None}
            c["main"] = c["main"] or e.get("role") == "MAIN"
            if label not in c["seasons"]:
                c["seasons"].append(label)
    chars = sorted(out.values(), key=lambda c: (not c["main"], c["order"]))
    return chars, max(total, len(chars))


def voice_roles(va_id):
    """Every character this voice actor plays in the shows Kura has cached: [(character name, AniList id)]."""
    store = characters_store()
    if _char_mem.get("vas") is None:
        vas = {}
        for mid, got in store.items():
            for e in got.get("edges") or []:
                for va in e.get("voiceActors") or []:
                    if va.get("id"):
                        vas.setdefault(va["id"], []).append(((e.get("node") or {}).get("name") or {}).get("full") or "?")
                        vas[va["id"]][-1] = (vas[va["id"]][-1], int(mid))
        _char_mem["vas"] = vas
    return _char_mem["vas"].get(va_id, [])


def save_lookup_cache(cache):
    """Merge what we looked up into anilist_cache.json without dropping what a
    running job may have written meanwhile."""
    with _store_lock:
        disk = org.load_cache()
        disk.update(cache)
        org.save_cache(disk)


def episode_numbers(ep):
    """anitopy's episode_number -> list of ints ('05' -> [5], ['01', '12'] -> 1..12)."""
    vals = ep if isinstance(ep, list) else [ep]
    nums = []
    for v in vals:
        try:
            nums.append(int(str(v)))
        except (TypeError, ValueError):
            return []   # 12.5, None, ...: not a regular episode
    if isinstance(ep, list) and len(nums) == 2 and 0 < nums[1] - nums[0] < 500:
        return list(range(nums[0], nums[1] + 1))
    return nums


NOT_EPISODES = {"SP", "SPECIAL", "OVA", "OAD", "ONA", "NCOP", "NCED", "OP", "ED", "PV", "CM", "EXTRA", "MOVIE"}
JUNK_KEEP = {".ass", ".ssa", ".srt", ".sup", ".vtt", ".idx", ".sub", ".ttf", ".otf", ".ttc", ".woff", ".woff2", ".mka"}


VERSION_PREFS = {}   # folder holding version folders -> the version you play (MainWindow: settings["version_prefs"])


class SeasonGroup:
    """One season kept as side-by-side folders ("Season 1 - Korean", "Season 1 - Japanese"): behaves like a
    season folder whose versions are those folders. str() is the key your version choice is saved under."""

    def __init__(self, show_dir, n, folders):
        self.show_dir, self.n, self.folders = Path(show_dir), n, dict(folders)
        self.name = f"Season {n}"

    def __str__(self):
        return str(self.show_dir / f"Season {self.n}")

    def __fspath__(self):
        return str(next(iter(self.folders.values())))   # "Open folder": the first version's folder


def align_versions(versions):
    """Versions numbered differently (Crunchyroll's S02E13-24 for the same 12 episodes): a version whose numbers
    all come after another version's run and fit inside it is counted from 1 like the others."""
    starts_at_one = [eps for eps in versions.values() if eps and min(eps) == 1]
    if not starts_at_one:
        return versions
    span = max(max(eps) for eps in starts_at_one)
    out = {}
    for name, eps in versions.items():
        if eps and min(eps) > span and max(eps) - min(eps) < span:
            shift = min(eps) - 1
            eps = {n - shift: f for n, f in eps.items()}
        out[name] = eps
    return out


def version_order(folder, versions):
    """Version names, the one to play first: your choice for this folder, else uncensored / extended / Blu-ray
    over normal / censored / TV, then the most complete."""
    pref = VERSION_PREFS.get(str(folder))
    ranked = sorted(versions, key=lambda n: (-org.version_rank(n), -len(versions[n]), n.lower()))
    if pref in versions:
        ranked.remove(pref)
        ranked.insert(0, pref)
    return ranked


def version_note(path):
    """"  ·  Normal version" when an episode plays from another version than the one you picked."""
    parent = Path(path).parent
    sv = org.season_version(parent.name)
    if sv:   # "Season 1 - Japanese" next to "Season 1 - Korean"
        group = org.season_version_groups(parent.parent).get(sv[0])
        if group:
            g = SeasonGroup(parent.parent, sv[0], group)
            versions = local_versions(g)
            if len(versions) > 1 and version_order(g, versions)[0] != sv[1]:
                return f"  ·  {sv[1]}"
        return ""
    versions = local_versions(parent.parent) if org.is_version_folder(parent.name) else {}
    if len(versions) > 1 and version_order(parent.parent, versions)[0] != parent.name:
        return f"  ·  {parent.name}"
    return ""


def local_versions(folder):
    """{version name: {episode: file}} for the version folders in a season folder, or the side-by-side season
    folders of a SeasonGroup (empty when there are none)."""
    if folder is None:
        return {}
    dirs = folder.folders if isinstance(folder, SeasonGroup) else org.version_dirs(folder)
    return align_versions({name: _plain_videos(d)[0] for name, d in dirs.items()})


def one_episode(found, total, fmt=None):
    """(eps, others) from local_videos: a one-episode entry (special, movie) whose folder holds a single video with
    no number ("Chobits - Bonus - Sumomo and Kotoko deliver.mkv") has that video as episode 1."""
    eps, others = found
    videos = [f for f in others if recap_number(f) is None]
    if not eps and (total == 1 or total is None and fmt == "MOVIE") and len(videos) == 1:
        return {1: videos[0]}, [f for f in others if f != videos[0]]
    return eps, others


def local_videos(folder):
    """({episode number: file}, [files without a number]) for one season folder. A folder kept in versions
    (Normal / Hyper Sexy...) gives each episode from your preferred version, else from another one."""
    eps, others = _plain_videos(folder)
    versions = local_versions(folder)
    if versions:
        for name in version_order(folder, versions):
            for n, f in versions[name].items():
                eps.setdefault(n, f)
    return eps, others


def _plain_videos(folder):
    eps, others = {}, []
    if folder is None or isinstance(folder, SeasonGroup):
        return eps, others
    try:
        files = sorted(f for f in folder.iterdir() if f.is_file() and f.suffix.lower() in org.VIDEO_EXTS)
    except OSError:
        return eps, others
    parsed = [(f, org.parse(f.name)) for f in files]
    tagged = {f for f, pr in parsed if {x.upper() for x in pr[2] or ()} & NOT_EPISODES}
    # specials and extras aren't a season's episodes ("One Piece - Egghead SP1" isn't episode 1), but in a
    # folder of only OVAs / specials ("Bikini Warriors - 14 (OVA)") they're the episodes
    regular = any(f not in tagged and episode_numbers(pr[3]) for f, pr in parsed)
    for f, pr in parsed:
        nums = [] if (regular and f in tagged) else episode_numbers(pr[3])
        for n in nums:
            eps.setdefault(n, str(f))
        if not nums:
            others.append(str(f))
    return eps, others


def recap_number(path):
    """8.5 for "Chobits - 8.5.mkv": a recap between two episodes (not an episode: never counted or tracked)."""
    try:
        ep = org.parse(Path(path).name)[3]
        n = float(str(ep).strip()) if ep is not None and not isinstance(ep, list) else None
    except (ValueError, TypeError):
        return None
    return n if n is not None and n != int(n) and n > 0 else None


def aired_count(d):
    if not d:
        return None
    if d.get("status") == "NOT_YET_RELEASED":
        return 0
    nxt = d.get("nextAiringEpisode")
    if nxt and nxt.get("episode"):
        return nxt["episode"] - 1
    if d.get("status") == "RELEASING":
        # still airing but AniList has no date for the next one: not every planned episode is out (Cheng Ye Xiao He,
        # 16 planned, 12 aired). The last one logged as aired, else don't guess.
        now = time.time()
        logged = [int(k) for k, ts in (_cached_air_log().get(str(d.get("id"))) or {}).items()
                  if ts <= now and k.isdigit()]
        return max(logged) if logged else None
    return d.get("episodes")


_AIR_LOG_CACHE = {"mtime": None, "data": {}}


def _cached_air_log():
    """airing_log.json, read again only when it changed (aired_count runs for every show, often)."""
    try:
        mtime = AIR_LOG_FILE.stat().st_mtime
    except OSError:
        return {}
    if _AIR_LOG_CACHE["mtime"] != mtime:
        _AIR_LOG_CACHE.update(mtime=mtime, data=_read_json(AIR_LOG_FILE))
    return _AIR_LOG_CACHE["data"]


def when(ts):
    dt = datetime.fromtimestamp(ts)
    days = (dt.date() - datetime.now().date()).days
    rel = "today" if days == 0 else "tomorrow" if days == 1 else f"in {days} days" if days > 1 else ""
    return f"{dt.strftime('%a %d %b, %H:%M')}" + (f" ({rel})" if rel else "")


def season_label(d):
    if d and d.get("season") and d.get("seasonYear"):
        return f"{d['season'].title()} {d['seasonYear']}"
    return str(d.get("seasonYear") or "") if d else ""


def clean_description(s):
    if not s:
        return ""
    s = re.sub(r"<br\s*/?>", "\n", s, flags=re.IGNORECASE)
    s = re.sub(r"<[^>]+>", "", s)
    s = html.unescape(s)
    return re.sub(r"\n{3,}", "\n\n", s).strip()


HAVE, MISSING, UPCOMING = "have", "missing", "upcoming"


def extras_skipped(path):
    """You said "not this one" for this extra (Live TV doesn't use it). Menus are never used."""
    skip = (APP.get("settings") or {}).get("extras_skip") or []
    return os.path.normcase(str(path)) in skip


def extras_index(extras_dir):
    """{kind: {season label or "": [files]}} for a show's Extras folder (Extras / <kind> / [season] / file);
    files still loose in Extras get their kind from their name."""
    out = {}
    try:
        files = sorted(f for f in Path(extras_dir).rglob("*") if f.is_file() and f.suffix.lower() in org.VIDEO_EXTS)
    except OSError:
        return out
    by_folder = {v: k for k, v in org.EXTRA_KIND_FOLDERS.items()}
    for f in files:
        rel = f.relative_to(extras_dir).parts[:-1]
        if rel and rel[0] in by_folder:
            kind, label = by_folder[rel[0]], " / ".join(rel[1:])
        else:
            kind, label = org.extra_kind(f.name, list(reversed(rel))) or "bonus", " / ".join(rel)
        out.setdefault(kind, {}).setdefault(label, []).append(str(f))

    def order(lbl):   # the whole show first, then Season 1, 2, 3…, then OVA / side-story folders by name
        m = re.match(r"season\s*0*(\d+)", lbl, re.I)
        return (0, 0, "") if not lbl else (1, int(m.group(1)), lbl) if m else (2, 0, lbl.lower())
    return {k: dict(sorted(g.items(), key=lambda kv: order(kv[0]))) for k, g in out.items()}


def build_extras_section(extras_dir):
    """The show page's Extras block: openings & endings, previews, commercials, menus, bonus (by season)."""
    idx = extras_index(extras_dir)
    n = sum(len(v) for g in idx.values() for v in g.values())
    kinds = [(k, org.EXTRA_KIND_FOLDERS[k], idx[k]) for k in org.EXTRA_KIND_FOLDERS if k in idx]
    return {"title": "Extras", "subtitle": "  ·  ".join(f"{len([x for v in g.values() for x in v])} {name.lower()}"
                                                      for _, name, g in kinds),
            "chips": [], "versions": {}, "folder": str(extras_dir), "badge": (f"{n} video{'s' if n != 1 else ''}", "muted"),
            "have": n, "missing": 0, "aired": None, "total": None, "id": None, "cover": None, "has_folder": True,
            "counted": False, "files": n, "media": None, "extras": kinds}


def build_section(title, d, folder, offset=None, count_missing=True):
    """One season (or OVAs/Movies...) block: episode chips and a status badge."""
    total = d.get("episodes") if d else None
    eps, others = one_episode(local_videos(folder), total, (d or {}).get("format"))
    aired = aired_count(d)
    nxt = (d or {}).get("nextAiringEpisode") or {}
    eps = shift_episodes(eps, offset, total) if offset else fit_numbering(eps, total)

    upto = max(total or 0, aired or 0, max(eps, default=0)) if count_missing else max(eps, default=0)
    chips, missing = [], 0
    for n in range(1, upto + 1):
        if n in eps:
            chips.append((str(n), HAVE, Path(eps[n]).name, eps[n]))
        elif count_missing and (aired is None or n <= aired):
            chips.append((str(n), MISSING, f"Episode {n} · not downloaded", None))
            missing += 1
        elif count_missing:
            tip = f"Episode {n} airs {when(nxt['airingAt'])}" if nxt.get("episode") == n else f"Episode {n} · not aired yet"
            chips.append((str(n), UPCOMING, tip, None))
    for f in others:
        r = recap_number(f)
        if r is not None:   # a recap goes right after its episode: 8 · 8.5 · 9
            at = next((i + 1 for i, c in enumerate(chips) if c[0] == str(int(r))), len(chips))
            chips.insert(at, (f"{r:g}", HAVE, f"Recap · {Path(f).name}", f))
            continue
        chips.append(("▶", HAVE, Path(f).name, f))

    have = sum(1 for c in chips if c[1] == HAVE and not str(c[2]).startswith("Recap · "))   # recaps aren't episodes
    if not count_missing:
        badge = (f"{have} file{'s' if have != 1 else ''}", "muted")
    elif folder is None:
        badge = ("Upcoming", "muted") if aired == 0 else ("Not downloaded", "bad")
    elif missing:
        badge = (f"{missing} missing", "warn")
    elif d and d.get("status") == "RELEASING":
        badge = ("Up to date", "accent")
    else:
        badge = ("Complete", "ok")

    parts = []
    if d:
        t = d.get("title") or {}
        name = t.get("english") if org.TITLE_LANGUAGE == "english" else t.get("romaji")
        parts += [name or t.get("romaji") or "", season_label(d)]
        if total:
            parts.append(f"{total} episodes")
        if nxt.get("episode"):
            parts.append(f"ep {nxt['episode']} airs {when(nxt['airingAt'])}")
    elif title.startswith("Season"):
        parts.append("Not matched to an AniList season")
    versions = local_versions(folder)
    if len(versions) > 1:
        order = version_order(folder, versions)
        versions = {n: (len(shift_episodes(versions[n], offset, total)), n == order[0]) for n in order}
    else:
        versions = {}
    return {"title": title, "subtitle": "  ·  ".join(p for p in parts if p), "chips": chips,
            "versions": versions, "folder": str(folder) if folder else None,
            "badge": badge, "have": have, "missing": missing, "aired": aired,
            "total": total, "id": (d or {}).get("id"), "cover": ((d or {}).get("coverImage") or {}).get("extraLarge"),
            "has_folder": folder is not None, "counted": count_missing, "files": eps, "media": d}


class DetailLoader(QThread):
    loaded = Signal(int, dict)
    image = Signal(int, str, QImage)

    def __init__(self, load_id, path, force=False, media_id=None, name=None):
        super().__init__()
        self.load_id = load_id
        self.path = Path(path) if path else None   # None = a show you don't have downloaded
        self.name = name or (self.path.name if self.path else "?")
        self.force = force
        self.media_id = media_id   # match already known (e.g. from your AniList list)

    def run(self):
        try:
            result = self.load()
        except Exception:
            org.log.exception(f"Couldn't load details for {self.name}")
            result = {"name": self.name, "path": str(self.path) if self.path else None,
                      "error": "Something went wrong, see the log.", "sections": [], "hero": None}
        self.loaded.emit(self.load_id, result)
        self.load_images(result)

    def load(self):
        name, show_dir = self.name, self.path
        cache = org.load_cache()
        entry = org.fetch_by_id(self.media_id, cache) if self.media_id else None
        if entry is None:
            entry, _ = org.lookup(name, None, cache)
        smap = org.season_map(entry, cache) if entry else None
        seasons = list((smap or {}).get("seasons") or [])
        for n, mid in org.SEASON_COVERS.get(name.lower(), {}).items():   # same per-show season fixes
            e = org.fetch_by_id(mid, cache)
            if e:
                seasons += [None] * (n - len(seasons))
                seasons[n - 1] = e
        if not seasons and entry:   # an OVA / ONA / movie with no TV seasons (most hentai): it is season 1
            seasons = [entry]       # (like library_index does), so "Season 1" isn't "not matched"
        standalone = bool(entry and entry.get("format") not in org.TV_FORMATS
                          and entry["id"] not in [s["id"] for s in seasons if s])
        if standalone:   # its own folder inside a TV franchise (Legend of Crimson): this page is the movie, not the TV
            seasons = [entry]
        save_lookup_cache(cache)

        # Local folders: seasons ("Season 2", "Season 2 - The Evil Eye", or named after the season),
        # then everything else: generic OVAs / Specials folders, extras
        fam = org.show_family(entry, cache) if entry else None
        local_seasons, local_other, extra_entries = {}, [], {}
        groups = org.season_version_groups(show_dir) if show_dir else {}
        grouped = {p for g in groups.values() for p in g.values()}
        try:
            subs = sorted(show_dir.iterdir() if show_dir else [], key=lambda p: p.name.lower())
        except OSError:
            subs = []
        mine = org.FOLDER_SEASONS.get(show_dir.name.lower(), {}) if show_dir else {}   # Edit info: "counts as"
        for c in subs:
            if not c.is_dir() or org.is_link(c) or c.name in (org.SPINOFF_FOLDER, org.SIDE_STORY_FOLDER) or c in grouped:
                continue
            if mine.get(c.name) and mine[c.name] not in local_seasons:
                local_seasons[mine[c.name]] = c
                continue
            k = org.classify_folder(c.name, fam)
            if k and k.get("season") and k["season"] not in local_seasons:
                local_seasons[k["season"]] = c
                continue
            local_other.append(c)
            if k and k.get("kind"):
                extra_entries[c] = (smap or {}).get(k["kind"])
        extra_entries = {c: e for c, e in extra_entries.items() if e}
        for n, g in groups.items():
            local_seasons[n] = SeasonGroup(show_dir, n, g)
        single = standalone or (entry is not None and [s["id"] for s in seasons if s] == [entry["id"]])
        if single and show_dir and not local_seasons:   # one entry's file in its Movies / OVAs / Specials folder
            holder = media_holder(show_dir)
            if holder is not None:
                local_seasons[1] = holder
                local_other = [c for c in local_other if c != holder]
                extra_entries.pop(holder, None)
        if show_dir and not local_seasons:
            root_versions = org.version_dirs(show_dir)
            loose = any(_plain_videos(show_dir))   # numbered or not (a special's one file), like season_folders
            if root_versions or loose:   # episodes right in the show folder, or in version folders there
                local_seasons[1] = show_dir
                local_other = [c for c in local_other if c not in root_versions.values()]
        save_lookup_cache(cache)
        ids = [entry and entry["id"]] + [s["id"] for s in seasons if s] + [e["id"] for e in extra_entries.values() if e]
        details = fetch_details(ids, self.force) if entry else {}

        sections, offset = [], 0
        for n in range(1, max([len(seasons), *local_seasons.keys()], default=0) + 1):
            s = seasons[n - 1] if n <= len(seasons) else None
            d = details.get(s["id"]) if s else None
            if s is None and n not in local_seasons:
                continue
            # Without AniList data there's nothing to compare against, so just list the files
            one = n == 1 and entry is not None and entry.get("format") not in org.TV_FORMATS and len(seasons) == 1
            head = FORMAT_TEXT.get(entry.get("format"), "Season 1") if one else f"Season {n}"   # "OVA", "Movie"...
            sec = build_section(head, d, local_seasons.get(n), offset, count_missing=d is not None)
            sec["n"] = n   # which season it is (Edit info: "counts as", this season's AniList entry)
            sections.append(sec)
            count = sec["total"] or sec["aired"]
            offset = offset + count if (offset is not None and count) else None
        for c in local_other:
            if c.name == org.EXTRAS_FOLDER:   # openings, previews, commercials... by kind (and season)
                sections.append(build_extras_section(c))
                continue
            e = extra_entries.get(c)
            d = details.get(e["id"]) if e else None
            sections.append(build_section(c.name, d, c, count_missing=d is not None))
        if not sections and entry and details.get(entry["id"]):
            # Movie / OVA / single entry with no TV seasons: one block for the entry itself
            d = details[entry["id"]]
            sections.append(build_section(FORMAT_TEXT.get(d.get("format"), "Episodes"), d, None))

        hero_entry = next((s for s in seasons if s), None) or entry
        hero = details.get(hero_entry["id"]) if hero_entry else None
        season_details = [details.get(s["id"]) for s in seasons if s and details.get(s["id"])]
        banner = (hero or {}).get("bannerImage") or next((d["bannerImage"] for d in season_details if d.get("bannerImage")), None)
        trailer = next((d["trailer"] for d in [hero or {}, *season_details]
                        if (d.get("trailer") or {}).get("site") in ("youtube", "dailymotion")), None)

        # Recommendations, like AniList's: every season's, added up (users' ratings), minus the show itself
        own = {e["id"] for e in seasons if e} | {entry["id"]} if entry else set()
        if fam:
            own |= {m["entry"]["id"] for m in fam["members"]}
        recs = {}
        for d in [details.get(i) for i in ids if i] + list(season_details):
            for node in (((d or {}).get("recommendations") or {}).get("nodes") or []):
                m = node.get("mediaRecommendation")
                if not m or m["id"] in own:
                    continue
                r = recs.setdefault(m["id"], {"media": m, "rating": 0, "seen": set()})
                if d["id"] not in r["seen"]:
                    r["seen"].add(d["id"])
                    r["rating"] += max(0, node.get("rating") or 0)
        recs = sorted(recs.values(), key=lambda r: -r["rating"])[:18]

        try:   # characters of every season (cached in anilist_characters.json)
            chars, char_total = show_characters([(f"Season {n}", s["id"]) for n, s in enumerate(seasons, 1) if s]
                                                or ([("", entry["id"])] if entry else []))
        except Exception:
            org.log.exception(f"Couldn't load the characters of {name}")
            chars, char_total = [], 0

        try:
            relations = self.relations(seasons, entry, sections, cache, details)
        except Exception:
            org.log.exception(f"Couldn't load the relations of {name}")
            relations = []

        counted = [s for s in sections if s["counted"]]
        return {
            "relations": relations,
            "characters": chars, "char_total": char_total,
            "recs": [{"media": r["media"], "rating": r["rating"]} for r in recs],
            "name": name, "path": str(show_dir) if show_dir else None, "media_id": self.media_id,
            "hero": hero, "banner": banner,
            "seasons": season_details, "sections": sections, "trailer": trailer,
            "have": sum(s["have"] for s in counted), "missing": sum(s["missing"] for s in counted),
            "seasons_have": sum(1 for s in counted if s["has_folder"]),
            "seasons_out": sum(1 for s in counted if s["aired"] != 0),
            "error": None if entry else "Couldn't find this show on AniList. If the folder name is unusual, "
                                        "press Edit info and pick the right entry.",
        }

    REL_ORDER = ["PARENT", "PREQUEL", "SEQUEL", "SIDE_STORY", "SUMMARY", "ALTERNATIVE", "SPIN_OFF", "COMPILATION",
                 "CONTAINS", "CHARACTER", "OTHER"]
    REL_TEXT = {"PARENT": "MAIN STORY", "PREQUEL": "PREQUEL", "SEQUEL": "SEQUEL", "SIDE_STORY": "SIDE STORY",
                "SUMMARY": "SUMMARY", "ALTERNATIVE": "ALTERNATIVE", "SPIN_OFF": "SPIN-OFF", "COMPILATION": "COMPILATION",
                "CONTAINS": "CONTAINS", "CHARACTER": "SHARES CHARACTERS", "OTHER": "OTHER"}

    def relations(self, seasons, entry, sections, cache, details):
        """AniList's relations of this show's seasons (like its Relations section), minus what this page already
        shows as a season or a folder: [{id, rel, text, title, format, year, episodes, cover}], story first."""
        shown = {e["id"] for e in seasons if e} | {s["id"] for s in sections if s.get("id") and s.get("has_folder")}
        found = {}
        for src in [e for e in seasons if e] or ([entry] if entry else []):
            if self.isInterruptionRequested():
                break
            info = org.media_relations(src["id"], cache)   # cached in anilist_cache.json ("rel:<id>")
            for rtype, node in (info or {}).get("relations") or []:
                if rtype not in self.REL_TEXT or not node.get("id") or node["id"] in shown:
                    continue
                old = found.get(node["id"])
                if old is None or self.REL_ORDER.index(rtype) < self.REL_ORDER.index(old["rel"]):
                    d = details.get(node["id"]) or {}
                    found[node["id"]] = {"id": node["id"], "rel": rtype, "text": self.REL_TEXT[rtype],
                                         "title": {"romaji": node.get("romaji"), "english": node.get("english")},
                                         "format": node.get("format") or d.get("format"),
                                         "year": d.get("seasonYear") or (d.get("startDate") or {}).get("year"),
                                         "episodes": d.get("episodes"), "cover": node.get("cover")}
        save_lookup_cache(cache)
        return sorted(found.values(), key=lambda r: (self.REL_ORDER.index(r["rel"]), r["year"] or 9999))

    def load_images(self, result):
        jobs = []
        hero = result.get("hero") or {}
        own = custom_art(self.path, "banner")
        if own:
            jobs.append(("banner", own, "own_banner"))
        elif result.get("banner"):
            jobs.append(("banner", result["banner"], f"banner_{hero.get('id') or 'x'}"))
        if (hero.get("coverImage") or {}).get("extraLarge"):
            jobs.append(("cover", hero["coverImage"]["extraLarge"], str(hero["id"])))
        trailer = result.get("trailer") or {}
        if trailer.get("site") == "youtube":   # sharp 1280px still, falling back to AniList's small one
            jobs.append(("trailer", f"https://i.ytimg.com/vi/{trailer['id']}/maxresdefault.jpg", f"trailer_{trailer['id']}"))
        if trailer.get("thumbnail"):
            jobs.append(("trailer", trailer["thumbnail"], f"trailer_{trailer['id']}_small"))
        for s in result["sections"]:
            if s["cover"]:
                jobs.append((f"thumb:{s['id']}", s["cover"], str(s["id"])))
        for r in result.get("recs") or []:
            url = (r["media"].get("coverImage") or {}).get("extraLarge")
            if url:
                jobs.append((f"rec:{r['media']['id']}", url, str(r["media"]["id"])))
        for r in result.get("relations") or []:
            if r.get("cover"):
                jobs.append((f"relc:{r['id']}", r["cover"], f"rel_{r['id']}"))
        for c in (result.get("characters") or [])[:40]:   # characters and their voice actors (cover_cache/char_…)
            if c.get("image"):
                jobs.append((f"char:{c['id']}", c["image"], f"char_{c['id']}"))
            va = c.get("va") or {}
            if va.get("image"):
                jobs.append((f"va:{va['id']}", va["image"], f"va_{va['id']}"))
        done = set()
        for key, url, stem in jobs:
            if self.isInterruptionRequested():
                return
            if key in done:
                continue
            suffix = Path(url.split("?")[0]).suffix or ".jpg"
            img = cached_image(url, COVER_DIR / f"{stem}{suffix}")
            if img is not None:
                done.add(key)
                self.image.emit(self.load_id, key, img)


