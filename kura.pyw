CARD_W, POSTER_H, RADIUS = 164, 232, 10
CARD_H = POSTER_H + 54


def cover_pixmap(img, w, h, dpr):
    tw, th = round(w * dpr), round(h * dpr)
    s = img.scaled(tw, th, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
    pm = QPixmap.fromImage(s.copy((s.width() - tw) // 2, (s.height() - th) // 2, tw, th))
    pm.setDevicePixelRatio(dpr)
    return pm


class CoverDelegate(QStyledItemDelegate):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._cache = {}
        self.card_w, self.poster_h = CARD_W, POSTER_H   # grown by LibraryPage.fit_cards

    def set_width(self, w):
        self.card_w, self.poster_h = w, round(w * POSTER_H / CARD_W)
        self._cache.clear()

    def sizeHint(self, option, index):
        return QSize(self.card_w, self.poster_h + CARD_H - POSTER_H)

    def paint(self, p, option, index):
        p.save()
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        r = QRectF(option.rect)
        poster = QRectF(round(r.x() + (r.width() - self.card_w) / 2), r.y() + 2, self.card_w, self.poster_h)
        hover = bool(option.state & QStyle.State_MouseOver)
        selected = bool(option.state & QStyle.State_Selected)
        title = index.data(Qt.DisplayRole) or ""
        img = index.data(COVER_ROLE)

        clip = QPainterPath()
        clip.addRoundedRect(poster, RADIUS, RADIUS)
        p.setClipPath(clip)
        if isinstance(img, QImage) and not img.isNull():
            dpr = p.device().devicePixelRatioF()
            key = (index.data(PATH_ROLE), img.cacheKey(), dpr)
            pm = self._cache.get(key)
            if pm is None:
                pm = self._cache[key] = cover_pixmap(img, self.card_w, self.poster_h, dpr)
            p.drawPixmap(poster.topLeft(), pm)
        else:
            hue = zlib.crc32(title.encode()) % 360
            grad = QLinearGradient(poster.topLeft(), poster.bottomRight())
            grad.setColorAt(0, QColor.fromHsl(hue, 120, 70))
            grad.setColorAt(1, QColor.fromHsl((hue + 40) % 360, 110, 38))
            p.fillRect(poster, grad)
            initials = "".join(w[0] for w in re.findall(r"[A-Za-z0-9]\w*", title)[:2]).upper() or "?"
            f = QFont(option.font)
            f.setPixelSize(44)
            f.setWeight(QFont.Bold)
            p.setFont(f)
            p.setPen(QColor(255, 255, 255, 200))
            p.drawText(poster, Qt.AlignCenter, initials)
        if index.data(NOTDL_ROLE):   # on your list, not in your library: dimmed with a label
            p.fillRect(poster, QColor(15, 17, 21, 130 if not hover else 90))
            f = QFont(option.font)
            f.setPointSizeF(8)
            f.setWeight(QFont.DemiBold)
            p.setFont(f)
            text = "Not downloaded"
            w = QFontMetrics(f).horizontalAdvance(text) + 16
            pill = QRectF(poster.left() + 8, poster.bottom() - 30, w, 22)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(15, 17, 21, 210))
            p.drawRoundedRect(pill, 11, 11)
            p.setPen(QColor(C["muted"]))
            p.drawText(pill, Qt.AlignCenter, text)
        if hover:
            p.fillRect(poster, QColor(255, 255, 255, 16))

        # Progress through the season you're watching
        prog = index.data(PROG_ROLE)
        if prog and prog[1]:
            bar = QRectF(poster.left(), poster.bottom() - 4, poster.width(), 4)
            p.fillRect(bar, QColor(0, 0, 0, 150))
            p.fillRect(QRectF(bar.left(), bar.top(), bar.width() * min(1, prog[0] / prog[1]), 4),
                       QColor(STATUS_COLORS["CURRENT"]))
        p.setClipping(False)

        new = index.data(NEW_ROLE)
        added = (index.data(ADDED_ROLE) or 0) >= time.time() - RECENT_DAYS * 86400
        if new or added:
            f = QFont(option.font)
            f.setPointSizeF(8)
            f.setWeight(QFont.Bold)
            p.setFont(f)
            text = f"{new} new" if new else "Added"
            w = QFontMetrics(f).horizontalAdvance(text) + 14
            pill = QRectF(poster.right() - w - 8, poster.top() + 8, w, 20)
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(C["accent"] if new else C["ok"]))
            p.drawRoundedRect(pill, 10, 10)
            p.setPen(QColor("white" if new else "#08130d"))
            p.drawText(pill, Qt.AlignCenter, text)

        p.setBrush(Qt.NoBrush)
        if hover or selected:
            p.setPen(QPen(QColor(C["accent"]), 2))
            p.drawRoundedRect(poster.adjusted(1, 1, -1, -1), RADIUS - 1, RADIUS - 1)
        else:
            p.setPen(QPen(QColor(255, 255, 255, 18), 1))
            p.drawRoundedRect(poster.adjusted(0.5, 0.5, -0.5, -0.5), RADIUS, RADIUS)

        f = QFont(option.font)
        f.setPointSizeF(9.5)
        f.setWeight(QFont.DemiBold)
        p.setFont(f)
        p.setPen(QColor(C["text"]))
        tr = QRectF(poster.left() + 2, poster.bottom() + 8, self.card_w - 4, 20)
        p.drawText(tr, Qt.AlignLeft | Qt.AlignVCenter,
                   QFontMetrics(f).elidedText(title, Qt.ElideRight, int(tr.width())))

        f2 = QFont(option.font)
        f2.setPointSizeF(8.5)
        p.setFont(f2)
        sr = tr.translated(0, 19)
        status = index.data(STATUS_ROLE)
        if status:   # coloured dot = your AniList status
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(STATUS_COLORS.get(status, C["muted"])))
            p.drawEllipse(QRectF(sr.left(), sr.center().y() - 3, 6, 6))
            sr.setLeft(sr.left() + 12)
        p.setPen(QColor(C["muted"]))
        p.drawText(sr, Qt.AlignLeft | Qt.AlignVCenter,
                   QFontMetrics(f2).elidedText(index.data(SUB_ROLE) or "", Qt.ElideRight, int(sr.width())))
        p.restore()


def show_state(index, account):
    """(status, unwatched downloaded episodes, (progress, total) or None, next episode or None)
    for one show folder, combining your AniList list with what's on disk."""
    if not index or not account or not account.connected:
        return None, 0, None, None
    on_list = [account.entry(i) for i in index["chain"] if account.entry(i)]
    if not on_list:
        status = None
    elif any(e["status"] in ("CURRENT", "REPEATING") for e in on_list):
        status = "CURRENT"
    else:
        status = on_list[-1]["status"]   # latest season on your list
    new, prog, nxt, prev_done = 0, None, None, False
    last_update = max((e.get("updatedAt") or 0 for e in on_list), default=0)
    for n, sid in enumerate(index["seasons"], 1):
        if not sid:
            continue
        e = account.entry(sid)
        eps = index["local"].get(sid, {})
        st, p = (e or {}).get("status"), (e or {}).get("progress") or 0
        if st in ("CURRENT", "REPEATING"):
            new += sum(1 for k in eps if k > p)
            if prog is None:
                prog = (p, (e.get("media") or {}).get("episodes"))
            if nxt is None and (p + 1) in eps:
                nxt = {"season": n, "ep": p + 1, "path": eps[p + 1], "updated": e.get("updatedAt") or 0}
        elif st is None and prev_done and nxt is None and 1 in eps:
            # Finished the last season and the next one is already downloaded
            nxt = {"season": n, "ep": 1, "path": eps[1], "updated": last_update}
        prev_done = st == "COMPLETED"
    return status, new, prog, nxt


RECENT_DAYS = 14   # Library "Recently added": the show's first file arrived within this many days
LIB_FORMATS = {"TV": ("TV", "TV_SHORT", "ONA"), "MOVIE": ("MOVIE",), "OVA": ("OVA", "SPECIAL", "MUSIC")}
LIB_FORMAT_TEXT = {"TV": "TV", "MOVIE": "Movies", "OVA": "OVAs and specials"}
LIB_STATUS_TEXT = {"CURRENT": "Watching", "PLANNING": "Planning", "COMPLETED": "Completed", "PAUSED": "Paused",
                   "DROPPED": "Dropped", "NONE": "Not on my list"}


def lib_view_match(view, it_data):
    """Library quick chips: does a show (data(role) getter) belong to this view?"""
    if view == "NEW":
        return (it_data(NEW_ROLE) or 0) > 0
    if view == "ADDED":
        return (it_data(ADDED_ROLE) or 0) >= time.time() - RECENT_DAYS * 86400
    if view == "NOTSTARTED":
        prog = it_data(PROG_ROLE)
        return it_data(STATUS_ROLE) in (None, "PLANNING") and not it_data(NOTDL_ROLE) or bool(prog and not prog[0])
    if view == "FINISHED":
        return it_data(STATUS_ROLE) == "COMPLETED"
    return True


class LibraryFilter(QSortFilterProxyModel):
    """Library grid: quick chip (view), the Filters pop-over (your list / format / genre / years) and the search,
    sorted by title, newest episode or recently added (user's pick: Library A + Filters pop-over, Oct 2026)."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.view = "ALL"
        self.statuses, self.formats, self.genres = set(), set(), set()
        self.years = (None, None)
        self.sort_key = "title"

    def refilter(self):
        """Re-run filterAcceptsRow (Qt 6.10+ way of saying the filter changed)."""
        self.beginFilterChange()
        self.endFilterChange()

    def active(self):
        """How many pop-over filters are on (the Filters button's count)."""
        return len(self.statuses) + len(self.formats) + len(self.genres) + (1 if any(self.years) else 0)

    def filterAcceptsRow(self, row, parent):
        idx = self.sourceModel().index(row, 0, parent)
        if not lib_view_match(self.view, idx.data):
            return False
        if self.statuses:
            st = idx.data(STATUS_ROLE)
            st = "NONE" if not st else "CURRENT" if st == "REPEATING" else st
            if st not in self.statuses:
                return False
        meta = idx.data(META_ROLE) or {}
        if self.formats and not any(meta.get("format") in LIB_FORMATS[f] for f in self.formats):
            return False
        if self.genres and not self.genres <= set(meta.get("genres") or ()):
            return False
        lo, hi = self.years
        if lo or hi:
            y = meta.get("year")
            if not y or (lo and y < lo) or (hi and y > hi):
                return False
        return super().filterAcceptsRow(row, parent)

    def lessThan(self, a, b):
        if self.sort_key in ("latest", "added"):
            role = LATEST_ROLE if self.sort_key == "latest" else ADDED_ROLE
            ta, tb = a.data(role) or 0, b.data(role) or 0
            if ta != tb:
                return ta > tb   # newest first
        return super().lessThan(a, b)


