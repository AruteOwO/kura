class Toast(QFrame):
    """Short message in the bottom-right corner (slides in): the show's cover when there is one, the text,
    and an action button (Play, Yes...)."""

    def __init__(self, parent):
        super().__init__(parent)
        self.setObjectName("toast")
        h = QHBoxLayout(self)
        h.setContentsMargins(12, 10, 12, 10)
        h.setSpacing(12)
        self.cover = QLabel()
        self.cover.setFixedSize(32, 46)
        h.addWidget(self.cover)
        self.text = label("", None, wrap=True)
        self.text.setMaximumWidth(360)
        self.text.setStyleSheet("background: transparent;")
        h.addWidget(self.text, 1)
        self.action = QPushButton()
        self.action.setObjectName("primary")
        self.action.setCursor(Qt.PointingHandCursor)
        self.action.clicked.connect(self.run_action)
        self.action.hide()
        h.addWidget(self.action)
        self.callback = None
        self.slide = None
        self.hide()
        self.timer = QTimer(self)
        self.timer.setSingleShot(True)
        self.timer.timeout.connect(self.hide)

    def set_cover(self, image):
        if image is None or image.isNull():
            self.cover.setPixmap(app_icon().pixmap(32, 32))
            self.cover.setFixedSize(32, 32)
            return
        dpr = 2
        pm = QPixmap(32 * dpr, 46 * dpr)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        path = QPainterPath()
        path.addRoundedRect(QRectF(0, 0, 32 * dpr, 46 * dpr), 10, 10)
        p.setClipPath(path)
        p.drawImage(QRectF(0, 0, 32 * dpr, 46 * dpr),
                    image.scaled(32 * dpr, 46 * dpr, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
        p.end()
        pm.setDevicePixelRatio(dpr)
        self.cover.setFixedSize(32, 46)
        self.cover.setPixmap(pm)

    def show_action(self, text, button, callback, ms=20000, image=None):
        """A message with a button, e.g. 'Mark episode 5 watched?' [Yes]."""
        self.callback = callback
        self.action.setText(button)
        self.action.show()
        self._show(text, ms, image)

    def run_action(self):
        cb, self.callback = self.callback, None
        self.hide()
        if cb:
            cb()

    def show_text(self, text, ms=6000, image=None):
        if self.callback and self.isVisible():
            return   # don't replace a question that's waiting for an answer
        self.action.hide()
        self._show(text, ms, image)

    def _show(self, text, ms, image=None):
        self.set_cover(image)
        self.text.setText(text)
        self.adjustSize()
        p = self.parentWidget()
        end = QPoint(p.width() - self.width() - 24, p.height() - self.height() - 24)
        was_up = self.isVisible()
        self.move(end if was_up else end + QPoint(0, 18))
        self.raise_()
        self.show()
        if not was_up:
            self.slide = QPropertyAnimation(self, b"pos", self)
            self.slide.setDuration(220)
            self.slide.setEasingCurve(QEasingCurve.OutCubic)
            self.slide.setStartValue(end + QPoint(0, 18))
            self.slide.setEndValue(end)
            self.slide.start()
        self.timer.start(ms)


