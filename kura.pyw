def fmt_bytes(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024


def fmt_eta(seconds):
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h}h {m}m" if h else f"{m}m {s:02d}s" if m else f"{s}s"


class ProgressDelegate(QStyledItemDelegate):
    """A thin progress bar with the percentage (UserRole = 0..1, UserRole+1 = done/paused/error/active)."""

    def paint(self, p, opt, index):
        super().paint(p, opt, index)
        frac = float(index.data(Qt.UserRole) or 0)
        kind = index.data(Qt.UserRole + 1) or "active"
        color = {"done": C["ok"], "paused": C["muted"], "error": C["bad"]}.get(kind, C["accent"])
        r = opt.rect.adjusted(6, 0, -48, 0)
        bar = QRectF(r.x(), r.center().y() - 3, max(r.width(), 10), 6)
        p.save()
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(C["border_hi"]))
        p.drawRoundedRect(bar, 3, 3)
        if frac > 0:
            p.setBrush(QColor(color))
            p.drawRoundedRect(QRectF(bar.x(), bar.y(), max(bar.width() * min(frac, 1), 6), bar.height()), 3, 3)
        p.setPen(QColor(C["muted"]))
        p.drawText(opt.rect.adjusted(0, 0, -6, 0), Qt.AlignRight | Qt.AlignVCenter, f"{int(frac * 100)}%")
        p.restore()


SORT_ROLE = Qt.UserRole + 20   # a row's value to sort that column by (sizes, progress, seeds: numbers, not text)


class ValueSortItem(QTreeWidgetItem):
    """Sorts by its SORT_ROLE value where it has one (1.4 GB after 852 MB), else by the text."""

    def __lt__(self, other):
        tree = self.treeWidget()
        col = tree.sortColumn() if tree is not None else 0
        a, b = self.data(col, SORT_ROLE), other.data(col, SORT_ROLE)
        if a is not None and b is not None:
            return a < b
        return self.text(col).casefold() < other.text(col).casefold()


