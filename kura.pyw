def ago(ts):
    s = max(0, time.time() - ts)
    if s < 60:
        return "now"
    if s < 3600:
        return f"{int(s // 60)}m"
    if s < 86400:
        return f"{int(s // 3600)}h"
    return "Yesterday" if s < 2 * 86400 else time.strftime("%b %d", time.localtime(ts))


class NoteRow(QFrame):
    """One notification: (unread dot,) cover or kind icon, text, time, its button; hover shows ×.
    compact: one line with a kind icon that opens in place (style C)."""
    acted = Signal(object)       # the note: do its action
    dismissed = Signal(object)
    toggled = Signal(object)     # compact: open / close

    def __init__(self, note, compact=False, opened=False):
        super().__init__()
        self.note = note
        self.setObjectName("noterow")
        self.setAttribute(Qt.WA_Hover)
        self.setCursor(Qt.PointingHandCursor)
        unread = not note.get("read")
        glyph, tint, _ = NOTE_KINDS.get(note.get("kind"), NOTE_KINDS["kura"])
        tint = C["accent_hi"] if tint == "accent" else tint
        bg = f"rgba({accent_rgb()},0.08)" if unread and not compact else "#1d212b" if opened else "transparent"
        self.setStyleSheet(f"QFrame#noterow {{ background: {bg}; border-radius: 12px; }}"
                           f" QFrame#noterow:hover {{ background: rgba(255,255,255,0.045); }}")
        v = QVBoxLayout(self)
        v.setContentsMargins(10, 6 if compact else 10, 10, 6 if compact else 10)
        v.setSpacing(6)
        h = QHBoxLayout()
        h.setSpacing(10 if compact else 12)
        v.addLayout(h)
        cover = cover_file(note["mid"]) if note.get("mid") else None
        if compact:
            h.addWidget(self.icon_tile(glyph, tint, 26), 0, Qt.AlignVCenter)
        else:
            dot = QLabel()
            dot.setFixedSize(6, 6)
            dot.setStyleSheet(f"background: {C['accent_hi'] if unread else 'transparent'}; border-radius: 3px;")
            h.addWidget(dot, 0, Qt.AlignTop)
            h.addSpacing(-4)
            if cover:
                img = RoundedImage(40, 56, 7, note.get("text", ""))
                img.set_image(QImage(str(cover)))
                h.addWidget(img, 0, Qt.AlignTop)
            else:
                h.addWidget(self.icon_tile(glyph, tint, 40), 0, Qt.AlignTop)
        texts = QVBoxLayout()
        texts.setSpacing(2)
        title = QLabel(note.get("text", ""))
        title.setStyleSheet(f"font-size: 9.5pt; font-weight: {600 if unread else 400}; background: transparent;"
                            f" color: {C['text'] if unread else '#c8ccd6'};")
        if compact and not opened:
            title.setText(QFontMetrics(title.font()).elidedText(note.get("text", ""), Qt.ElideRight, 230))
            title.setToolTip(note.get("text", ""))
            title.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        else:
            title.setWordWrap(True)
        texts.addWidget(title)
        if not compact and note.get("sub"):
            texts.addWidget(label(note["sub"], "faint"))
        h.addLayout(texts, 1)
        t = label(ago(note.get("t", 0)), "faint")
        h.addWidget(t, 0, Qt.AlignTop if not compact else Qt.AlignVCenter)
        if compact and unread:
            dot = QLabel()
            dot.setFixedSize(6, 6)
            dot.setStyleSheet(f"background: {C['accent_hi']}; border-radius: 3px;")
            h.addWidget(dot, 0, Qt.AlignVCenter)
        self.x = QPushButton(self)
        self.x.setObjectName("icon")
        self.x.setFixedSize(22, 22)
        self.x.setIcon(glyph_icon("close", C["muted"], C["text"], px=12))
        self.x.setToolTip("Dismiss")
        self.x.setStyleSheet(f"QPushButton {{ background: {C['surface2']}; border: none; border-radius: 6px; padding: 0; }}"
                             f" QPushButton:hover {{ background: {C['hover']}; }}")
        self.x.clicked.connect(lambda: self.dismissed.emit(self.note))
        self.x.hide()
        # the buttons: on every row in the inbox, only when opened in the compact list
        if note.get("button") and (not compact or opened):
            row = QHBoxLayout()
            row.setSpacing(6)
            row.setContentsMargins(36 if compact else 70, 0, 0, 0)
            if compact and cover:
                img = RoundedImage(48, 68, 7, note.get("text", ""))
                img.set_image(QImage(str(cover)))
                row.addWidget(img)
                row.addSpacing(6)
            b = QPushButton(note["button"])
            b.setObjectName("primary" if note.get("kind") != "problem" else "")
            b.setCursor(Qt.PointingHandCursor)
            b.setStyleSheet("QPushButton { padding: 5px 14px; font-size: 9pt; border-radius: 8px; }")
            b.clicked.connect(lambda: self.acted.emit(self.note))
            row.addWidget(b, 0, Qt.AlignBottom)
            if compact:
                d = QPushButton("Dismiss")
                d.setStyleSheet("QPushButton { padding: 5px 12px; font-size: 9pt; border-radius: 8px; }")
                d.clicked.connect(lambda: self.dismissed.emit(self.note))
                row.addWidget(d, 0, Qt.AlignBottom)
            row.addStretch(1)
            v.addLayout(row)

    def icon_tile(self, glyph, tint, size):
        tile = QLabel()
        tile.setFixedSize(size, size)
        tile.setAlignment(Qt.AlignCenter)
        c = QColor(tint)
        tile.setStyleSheet(f"background: rgba({c.red()},{c.green()},{c.blue()},0.16); border-radius: {size // 4}px;")
        tile.setPixmap(glyph_pixmap(glyph, tint, max(14, size // 2)))
        return tile

    def event(self, e):
        if e.type() == QEvent.HoverEnter:
            self.x.move(self.width() - self.x.width() - 8, 8 if self.height() > 40 else (self.height() - 22) // 2)
            self.x.show()
            self.x.raise_()
        elif e.type() == QEvent.HoverLeave:
            self.x.hide()
        return super().event(e)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.position().toPoint()):
            (self.toggled if self.property("compact") else self.acted).emit(self.note)


class NotificationPanel(QFrame):
    """The bell's panel. Inbox (A): cards with covers and buttons, Today / Yesterday / Earlier, filter chips
    (Settings can hide them). Compact (C): one line each, a click opens it in place."""

    def hideEvent(self, e):
        super().hideEvent(e)
        a = self.anchor
        if a is not None:   # the popup had the mouse: the bell never saw it leave, so it stayed lit
