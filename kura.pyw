    """A show's extras by kind (and season): Openings & Endings, Previews, Commercials, Menus, Bonus.
    Right-click an extra: play it, "Don't use on Live TV" (your "not this one"), move it to another kind."""

    def __init__(self, kinds, extras_dir, changed):
        super().__init__()
        self.extras_dir, self.changed = Path(extras_dir), changed
        v = QVBoxLayout(self)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)
