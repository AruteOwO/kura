            self.set("backup_dir", d)
            self.fill()

    def showEvent(self, e):
        super().showEvent(e)
        self.fill()

    def fill(self):
        d = backup_dir(self.settings)
        tip = "" if d.drive.upper() != SCRIPT_DIR.drive.upper() else \
            "  ·  On the same drive as Kura: another drive keeps them safe if this one fails."
        self.folder.setText(str(d) + tip)
        self.tree.clear()
        for path, m in backup_mod.list_backups(d):
            when = datetime.fromtimestamp(m.get("made", 0))
            it = QTreeWidgetItem([when.strftime("%a %d %b %Y, %H:%M"), BACKUP_KINDS.get(m.get("reason"), "Backup"),
                                  str(len(m.get("files") or {})), fmt_bytes(path.stat().st_size)])
            it.setData(0, Qt.UserRole, str(path))
            self.tree.addTopLevelItem(it)
        last = self.settings.get("backup_last")
        if self.job is None:
            self.status.setText(f"Last backup {_ago(last)}" if last else "No backups yet")
        self.selected()

    def current(self):
        it = self.tree.currentItem()
        return it.data(0, Qt.UserRole) if it is not None else None

    def selected(self):
        on = self.current() is not None
        for b in (self.restore_btn, self.show_btn, self.del_btn):
            b.setEnabled(on)

    def menu(self, pos):
        if not self.current():
            return
        m = QMenu(self)
        m.addAction("Restore…", lambda: self.restore(self.current()))
        m.addAction("Show in folder", lambda: subprocess_open_select(self.current()))
        m.addAction("Delete", self.delete)
        m.exec(self.tree.viewport().mapToGlobal(pos))

    def make(self, reason="manual"):
        """A backup on a worker thread (also the weekly one, from MainWindow)."""
        if self.job is not None:
            return
        d, keep = backup_dir(self.settings), int(self.settings.get("backup_keep", 8))
        self.now_btn.setEnabled(False)
        self.status.setText("Backing up…")

        def work():
            path = backup_mod.make(SCRIPT_DIR, d, reason)
            backup_mod.prune(d, keep)
            return path
        self.job = BgCall(work)
        self.job.done.connect(lambda path, err, r=reason: self.made(path, err, r))
        self.job.start()

    def made(self, path, err, reason):
        self.job.wait()
        self.job = None
        self.now_btn.setEnabled(True)
        if err:
            klog.error(f"Backup failed: {err}")
            self.notify.emit(f"Couldn't back up Kura's data: {err}")
        else:
            self.set("backup_last", time.time())
            klog.info(f"Backup made ({reason}): {path}")
            if reason == "manual":
                self.notify.emit("Backup made")
        self.fill()

    def restore(self, path):
        if not path:
            return
        m = backup_mod.read_manifest(path)
        if not m:
            QMessageBox.warning(self, APP_NAME, "That file isn't a Kura backup.")
            return
        dlg = RestoreDialog(self, path, m)
        if dlg.exec() == QDialog.Accepted and dlg.names():
            backup_mod.request_restore(SCRIPT_DIR, path, dlg.names())
            klog.info(f"Restore asked for: {path} ({', '.join(dlg.names())})")
            self.restart.emit()

    def restore_file(self):
        path, _ = QFileDialog.getOpenFileName(self, "Restore a Kura backup", str(backup_dir(self.settings)),
                                              "Kura backups (*.zip)")
        if path:
            self.restore(path)

    def delete(self):
        path = self.current()
        if path and QMessageBox.question(self, APP_NAME, "Send this backup to the Recycle Bin?") == QMessageBox.Yes:
            err = recycle([path])
            if err:
                QMessageBox.warning(self, APP_NAME, err)
            self.fill()

    def shutdown(self):
        if self.job is not None:
            self.job.wait(30000)


class LogHighlighter(QSyntaxHighlighter):
    """Problems red, warnings amber, timestamps faint."""
    BAD = re.compile(r"error|traceback|exception|failed|couldn't|could not|critical", re.I)
    WARN = re.compile(r"warning|warn\b|skipp|retry|429", re.I)
    STAMP = re.compile(r"^\d{4}-\d\d-\d\d[ T]\d\d:\d\d:\d\d")

    def __init__(self, doc):
        super().__init__(doc)
        self.fmt = {}
        for k, col in (("bad", C["bad"]), ("warn", C["warn"]), ("stamp", C["faint"])):
            f = QTextCharFormat()
            f.setForeground(QColor(col))
            self.fmt[k] = f

    def highlightBlock(self, text):
        if self.BAD.search(text) or text.startswith(("  File ", "Traceback")):
            self.setFormat(0, len(text), self.fmt["bad"])
        elif self.WARN.search(text):
            self.setFormat(0, len(text), self.fmt["warn"])
        m = self.STAMP.match(text)
        if m:
            self.setFormat(0, m.end(), self.fmt["stamp"])


class LogTool(QWidget):
    """Tools → Logs: Kura's, the organizer's and the Crunchyroll import's logs, live while open."""
    back = Signal()
