        pen = QPen(QColor(C["accent"] if self._hover else C["border_hi"]), 1.5, Qt.DashLine)
        pen.setDashPattern([5, 4])
        p.setPen(pen)
        p.setBrush(accent_color(26) if self._hover else QColor(C["surface"]))
        p.drawRoundedRect(r, 14, 14)


