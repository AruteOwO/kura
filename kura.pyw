class ListBar(QFrame):
    """Your AniList entry for one season: status, progress, score, dates."""

    def __init__(self, account, media):
        super().__init__()
        self.setObjectName("listbar")
        self.account, self.media, self.mid = account, media, media["id"]
        h = QHBoxLayout(self)
        h.setContentsMargins(10, 7, 12, 7)
        h.setSpacing(8)
        self.status_btn = QPushButton()
        self.status_btn.setObjectName("status")
        self.status_btn.setCursor(Qt.PointingHandCursor)
        self.status_btn.clicked.connect(self.status_menu)
        h.addWidget(self.status_btn)
        h.addSpacing(6)
        self.minus = QPushButton()
        self.minus.setObjectName("icon")
        self.minus.setIcon(glyph_icon(G["minus"], C["text"], px=12))
        self.minus.setToolTip("One episode less")
        self.minus.clicked.connect(lambda: self.step(-1))
        self.prog = label("", "h2")
        self.plus = QPushButton()
        self.plus.setObjectName("icon")
        self.plus.setIcon(glyph_icon(G["add"], C["text"], px=12))
        self.plus.setToolTip("Watched one more episode")
        self.plus.clicked.connect(lambda: self.step(1))
        for w in (self.minus, self.prog, self.plus):
            h.addWidget(w)
        h.addSpacing(10)
        self.score_lbl = label("Score", "faint")
        self.score = QComboBox()   # a list of the scores your AniList scale allows (1-10), not a number to type
        self.score.setToolTip("Your score")
        self.score.setMaxVisibleItems(12)
        self.score.activated.connect(lambda _i: self.score_changed())
        h.addWidget(self.score_lbl)
        h.addWidget(self.score)
        h.addStretch(1)
        self.dates = label("", "faint")
        h.addWidget(self.dates)
        self.refresh()

    def entry(self):
        return self.account.entry(self.mid)

    def refresh(self):
        e = self.entry()
        on = e is not None
        if on:
            self.status_btn.setText(f"{acct.STATUS_NAMES.get(e['status'], e['status'])}  ▾")
            self.status_btn.setStyleSheet(status_style(e["status"]))
        else:
            self.status_btn.setText("+  Add to list")
            self.status_btn.setStyleSheet("")
        for w in (self.minus, self.prog, self.plus, self.score_lbl, self.score, self.dates):
            w.setVisible(on)
        if not on:
            return
        total = self.media.get("episodes")
        self.prog.setText(f"{e.get('progress') or 0} / {total or '?'}")
        fmt = self.account.score_format
        top, decimals = acct.SCORE_RANGES.get(fmt, (10, 0))
        step = 0.5 if decimals else (5 if top == 100 else 1)
        values, v = [], float(top)
        while v >= step - 1e-9:   # highest first: 10, 9, ... 1
            values.append(round(v, 1))
            v -= step
        mine = e.get("score") or 0
        if mine and all(abs(mine - x) > 1e-6 for x in values):   # a score set elsewhere (7.3): keep it in the list
            values = sorted(values + [mine], reverse=True)
        self.score.blockSignals(True)
        self.score.clear()
        self.score.addItem("–", 0)   # no score
        for x in values:
            self.score.addItem(acct.format_score(x, fmt) or str(x), x)
        self.score.setCurrentIndex(max(0, self.score.findData(mine) if mine else 0))
        self.score.blockSignals(False)
        parts = []
        if acct.format_date(e.get("startedAt")):
            parts.append(f"Started {acct.format_date(e['startedAt'])}")
        if acct.format_date(e.get("completedAt")):
            parts.append(f"Finished {acct.format_date(e['completedAt'])}")
        if e.get("repeat"):
            parts.append(f"Rewatched {e['repeat']}×")
        self.dates.setText("  ·  ".join(parts))

    def step(self, delta):
        e = self.entry()
        self.account.set_progress(self.mid, ((e or {}).get("progress") or 0) + delta, self.media)

    def score_changed(self):
        e = self.entry()
        value = float(self.score.currentData() or 0)
        if e and abs((e.get("score") or 0) - value) > 1e-6:
            self.account.save(self.mid, self.media, score=value)

    def status_menu(self):
        e = self.entry()
        menu = QMenu(self)
        for st in acct.STATUS_ORDER:
            a = menu.addAction(acct.STATUS_NAMES[st], lambda s=st: self.account.set_status(self.mid, s, self.media))
            a.setCheckable(True)
            a.setChecked(bool(e and e["status"] == st))
        menu.addSeparator()
        orig = self.media.get("episodes_anilist", self.media.get("episodes"))
        menu.addAction(f"Episode count… ({self.media.get('episodes') or '?'})", self.set_count)
        if e:
            menu.addAction("Remove from list", self.remove)
        menu.exec(self.status_btn.mapToGlobal(self.status_btn.rect().bottomLeft()))

    def set_count(self):
        """AniList's episode count is wrong for this season (recaps counted, a split...): use yours."""
        orig = self.media.get("episodes_anilist", self.media.get("episodes")) or 0
        n, ok = QInputDialog.getInt(self, "Episode count", f"How many episodes does this season really have?\n"
                                    f"AniList says {orig or 'nothing'}. 0 = use AniList's again.",
                                    self.media.get("episodes") or orig, 0, 5000)
        if not ok:
            return
        settings = APP.get("settings") or {}
        counts = dict(settings.get("episode_counts") or {})
        if n and n != orig:
            counts[str(self.mid)] = n
        else:
            counts.pop(str(self.mid), None)
            EPISODE_FIX.pop(self.mid, None)
        settings["episode_counts"] = counts
        save_settings(settings)
        _DETAILS_CACHE.clear()
        fix_list_episodes(self.account)
        self.account.changed.emit()   # every page counts again

    def remove(self):
        title = (self.media.get("title") or {}).get("romaji") or "this entry"
        box = QMessageBox(QMessageBox.Question, "Remove from list",
                          f"Remove {title} from your AniList list? Your progress and score for it are deleted.",
                          QMessageBox.Yes | QMessageBox.Cancel, self)
        if box.exec() == QMessageBox.Yes:
            self.account.remove(self.mid)


def next_episode(sections, account):
    """The next episode to watch: first season you haven't finished, one past your progress."""
    for s in sections:
        if not s["id"] or not s["counted"]:
            continue
        e = account.entry(s["id"])
        st, p = (e or {}).get("status"), (e or {}).get("progress") or 0
        if st in ("COMPLETED", "DROPPED"):
            continue
        n = p + 1
        if s["aired"] == 0 or (s["aired"] is not None and n > s["aired"]):
            return None   # caught up
        return {"section": s, "n": n, "path": s["files"].get(n)}
    return None


_web = {}


def trailer_profile():
    """Browser profile for trailers, created the first time one is played."""
    if "profile" not in _web:
        from PySide6.QtWebEngineCore import QWebEngineProfile, QWebEngineSettings, QWebEngineUrlRequestInterceptor

        class Referer(QWebEngineUrlRequestInterceptor):
            # YouTube refuses embedded players that don't say which site they're on (error 153)
            def interceptRequest(self, info):
                if info.requestUrl().host().endswith(("youtube-nocookie.com", "youtube.com")):
                    info.setHttpHeader(b"Referer", b"https://kura.app/")

        # Off-the-record: nothing saved to disk, so several Kura windows never fight over it
        profile = QWebEngineProfile(QApplication.instance())
        interceptor = Referer(profile)
        profile.setUrlRequestInterceptor(interceptor)
        profile.settings().setAttribute(QWebEngineSettings.PlaybackRequiresUserGesture, False)   # you just clicked play
        profile.settings().setAttribute(QWebEngineSettings.FullScreenSupportEnabled, True)
        _web.update(profile=profile, interceptor=interceptor)
    return _web["profile"]


def warm_up_trailers():
    """Start the video engine in the background (on a show page with a trailer),
    so pressing Play doesn't wait for it."""
    if "warm" in _web:
        return
    try:
        from PySide6.QtWebEngineCore import QWebEnginePage
    except ImportError:
        return
    page = QWebEnginePage(trailer_profile())
    page.setUrl(QUrl("about:blank"))
    _web["warm"] = page


def shut_down_trailers():
    """The engine wants its pages gone before the profile; called when Kura closes."""
    page = _web.pop("warm", None)
    if page is not None:
        import shiboken6
        shiboken6.delete(page)


def trailer_urls(trailer):
    """(embed url, watch url) for an AniList trailer."""
    tid, site = trailer["id"], trailer.get("site")
    if site == "youtube":
        return (f"https://www.youtube-nocookie.com/embed/{tid}?autoplay=1&rel=0&modestbranding=1",
                f"https://www.youtube.com/watch?v={tid}")
    return f"https://www.dailymotion.com/embed/video/{tid}?autoplay=1", f"https://www.dailymotion.com/video/{tid}"


class TrailerSeek(QWidget):
    """The trailer's progress: a thin bar that grows on hover; click or drag to seek (on release)."""
    seek = Signal(float)

    def __init__(self, parent):
        super().__init__(parent)
        self.pos, self.dur, self.hover, self.drag = 0.0, 0.0, False, None
        self.setFixedHeight(16)
        self.setCursor(Qt.PointingHandCursor)

    def set_state(self, pos, dur):
        if self.drag is None:
            self.pos, self.dur = pos, dur
            self.update()

    def _frac(self, x):
        return max(0.0, min(1.0, (x - 6) / max(1, self.width() - 12)))

    def enterEvent(self, e):
        self.hover = True
        self.update()

    def leaveEvent(self, e):
        self.hover = False
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.LeftButton and self.dur:
            self.drag = self._frac(e.position().x())
            self.update()

    def mouseMoveEvent(self, e):
        if self.drag is not None:
            self.drag = self._frac(e.position().x())
            self.update()

    def mouseReleaseEvent(self, e):
        if self.drag is not None:
            self.pos = self._frac(e.position().x()) * self.dur
            self.drag = None
            self.seek.emit(self.pos)
            self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        big = self.hover or self.drag is not None
        h = 5 if big else 3
        w = self.width() - 12
        y = self.height() / 2 - h / 2
        p.setBrush(QColor(255, 255, 255, 70))
        p.drawRoundedRect(QRectF(6, y, w, h), h / 2, h / 2)
        frac = self.drag if self.drag is not None else (self.pos / self.dur if self.dur else 0.0)
        frac = max(0.0, min(1.0, frac))
        if frac > 0:
            p.setBrush(QColor(C["accent"]))
            p.drawRoundedRect(QRectF(6, y, max(h, w * frac), h), h / 2, h / 2)
        if big:
            p.setBrush(QColor("white"))
            p.drawEllipse(QPointF(6 + w * frac, self.height() / 2), 6, 6)


