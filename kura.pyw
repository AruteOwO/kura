class PadRing(QWidget):
    """The highlight around what the controller is on."""

    def __init__(self, parent):
        super().__init__(parent)
        self.setAttribute(Qt.WA_TransparentForMouseEvents)
        self.setAttribute(Qt.WA_NoSystemBackground)
        self.hide()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(2, 2, -2, -2)
        p.setPen(QPen(QColor(C["accent"]).lighter(130), 3))
        p.setBrush(accent_color(28))
        p.drawRoundedRect(r, 12, 12)


class PadNavigator(QObject):
    """Controllers around Kura: the d-pad / left stick moves a ring between buttons, cards, episodes and list
    items (spatially, like a TV app), A clicks, B goes back, LB / RB switch pages, the right stick scrolls, Menu is
    a right-click, View opens search. While Kura's player is in front, the buttons drive the player instead.
    Only while a Kura window is the active one, so a game played with the same pad doesn't move Kura."""
    KEYS = {"DPAD_UP": Qt.Key_Up, "DPAD_DOWN": Qt.Key_Down, "DPAD_LEFT": Qt.Key_Left, "DPAD_RIGHT": Qt.Key_Right}
    VEC = {"DPAD_UP": (0, -1), "DPAD_DOWN": (0, 1), "DPAD_LEFT": (-1, 0), "DPAD_RIGHT": (1, 0)}

    def __init__(self, win, reader=None):
        super().__init__(win)
        self.win = win
        self.pads = pad_mod.Gamepads(reader)
        self.target = None          # (widget, QRect in widget coords or None for an item view)
        self.ring = None
        self.mouse_at = None
        self.greeted = False
        self.timer = QTimer(self, interval=16, timeout=self.tick)
        if self.pads.available:
            self.timer.start()
            QApplication.instance().installEventFilter(self)

    # ---- the loop
    def tick(self):
        if not self.win.settings.get("controller_enabled", True):
            if self.ring is not None and self.ring.isVisible():
                self.ring.hide()
                self.target = None
            return
        active = QApplication.activeWindow()
        if active is None:
            return   # Kura isn't in front
        ev = self.pads.poll()
        if ev["pads"] and not self.greeted:
            self.greeted = True
            self.win.notify("Controller connected: the d-pad moves, A selects, B goes back")
        if not ev["any"]:
            return
        pl = self.win.player
        if pl is not None and pl.isVisible() and active is pl.window():
            for name in ev["pressed"] + ev["repeat"]:
                pl.pad(name)
            return
        for name in ev["pressed"] + ev["repeat"]:
            self.press(name)
        sx, sy = ev["scroll"]
        if sy or sx:
            self.scroll(sx, sy)

    def eventFilter(self, obj, e):
        if e.type() == QEvent.MouseMove and self.ring is not None and self.ring.isVisible():
            pos = e.globalPosition().toPoint()
            if self.mouse_at is None:
                self.mouse_at = pos
            elif (pos - self.mouse_at).manhattanLength() > 6:   # the mouse is back: no ring
                self.ring.hide()
                self.target = None
                self.mouse_at = None
        return False

    # ---- what's on screen
    def root(self):
        """Where the ring may go: an open dialog / menu / overlay, else Kura's window."""
        modal = QApplication.activeModalWidget()
        if modal is not None:
            return modal
        for w in (getattr(self.win, "palette", None), getattr(self.win, "close_overlay", None)):
            if w is not None and w.isVisible():
                return w
        return self.win.centralWidget()

    def targets(self, root):
        out = []
        for w in root.findChildren(QWidget):
            if not w.isVisible() or not w.isEnabled() or w.width() < 8 or w.height() < 8 or w is self.ring:
                continue
            par = w.parentWidget()
            skip = False
            while par is not None and par is not root:
                if isinstance(par, (QAbstractItemView, QComboBox)) or par.__class__.__name__ in ("RecCard",):
                    skip = True   # inside a list view / combo / card: the outer thing is the target
                    break
                par = par.parentWidget()
            if skip:
                continue
            if isinstance(w, QAbstractItemView):
                if w.model() is not None and w.model().rowCount() > 0:
                    out.append((w, None))
            elif hasattr(w, "pad_rects"):
                out += [(w, r) for r in w.pad_rects()]
            elif isinstance(w, (QAbstractButton, QComboBox, QSlider)) or isinstance(getattr(type(w), "clicked", None), Signal):
                out.append((w, w.rect()))
        return out

    def global_rect(self, t):
        w, r = t
        if r is None:   # an item view: its current item
            idx = w.currentIndex()
            vr = w.visualRect(idx) if idx.isValid() else QRect()
            if not vr.isValid():
                return QRect(w.mapToGlobal(QPoint(0, 0)), w.size())
            return QRect(w.viewport().mapToGlobal(vr.topLeft()), vr.size())
        return QRect(w.mapToGlobal(r.topLeft()), r.size())

    def valid(self, t):
        try:
            if t is None or not t[0].isVisible() or not self.root().isAncestorOf(t[0]):
                return False
            # the page changed under it (A opened a show, a link switched pages): start again on the new page
            pages = self.win.pages
            return not pages.isAncestorOf(t[0]) or pages.currentWidget().isAncestorOf(t[0])
        except RuntimeError:
            return False

    def in_side(self, w):
        return self.win.side.isAncestorOf(w)

    # ---- moving
    def press(self, name):
        if QApplication.activePopupWidget() is not None:   # a right-click menu / combo list is open
            self.key({"A": Qt.Key_Return, "B": Qt.Key_Escape, **self.KEYS}.get(name), QApplication.activePopupWidget())
            return
        if name in self.VEC:
            self.move(name)
        elif name == "A":
            self.activate()
        elif name == "B":
            self.back()
        elif name in ("LB", "RB"):
            self.page(-1 if name == "LB" else 1)
        elif name == "START":
            self.context_menu()
        elif name == "BACK" and getattr(self.win, "palette", None) is not None:
            self.win.palette.open()

    def move(self, name):
        root = self.root()
        if not self.valid(self.target):
            self.target = self.first(root)
            return self.show_ring()
        w, r = self.target
        if r is None:   # inside a list: let it move first; leave it at its edge
            before = w.currentIndex()
            self.key(self.KEYS[name], w)
            if w.currentIndex() != before:
                return self.show_ring()
        here = self.global_rect(self.target)
        dx, dy = self.VEC[name]
        best, score = None, None
        c = here.center()
        side = self.in_side(w)
        for t in self.targets(root):
            if t[0] is w and (t[1] == r or r is None):
                continue
            if dy and self.in_side(t[0]) != side:
                continue
            g = self.global_rect(t) if t[1] is not None else QRect(t[0].mapToGlobal(QPoint(0, 0)), t[0].size())
            p = g.center()
            vx, vy = p.x() - c.x(), p.y() - c.y()
            along = vx * dx + vy * dy
            if along <= 4:
                continue
            # overlapping across the move (same row / column) costs nothing sideways
            if dx:
                across = 0 if (g.top() < here.bottom() and g.bottom() > here.top()) else abs(vy)
            else:
                across = 0 if (g.left() < here.right() and g.right() > here.left()) else abs(vx)
            sc = along + across * 2.5
            if score is None or sc < score:
                best, score = t, sc
        if best is not None:
            self.target = best
            if best[1] is None:   # into a list: start at its first visible item
                v = best[0]
                if not v.currentIndex().isValid():
                    v.setCurrentIndex(v.indexAt(QPoint(8, 8)) if v.indexAt(QPoint(8, 8)).isValid() else
                                      v.model().index(0, 0))
        self.show_ring()

    def first(self, root):
        """Where the ring starts: the current page's first thing (top-left), else anything."""
        page = self.win.pages.currentWidget() if root is self.win.centralWidget() else root
        start = getattr(page, "pad_start", None)
        t = start() if start else None
        if t is not None and self.valid(t):
            return t
        ts = self.targets(page) or self.targets(root)
        if not ts:
            return None
        return min(ts, key=lambda t: (self.global_rect(t).top() // 40, self.global_rect(t).left()))

    def show_ring(self):
        if not self.valid(self.target):
            if self.ring is not None:
                self.ring.hide()
            return
        self.ensure_visible()
        host = self.root().window()
        if self.ring is None or self.ring.parentWidget() is not host:
            self.ring = PadRing(host)
        g = self.global_rect(self.target).adjusted(-5, -5, 5, 5)
        self.ring.setGeometry(QRect(host.mapFromGlobal(g.topLeft()), g.size()))
        self.ring.show()
        self.ring.raise_()
        self.mouse_at = None

    def ensure_visible(self):
        w, r = self.target
        if r is None:
            w.scrollTo(w.currentIndex())
            return
        child, rect = w, r
        par = w.parentWidget()
        while par is not None:
            if isinstance(par, QScrollArea) and par.widget() is not None and par.widget().isAncestorOf(w):
                top = child.mapTo(par.widget(), rect.center())
                par.ensureVisible(top.x(), top.y(), rect.width() // 2 + 30, rect.height() // 2 + 40)
            par = par.parentWidget()

    # ---- doing
    def activate(self):
        if not self.valid(self.target):
            return self.move("DPAD_DOWN")
        w, r = self.target
        if isinstance(w, QAbstractButton):
            w.click()
        elif isinstance(w, QComboBox):
            w.showPopup()
        else:
            self.click(w, r)
        QTimer.singleShot(60, self.show_ring)

    def click(self, w, r, button=Qt.LeftButton):
        if r is None:   # list item: click its middle
            vr = w.visualRect(w.currentIndex())
            target, pos = w.viewport(), QPointF(vr.center())
        else:
            target, pos = w, QPointF(r.center())
        gpos = QPointF(target.mapToGlobal(pos.toPoint()))
        for kind in (QEvent.MouseButtonPress, QEvent.MouseButtonRelease):
            QApplication.sendEvent(target, QMouseEvent(kind, pos, gpos, button, button if kind == QEvent.MouseButtonPress
                                                       else Qt.NoButton, Qt.NoModifier))

    def context_menu(self):
        if not self.valid(self.target):
            return
        w, r = self.target
        target = w.viewport() if r is None else w
        pos = (w.visualRect(w.currentIndex()).center() if r is None else r.center())
        QApplication.sendEvent(target, QContextMenuEvent(QContextMenuEvent.Keyboard, pos, target.mapToGlobal(pos)))

    def back(self):
        modal = QApplication.activeModalWidget()
        if modal is not None:
            return self.key(Qt.Key_Escape, modal)
        for w in (getattr(self.win, "palette", None), getattr(self.win, "close_overlay", None)):
            if w is not None and w.isVisible():
                return self.key(Qt.Key_Escape, w)
        if self.win.pages.currentIndex() == self.win.DETAIL:
            self.win.detail.back.emit()
        elif self.win.pages.currentIndex() != self.win.HOME:
            self.win.go(self.win.HOME)
        self.target = None
        QTimer.singleShot(250, lambda: self.move("DPAD_DOWN"))

    def page(self, step):
        order = [i for i, b in self.win.nav_buttons.items() if not b.isHidden()]
        cur = self.win.pages.currentIndex()
        cur = self.win.prev_page if cur not in order else cur
        i = order.index(cur) if cur in order else 0
        self.win.go(order[(i + step) % len(order)])
        self.target = None
        QTimer.singleShot(250, lambda: self.move("DPAD_DOWN"))

    def scroll(self, sx, sy):
        g = self.global_rect(self.target) if self.valid(self.target) else None
        point = g.center() if g else QCursor.pos()
        w = QApplication.widgetAt(point) or self.win.pages.currentWidget()
        local = QPointF(w.mapFromGlobal(point))
        ev = QWheelEvent(local, QPointF(point), QPoint(0, 0), QPoint(int(-sx * 40), int(sy * 40)), Qt.NoButton,
                         Qt.NoModifier, Qt.NoScrollPhase, False)
        QApplication.sendEvent(w, ev)
        if self.ring is not None and self.ring.isVisible():
            QTimer.singleShot(0, self.show_ring)

    @staticmethod
    def key(code, target):
        if code is None or target is None:
            return
        for kind in (QEvent.KeyPress, QEvent.KeyRelease):
            QApplication.sendEvent(target, QKeyEvent(kind, code, Qt.NoModifier))


def backup_dir(settings):
