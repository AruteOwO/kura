class KickoffPage(Page):
    """What's starting: your Planning shows that began this season, sequels to shows you finished (airing now,
    announced, or out and not on your list). Start watching = Watching on AniList, which is what Kura's torrent
    feed downloads new episodes for."""
    open_media = Signal(int, str, object)
    find_torrents = Signal(str)
    check_now = Signal()
    count_changed = Signal(int)

    def __init__(self, settings, account):
        super().__init__("Kickoff", "")
        self.settings, self.account = settings, account
        self.loader = None
        head = QHBoxLayout()
        self.when = label("", "faint")
        head.addWidget(self.when, 1)
        self.check_btn = QPushButton(" Check for sequels")
        self.check_btn.setIcon(glyph_icon("sync", C["text"]))
        self.check_btn.clicked.connect(self.check_now)
        head.addWidget(self.check_btn)
        self.outer.addLayout(head)
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setFrameShape(QFrame.NoFrame)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.outer.addWidget(self.scroll, 1)
        self.timer = QTimer(self, singleShot=True, interval=400, timeout=self.fresh_rebuild)

    def showEvent(self, e):
        super().showEvent(e)
        # only when your list changed while it showed, or it's old (it rebuilt on every visit: ~0.7 s)
        if getattr(self, "dirty", True) or time.time() - getattr(self, "built_at", 0) > 1800:
            self.fresh_rebuild()

    def fresh_rebuild(self, force=False):
        """force: the loading screen builds it while hidden. Otherwise a hidden page only updates its sidebar
        count and stays dirty (marking it fresh there left Kickoff blank until a list change)."""
        if not (force or self.isVisible()):
            self.dirty = True
            self.count_changed.emit(self.count())
            return
        self.dirty, self.built_at = False, time.time()
        self.rebuild(force)

    def schedule(self, *_):
        """Your list changed. While you're looking at the page it isn't redrawn under you (only the sidebar count
        updates); it's fresh the next time you open it."""
        if self.isVisible():
            self.count_changed.emit(self.count())
            self.dirty = True
            return
        self.timer.start()

    def sections(self):
        a = self.account
        if not (a and a.connected):
            return None
        season, year = current_season()
        starting = []
        for mid, e in a.view().items():
            m = e.get("media") or {}
            if e.get("status") == "PLANNING" and m.get("status") == "RELEASING" and \
                    (m.get("season"), m.get("seasonYear")) == (season, year):
                starting.append(m)
        seq = (alerts_mod.load().get("sequels") or [])
        seq = [x for x in seq if x["media"]["id"] not in a.entries and acct.is_adult(x["media"]) == acct.ADULT["on"]]
        airing = [x for x in seq if x["media"].get("status") == "RELEASING"]
        coming = sorted([x for x in seq if x["media"].get("status") == "NOT_YET_RELEASED"],
                        key=lambda x: tuple((x["media"].get("startDate") or {}).get(k) or 9999 for k in ("year", "month", "day")))
        done = sorted([x for x in seq if x["media"].get("status") == "FINISHED"
                       and x["media"].get("format") in ("TV", "TV_SHORT", "ONA", "OVA", "MOVIE")],
                      key=lambda x: -((x["media"].get("startDate") or {}).get("year") or 0))
        return starting, airing, coming, done

    def rebuild(self, force=False):
        if not (force or self.isVisible()):
            self.count_changed.emit(self.count())
            return
        body = QWidget()
        col = QVBoxLayout(body)
        col.setContentsMargins(0, 0, 8, 0)
        col.setSpacing(14)
        season, year = current_season()
        self.subtitle.setText(f"{season_name(season, year)}  ·  what's starting from your list, and sequels to "
                              "shows you've finished")
        cached = alerts_mod.load()
        self.when.setText(f"Sequels checked {time.strftime('%d %b %H:%M', time.localtime(cached['t']))}  ·  "
                          "once a day" if cached.get("t") else "Sequels not checked yet")
        secs = self.sections()
        self.cards = {}
        if secs is None:
            col.addWidget(EmptyState("person", "Connect your AniList account",
                                     "Kickoff works from your list: shows you planned, and sequels to the ones "
                                     "you've finished."))
        else:
            starting, airing, coming, done = secs
            self.section(col, f"Started this season from your Planning list", starting, "starting",
                         "None of your Planning shows started this season.")
            self.section(col, "Sequels airing now", [x["media"] for x in airing], "airing",
                         "No sequels to your shows are airing right now.", airing)
            self.section(col, "Announced", [x["media"] for x in coming], "coming",
                         "No sequels announced." if cached.get("t") else "Press Check for sequels.", coming)
            if done:
                self.section(col, "Sequels you haven't added", [x["media"] for x in done[:48]], "done", "", done)
        col.addStretch(1)
        self.scroll.setWidget(body)
        self.load_images()
        self.count_changed.emit(self.count())

    def count(self):
        secs = self.sections()
        return len(secs[0]) + len(secs[1]) if secs else 0

    def section(self, col, title, medias, kind, empty, sources=None):
        head = QHBoxLayout()
        head.addWidget(row_title(title))
        if medias:
            head.addWidget(label(str(len(medias)), "faint"))
        head.addStretch(1)
        col.addLayout(head)
        if not medias:
            col.addWidget(label(empty, "faint", wrap=True))
            return
        froms = {x["media"]["id"]: x.get("from_title") for x in sources or []}
        cards = []
        for m in medias:
            mid, title = m["id"], media_title(m)
            nxt = m.get("nextAiringEpisode") or {}
            if kind in ("starting", "airing"):
                badge = ("Airing", "#3db4f2")
                note = (f"Ep {nxt['episode']} in {countdown(nxt['airingAt'])}" if nxt.get("airingAt") else "Airing")
                buttons = [("Start watching", True, lambda _=False, i=mid, mm=m: self.start(i, mm))]
                if kind == "airing":
                    buttons.append(("Add to Planning", False, lambda _=False, i=mid, mm=m: self.plan(i, mm)))
                else:
                    buttons.append(("Find episodes", False, lambda _=False, mm=m: self.find_torrents.emit(
                        (mm.get("title") or {}).get("romaji") or media_title(mm))))
            elif kind == "coming":
                badge = ("Announced", "#c084fc")
                note = season_name(m.get("season"), m.get("seasonYear") or (m.get("startDate") or {}).get("year"))
                buttons = [("Add to Planning", True, lambda _=False, i=mid, mm=m: self.plan(i, mm))]
            else:
                badge = None
                note = f"{FORMAT_TEXT.get(m.get('format'), '')}  ·  {(m.get('startDate') or {}).get('year') or ''}"
                buttons = [("Add to Planning", True, lambda _=False, i=mid, mm=m: self.plan(i, mm))]
            c = KickCard(m, badge, note, buttons)
            if froms.get(mid):
                c.card.setToolTip(f"{title}\nSequel to {froms[mid]}")
            c.card.clicked.connect(lambda i=mid, t=title: self.open_media.emit(i, t, None))
            self.cards[mid] = c
            cards.append(c)
        grid = RecGrid(cards)
        more = LinkButton(f"Show all {len(cards)}")
        more.clicked.connect(lambda: (grid.set_expanded(not grid.expanded),
                                      more.setText("Show fewer" if grid.expanded else f"Show all {len(cards)}")))
        head.addWidget(more)
        more.setVisible(len(cards) > 8)
        col.addWidget(grid)

    def load_images(self):
        if self.loader is not None:
            return
        want = []
        for mid, c in self.cards.items():
            cover = c.card.media.get("coverImage") or {}
            url = cover.get("extraLarge") or cover.get("large")
            if url:
                want.append((mid, url))

        def work():   # each poster shows as soon as it's here
            for mid, url in want:
                img = cached_image(url, COVER_DIR / f"{mid}{Path(url.split('?')[0]).suffix or '.jpg'}")
                if img is not None:
                    QTimer.singleShot(0, self, lambda m=mid, i=img: self.on_image(m, i))
        self.loader = BgCall(work)
        self.loader.done.connect(lambda *_: (self.loader.wait(), setattr(self, "loader", None)))
        self.loader.start()

    def on_image(self, mid, img):
        c = self.cards.get(mid)
        if c is not None:
            try:
                c.set_image(img)
            except RuntimeError:
                pass

    def start(self, mid, media):
        self.account.save(mid, media, status="CURRENT", progress=0)
        self.mark(mid, "Watching")

    def plan(self, mid, media):
        self.account.save(mid, media, status="PLANNING")
        self.mark(mid, "Added to Planning")

    def mark(self, mid, text):
        c = self.cards.get(mid)
        if c is not None:
            c.mark_done(text)
        self.count_changed.emit(self.count())

    def shutdown(self):
        if self.loader is not None:
            self.loader.wait(10000)



