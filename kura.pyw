    def notes(self):
        return [n for n in reversed(self.win.visible_notes())
                if self.chip == "All" or NOTE_KINDS.get(n.get("kind"), NOTE_KINDS["kura"])[2] == self.chip]

    def fill(self):
        while self.chips.count():
            w = self.chips.takeAt(0).widget()
            if w:
                w.deleteLater()
        if self.filters:
            for name in ("All", "Episodes", "Shows", "Downloads", "Live TV", "Kura"):
                b = QPushButton(name)
                b.setObjectName("notechip")
                b.setCursor(Qt.PointingHandCursor)
                on = name == self.chip
                b.setStyleSheet(f"QPushButton#notechip {{ background: {f'rgba({accent_rgb()},0.22)' if on else 'transparent'};"
                                f" border: 1px solid {f'rgba({accent_rgb()},0.5)' if on else C['border_hi']};"
                                f" color: {'white' if on else '#a9afbf'}; border-radius: 11px; padding: 3px 11px; font-size: 8.5pt; }}"
                                f" QPushButton#notechip:hover {{ color: white; }}")
                b.clicked.connect(lambda _=False, n=name: (setattr(self, "chip", n), self.fill()))
                self.chips.addWidget(b)
            self.chips.addStretch(1)
        unread = sum(1 for n in self.win.visible_notes() if not n.get("read"))
        self.new_pill.setText(f"{unread} new")
        self.new_pill.setVisible(unread > 0)
        body = QWidget()
        col = QVBoxLayout(body)
        col.setContentsMargins(0, 0, 0, 0)
        col.setSpacing(2)
        notes = self.notes()
        if not notes:
            box = QVBoxLayout()
            box.setContentsMargins(20, 30, 20, 30)
            box.addWidget(glyph_label("notifications_none", C["faint"], 34), 0, Qt.AlignHCenter)
            box.addWidget(label("You're all caught up", "h2"), 0, Qt.AlignHCenter)
            box.addWidget(label("New episodes, reminders and problems show up here.", "faint", wrap=True), 0, Qt.AlignHCenter)
            col.addLayout(box)
        last = None
        today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
        for n in notes[:60]:
            group = "TODAY" if n["t"] >= today else "YESTERDAY" if n["t"] >= today - 86400 else "EARLIER"
            if group != last and not self.compact:
                g = QLabel(group)
                g.setStyleSheet(f"color: {C['faint']}; font-size: 7.5pt; letter-spacing: 1.2px; padding: 8px 10px 4px 10px;"
                                " background: transparent;")
                col.addWidget(g)
                last = group
            row = NoteRow(n, compact=self.compact, opened=self.opened == n["id"])
            row.setProperty("compact", self.compact)
            row.acted.connect(self.act)
            row.dismissed.connect(self.dismiss)
            row.toggled.connect(self.toggle)
            col.addWidget(row)
        col.addStretch(1)
        self.scroll.setWidget(body)
        body.adjustSize()
        self.scroll.setFixedHeight(min(600, max(120, body.sizeHint().height() + 4)))
        self.adjustSize()
        self.place()

    def place(self):
        a = self.anchor
        top_right = a.mapToGlobal(QPoint(a.width(), a.height() + 6))
        self.move(top_right.x() - self.width() + 40, top_right.y())

    def act(self, note):
        if not note.get("button"):   # nothing to do: just read
            self.win.read_note(note)
            self.fill()
            return
        self.close()
        self.win.run_note(note)

    def dismiss(self, note):
        self.win.drop_note(note)
        self.fill()

    def toggle(self, note):
        self.opened = None if self.opened == note["id"] else note["id"]
        self.win.read_note(note)
        self.fill()

    def mark_all(self):
        self.win.read_note(None)
        self.fill()

    def clear_all(self):
        self.win.drop_note(None)
        self.fill()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(QPen(QColor(C["border_hi"]), 1))
        p.setBrush(QColor(C["surface"]))
        p.drawRoundedRect(QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5), 16, 16)


def cover_file(mid):
    """A show's cover already in cover_cache (no download), or None."""
    for ext in (".jpg", ".png", ".jpeg", ".webp"):
        f = COVER_DIR / f"{mid}{ext}"
