        self.rebuild()

    # ---- the week board: 2 days back, 5 ahead, then Needs you · Your week · Next up
    def week_data(self, have_ids):
        """Episodes airing in the 7 days around today (past ones from the air log), with their status: on disk,
        downloading, sent, needs you (why), not out yet... and the missed-episode entries."""
        from datetime import date as _date, timedelta
        a = self.account
        today = _date.today()
        days = [today + timedelta(days=i) for i in range(-2, 5)]
        start = datetime.combine(days[0], datetime.min.time()).timestamp()
        end = datetime.combine(days[-1] + timedelta(days=1), datetime.min.time()).timestamp()
        now = time.time()
        log = air_log(a)
        tp = getattr(self, "torrents", None)
        needs = tp.missed_entries() if tp is not None else []
        state = tp.load_missed() if tp is not None else {}
        have, lib, sent = tp.have_sent() if tp is not None else ({}, set(), set())
        downloading = {}
        dl = getattr(tp, "downloads", None) if tp is not None else None
        if dl is not None and dl.connected:
            for t in dl.torrents.values():
                for e in ([t["episode"]] if t.get("episode") else t.get("episodes") or []):
                    if t.get("mid") and not tor.is_done(t):
                        downloading[(t["mid"], e)] = t.get("progress") or 0
        need_at = {}
        for e in needs:
            for ep in e["eps"]:
                need_at[(e["mid"], ep)] = e
        wanted = {"CURRENT", "REPEATING", "PAUSED"} | ({"PLANNING"} if self.settings.get("schedule_planning", True) else set())
        auto = self.settings.get("torrent_auto_check") and self.settings.get("torrent_new_action") == "download"
        eps = []
        for mid, e in a.view().items():
            if e.get("status") not in wanted or (have_ids is not None and mid not in have_ids):
                continue
            m = e.get("media") or {}
            nxt = m.get("nextAiringEpisode") or {}
            found = {}
            for k, ts in (log.get(str(mid)) or {}).items():
                try:
                    found[int(k)] = ts
                except ValueError:
                    pass
            if nxt.get("episode") and nxt.get("airingAt"):
                found[nxt["episode"]] = nxt["airingAt"]
                for back in (1, 2):
                    n = nxt["episode"] - back
                    if n >= 1 and n not in found:
                        found[n] = aired_at(log, mid, n, nxt)
            for n, ts in found.items():
                if ts and start <= ts < end and (not nxt.get("episode") or n <= nxt["episode"]):
                    eps.append(self.week_status(mid, e, m, n, ts, now, have, lib, sent, downloading, need_at,
                                                state, auto))
        by_day = {d: [] for d in days}
        for x in eps:
            d = datetime.fromtimestamp(x["ts"]).date()
            if d in by_day:
                by_day[d].append(x)
        for d in by_day:
            by_day[d].sort(key=lambda x: x["ts"])
        return days, by_day, needs

    def week_status(self, mid, e, m, n, ts, now, have, lib, sent, downloading, need_at, state, auto):
        title = media_title(m)
        x = {"mid": mid, "ep": n, "ts": ts, "title": title, "media": m, "kind": "todo"}
        if ts > now:
            behind = (n - 1) - (e.get("progress") or 0)
            if e.get("status") == "PLANNING":
                x.update(st="Planning", st_color=STATUS_COLORS["PLANNING"])
            elif behind > 0:
                x.update(st=f"{behind} behind", st_color="#e8c27a")
            else:
                x.update(st="Watching", st_color="#9ccbff")
            x["sub"] = f"Episode {n}  ·  in {countdown(ts)}"
            x["auto"] = bool(auto and mid in lib)
            return x
        x["sub"] = f"Episode {n}"
        need = need_at.get((mid, n))
        st = state.get(f"{mid}:{n}") or {}
        if mid in lib and n in have.get(mid, ()):
            x.update(st="✓ Downloaded", st_color="#7fe0b0", kind="got", dim=True)
        elif (mid, n) in downloading:
            pct = int(downloading[(mid, n)] * 100)
            x.update(st=f"Downloading {pct}%", st_color="#9ccbff", kind="got")
            if need is not None and need["kind"] == "stuck":
                x.update(st=f"Stuck · {pct}%", st_color="#ff9aa7", kind="miss", line="rgba(245,182,66,0.55)",
                         sub=need["why"], tip=need["why"])
        elif need is not None:
            x.update(st=need["tag"].capitalize(), st_color=need["color"], kind="miss",
                     line="rgba(245,182,66,0.55)", sub=need["why"], tip=need["why"])
        elif (mid, n) in sent:
            x.update(st="Sent", st_color="#9ccbff", kind="got")
        elif st.get("reason") == "off_schedule" and st.get("moved"):
            x.update(st=f"Moved to {datetime.fromtimestamp(st['moved']).strftime('%d %b').lstrip('0')}",
                     st_color="#d6b4ff")
        elif mid not in lib:
            x.update(st="Aired", st_color="#aeb4c4", kind="other")   # a show you don't have: not in Your week
        else:
            x.update(st="Not out yet" if now - ts < 36 * 3600 else "Not found yet", st_color="#c8ccd6",
                     sub=f"Episode {n}  ·  Kura keeps looking")
        return x

    def fit_days(self, days, by_day, today):
        """As many days as fit (about 120 px per column, a busy day counts twice): future days go first, then the
        oldest; today and yesterday stay."""
        from datetime import timedelta
        width = max(400, self.scroll.viewport().width() - 16)
        days = list(days)

        def need(ds):
            units = sum(2 if len(by_day[d]) > 4 else 1 for d in ds)
            return units * 120 + (len(ds) - 1) * 10
        while need(days) > width and len(days) > 2:
            if days[-1] > today + timedelta(days=1) or days[0] >= today - timedelta(days=1):
                days.pop()
            else:
                days.pop(0)
        return days

    def week_page(self, have_ids):
        from datetime import date as _date, timedelta
        days, by_day, needs = self.week_data(have_ids)
        self.week_made = (have_ids, days, by_day)   # check_fit on show: the same week, no second pass
        today = _date.today()
        all_days, days = days, self.fit_days(days, by_day, today)
        wrap = QWidget()
        v = QVBoxLayout(wrap)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(16)
        board = QWidget()
        # tall enough that every card gets two lines of title (a busy week makes the board taller)
        most = max([((len(by_day[d]) + 1) // 2 if len(by_day[d]) > 4 else len(by_day[d])) for d in days] + [1])
        board.setFixedHeight(max(440, min(900, 64 + most * 116)))
        row = QHBoxLayout(board)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(10)
        total = sum(len(by_day[d]) for d in all_days)
        bars = []
        for d in days:
            items = by_day[d]
            wide = len(items) > 4
            rows = (len(items) + 1) // 2 if wide else len(items)
            tiles = []
            for x in items:
                x["big"] = rows <= 2
                x["px"] = 15 if rows <= 2 else 13 if rows <= 3 else 12
                t = SchedTile(x)
                t.clicked.connect(lambda mid=x["mid"], tt=x["title"]: self.open_media.emit(mid, tt, None))
                if x["kind"] == "miss":
                    t.setContextMenuPolicy(Qt.CustomContextMenu)
                    t.customContextMenuRequested.connect(lambda _p, mid=x["mid"], n=x["ep"]: self.open_need(mid, n))
                url = (x["media"].get("coverImage") or {}).get("extraLarge")
                if url:
                    self.slots.setdefault(x["mid"], (url, []))[1].append(t)
                tiles.append(t)
            kind = "today" if d == today else "past" if d < today else "future"
            name = ("Today" if d == today else "Yesterday" if d == today - timedelta(days=1)
                    else "Tomorrow" if d == today + timedelta(days=1) else d.strftime("%A"))
            row.addWidget(DayColumn((name, d.strftime("%d %b").lstrip("0")), tiles, wide, kind), 2 if wide else 1)
        for d in all_days:   # Your week: all 7 days, even when fewer fit on the board
            items = by_day[d]
            got = sum(1 for x in items if x["kind"] == "got")
            miss = sum(1 for x in items if x["kind"] == "miss")
            bars.append((d.strftime("%a"), got, miss, sum(1 for x in items if x["kind"] == "todo"), d == today))
        v.addWidget(board)

        bottom = QWidget()
        narrow = self.scroll.viewport().width() < 1180   # Needs you on its own row, the other two under it
        self.shown_days = (len(days), narrow)
        self.shown_width = self.scroll.viewport().width()
        bottom.setFixedHeight(620 if narrow else 300)
        grid = QGridLayout(bottom)
        grid.setContentsMargins(0, 0, 0, 0)
        grid.setSpacing(14)
        bh = QHBoxLayout()
        bh.setSpacing(14)
        if narrow:
            grid.addWidget(self.needs_panel(needs), 0, 0)
            grid.addLayout(bh, 1, 0)
        else:
            bh.addWidget(self.needs_panel(needs), 14)
            grid.addLayout(bh, 0, 0)
        week = QFrame()
        week.setObjectName("weekpanel")
        week.setStyleSheet(f"QFrame#weekpanel {{ background: {C['surface']}; border: 1px solid {C['border']};"
                           f" border-radius: 16px; }} QLabel {{ background: transparent; }}")
        wv = QVBoxLayout(week)
        wv.setContentsMargins(16, 14, 16, 12)
        wv.setSpacing(10)
        here = sum(b[1] for b in bars)
        aired = sum(b[1] + b[2] for b in bars)
        to_come = sum(b[3] for b in bars)
        wv.addLayout(self.panel_head(C["ok"], "Your week", f"{here} of {aired} here  ·  {to_come} to come"))
        wv.addWidget(SchedBars(bars), 1)
        key = QLabel(f"<span style='color:{C['ok']}'>■</span> here &nbsp; <span style='color:{C['warn']}'>■</span>"
                     f" needs you &nbsp; ▢ to come")
        key.setTextFormat(Qt.RichText)
        key.setStyleSheet(f"color: {C['muted']}; font-size: 8pt;")
        wv.addWidget(key)
        bh.addWidget(week, 10)
        upcoming = sorted((x for d in all_days for x in by_day[d] if x["ts"] > time.time()), key=lambda x: x["ts"])
        nxt = upcoming[0] if upcoming else None
        thumb = self.thumb(nxt["mid"], nxt["media"], nxt["title"]) if nxt else None
        if thumb is not None:
            thumb.setFixedSize(74, 104)
        self.next_panel = NextUpPanel(nxt, thumb)
        self.next_panel.open.connect(lambda mid: self.open_media.emit(mid, nxt["title"] if nxt else "", None))
        bh.addWidget(self.next_panel, 10)
        v.addWidget(bottom)
        self.needs = needs
        n_need = len(needs)
        self.subtitle.setText(f"{total} episodes this week" + (f"  ·  {n_need} show{'s' if n_need != 1 else ''} need you" if n_need else "")
                              + "  ·  times in your timezone")
        return wrap

