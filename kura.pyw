def recycle(paths):
    """Send files or folders to the Recycle Bin (Windows asks first if something can't go there and would be
    deleted for good). Returns "" or the error."""
    if os.name != "nt":
        return "only on Windows"
    import ctypes
    from ctypes import wintypes

    class SHFILEOPSTRUCTW(ctypes.Structure):
        _fields_ = [("hwnd", wintypes.HWND), ("wFunc", wintypes.UINT), ("pFrom", wintypes.LPCWSTR),
                    ("pTo", wintypes.LPCWSTR), ("fFlags", ctypes.c_uint16), ("fAnyOperationsAborted", wintypes.BOOL),
                    ("hNameMappings", ctypes.c_void_p), ("lpszProgressTitle", wintypes.LPCWSTR)]
    FO_DELETE, FOF_SILENT, FOF_NOCONFIRMATION, FOF_ALLOWUNDO, FOF_NOERRORUI, FOF_WANTNUKEWARNING = \
        3, 0x4, 0x10, 0x40, 0x400, 0x4000
    op = SHFILEOPSTRUCTW(None, FO_DELETE, "\0".join(str(p) for p in paths) + "\0\0", None,
                         FOF_ALLOWUNDO | FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI | FOF_WANTNUKEWARNING,
                         False, None, None)
    rc = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))
    if rc:
        return f"Windows couldn't do it (error {rc}); a file may be open in another app"
    return "Canceled" if op.fAnyOperationsAborted else ""


