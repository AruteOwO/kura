HOVER_HINTS = {"on": True}   # Settings → App → Hover hints (WheelDebounce's filter blocks ToolTip events when off)


class WheelDebounce(QObject):
    """The user's mouse wheel bounces: while spinning it sometimes sends a single tick the
    wrong way, often in the same millisecond as a real tick, or just before one after a
    pause. At the end of a page that showed as a jitter (up one notch, back down).
    Rules, worked out from a recording of the real mouse:
      - a tick that reverses direction within 60 ms of the previous tick is a bounce
        (no finger reverses that fast), unless the next tick agrees with it;
      - any other reversing tick is held for 50 ms: if a tick the original way arrives
        meanwhile it was a bounce and is dropped, otherwise it's replayed as a real reversal;
      - two reversing ticks in a row (within 150 ms) are always a real change of direction."""
    BOUNCE_MS, HOLD_MS, CONFIRM_MS = 60, 50, 150

    def __init__(self, parent=None):
        super().__init__(parent)
        self.sign, self.last_ts, self.dropped = 0, -10 ** 9, None
        self.held = None                    # (timestamp, event copy, widget) of a reversing tick
        self.replaying = False
        self.last = (None, None, False)     # (timestamp, delta, dropped): one event, many widgets
        self.timer = QTimer(self, singleShot=True, interval=self.HOLD_MS, timeout=self.release,
                            timerType=Qt.PreciseTimer)

    def eventFilter(self, obj, e):
        t = e.type()
        if t == QEvent.ToolTip:   # Settings → App → Hover hints off: no hover text (charts draw their own readouts)
            return not HOVER_HINTS["on"]
        if t == QEvent.Polish and obj.isWidgetType() and obj.metaObject().className() == "QTipLabel":
            # Qt's hover text is a small window of its own: see-through so the rounded style shows (a solid one
            # has square corners) and without Windows' square drop shadow
            obj.setAttribute(Qt.WA_TranslucentBackground)
            obj.setWindowFlags(obj.windowFlags() | Qt.NoDropShadowWindowHint)   # (setWindowFlag(f) alone: no-op)
            return False
        if t in (QEvent.Polish, QEvent.Resize, QEvent.WindowTitleChange) and obj.isWidgetType() and obj.isWindow():
            frame_event(obj, t)
            return False
        if self.replaying or t != QEvent.Wheel:
            return False
        d, ts = e.angleDelta().y(), e.timestamp()
        if not d:
            return False
        if self.last[:2] == (ts, d):        # the same event moving up to a parent widget
            return self.last[2]
        drop = self.decide(obj, e, d, ts)
        self.last = (ts, d, drop)
        return drop

    def decide(self, obj, e, d, ts):
        s = 1 if d > 0 else -1
        if self.held and ts - self.held[0] > self.HOLD_MS:
            self.release()
        if self.held:
            held, self.held = self.held, None
            self.timer.stop()
            self.last_ts, self.dropped = ts, None
            if s == self.sign:              # back the original way: the held tick was a bounce
                return False
            self.replay(held)               # a second tick the new way: real reversal
            self.sign = s
            return False
        if self.sign and s != self.sign:
            if self.dropped == s and ts - self.last_ts < self.CONFIRM_MS:   # second one in a row: real
                self.sign, self.dropped, self.last_ts = s, None, ts
                return False
            if ts - self.last_ts < self.BOUNCE_MS:
                self.dropped, self.last_ts = s, ts
                return True
            self.held = (ts, self.copy(e), obj)
            self.timer.start()
            self.last_ts = ts
            return True
        self.sign, self.dropped, self.last_ts = s, None, ts
        return False

    @staticmethod
    def copy(e):
        c = QWheelEvent(e.position(), e.globalPosition(), e.pixelDelta(), e.angleDelta(), e.buttons(),
                        e.modifiers(), e.phase(), e.inverted(), e.source())
        c.setTimestamp(e.timestamp())
        return c

    def release(self):
        """Nothing came back the other way within 50 ms: the held tick was real."""
        if self.held:
            held, self.held = self.held, None
            self.timer.stop()
            self.replay(held)
            self.sign = 1 if held[1].angleDelta().y() > 0 else -1

    def replay(self, held):
        _, event, target = held
        import shiboken6
        if not shiboken6.isValid(target):
            return
        self.replaying = True
        try:
            QApplication.sendEvent(target, event)
        finally:
            self.replaying = False


