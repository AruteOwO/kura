    def set_avatar(self, img, initial):
        px = 34 * 2
        pm = QPixmap(px, px)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        p.setRenderHint(QPainter.SmoothPixmapTransform)
        path = QPainterPath()
        path.addEllipse(QRectF(0, 0, px, px))
        p.setClipPath(path)
        if img is not None and not img.isNull():
            p.drawImage(QRectF(0, 0, px, px), img.scaled(px, px, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
        else:
            g = QLinearGradient(0, 0, px, px)
            g.setColorAt(0, QColor("#8f7dff"))
            g.setColorAt(1, QColor("#5b4be0"))
            p.fillRect(QRectF(0, 0, px, px), g)
            f = QFont(self.font())
            f.setPixelSize(30)
            f.setWeight(QFont.Bold)
            p.setFont(f)
            p.setPen(QColor("white"))
            p.drawText(QRectF(0, 0, px, px), Qt.AlignCenter, initial)
        p.end()
        pm.setDevicePixelRatio(2)
        self.avatar.setPixmap(pm)

    def set_status(self, text, color=None, dot=None):
        dot_html = f"<span style='color:{dot}'>●</span>&nbsp; " if dot else ""
        self.status.setText(f"{dot_html}<span style='color:{color or C['faint']}'>{html.escape(text)}</span>")

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.LeftButton and self.rect().contains(e.position().toPoint()):
            self.clicked.emit()


class PaletteDelegate(QStyledItemDelegate):
    """A command palette result: icon tile, title, a faint line under it, and its kind on the right."""

    def sizeHint(self, option, index):
        return QSize(option.rect.width(), 48)

    def paint(self, p, option, index):
        d = index.data(Qt.UserRole) or {}
        p.save()
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(option.rect).adjusted(4, 2, -4, -2)
        if option.state & QStyle.State_Selected:
            p.setPen(Qt.NoPen)
            p.setBrush(accent_color(46))
            p.drawRoundedRect(r, 9, 9)
        tile = QRectF(r.x() + 8, r.y() + (r.height() - 30) / 2, 30, 30)
        p.setPen(Qt.NoPen)
        p.setBrush(QColor(255, 255, 255, 14))
        p.drawRoundedRect(tile, 8, 8)
        pm = glyph_pixmap(d.get("glyph", "search"), accent_soft() if option.state & QStyle.State_Selected else C["muted"], 18)
        p.drawPixmap(QPointF(tile.x() + 6, tile.y() + 6), pm)
        f = QFont(option.font)
        f.setPointSizeF(10)
        p.setFont(f)
        kind = d.get("kind", "")
        fm = QFontMetrics(f)
        right = r.right() - 12
        if kind:
            kf = QFont(option.font)
            kf.setPointSizeF(8)
            p.setFont(kf)
            kw = QFontMetrics(kf).horizontalAdvance(kind) + 16
            pill = QRectF(right - kw, r.center().y() - 10, kw, 20)
            p.setBrush(QColor(255, 255, 255, 12))
            p.drawRoundedRect(pill, 10, 10)
            p.setPen(QColor(C["muted"]))
            p.drawText(pill, Qt.AlignCenter, kind)
            right = pill.left() - 10
            p.setFont(f)
        x = tile.right() + 12
        width = int(right - x)
        sub = d.get("sub", "")
        p.setPen(QColor(C["text"]))
        ty = r.y() + (8 if sub else (r.height() - fm.height()) / 2)
        p.drawText(QRectF(x, ty, width, fm.height()), Qt.AlignVCenter | Qt.AlignLeft,
                   fm.elidedText(d.get("title", ""), Qt.ElideRight, width))
        if sub:
            sf = QFont(option.font)
            sf.setPointSizeF(8.5)
            p.setFont(sf)
            p.setPen(QColor(C["faint"]))
            p.drawText(QRectF(x, ty + fm.height(), width, 16), Qt.AlignVCenter | Qt.AlignLeft,
                       QFontMetrics(sf).elidedText(sub, Qt.ElideRight, width))
        p.restore()


class CommandPalette(QWidget):
    """Ctrl+K: one search for the whole app - your shows, your list, pages and actions; Enter opens the
    chosen one, and any text can be searched as torrents."""

    def __init__(self, host, win):
        super().__init__(host)
        self.win = win
        self.items = []
        self.panel = QFrame(self)
        self.panel.setObjectName("palette")
        self.panel.setStyleSheet(f"QFrame#palette {{ background: {C['surface']}; border: 1px solid {C['border_hi']};"
                                 f" border-radius: 16px; }}")
        v = QVBoxLayout(self.panel)
        v.setContentsMargins(10, 10, 10, 10)
        v.setSpacing(8)
        row = QHBoxLayout()
        row.setContentsMargins(8, 0, 4, 0)
        row.addWidget(glyph_label("search", C["muted"], 20))
        self.edit = QLineEdit()
        self.edit.setPlaceholderText("Search shows, pages and actions…")
        self.edit.setStyleSheet("QLineEdit { background: transparent; border: none; font-size: 13pt; padding: 8px 4px; }")
        self.edit.textChanged.connect(self.refilter)
        self.edit.installEventFilter(self)
        row.addWidget(self.edit, 1)
        esc = QLabel("Esc")
        esc.setStyleSheet(f"color: {C['muted']}; border: 1px solid {C['border_hi']}; border-radius: 5px;"
                          f" padding: 1px 6px; font-size: 8pt;")
        row.addWidget(esc)
        v.addLayout(row)
        line = QFrame()
        line.setObjectName("divider")
        v.addWidget(line)
        self.list = QListWidget()
        self.list.setObjectName("palettelist")
        self.list.setStyleSheet("QListWidget#palettelist { background: transparent; border: none; outline: none; }")
        self.list.setItemDelegate(PaletteDelegate(self.list))
        self.list.setVerticalScrollMode(QListWidget.ScrollPerPixel)
        self.list.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.list.itemActivated.connect(self.activate)
        self.list.itemClicked.connect(self.activate)
        v.addWidget(self.list, 1)
        host.installEventFilter(self)
        self.hide()

    # ---- what can be found
    def index(self):
        w = self.win
        out = []
        pages = [("Home", "home", w.HOME), ("Library", "video_library", w.LIBRARY), ("Schedule", "calendar_month", 5),
                 ("Seasonal", "auto_awesome", 6), ("To download", "download", 3), ("Torrents", "cloud_download", w.TORRENTS),
                 ("Organize", "drive_file_move", w.ORGANIZE), ("Statistics", "insights", w.STATS),
                 ("Tools", "handyman", w.TOOLS), ("Live TV", "live_tv", 12), ("Settings", "settings", w.SETTINGS)]
        for name, glyph, idx in pages:
            out.append(dict(title=name, sub="", kind="Page", glyph=glyph, keys=name.lower(), rank=1,
                            run=lambda i=idx: w.go(i)))
        actions = [("Check the torrent feed", "refresh", lambda: (w.go(w.TORRENTS), w.torrents.check())),
                   ("Sync your AniList list", "sync", lambda: w.account.refresh()),
                   ("Organize the library folder", "drive_file_move", lambda: (w.go(w.ORGANIZE), w.organize.sort_library())),
                   ("Sort the downloads folder", "download", lambda: (w.go(w.ORGANIZE), w.organize.sort_downloads())),
                   ("Torrent downloads", "downloading", w.show_downloads)]
        for name, glyph, fn in actions:
            out.append(dict(title=name, sub="", kind="Action", glyph=glyph, keys=name.lower(), rank=2, run=fn))
        seen = set()
        for path, it in w.library.items.items():
            idx = it.data(INDEX_ROLE) or {}
            title = it.data(Qt.DisplayRole) or Path(path).name
            seen |= set(idx.get("chain") or [])
            m = media_for(idx.get("mid"), w.account) if idx.get("mid") else {}
            alts = " ".join(filter(None, [(m.get("title") or {}).get("romaji"), (m.get("title") or {}).get("english"),
                                          *(m.get("synonyms") or [])]))
            n_eps = sum(len(v) for v in (idx.get("local") or {}).values())
            out.append(dict(title=title, sub=f"In your library · {n_eps} episode{'s' if n_eps != 1 else ''}",
                            kind="Show", glyph="video_library", keys=f"{title} {Path(path).name} {alts}".lower(),
                            rank=0, run=lambda p=path: w.show_details(p, None)))
        if w.account and w.account.connected:
            for mid, e in w.account.view().items():
                if mid in seen or not e.get("status"):
                    continue
                m = e.get("media") or {}
                t = m.get("title") or {}
                title = media_title(m) if t else str(mid)
                alts = " ".join(filter(None, [t.get("romaji"), t.get("english"), *(m.get("synonyms") or [])]))
                out.append(dict(title=title, sub=acct.STATUS_NAMES.get(e["status"], e["status"]) + " · not downloaded",
                                kind="On your list", glyph="bookmark", keys=f"{title} {alts}".lower(), rank=3,
                                run=lambda i=mid, tt=title: w.show_media(i, tt, None)))
        return out

    def open(self):
        self.items = self.index()
        host = self.parentWidget()
        self.setGeometry(host.rect())
        self.place()
        self.edit.clear()
        self.refilter("")
        self.show()
        self.raise_()
        self.edit.setFocus()

    def place(self):
        w = min(680, self.width() - 80)
        h = min(520, self.height() - 120)
        self.panel.setGeometry((self.width() - w) // 2, max(40, int(self.height() * 0.12)), w, h)

    def refilter(self, text):
        q = " ".join(text.lower().split())
        results = []
        if not q:
            results = [i for i in self.items if i["kind"] in ("Page", "Action")]
        else:
            words = q.split()
            for it in self.items:
                keys = it["keys"]
                if all(wd in keys for wd in words):
                    title = it["title"].lower()
                    score = 0 if title.startswith(q) else 1 if any(t.startswith(words[0]) for t in title.split()) else 2
                    results.append((score, it["rank"], it["title"].lower(), it))
            results = [r[-1] for r in sorted(results, key=lambda r: r[:3])[:60]]
            results.append(dict(title=f"Search torrents for “{text.strip()}”", sub="Opens the Torrents page search",
                                kind="Torrents", glyph="cloud_download", run=lambda t=text.strip(): self.win.find_torrents(t)))
        self.list.clear()
        for it in results:
            li = QListWidgetItem()
            li.setData(Qt.UserRole, it)
            self.list.addItem(li)
        if self.list.count():
            self.list.setCurrentRow(0)

    def activate(self, li=None):
        li = li or self.list.currentItem()
        if li is None:
            return
        it = li.data(Qt.UserRole)
        self.hide()
        it["run"]()

    # ---- keys, clicks, resizing
    def eventFilter(self, obj, e):
        if obj is self.edit and e.type() == QEvent.KeyPress:
            k = e.key()
            if k in (Qt.Key_Down, Qt.Key_Up, Qt.Key_PageDown, Qt.Key_PageUp):
                step = {Qt.Key_Down: 1, Qt.Key_Up: -1, Qt.Key_PageDown: 8, Qt.Key_PageUp: -8}[k]
                n = self.list.count()
                if n:
                    self.list.setCurrentRow(max(0, min(n - 1, self.list.currentRow() + step)))
                return True
            if k in (Qt.Key_Return, Qt.Key_Enter):
                self.activate()
                return True
            if k == Qt.Key_Escape:
                self.hide()
                return True
        if obj is self.parentWidget() and e.type() == QEvent.Resize and self.isVisible():
            self.setGeometry(obj.rect())
            self.place()
        return False

    def paintEvent(self, _):
        QPainter(self).fillRect(self.rect(), QColor(5, 6, 10, 150))

    def mousePressEvent(self, e):
        if not self.panel.geometry().contains(e.position().toPoint()):
            self.hide()


class PageFade(QWidget):
    """Switching pages: the new one fades in (a cover in the background colour fading out; graphics effects
    can't be used on pages that hold a video surface)."""

    def __init__(self, host):
        super().__init__(host)
        self.setAttribute(Qt.WA_TransparentForMouseEvents)
        self._a = 0.0
        self.anim = QPropertyAnimation(self, b"alpha", self)
        self.anim.setDuration(190)
        self.anim.setEasingCurve(QEasingCurve.OutCubic)
        self.anim.finished.connect(self.hide)
        self.hide()

    def get_alpha(self):
        return self._a

    def set_alpha(self, v):
        self._a = v
        self.update()

    alpha = Property(float, get_alpha, set_alpha)

    def play(self):
        host = self.parentWidget()
        self.setGeometry(host.rect())
        self.show()
        self.raise_()
        self.anim.stop()
        self.anim.setStartValue(1.0)
        self.anim.setEndValue(0.0)
        self.anim.start()

    def paintEvent(self, _):
        c = QColor(C["bg"])
        c.setAlphaF(max(0.0, min(1.0, self._a)))
        QPainter(self).fillRect(self.rect(), c)


