    def show_window(self):
        if self.isMinimized():   # back the way it was (maximized stays maximized)
            self.setWindowState(self.windowState() & ~Qt.WindowMinimized)
        self.show()
        self.raise_()
        self.activateWindow()

    def tray_message_clicked(self):
