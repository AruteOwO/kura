        for s in sorted(shows, key=lambda s: s["name"].lower()):
            self.slot_show.addItem(s["name"], s["key"])
        slot = (ch.get("slots") or [{}])[0]
        self.slot_show.setCurrentIndex(max(0, self.slot_show.findData(slot.get("show"))))
        self.slot_time = QLineEdit(slot.get("time") or "20:00")
        self.slot_time.setFixedWidth(70)
        srow.addWidget(self.slot_show, 1)
        srow.addWidget(label("at", "muted"))
        srow.addWidget(self.slot_time)
        self.body.addLayout(srow)
