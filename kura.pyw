def load_material():
    """Load Material Symbols Rounded and its name → code point list (once, at startup)."""
    try:
        fid = QFontDatabase.addApplicationFont(str(FONT_DIR / "MaterialSymbolsRounded.ttf"))
        fams = QFontDatabase.applicationFontFamilies(fid)
        cp = {}
        for line in open(FONT_DIR / "MaterialSymbolsRounded.codepoints", encoding="utf-8"):
            parts = line.split()
            if len(parts) == 2:
                cp[parts[0]] = chr(int(parts[1], 16))
    except (OSError, ValueError):
        return False
    if fams and cp:
        MATERIAL.update(family=fams[0], cp=cp)
        return True
    return False


def resolve_glyph(glyph):
    """(text, font family, filled) to draw a glyph."""
    if MATERIAL["family"] and glyph:
        spec = SEGOE_MATERIAL.get(glyph) if len(glyph) == 1 else glyph
        if spec:
            name, _, style = spec.partition(":")
            ch = MATERIAL["cp"].get(name)
            if ch:
                return ch, MATERIAL["family"], style == "fill"
    return glyph, ICON_FONT, False


def icon_font(family, px, filled):
    f = QFont(family)
    f.setPixelSize(px)
    if family == MATERIAL["family"]:
        f.setVariableAxis(QFont.Tag("FILL"), 1.0 if filled else 0.0)
        f.setVariableAxis(QFont.Tag("wght"), 500.0 if filled else 400.0)
        f.setVariableAxis(QFont.Tag("opsz"), float(max(20, min(48, px // 2))))
    return f


def find_icon_font():
    families = set(QFontDatabase.families())
    for name in ("Segoe Fluent Icons", "Segoe MDL2 Assets"):
        if name in families:
            return name
    return None


def glyph_pixmap(glyph, color, px, fill=None):
    """A glyph drawn at 2x. fill: True/False forces Material's filled/outlined style."""
    pm = QPixmap(px * 2, px * 2)
    pm.fill(Qt.transparent)
    text, family, filled = resolve_glyph(glyph)
    if family:
        material = family == MATERIAL["family"]
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        p.setFont(icon_font(family, int(px * 2 * (0.96 if material else 0.82)), filled if fill is None else fill))
        p.setPen(QColor(color))
        p.drawText(pm.rect(), Qt.AlignCenter, text)
        p.end()
    pm.setDevicePixelRatio(2)
    return pm


def glyph_icon(glyph, color=C["muted"], on_color=C["text"], px=18):
    """Checked ("on") buttons get the filled style, like the page you're on in the sidebar."""
    icon = QIcon()
    icon.addPixmap(glyph_pixmap(glyph, color, px), QIcon.Normal, QIcon.Off)
    icon.addPixmap(glyph_pixmap(glyph, on_color, px, fill=True), QIcon.Normal, QIcon.On)
    icon.addPixmap(glyph_pixmap(glyph, C["faint"], px), QIcon.Disabled, QIcon.Off)
    return icon


def glyph_label(glyph, color=C["muted"], px=20):
    lbl = QLabel()
    lbl.setPixmap(glyph_pixmap(glyph, color, px))
    lbl.setFixedSize(px, px)
    return lbl


def app_icon(colors=("#8f7dff", "#5b4be0")):
    pm = QPixmap(128, 128)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    grad = QLinearGradient(0, 0, 128, 128)
    grad.setColorAt(0, QColor(colors[0]))
    grad.setColorAt(1, QColor(colors[1]))
    p.setBrush(grad)
    p.setPen(Qt.NoPen)
    p.drawRoundedRect(QRectF(4, 4, 120, 120), 30, 30)
    f = QFont()
    f.setFamilies(["Yu Gothic UI", "Yu Gothic", "Meiryo", "MS Gothic"])
    f.setPixelSize(76)
    f.setWeight(QFont.Bold)
    p.setFont(f)
    p.setPen(QColor("white"))
    p.drawText(QRectF(4, 2, 120, 120), Qt.AlignCenter, "蔵")
    p.end()
    return QIcon(pm)


def label(text, name=None, wrap=False):
    lbl = QLabel(text)
    if name:
        lbl.setObjectName(name)
    lbl.setWordWrap(wrap)
    return lbl


def card(name="card"):
    f = QFrame()
    f.setObjectName(name)
    return f


def dark_title_bar(window):
    """Windows 11: dark title bar that matches the window background."""
    if os.name != "nt":
        return
    try:
        import ctypes
        hwnd = int(window.winId())
        dwm = ctypes.windll.dwmapi
        on = ctypes.c_int(1)
        dwm.DwmSetWindowAttribute(hwnd, 20, ctypes.byref(on), 4)          # immersive dark mode
        bg = QColor(C["bg"])
        colorref = ctypes.c_int(bg.red() | bg.green() << 8 | bg.blue() << 16)
        dwm.DwmSetWindowAttribute(hwnd, 35, ctypes.byref(colorref), 4)    # caption colour
        # no maximize / restore / fullscreen animation: Windows animates a snapshot of the old window,
        # which showed as a second, stale copy of Kura (and the video) while the window changed size
        dwm.DwmSetWindowAttribute(hwnd, 3, ctypes.byref(on), 4)           # DWMWA_TRANSITIONS_FORCEDISABLED
        # DWM always draws the frame: with the player's OpenGL surface in the window, Windows fell back to
        # the old "basic" (Windows 7 style, light blue) frame for a frame or two while the size changed
        policy = ctypes.c_int(2)
        dwm.DwmSetWindowAttribute(hwnd, 2, ctypes.byref(policy), 4)       # DWMWA_NCRENDERING_POLICY = ENABLED
    except Exception:
        pass


# ---------------------------------------------------------------- Kura's own title bar (Windows)
# The window stays a normal captioned Windows window (WS_CAPTION | WS_THICKFRAME...), so snapping, Aero Shake,
# minimize from the taskbar and Windows 11's snap layouts keep working; WM_NCCALCSIZE gives the whole window to
# Kura, and WM_NCHITTEST says where the edges, the drag area and the maximize button are.
WM_NCCALCSIZE, WM_NCHITTEST, WM_NCACTIVATE = 0x0083, 0x0084, 0x0086
WM_NCMOUSEMOVE, WM_NCLBUTTONDOWN, WM_NCLBUTTONUP, WM_NCLBUTTONDBLCLK, WM_NCMOUSELEAVE = 0xA0, 0xA1, 0xA2, 0xA3, 0x2A2
HTCLIENT, HTCAPTION, HTMAXBUTTON = 1, 2, 9
HT_EDGES = {(-1, 0): 10, (1, 0): 11, (0, -1): 12, (-1, -1): 13, (1, -1): 14, (0, 1): 15, (-1, 1): 16, (1, 1): 17}


def own_frame(window):
    """Give a frameless Qt window the styles of a normal Windows window back, with a shadow and round corners."""
    if os.name != "nt":
        return
    try:
        import ctypes
        from ctypes import wintypes
        hwnd = int(window.winId())
        u = ctypes.windll.user32
        GWL_STYLE = -16
        get = u.GetWindowLongPtrW if hasattr(u, "GetWindowLongPtrW") else u.GetWindowLongW
        put = u.SetWindowLongPtrW if hasattr(u, "SetWindowLongPtrW") else u.SetWindowLongW
        get.restype = ctypes.c_ssize_t
        get.argtypes = [wintypes.HWND, ctypes.c_int]
        put.restype = ctypes.c_ssize_t
        put.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_ssize_t]
        style = get(hwnd, GWL_STYLE)
        if window.isFullScreen():
            return   # Qt owns the styles while fullscreen (it puts these back when it leaves)
        WS_POPUP, WS_CAPTION, WS_THICKFRAME, WS_SYSMENU, WS_MINIMIZEBOX, WS_MAXIMIZEBOX = (
            0x80000000, 0x00C00000, 0x00040000, 0x00080000, 0x00020000, 0x00010000)
        want = (style & ~WS_POPUP) | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
        if want != style:
            put(hwnd, GWL_STYLE, want)
            u.SetWindowPos(hwnd, None, 0, 0, 0, 0, 0x0001 | 0x0002 | 0x0004 | 0x0010 | 0x0020)   # FRAMECHANGED

        class MARGINS(ctypes.Structure):
            _fields_ = [("l", ctypes.c_int), ("r", ctypes.c_int), ("t", ctypes.c_int), ("b", ctypes.c_int)]
        dwm = ctypes.windll.dwmapi
        dwm.DwmExtendFrameIntoClientArea(hwnd, ctypes.byref(MARGINS(1, 1, 1, 1)))   # the shadow
        round_ = ctypes.c_int(2)
        dwm.DwmSetWindowAttribute(hwnd, 33, ctypes.byref(round_), 4)   # DWMWA_WINDOW_CORNER_PREFERENCE = ROUND
    except Exception as e:
        klog.warning(f"Own title bar: {e}")


def frame_native_event(window, message, regions):
    """WM_NC* for a window with Kura's title bar. regions(pos) -> HTCLIENT / HTCAPTION / HTMAXBUTTON for a point
    in the window (logical px). Returns (handled, result) like nativeEvent."""
    import ctypes
    from ctypes import wintypes
    msg = wintypes.MSG.from_address(int(message))
    m = msg.message
    if m not in (WM_NCCALCSIZE, WM_NCHITTEST, WM_NCACTIVATE, WM_NCMOUSEMOVE, WM_NCLBUTTONDOWN, WM_NCLBUTTONUP,
                 WM_NCLBUTTONDBLCLK, WM_NCMOUSELEAVE):
        return False, 0
    u = ctypes.windll.user32
    hwnd = msg.hWnd
    if m == WM_NCCALCSIZE:
        if not msg.wParam:
            return False, 0
        if u.IsZoomed(hwnd):   # maximized windows hang over the screen's edge by the (invisible) frame
            class RECT(ctypes.Structure):
                _fields_ = [("l", ctypes.c_long), ("t", ctypes.c_long), ("r", ctypes.c_long), ("b", ctypes.c_long)]
            r = RECT.from_address(msg.lParam)   # NCCALCSIZE_PARAMS.rgrc[0]
            try:
                dpi = u.GetDpiForWindow(hwnd)
                bx = u.GetSystemMetricsForDpi(32, dpi) + u.GetSystemMetricsForDpi(92, dpi)   # SIZEFRAME + PADDEDBORDER
                by = u.GetSystemMetricsForDpi(33, dpi) + u.GetSystemMetricsForDpi(92, dpi)
            except Exception:
                bx = u.GetSystemMetrics(32) + u.GetSystemMetrics(92)
                by = u.GetSystemMetrics(33) + u.GetSystemMetrics(92)
            r.l += bx
            r.t += by
            r.r -= bx
            r.b -= by
        return True, 0
    if m == WM_NCACTIVATE:   # no old-style caption repaint when the window (de)activates
        u.DefWindowProcW.argtypes = [wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM]
        u.DefWindowProcW.restype = ctypes.c_ssize_t
        return True, u.DefWindowProcW(hwnd, m, msg.wParam, -1)
    if m == WM_NCHITTEST:
        if window.isFullScreen():
            return True, HTCLIENT
        pt = wintypes.POINT(ctypes.c_short(msg.lParam & 0xFFFF).value, ctypes.c_short((msg.lParam >> 16) & 0xFFFF).value)
        u.ScreenToClient(hwnd, ctypes.byref(pt))
        dpr = window.devicePixelRatioF() or 1.0
        pos = QPoint(int(pt.x / dpr), int(pt.y / dpr))
        if not window.isMaximized():
            e = 6
            dx = -1 if pos.x() < e else 1 if pos.x() >= window.width() - e else 0
            dy = -1 if pos.y() < e else 1 if pos.y() >= window.height() - e else 0
            if dx or dy:
                return True, HT_EDGES[(dx, dy)]
        return True, regions(pos)
    # the maximize button: Windows sends its mouse as non-client messages (that's what shows snap layouts)
    btn = getattr(window, "nc_max_btn", None)
    if m in (WM_NCMOUSEMOVE, WM_NCMOUSELEAVE):
        over = m == WM_NCMOUSEMOVE and msg.wParam == HTMAXBUTTON
        for b in window.max_buttons():
            b.set_nc_hover(over and b is btn)
        if over:
            class TME(ctypes.Structure):
                _fields_ = [("cb", wintypes.DWORD), ("flags", wintypes.DWORD), ("hwnd", wintypes.HWND),
                            ("hover", wintypes.DWORD)]
            t = TME(ctypes.sizeof(TME), 0x00000002 | 0x00000010, hwnd, 0)   # TME_LEAVE | TME_NONCLIENT
            u.TrackMouseEvent(ctypes.byref(t))
        return False, 0
    if msg.wParam == HTMAXBUTTON and btn is not None:
        if m == WM_NCLBUTTONDOWN:
            btn.set_nc_down(True)
        elif m == WM_NCLBUTTONUP:
            btn.set_nc_down(False)
            btn.clicked.emit()
        return True, 0
    return False, 0


class CapButton(QAbstractButton):
    """A window button drawn like Windows 11's (thin lines): minimize, maximize / restore, close, or the bell."""

    def __init__(self, kind, h=36, w=46):
        super().__init__()
        self.kind = kind
        self.setFixedSize(w, h)
        self.setFocusPolicy(Qt.NoFocus)
        self.setAttribute(Qt.WA_Hover)
        self.nc_hover = self.nc_down = False
        self.dot = None
        self.setToolTip({"min": "Minimize", "max": "Maximize", "close": "Close", "bell": "Notifications"}[kind])
        if kind == "bell":
            self.dot = QLabel(self)   # unread notifications
            self.dot.setFixedSize(6, 6)
            self.dot.move(w // 2 + 4, h // 2 - 8)
            self.dot.hide()

    def set_nc_hover(self, on):
        if on != self.nc_hover:
            self.nc_hover = on
            self.update()

    def set_nc_down(self, on):
        self.nc_down = on
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        hover = self.underMouse() or self.nc_hover
        down = self.isDown() or self.nc_down
        if hover or down:
            if self.kind == "close":
                p.fillRect(self.rect(), QColor("#c42b1c" if not down else "#a8261a"))
            else:
                p.fillRect(self.rect(), accent_color(70 if down else 46))
        active = self.window().isActiveWindow()
        fg = QColor("white" if (hover and self.kind == "close") or hover else C["text"] if active else C["faint"])
        if self.dot is not None:
            self.dot.setStyleSheet(f"background: {C['accent_hi']}; border-radius: 3px;")
        if self.kind == "bell":
            pm = glyph_pixmap("notifications", fg.name(), 16)
            p.drawPixmap((self.width() - 16) // 2, (self.height() - 16) // 2, pm)
            return
        dpr = self.devicePixelRatioF()
        pen = QPen(fg, 1.0 / dpr * max(1, round(dpr)))   # one device pixel (crisp, like Windows' own)
        p.setPen(pen)
        cx, cy = self.width() / 2, self.height() / 2
        s = 5   # half of the 10 px glyph
        if self.kind == "min":
            p.drawLine(QPointF(cx - s, cy), QPointF(cx + s, cy))
        elif self.kind == "close":
            p.setRenderHint(QPainter.Antialiasing)
            p.drawLine(QPointF(cx - s, cy - s), QPointF(cx + s, cy + s))
            p.drawLine(QPointF(cx + s, cy - s), QPointF(cx - s, cy + s))
        elif self.window().isMaximized():   # restore: two overlapping squares
            p.setRenderHint(QPainter.Antialiasing)
            p.drawRoundedRect(QRectF(cx - s, cy - s + 2, 8, 8), 1.2, 1.2)
            p.drawPolyline([QPointF(cx - s + 2, cy - s), QPointF(cx + s - 1, cy - s), QPointF(cx + s, cy - s + 1),
                            QPointF(cx + s, cy + s - 2)])
        else:
            p.setRenderHint(QPainter.Antialiasing)
            p.drawRoundedRect(QRectF(cx - s, cy - s, 2 * s, 2 * s), 1.5, 1.5)


class FrameKeeper(QObject):
    """Puts Kura's own frame back when Qt makes a new native window (WinIdChange). An event filter, not an
    event() override on the window: an override runs every event of the main window through Python, holding
    the GIL while Qt lays out and paints, and the library scan's thread took 28 s instead of 4 at startup."""

    def __init__(self, window):
        super().__init__(window)
        self.window = window
        window.installEventFilter(self)

    def eventFilter(self, obj, e):
        if e.type() == QEvent.WinIdChange:
            QTimer.singleShot(0, lambda: own_frame(self.window))
        return False


class CaptionButtons(QWidget):
    """Top right of Kura: (the bell, a thin divider,) minimize, maximize and close."""

    def __init__(self, window, bell=True, h=36):
        super().__init__()
        self.win = window
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(0)
        self.bell = None
        if bell:
            self.bell = CapButton("bell", h)
            lay.addWidget(self.bell)
            div = QFrame()
            div.setFixedSize(1, 16)
            div.setStyleSheet(f"background: {C['border_hi']};")
            lay.addSpacing(4)
            lay.addWidget(div, 0, Qt.AlignVCenter)
            lay.addSpacing(4)
        self.min_btn = CapButton("min", h)
        self.max_btn = CapButton("max", h)
        self.close_btn = CapButton("close", h)
        for b in (self.min_btn, self.max_btn, self.close_btn):
            lay.addWidget(b)
        self.min_btn.clicked.connect(window.showMinimized)
        self.max_btn.clicked.connect(lambda: window.showNormal() if window.isMaximized() else window.showMaximized())
        self.close_btn.clicked.connect(window.close)

    def show_window_buttons(self, on):
        for b in (self.min_btn, self.max_btn, self.close_btn):
            b.setVisible(on)


class TitleStrip(QWidget):
    """The top of the page column: the search, centred on the whole window, and the window buttons.
    Its empty space moves the window (double-click maximizes), like a title bar."""
    H = 50

    def __init__(self, window, own_buttons):
        super().__init__()
        self.win = window
        self.setFixedHeight(self.H)
        self.setProperty("kura_drag", True)
        self.search = SideSearch()
        self.search.setObjectName("topsearch")
        self.search.setParent(self)
        self.search.setFixedHeight(34)
        self.caps = CaptionButtons(window, bell=True)
        self.caps.setParent(self)
        self.caps.show_window_buttons(own_buttons)

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.caps.adjustSize()
        cw = self.caps.sizeHint().width()
        self.caps.setGeometry(self.width() - cw, 0, cw, 36)
        room = self.width() - cw - 32
        sw = max(180, min(400, room - 24))
        # centred on the window (not just this column), kept clear of the buttons
        cx = self.win.width() / 2 - self.mapTo(self.win, QPoint(0, 0)).x()
        left = int(min(max(cx - sw / 2, 24), self.width() - cw - 16 - sw))
        self.search.setGeometry(max(16, left), (self.H - 34) // 2, sw, 34)


class PlayerTitleStrip(QWidget):
