        self.busy.show()
        self.status.setText("Checking…")
        self.worker = BgCall(lambda: self.preview(self.library))
        self.worker.done.connect(self.on_preview)
        self.worker.start()

    def preview(self, library):
        cache = org.load_cache()
        plan = org.extras_plan(Path(library), cache, getattr(self, "sources", []))
        save_lookup_cache(cache)
        out = []
        for it in plan:
            dest = Path(it["dest"])
            show_dir = Path(library) / it["show"]
            into = str(dest.parent.relative_to(show_dir)) if dest.is_relative_to(show_dir) else str(dest.parent)
            kind = "Special" if it["kind"] == "special" else org.EXTRA_KIND_FOLDERS[it["kind"]]
            out.append((it["show"], Path(it["src"]).name, kind, into))
        return out

    def child(self, row):
        _, name, kind, into = row
        return [name, kind, into]


