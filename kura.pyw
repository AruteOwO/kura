        self.col = QVBoxLayout(self.inner)
        self.col.setContentsMargins(0, 0, 8, 0)
        self.col.setSpacing(8)
        self.scroll.setWidget(self.inner)
        v.addWidget(self.scroll, 1)
        self.images = {}

    def showEvent(self, e):
        super().showEvent(e)
        if self.pick.count() == 0:
            for s in library_shows(self.library):
                mid = (s["index"] or {}).get("mid")
                if mid:
                    self.pick.addItem(s["name"], mid)
            self.pick.setCurrentIndex(-1)

    def show_for(self, mid, name):
        """Open the guide on a show (from elsewhere in Kura)."""
        i = self.pick.findData(mid)
        if i < 0:
            self.pick.addItem(name, mid)
            i = self.pick.count() - 1
        self.pick.setCurrentIndex(i)
        self.load()

    def load(self):
        mid = self.pick.currentData()
        if not mid or self.job is not None:
            return
        self.status.setText("Reading AniList…")
        st = self.status
        self.job = BgCall(lambda: order_mod.franchise(mid, progress=lambda n: QTimer.singleShot(
            0, st, lambda: st.setText(f"Reading AniList… {n} entries"))))
        self.job.done.connect(self.on_loaded)
        self.job.start()

    def on_loaded(self, entries, err):
        self.job.wait()
        self.job = None
        self.status.setText(f"Couldn't read AniList: {err}" if err else "")
        self.entries = entries or []
        self.fill()

    def mark(self, mid):
        """(text, colour) for what you have / your list says."""
        a = self.account
        e = (a.entry(mid) or {}) if a and a.connected else {}
        have = any(mid in ((s["index"] or {}).get("chain") or []) and ((s["index"] or {}).get("local") or {}).get(mid)
                   for s in library_shows(self.library))
        st = e.get("status")
        if st == "COMPLETED":
            return "Watched", C["ok"]
        if st in ("CURRENT", "REPEATING"):
            return f"Watching · {e.get('progress') or 0}", "#3db4f2"
        if have:
            return "In your library", C["accent_hi"]
        if st == "PLANNING":
            return "Planning", "#c084fc"
        return "", C["faint"]

    def fill(self):
        clear_layout(self.col)
        rows = [e for e in self.entries if e["main"] or not self.main_only.isChecked()]
        n = 0
        for e in rows:
            if e["main"]:
                n += 1
            self.col.addWidget(self.row(e, n if e["main"] else None))
        if self.entries and not rows:
            self.col.addWidget(label("Nothing to show.", "faint"))
        self.col.addStretch(1)

    def row(self, e, number):
        w = ClickRow(f"Open {e['title']}")
        h = QHBoxLayout(w)
        h.setContentsMargins(10, 8, 10, 8)
        h.setSpacing(12)
        num = QLabel(str(number) if number else "·")
        num.setFixedWidth(26)
        num.setAlignment(Qt.AlignCenter)
        num.setStyleSheet(f"color: {C['accent_hi'] if number else C['faint']}; font-size: 13pt; font-weight: 700;"
                          " background: transparent;")
        h.addWidget(num)
        pic = RoundedImage(44, 62, 6, e["title"])
        h.addWidget(pic)
        if e.get("cover"):
            call = BgCall(lambda u=e["cover"], i=e["id"]: cached_image(u, COVER_DIR / f"small_{i}.jpg"))
            call.done.connect(lambda img, err, p=pic, c=call: (c.wait(), p.set_image(img) if img is not None else None))
            self.images[e["id"]] = call
            call.start()
        txt = QVBoxLayout()
        txt.setSpacing(2)
        txt.addWidget(label(e["title"], "h2"))
        bits = [e["format"], str(e["year"]) if e["year"] and e["year"] != 9999 else "TBA",
                f"{e['episodes']} ep" if e.get("episodes") else "",
                self.REL.get(e["relation"], "") if not e["main"] else "Main story",
                "Not aired yet" if e.get("status") == "NOT_YET_RELEASED" else ""]
        txt.addWidget(label("  ·  ".join(b for b in bits if b), "faint"))
        h.addLayout(txt, 1)
        text, color = self.mark(e["id"])
        if text:
            m = QLabel(text)
            m.setStyleSheet(f"color: {color}; font-weight: 600; background: transparent;")
            h.addWidget(m)
        w.clicked.connect(lambda i=e["id"], t=e["title"]: self.open_media.emit(i, t, None))
        return w

    def shutdown(self):
        if self.job is not None:
            self.job.wait(60000)
        for c in self.images.values():
            c.wait(5000)



